# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit it.

# ── General ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── MCP server ────────────────────────────────────────────────────────────────
# Set to 1 to enable verbose debug logging to stderr
MCP_DEBUG=0

# ── HTTP server (src/http.ts) ─────────────────────────────────────────────────
# Used only when running: npm run http:start
PORT=3000
HOST=0.0.0.0

# ── GitHub ────────────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── GitLab ────────────────────────────────────────────────────────────────────
# Create at: https://gitlab.com/-/profile/personal_access_tokens
# Required scope: api
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_API_URL=https://gitlab.com

# ── Optional MCP servers ──────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb

# ── cv-recruiter tool (src/tools/cv-recruiter.ts) ─────────────────────────────
# Chiama l'endpoint /api/cv-recruiter deployato su cv-site (stessa passphrase
# impostata lì come CV_TOOL_PASSPHRASE — vedi cv-site/.env.example).
CV_TOOL_BASE_URL=https://giulio-occhipinti.com
CV_TOOL_PASSPHRASE=

# ── Project-specific variables (add below) ───────────────────────────────────

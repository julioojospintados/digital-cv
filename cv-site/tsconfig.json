{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "../src/data/cv.ts",
    "../src/data/cv.en.ts",
    "../scripts/cv-pdf-template.ts"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    // Disabilitato solo per il falso positivo Flip.d.ts/flip.d.ts (todo #42):
    // il conflitto di casing è interno al pacchetto gsap stesso, rilevabile
    // solo su filesystem case-insensitive (Windows) — il nostro unico import
    // (memory-drawer.ts) usa già "gsap/Flip" in modo consistente. skipLibCheck
    // (già true nel preset astro/tsconfigs/strict) non basta perché questo
    // controllo riguarda i percorsi dei moduli, non il contenuto dei .d.ts.
    "forceConsistentCasingInFileNames": false,
    "paths": {
      "@cv-data": ["../src/data/cv.ts"],
      "@cv-data-en": ["../src/data/cv.en.ts"],
      "@cv-pdf-template": ["../scripts/cv-pdf-template.ts"]
    }
  }
}

# Copy to .env (gitignored) for local dev, and set the same names as
# server-side env vars in the Vercel project settings for production.
# Used only by src/pages/api/cv-recruiter.ts (the private /tools/cv-recruiter
# generator) — the rest of the site needs no env vars.

# Google AI Studio API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to "gemini-flash-latest" (always the newest free-tier
# Flash model) if unset.
GEMINI_MODEL=

# Shared secret checked by /api/cv-recruiter on every request. Pick your own
# passphrase — it is never sent anywhere except this endpoint.
CV_TOOL_PASSPHRASE=

# Used by src/pages/api/cv-recruiter-insight.ts to persist JD-insight entries
# to a PRIVATE Vercel Blob store (see insights-store.ts — never the public
# digital-cv repo, never the function's own ephemeral filesystem). Create/
# connect a Blob store with private access to this project on the Vercel
# dashboard (Storage tab) — that step normally injects this variable for you
# automatically; only set it by hand for local dev.
BLOB_READ_WRITE_TOKEN=

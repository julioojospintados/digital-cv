---
import type { Skill, SoftSkill, TransversalSkill } from '@cv-data';

interface Props {
  technicalSkills: Skill[];
  softSkills: SoftSkill[];
  transversalSkills: TransversalSkill[];
}

const { technicalSkills, softSkills, transversalSkills } = Astro.props;

const levelMap: Record<string, number> = {
  Base: 25,
  Intermedio: 50,
  Avanzato: 75,
  Esperto: 100,
};
---

<section id="skills" class="py-24 bg-neutral-900/30">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="reveal text-3xl font-bold mb-16 text-neutral-100">
      <span class="text-indigo-400">/</span> Competenze
    </h2>

    <!-- Technical -->
    {technicalSkills.length > 0 && (
      <div class="reveal mb-14">
        <h3 class="text-sm uppercase tracking-widest text-neutral-500 mb-6">Tecniche</h3>
        <div class="grid sm:grid-cols-2 gap-4">
          {technicalSkills.map((skill, i) => (
            <div class={`reveal delay-${Math.min((i % 5 + 1) * 100, 500)}`}>
              <div class="flex justify-between text-sm mb-1.5">
                <span class="text-neutral-200 font-medium">{skill.name}</span>
                <span class="text-neutral-500">{skill.level}</span>
              </div>
              <div class="h-1.5 bg-neutral-800 rounded-full overflow-hidden">
                <div
                  class="h-full bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full skill-bar"
                  style={`width: 0%; --target-width: ${levelMap[skill.level]}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Soft skills -->
    {softSkills.length > 0 && (
      <div class="reveal mb-14">
        <h3 class="text-sm uppercase tracking-widest text-neutral-500 mb-6">Soft Skills</h3>
        <div class="grid sm:grid-cols-2 gap-3">
          {softSkills.map((skill, i) => (
            <div class={`reveal delay-${Math.min((i % 5 + 1) * 100, 500)} bg-neutral-900/60 border border-neutral-800 rounded-xl p-4 hover:border-purple-500/40 transition-colors duration-300`}>
              <p class="font-medium text-neutral-200 mb-1">{skill.name}</p>
              {skill.description && <p class="text-sm text-neutral-500 leading-relaxed">{skill.description}</p>}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Transversal -->
    {transversalSkills.length > 0 && (
      <div class="reveal">
        <h3 class="text-sm uppercase tracking-widest text-neutral-500 mb-6">Trasversali</h3>
        <div class="flex flex-wrap gap-3">
          {transversalSkills.map((skill, i) => (
            <div class={`reveal delay-${Math.min((i % 5 + 1) * 100, 500)} group relative bg-neutral-900/60 border border-neutral-800 rounded-xl px-4 py-3 hover:border-indigo-500/40 transition-colors duration-300 cursor-default`}>
              <span class="font-medium text-neutral-200">{skill.name}</span>
              {skill.description && (
                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 bg-neutral-800 border border-neutral-700 text-xs text-neutral-300 rounded-lg p-2.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none z-10 leading-relaxed">
                  {skill.description}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  // Animate skill bars when they enter the viewport
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const bar = entry.target as HTMLElement;
          bar.style.width = bar.style.getPropertyValue('--target-width');
          bar.style.transition = 'width 1s cubic-bezier(0.4, 0, 0.2, 1)';
          observer.unobserve(bar);
        }
      });
    },
    { threshold: 0.2 }
  );

  document.querySelectorAll('.skill-bar').forEach((el) => observer.observe(el));
</script>

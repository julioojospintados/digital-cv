---
// ContactFooter.astro — blocco contatti CTA condiviso (home + pagine CV).
//
// Il titolo è "Tocca a te." / "Your move." (scelta di Giulio, 2026-09-01).
// Prima era "Parliamone." / "Let's talk.", e aveva due difetti diversi nelle
// due lingue. In inglese "Let's talk" duplicava la costruzione di "Let's
// connect", il comando di LinkedIn trecento pixel più sotto: la stessa frase
// due volte nello stesso blocco. In italiano "Parliamone." è il riempitivo che
// sta su ogni pagina contatti esistente, e quel "ne" non si riferisce a niente.
// "Tocca a te." è la sola formula che sposta la palla: il CV ha finito di
// parlare, adesso decide chi legge. In inglese "Your move." è un idioma vero e
// non la traduzione di qualcosa, e il pezzo degli scacchi sta già sul piano
// knolling dell'ingresso, quindi la metafora non arriva da fuori.
// Email e LinkedIn sono azioni cliccabili, non testo da copiare: ogni card
// ha label mono, valore reale e verbo d'azione con freccia. LinkedIn apre in
// una nuova scheda (naviga verso un altro sito); mailto resta nella stessa
// scheda perché apre il client di posta, non una pagina.
import { cvData } from "@cv-data";
import { cvDataEn } from "@cv-data-en";

interface Props {
  lang?: "it" | "en";
  emphasis?: boolean;
}
const { lang = "it" } = Astro.props;
const data = lang === "en" ? cvDataEn : cvData;

// `emphasis`: email come azione primaria, LinkedIn come secondaria, piu' il
// pulsante che copia l'indirizzo. Spento di default per ragioni storiche —
// serviva anche /old-version, cancellata il 2026-08-26. Oggi arriva sempre
// acceso da EntryFooter.
const emphasis = Astro.props.emphasis ?? false;

const email = data.social.find((s) => s.platform === "Email");
const linkedin = data.social.find((s) => s.platform === "LinkedIn");

const emailAddress = email?.url.replace("mailto:", "") ?? "";

const t =
  lang === "en"
    ? {
        title: "Your move",
        email: {
          label: "Email",
          action: "Write to me",
          aria: "Write an email to Giulio",
          subject: "Hello Giulio",
          copy: "Copy",
          copied: "Copied",
          copyAria: "Copy the email address",
        },
        linkedin: {
          label: "LinkedIn",
          action: "Let's connect",
          aria: "Open Giulio's LinkedIn profile in a new tab",
        },
      }
    : {
        title: "Tocca a te",
        email: {
          label: "Email",
          action: "Scrivimi",
          aria: "Scrivi una email a Giulio",
          subject: "Ciao Giulio",
          copy: "Copia",
          copied: "Copiato",
          copyAria: "Copia l'indirizzo email",
        },
        linkedin: {
          label: "LinkedIn",
          action: "Connettiamoci",
          aria: "Apri il profilo LinkedIn di Giulio in una nuova scheda",
        },
      };
---

<section class="contact-cta" aria-labelledby="contact-cta-title">
  {
    /* Nessun occhiello, né sopra né sotto. Ce n'era uno, "CONTATTI", e stava
      SOTTO il titolo: un occhiello sotto non introduce più niente, commenta
      quello che il titolo ha appena detto, e lo commentava ripetendolo. Il
      titolo dice già cosa si fa qui, e sotto ci sono un indirizzo email e un
      profilo LinkedIn: non c'è niente da etichettare. */
  }
  <h2 class="contact-cta__title" id="contact-cta-title">
    {t.title}<span class="contact-cta__dot">.</span>
  </h2>

  <div class:list={["contact-cta__grid", { "contact-cta__grid--emphasis": emphasis }]}>
    <!-- _blank anche sul mailto: se il gestore di posta è webmail (Gmail nel
         browser), _self sostituirebbe il CV con la pagina di composizione.
         Con il client nativo la scheda transitoria si chiude da sola. -->
    {
      email &&
        (emphasis ? (
          /* Nella variante enfatica la card NON e' piu' un link solo: dentro
             ci sono due azioni, e un <button> annidato in un <a> non e' HTML
             valido. Il riquadro resta, il clic si sposta sui due comandi. */
          <div class="contact-card contact-card--primary">
            <span class="contact-card__label">{t.email.label}</span>
            <span class="contact-card__value">{emailAddress}</span>
            <span class="contact-card__actions">
              <a
                class="contact-card__cta"
                href={`${email.url}?subject=${encodeURIComponent(t.email.subject)}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t.email.aria}
              >
                {t.email.action}
                <span class="contact-card__arrow" aria-hidden="true" />
              </a>
              {/* Il pulsante nasce `hidden` e lo accende lo script: se il
                  copia-incolla non e' disponibile (contesto non sicuro, API
                  assente) non resta un comando che non fa niente. */}
              <button class="contact-card__copy" type="button" data-copy={emailAddress} hidden>
                <span data-copy-label>{t.email.copy}</span>
                <span class="contact-card__copied" data-copy-done>
                  {t.email.copied}
                </span>
              </button>
            </span>
          </div>
        ) : (
          <a
            class="contact-card"
            href={email.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.email.aria}
          >
            <span class="contact-card__label">{t.email.label}</span>
            <span class="contact-card__value">{email.label ?? emailAddress}</span>
            <span class="contact-card__action">
              {t.email.action}
              <span class="contact-card__arrow" aria-hidden="true" />
            </span>
          </a>
        ))
    }
    {
      linkedin && (
        <a
          class:list={["contact-card", { "contact-card--secondary": emphasis }]}
          href={linkedin.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.linkedin.aria}
        >
          <span class="contact-card__label">{t.linkedin.label}</span>
          <span class="contact-card__value">{linkedin.label ?? linkedin.url}</span>
          <span class="contact-card__action">
            {t.linkedin.action}
            <span class="contact-card__arrow" aria-hidden="true" />
          </span>
        </a>
      )
    }
  </div>
</section>

<style>
  /* Il contenitore orizzontale (max-width + padding laterale) lo dà la
     pagina ospite (.cv-footer / .entry-footer) — qui solo spazio verticale. */
  .contact-cta {
    padding: 2rem 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-cta__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text-primary);
  }

  .contact-cta__dot {
    color: var(--color-accent);
  }

  /* Mobile-first: una colonna, poi due da tablet in su. La variante
     enfatica piu' sotto resta a una colonna anche li'. */
  .contact-cta__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .contact-cta__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.15rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-16, 1rem);
    text-decoration: none;
    transition:
      transform 0.2s cubic-bezier(0.23, 1, 0.32, 1),
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .contact-card:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-card:hover {
      transform: translateY(-3px);
      border-color: color-mix(in srgb, var(--color-accent) 70%, transparent);
      box-shadow: 0 0 1.375rem color-mix(in srgb, var(--color-accent) 22%, transparent);
    }
    .contact-card:hover .contact-card__action {
      color: var(--color-accent);
    }
    .contact-card:hover .contact-card__arrow {
      transform: translateX(0.3rem);
    }
  }

  .contact-card__label {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .contact-card__value {
    font-size: var(--fs-16);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
  }

  .contact-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 600;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  /* Stanghetta, non un glifo. Il progetto la costruisce ovunque con due bordi
     di un quadratino ruotato — .work-chevron in work-page.css,
     .exp-cluster__chevron in cv-page.css — e quel commento lo dice per
     esteso: "mai un glifo Unicode". La freccia che stava qui (→) era
     l'eccezione, e si vedeva: dipende dal font, cambia peso da un sistema
     all'altro e non eredita lo spessore del testo accanto.

     `currentColor` la fa scurire da sé sopra il riempimento del bottone
     primario e schiarire sul link secondario, senza una seconda regola. */
  .contact-card__arrow {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    flex-shrink: 0;
    border: solid currentColor;
    border-width: 0 0.09375rem 0.09375rem 0;
    rotate: -45deg;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card,
    .contact-card__arrow {
      transition-duration: 0.01ms !important;
    }
  }

  /* ═══ Variante enfatica — la home nuova ═══════════════════════════════
     Due card identiche dicono "sono la stessa cosa, decidi tu": chi legge
     deve scegliere senza nessun indizio, e una scelta senza indizi e' un
     attrito, non una liberta'. Qui la mail prende il peso pieno e LinkedIn
     resta disponibile, piu' quieto, sotto.

     **Una colonna sola, anche da desktop.** Prima erano affiancate a
     1.35fr / 1fr, e la larghezza diversa portava la gerarchia senza
     affidarla al colore (1.4.1) — serve a chi il colore non lo distingue.
     Impilandole quel segnale non si perde, cambia portante: lo dice
     l'ORDINE di lettura, che e' piu' forte della misura ed e' l'unico
     identico in ogni condizione, mobile compreso. E due card affiancate
     si leggono come una coppia da confrontare; una sopra l'altra tornano
     a essere una richiesta e la sua alternativa.

     Niente `align-items: stretch`: pareggiava l'altezza di due card
     affiancate, e in colonna non pareggia niente. */
  @media (min-width: 48rem) {
    .contact-cta__grid--emphasis {
      grid-template-columns: 1fr;
    }
  }

  .contact-card--primary {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 2rem color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  /* La secondaria non e' "spenta": resta a contrasto pieno e leggibile. La
     differenza sta nel riempimento e nel bordo, non nell'opacita' — un
     contatto sbiadito sembra un contatto vecchio. */
  .contact-card--secondary {
    background: transparent;
  }

  .contact-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--size-8);
    margin-top: var(--size-4);
  }

  /* Il bottone pieno: accento come RIEMPIMENTO con sopra l'inchiostro scuro.
     Come testo l'accento su questo fondo, in lente creative, farebbe 3,62:1
     — sotto la soglia di 4,5:1. Da riempimento con l'inchiostro sopra sta a
     5,64:1. Stessa ricetta dei bottoni pieni della home. */
  .contact-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0 var(--size-16);
    border-radius: 999rem;
    background: var(--color-accent);
    color: rgba(16, 12, 8, 1);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: filter 0.2s ease;
  }

  /* Copia negli appunti. Non e' una rifinitura: su un desktop senza client
     di posta configurato `mailto:` non apre niente e il clic fallisce in
     silenzio — l'utente resta con l'indirizzo davanti e nessun modo comodo
     di prenderlo. */
  .contact-card__copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--size-12);
    border: 1px solid var(--color-border);
    border-radius: 999rem;
    background: transparent;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .contact-card__copy[hidden] {
    display: none;
  }

  /* "Copiato" sta gia' nel DOM sotto quello che sostituisce, non appare da
     JS: cosi' la larghezza del bottone non salta al clic, e chi legge con
     uno screen reader trova la conferma senza una regione live. */
  .contact-card__copied {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    background: var(--color-surface);
    color: var(--color-text-primary);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .contact-card__copy.is-done .contact-card__copied {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-card__cta:hover {
      filter: brightness(1.08);
    }

    .contact-card__copy:hover {
      border-color: var(--color-accent);
    }

    /* La primaria non si solleva al passaggio: dentro ha due comandi propri,
       e un riquadro che si muove sotto il dito mentre punti un bottone e'
       un bersaglio che scappa. */
    .contact-card--primary:hover {
      transform: none;
      box-shadow: inset 0 0 2rem color-mix(in srgb, var(--color-accent) 8%, transparent);
    }
  }

  .contact-card--primary:active {
    transform: none;
  }
</style>

<script>
  // Copia dell'indirizzo. Il pulsante nasce `hidden` e viene acceso qui: se
  // l'API non c'e' (contesto non sicuro, browser vecchio) resta nascosto,
  // invece di restare visibile e non fare niente al clic.
  const bottoni = document.querySelectorAll<HTMLButtonElement>(".contact-card__copy");
  if (navigator.clipboard && bottoni.length) {
    bottoni.forEach((b) => {
      b.hidden = false;
      let timer: number | undefined;
      b.addEventListener("click", async () => {
        const testo = b.dataset.copy;
        if (!testo) return;
        try {
          await navigator.clipboard.writeText(testo);
        } catch {
          return; // permesso negato: nessuna conferma falsa
        }
        b.classList.add("is-done");
        window.clearTimeout(timer);
        timer = window.setTimeout(() => b.classList.remove("is-done"), 1600);
      });
    });
  }
</script>

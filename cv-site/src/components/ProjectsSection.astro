---
import type { Project } from '@cv-data';

interface Props {
  projects: Project[];
  interests: readonly string[];
}

const { projects, interests } = Astro.props;
---

{(projects.length > 0 || interests.length > 0) && (
  <section id="projects" class="py-24 bg-neutral-900/30">
    <div class="max-w-4xl mx-auto px-6">

      {projects.length > 0 && (
        <>
          <h2 class="reveal text-3xl font-bold mb-16 text-neutral-100">
            <span class="text-indigo-400">/</span> Progetti
          </h2>
          <div class="grid sm:grid-cols-2 gap-5 mb-16">
            {projects.map((project, i) => (
              <div class={`reveal delay-${Math.min((i + 1) * 100, 500)} group bg-neutral-900/60 border border-neutral-800 rounded-2xl p-5 hover:border-indigo-500/40 transition-colors duration-300`}>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h3 class="font-semibold text-neutral-100 group-hover:text-indigo-300 transition-colors">{project.name}</h3>
                  <div class="flex gap-2 shrink-0">
                    {project.repoUrl && (
                      <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="text-neutral-500 hover:text-neutral-300 text-xs" title="Repository">
                        GitHub ↗
                      </a>
                    )}
                    {project.url && (
                      <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-indigo-300 text-xs">
                        Demo ↗
                      </a>
                    )}
                  </div>
                </div>
                <p class="text-sm text-neutral-500 leading-relaxed mb-3">{project.description}</p>
                {project.tags && project.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {project.tags.map(tag => (
                      <span class="text-xs bg-neutral-800 text-neutral-500 px-2 py-0.5 rounded-full border border-neutral-700">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </>
      )}

      {interests.length > 0 && (
        <div class="reveal">
          <h3 class="text-sm uppercase tracking-widest text-neutral-500 mb-6">Interessi</h3>
          <div class="flex flex-wrap gap-3">
            {interests.map((interest, i) => (
              <span class={`reveal delay-${Math.min((i + 1) * 100, 500)} bg-neutral-900/60 border border-neutral-800 text-neutral-400 px-4 py-2 rounded-full text-sm`}>
                {interest}
              </span>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>
)}

---
/**
 * Usato sia per Soft Skills che per Mindset/Methodology.
 * La prop `variant` determina il prefisso CSS delle classi BEM
 * (default 'soft' → .soft-item; 'method' → .method-item).
 * Entrambe le varianti hanno stili identici — una sola implementazione.
 */
interface Props {
  name: string;
  description: string;
  modeTags: string;
  variant?: 'soft' | 'method';
}

const { name, description, modeTags, variant = 'soft' } = Astro.props;
const cls = variant === 'method' ? 'method-item' : 'soft-item';
---

<li class={`${cls} cv-card`} data-tags={modeTags}>
  <span class={`${cls}__name`}>{name}</span>
  <p class={`${cls}__desc`}>{description}</p>
</li>

<style>
  /* ── Soft item ── */
  .soft-item,
  .method-item {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.02);
    transition:
      opacity var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard);
  }

  .soft-item[data-state='active'],
  .method-item[data-state='active'] {
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  .soft-item__name,
  .method-item__name {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.3rem;
  }

  .soft-item__desc,
  .method-item__desc {
    font-size: 0.7rem;
    line-height: 1.6;
    color: rgba(192, 220, 215, 0.85);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .soft-item[data-state='active'] .soft-item__desc,
  .method-item[data-state='active'] .method-item__desc {
    -webkit-line-clamp: 8;
  }
</style>

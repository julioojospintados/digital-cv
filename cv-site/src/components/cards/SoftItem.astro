---
/**
 * Usato sia per Soft Skills che per Mindset/Methodology.
 * La prop `variant` determina il prefisso CSS delle classi BEM
 * (default 'soft' → .soft-item; 'method' → .method-item).
 * Entrambe le varianti hanno stili identici — una sola implementazione.
 */
interface Props {
  name: string;
  description: string;
  modeTags: string;
  variant?: "soft" | "method";
}

const { name, description, modeTags, variant = "soft" } = Astro.props;
const cls = variant === "method" ? "method-item" : "soft-item";
---

<li class={`${cls} cv-card`} data-tags={modeTags} title={description}>
  <span class={`${cls}__name`}>{name}</span>
</li>

<style>
  /* ── Soft item — chip knolling: solo il title, niente descrizione a schermo.
     description resta nel markup via title="" (tooltip nativo), non sparisce
     dai dati, sparisce solo dalla vista — sussurro, non silenzio. */
  .soft-item,
  .method-item {
    --card-opacity-passive: 0.55;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    transition:
      opacity var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard);
  }

  /* Attive in testa: .soft-list/.method-list sono flex-wrap, order riordina
     solo visivamente — le attive (order 0 default) salgono, le passive scendono.
     Il recruiter vede subito le skill pertinenti al mode corrente. */
  .soft-item[data-state="passive"],
  .method-item[data-state="passive"] {
    order: 1;
  }

  .soft-item[data-state="active"],
  .method-item[data-state="active"] {
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  .soft-item__name,
  .method-item__name {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-primary);
    white-space: nowrap;
  }
</style>

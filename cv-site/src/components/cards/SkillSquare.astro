---
interface Props {
  name: string;
  shortName?: string;
  level: string;
  borderPx: number;
  isGlow: boolean;
  modeTags: string;
  weight?: number; // 1–5 from cv.ts — drives grid span & font size
}

const { name, shortName, level, borderPx, isGlow, weight = 1, modeTags } = Astro.props;

const levelAbbr = level.substring(0, 3).toUpperCase();
// sizeClass guida anche il grid-column/row — regole in cv-page.css (.skill-sq--w*),
// non più inline: così il mobile può ridurre lo span senza !important.
const sizeClass =
  weight >= 5
    ? "skill-sq--w5"
    : weight >= 4
      ? "skill-sq--w4"
      : weight >= 3
        ? "skill-sq--w3"
        : "skill-sq--w1";

const classes = ["skill-sq", "cv-card", sizeClass, isGlow ? "skill-sq--glow" : ""]
  .filter(Boolean)
  .join(" ");
---

<div
  class={classes}
  data-tags={modeTags}
  data-weight={weight}
  data-border={borderPx}
  data-name={name}
  style={`--skill-border: ${borderPx}px;`}
  title={`${name} — ${level}`}
  role="listitem"
  aria-label={`${name} — ${level}`}
>
  {
    shortName ? (
      <>
        <span class="skill-sq__name skill-sq__name--full" aria-hidden="true">
          {name}
        </span>
        <span class="skill-sq__name skill-sq__name--short" aria-hidden="true">
          {shortName}
        </span>
      </>
    ) : (
      <span class="skill-sq__name" aria-hidden="true">
        {name}
      </span>
    )
  }
  <span class="skill-sq__level" aria-hidden="true">{levelAbbr}</span>
</div>

<style>
  .skill-sq {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    width: 100%;
    height: 100%;
    border: var(--skill-border, 1px) solid var(--color-accent);
    border-radius: var(--radius-4);
    padding: 0.25rem;
    cursor: default;
    container-type: inline-size;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      transform var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard),
      box-shadow var(--duration-state) var(--ease-standard);
    text-align: center;
  }

  /* Mobile: bordo uniforme 1px — la variazione 1/2/3/4px per livello
     (Base→Esperto) ha senso solo con lo spazio del desktop; su schermi
     stretti, con le celle già più piccole, i bordi spessi affollavano
     la griglia più del testo stesso. */
  @media (max-width: 39.9375rem) {
    .skill-sq {
      border-width: 1px;
    }
    .skill-sq__name {
      font-weight: 400 !important;
    }
  }

  /* Etichetta breve (shortName) — solo per i nomi troppo lunghi per una
     cella stretta a 1 colonna su mobile (es. "Social media management").
     Desktop: nome esteso sempre. Il testo pieno resta comunque in
     title/aria-label sul contenitore, per screen reader e hover. */
  .skill-sq__name--short {
    display: none;
  }

  @media (max-width: 39.9375rem) {
    .skill-sq__name--full {
      display: none;
    }
    .skill-sq__name--short {
      display: inline;
    }
  }

  .skill-sq--glow {
    box-shadow:
      0 0 8px rgba(0, 0, 0, 0),
      0 0 0px var(--color-accent);
  }

  .skill-sq--glow:hover,
  .skill-sq--glow[data-state="active"] {
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .skill-sq__name {
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--color-text-primary);
    /* Font scala con la larghezza reale della card. Pavimento a 12px
       (var(--fs-12)): sotto quella soglia il nome skill (testo vero, non
       decorativo) diventava illeggibile nelle celle weight=1 più strette —
       violazione del minimo assoluto (design-system/SKILL.md). */
    font-size: clamp(var(--fs-12), 9cqi, var(--fs-14));
  }

  .skill-sq__level {
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgba(192, 220, 215, 0.85);
    /* Abbreviazione di 3 lettere (EXP/AVA/BAS…), maiuscola: qualifica per
       l'eccezione dei 10px (badge cortissimo, non prosa). */
    font-size: clamp(var(--fs-10), 6.5cqi, var(--fs-12));
  }
</style>

---
interface Props {
  name: string;
  level: string;
  borderPx: number;
  isGlow: boolean;
  modeTags: string;
  weight?: number; // 1–5 from cv.ts — drives grid span & font size
}

const { name, level, borderPx, isGlow, weight = 1, modeTags } = Astro.props;

// Grid span based on weight
const spanCol = weight >= 5 ? 3 : weight >= 4 ? 2 : 1;
const spanRow = weight >= 5 ? 2 : weight >= 4 ? 2 : 1;

const levelAbbr = level.substring(0, 3).toUpperCase();
const sizeClass = weight >= 5 ? 'skill-sq--w5'
                : weight >= 4 ? 'skill-sq--w4'
                : weight >= 3 ? 'skill-sq--w3'
                : 'skill-sq--w1';

const classes = [
  'skill-sq',
  'cv-card',
  sizeClass,
  isGlow ? 'skill-sq--glow' : '',
].filter(Boolean).join(' ');
---

<div
  class={classes}
  data-tags={modeTags}
  style={`--skill-border: ${borderPx}px; grid-column: span ${spanCol}; grid-row: span ${spanRow};`}
  title={`${name} — ${level}`}
>
  <span class="skill-sq__name">{name}</span>
  <span class="skill-sq__level">{levelAbbr}</span>
</div>

<style>
  .skill-sq {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    width: 100%;
    height: 100%;
    border: var(--skill-border, 1px) solid var(--color-accent);
    border-radius: 2px;
    padding: 0.25rem;
    cursor: default;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      transform var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard),
      box-shadow var(--duration-state) var(--ease-standard);
    text-align: center;
  }

  /* Weight-based font scaling */
  .skill-sq--w5 .skill-sq__name { font-size: 0.82rem; }
  .skill-sq--w5 .skill-sq__level { font-size: 0.6rem; }

  .skill-sq--w4 .skill-sq__name { font-size: 0.66rem; }
  .skill-sq--w4 .skill-sq__level { font-size: 0.52rem; }

  .skill-sq--w3 .skill-sq__name { font-size: 0.56rem; }
  .skill-sq--w3 .skill-sq__level { font-size: 0.46rem; }

  .skill-sq--w1 .skill-sq__name { font-size: 0.5rem; }
  .skill-sq--w1 .skill-sq__level { font-size: 0.42rem; }

  .skill-sq--glow {
    box-shadow: 0 0 8px rgba(0, 0, 0, 0), 0 0 0px var(--color-accent);
  }

  .skill-sq--glow:hover,
  .skill-sq--glow[data-state='active'] {
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .skill-sq__name {
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .skill-sq__level {
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgba(192, 220, 215, 0.85);
  }
</style>

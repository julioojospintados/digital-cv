---
// Stessa card usata nell'indice /work — riusata anche nella home (sezione
// Web & UX Designer) come prova visiva. Markup + classi (work-page.css)
// invariati rispetto all'originale inline in pages/work/index.astro, solo
// estratti in componente per evitare due copie divergenti.
//
// L'unica cosa che è cambiata rispetto a quella versione: l'oggetto knolling
// è scelto per slug e non per mode — con 3 mode e 4 case study uscivano due
// sole immagini su quattro card. Le mappe e il perché stanno in
// lib/work-knolling.ts.
import { workKnollIcon, workKnollRatio } from "../../lib/work-knolling";

interface Props {
  name: string;
  slug: string;
  role?: string;
  workHref?: string;
  ctaLabel?: string;
  /** Pulse periodico (stesso linguaggio delle mode-card della home) invece
   * del solo glow al hover — riservato all'istanza "vetrina" nella home. */
  pulse?: boolean;
}

const {
  name,
  slug,
  role,
  workHref = "/work",
  ctaLabel = "Leggi il case study",
  pulse = false,
} = Astro.props;
const iconFile = workKnollIcon(slug);
// Modificatore per oggetto (…__icon--flashlight): serve perché non tutti
// stanno bene nella stessa posa. La regola comune vale per default, il
// modificatore corregge solo chi ne ha bisogno.
const iconName = iconFile.replace(".webp", "");
---

<a
  class:list={["work-index-card", { "work-index-card--pulse": pulse }]}
  href={`${workHref}/${slug}`}
>
  <img
    class:list={["work-index-card__icon", `work-index-card__icon--${iconName}`]}
    src={`/knolling/${iconFile}`}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    style={`aspect-ratio: ${workKnollRatio(iconFile)};`}
  />
  <p class="work-index-card__eyebrow">Case Study</p>
  <h2 class="work-index-card__name">{name}</h2>
  {role && <p class="work-index-card__role">{role}</p>}
  <span class="work-index-card__cta">
    {ctaLabel}
    <span class="work-chevron" aria-hidden="true"></span>
  </span>
</a>

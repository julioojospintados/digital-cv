---
// Stessa card usata nell'indice /work — riusata anche nella home (sezione
// Web & UX Designer) come prova visiva. Markup + classi (work-page.css)
// invariati rispetto all'originale inline in pages/work/index.astro, solo
// estratti in componente per evitare due copie divergenti.
interface Props {
  name: string;
  slug: string;
  role?: string;
  primaryMode?: string;
  workHref?: string;
  ctaLabel?: string;
  /** Pulse periodico (stesso linguaggio delle mode-card della home) invece
   * del solo glow al hover — riservato all'istanza "vetrina" nella home. */
  pulse?: boolean;
}

const KNOLL_ICON: Record<string, string> = {
  tech: "laptop.webp",
  creative: "camera.webp",
  human: "plant.webp",
};

// Rapporto larghezza/altezza reale dei file — ogni knolling icon ha un
// crop diverso, serve per riservare lo spazio corretto (CLS) prima che
// l'immagine carichi. Stessa mappa in work/[slug].astro, en/work/[slug].astro.
const KNOLL_RATIO: Record<string, string> = {
  "laptop.webp": "524 / 476",
  "camera.webp": "327 / 221",
  "plant.webp": "226 / 250",
  "chess.webp": "177 / 274",
};

const {
  name,
  slug,
  role,
  primaryMode,
  workHref = "/work",
  ctaLabel = "Leggi il case study",
  pulse = false,
} = Astro.props;
const iconFile = KNOLL_ICON[primaryMode ?? "tech"];
---

<a
  class:list={["work-index-card", { "work-index-card--pulse": pulse }]}
  href={`${workHref}/${slug}`}
>
  <img
    class="work-index-card__icon"
    src={`/knolling/${iconFile}`}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    style={`aspect-ratio: ${KNOLL_RATIO[iconFile]};`}
  />
  <p class="work-index-card__eyebrow">Case Study</p>
  <h2 class="work-index-card__name">{name}</h2>
  {role && <p class="work-index-card__role">{role}</p>}
  <span class="work-index-card__cta">
    {ctaLabel}
    <span class="work-chevron" aria-hidden="true"></span>
  </span>
</a>

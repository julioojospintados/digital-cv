---
// La card dell'indice /work. Markup e classi stanno in work-page.css.
//
// Niente immagine. Fino al 2026-09-02 ogni card portava un oggetto knolling
// in alto a destra, al 12% di opacità e tagliato dall'overflow: una filigrana,
// non un'illustrazione. Tolta su richiesta di Giulio.
// Quello che si è perso: era l'unica cosa che distingueva una card dall'altra
// a colpo d'occhio, prima di leggere. Adesso le quattro card si distinguono
// solo per il testo, quindi il nome e il sottotitolo devono fare tutto il
// lavoro — è il motivo per cui il nome sta su una riga sua (splitProjectName,
// lib/project-name.ts) invece che infilato in fondo a una stringa.
// La mappa slug -> oggetto resta in lib/work-knolling.ts: la usa ancora la
// testata del case study.
import { projectInitials, splitProjectName } from "../../lib/project-name";

interface Props {
  name: string;
  slug: string;
  role?: string;
  workHref?: string;
  ctaLabel?: string;
  /** Pulse periodico (stesso linguaggio delle mode-card della home) invece
   * del solo glow al hover — riservato all'istanza "vetrina" nella home. */
  pulse?: boolean;
}

const {
  name,
  slug,
  role,
  workHref = "/work",
  ctaLabel = "Leggi il Case study",
  pulse = false,
} = Astro.props;
// Il nome porta due cose in una stringa sola: vanno su due righe, e la
// prima è il nome e basta. Il perché sta in lib/project-name.ts.
const { nome, descrittore } = splitProjectName(name);
const sigla = projectInitials(name);
---

<a
  class:list={["work-index-card", { "work-index-card--pulse": pulse }]}
  href={`${workHref}/${slug}`}
>
  {
    /* Nessun occhiello. Diceva «CASE STUDY» sopra ogni card dell'indice
      dei case study: ripeteva a chi guardava la cosa che stava già
      guardando, e si prendeva la prima riga, cioè quella che l'occhio
      usa per cercare il nome. Tolto il 2026-09-02. */
  }
  {
    /* La sigla in filigrana, al posto dell oggetto knolling che stava qui
      fino al 2026-09-02. aria-hidden perché è un appiglio per l occhio: due
      lettere lette ad alta voce non sono un informazione, sono rumore.
      Stessa ragione, e stessa tecnica, di .lh-section__initial sulla home. */
  }
  <p class="work-index-card__sigla" aria-hidden="true">{sigla}</p>
  <h2 class="work-index-card__name">{nome}</h2>
  {descrittore && <p class="work-index-card__tagline">{descrittore}</p>}
  {role && <p class="work-index-card__role">{role}</p>}
  <span class="work-index-card__cta">
    {ctaLabel}
    <span class="work-chevron" aria-hidden="true"></span>
  </span>
</a>

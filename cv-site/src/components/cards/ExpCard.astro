---
interface Props {
  company: string;
  role: string;
  startYear: string;
  endYear: string;
  location?: string;
  remote?: boolean;
  description: string;
  highlights?: string[];
  skills?: string[];
  modeTags: string;
  aiAugmented?: boolean;
}

const {
  company,
  role,
  startYear,
  endYear,
  location,
  remote = false,
  description,
  highlights = [],
  skills = [],
  modeTags,
  aiAugmented = false,
} = Astro.props;

const locationText = location?.trim() ?? "";
const normalizedLocation = locationText.toLowerCase();
const italianLocationHints = [
  "italia",
  "italy",
  "torino",
  "chieri",
  "milano",
  "roma",
  "toscana",
  "piemonte",
  "ravenna",
  "crotone",
];
const abroadLabel =
  locationText && !remote && !italianLocationHints.some((hint) => normalizedLocation.includes(hint))
    ? "Estero"
    : null;

// "2026 — 2026" diventa "2026"; senza startYear (card progetto del cluster
// personale, es. poesia senza data singola) l'intervallo non si mostra.
const datesLabel = startYear
  ? startYear === endYear
    ? startYear
    : `${startYear} — ${endYear}`
  : "";
---

<article class="exp-card cv-card" data-tags={modeTags}>
  {
    aiAugmented && (
      <span class="ai-clip" aria-label="AI-augmented workflow">
        <span class="ai-clip__pin" aria-hidden="true" />
        <span class="ai-clip__text" aria-hidden="true">
          ⚡ AI
        </span>
      </span>
    )
  }
  <header class="exp-card__header">
    <div class="exp-card__top">
      <span class="exp-card__company">{company}</span>
      {datesLabel && <span class="exp-card__dates">{datesLabel}</span>}
    </div>
    <h3 class="exp-card__role">{role}</h3>
    {
      location && (
        <p class="exp-card__location">
          <span class="exp-card__location-text">
            {location}
            {remote ? " · Remote" : ""}
          </span>
          {abroadLabel && <span class="exp-card__abroad-chip">{abroadLabel}</span>}
        </p>
      )
    }
  </header>
  <p class="exp-card__desc">{description}</p>
  {
    highlights.length > 0 && (
      <ul class="exp-card__highlights">
        {highlights.slice(0, 3).map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }
  {
    skills.length > 0 && (
      <div class="exp-card__skills">
        {skills.slice(0, 7).map((s) => (
          <span class="skill-chip">{s}</span>
        ))}
      </div>
    )
  }
</article>

<style>
  .exp-card {
    position: relative; /* anchor for .ai-clip absolute badge  */
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-16);
    background: rgba(255, 255, 255, 0.03);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      transform var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard);
  }

  /* ── AI clip badge — straddles the top border like a physical label ── */
  .ai-clip {
    position: absolute;
    top: -1.5rem; /* half above card top border */
    right: 1.1rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    z-index: 4;
    pointer-events: none;
    user-select: none;
  }

  .ai-clip__pin {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.55;
    box-shadow: 0 0 4px var(--color-accent);
  }

  .ai-clip__text {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.55rem;
    /* Fill piatto nel colore del mode, niente glow pulsante (troppo
       "luminescente", poco leggibile). Accent puro fallirebbe comunque
       WCAG con testo ottanio in creative (~3.6:1) e management (~3:1),
       quindi resta schiarito 65/35 con bianco per stare sopra 4.5:1 su
       tutti i 4 mode — non tornare a var(--color-accent) puro senza
       riverificare il contrasto. */
    background: color-mix(in srgb, var(--color-accent) 65%, white 35%);
    border-radius: var(--radius-4);
    color: rgba(8, 73, 67, 1);
    font-size: var(--fs-12);
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .exp-card[data-state="active"] {
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    background: rgba(255, 255, 255, 0.05);
  }

  .exp-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .exp-card__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .exp-card__company {
    font-size: var(--fs-12);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .exp-card__dates {
    font-size: var(--fs-12);
    font-weight: 500;
    color: rgba(192, 220, 215, 0.85);
    font-variant-numeric: tabular-nums;
  }

  .exp-card__role {
    font-size: var(--fs-16);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .exp-card__location {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: var(--fs-12);
    color: rgba(192, 220, 215, 0.85);
    margin: 0;
  }

  .exp-card__location-text {
    min-width: 0;
  }

  .exp-card__abroad-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.45rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 48%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 18%, rgba(8, 73, 67, 0.88));
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow:
      0 0 14px color-mix(in srgb, var(--color-accent) 38%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.24);
  }

  .exp-card__desc {
    font-size: var(--fs-14);
    line-height: 1.65;
    color: rgba(192, 220, 215, 0.85);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .exp-card[data-state="active"] .exp-card__desc {
    -webkit-line-clamp: 10;
  }

  /* Sotto i 48rem .exp-grid è single-column (vedi cv-page.css): il clamp
     non serve più ad allineare le altezze delle card in griglia, quindi
     tronca il testo senza guadagno di layout. Rimosso per leggibilità
     mobile — vedi bug "testo tagliato nelle card in mode da mobile". */
  @media (max-width: 47.9375rem) {
    .exp-card__desc {
      /* display:-webkit-box va resettato del tutto, non solo il clamp:
         quel box model (legacy flexbox verticale) può mantenere l'altezza
         congelata al conteggio righe originario anche con line-clamp
         rimosso, facendo sovrapporre il testo che eccede su .exp-card__highlights
         sotto. display:block torna al normal flow, altezza = contenuto reale. */
      display: block;
      -webkit-line-clamp: unset;
      overflow: visible;
    }
  }

  .exp-card__highlights {
    margin: 0;
    padding: 0 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .exp-card__highlights li {
    font-size: var(--fs-14);
    line-height: 1.5;
    color: rgba(192, 220, 215, 0.85);
  }

  .exp-card__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
  }

  .skill-chip {
    font-size: var(--fs-12);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(192, 220, 215, 0.85);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 1px;
  }
</style>

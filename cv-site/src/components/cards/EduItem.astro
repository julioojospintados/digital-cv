---
/**
 * Riga singola usata sia in Formazione che in Certificazioni.
 * Il separatore border-bottom è gestito via CSS :last-child sul genitore.
 */
interface Props {
  institution: string;
  degree: string;
  dates: string;
}

const { institution, degree, dates } = Astro.props;
---

<li class="edu-item">
  <span class="edu-item__inst">{institution}</span>
  <span class="edu-item__degree">{degree}</span>
  <span class="edu-item__dates">{dates}</span>
</li>

<style>
  .edu-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* Il genitore <ul class="edu-list"> deve avere list-style:none — già in cv.astro */
  :global(.edu-list) .edu-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .edu-item__inst {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .edu-item__degree {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .edu-item__dates {
    font-size: 0.62rem;
    color: rgba(192, 220, 215, 0.85);
    font-variant-numeric: tabular-nums;
  }
</style>

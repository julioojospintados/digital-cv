---
interface Props {
  name: string;
  description: string;
  tags: string[];
  modeTags: string;
  slug?: string;
  workHref?: string;
}

const { name, description, tags, modeTags, slug, workHref = "/work" } = Astro.props;
---

<div class="project-card cv-card" data-tags={modeTags}>
  <h3 class="project-card__name">{name}</h3>
  <p class="project-card__desc">{description}</p>
  {tags.length > 0 && (
    <div class="project-card__tags">
      {tags.map(t => (
        <span class="tag-chip">{t}</span>
      ))}
    </div>
  )}
  {slug && (
    <a class="project-card__case-study" href={`${workHref}/${slug}`}>
      Case study<span class="project-card__case-study-arrow" aria-hidden="true" />
    </a>
  )}
</div>

<style>
  .project-card {
    position: relative;
    overflow: hidden;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-16);
    background: rgba(255, 255, 255, 0.02);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard);
  }

  /* Glow al hover — stesso linguaggio delle mode-card della home
     (index-page.css .mode-card::before): radial-gradient che sfuma in
     opacity, colore legato a --color-accent (già coerente col mode attivo
     della pagina, niente nuova mappa colori da mantenere). */
  .project-card::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      ellipse at 50% 120%,
      color-mix(in srgb, var(--color-accent) 16%, transparent) 0%,
      transparent 70%
    );
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover::before {
      opacity: 1;
    }

    .project-card:hover {
      border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    }
  }

  .project-card__name {
    font-size: var(--fs-14);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .project-card__desc {
    font-size: var(--fs-14);
    line-height: 1.6;
    color: rgba(192, 220, 215, 0.85);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
  }

  .tag-chip {
    font-size: var(--fs-12);
    font-weight: 500;
    letter-spacing: 0.05em;
    color: rgba(192, 220, 215, 0.85);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 1px;
  }

  .project-card__case-study {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    width: fit-content;
    transition: gap 0.2s ease;
  }

  .project-card__case-study:hover,
  .project-card__case-study:focus-visible {
    gap: 0.6rem;
  }

  /* Chevron destro in CSS puro — stessa tecnica di .exp-cluster__chevron
     (bordo ad angolo ruotato), mai un glifo Unicode. */
  .project-card__case-study-arrow {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    flex-shrink: 0;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    rotate: -45deg;
  }
</style>

---
interface Props {
  name: string;
  description: string;
  modeTags: string;
  slug?: string;
  workHref?: string;
}

const { name, description, modeTags, slug, workHref = "/work" } = Astro.props;
---

<div class="project-card cv-card" data-tags={modeTags}>
  <h3 class="project-card__name">
    {slug ? <a href={`${workHref}/${slug}`}>{name}</a> : name}
  </h3>
  <details class="project-card__desc">
    <summary class="project-card__desc-summary" aria-label={`Espandi descrizione: ${name}`}>
      <span class="project-card__desc-text">{description}</span>
      <span class="project-card__desc-chevron" aria-hidden="true"></span>
    </summary>
  </details>
</div>

<style>
  .project-card {
    position: relative;
    overflow: hidden;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-16);
    background: rgba(255, 255, 255, 0.02);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard);
  }

  /* Glow al hover — stesso linguaggio delle mode-card della home
     (index-page.css .mode-card::before): radial-gradient che sfuma in
     opacity, colore legato a --color-accent (già coerente col mode attivo
     della pagina, niente nuova mappa colori da mantenere). */
  .project-card::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      ellipse at 50% 120%,
      color-mix(in srgb, var(--color-accent) 16%, transparent) 0%,
      transparent 70%
    );
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover::before {
      opacity: 1;
    }

    .project-card:hover {
      border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    }
  }

  .project-card__name {
    font-size: var(--fs-14);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .project-card__name a {
    color: inherit;
    text-decoration: none;
  }

  .project-card__name a:hover,
  .project-card__name a:focus-visible {
    text-decoration: underline;
  }

  .project-card__desc {
    flex: 1;
  }

  .project-card__desc-summary {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .project-card__desc-summary::-webkit-details-marker {
    display: none;
  }

  .project-card__desc-text {
    font-size: var(--fs-14);
    line-height: 1.6;
    color: rgba(192, 220, 215, 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__desc[open] .project-card__desc-text {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  /* Chevron in CSS con bordi ruotati (regola DS: mai glifi Unicode) —
     stessa tecnica di .exp-cluster__chevron. */
  .project-card__desc-chevron {
    margin-top: 0.3rem;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--color-text-muted);
    border-bottom: 2px solid var(--color-text-muted);
    rotate: 45deg;
    flex-shrink: 0;
    transition: rotate var(--duration-state) var(--ease-standard);
  }

  .project-card__desc[open] .project-card__desc-chevron {
    rotate: -135deg;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card__desc-summary:hover .project-card__desc-chevron {
      border-color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__desc-chevron {
      transition: none;
    }
  }
</style>

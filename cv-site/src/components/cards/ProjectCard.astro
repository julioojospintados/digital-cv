---
interface Props {
  name: string;
  description: string;
  tags: string[];
  modeTags: string;
}

const { name, description, tags, modeTags } = Astro.props;
---

<div class="project-card cv-card" data-tags={modeTags}>
  <h3 class="project-card__name">{name}</h3>
  <p class="project-card__desc">{description}</p>
  {tags.length > 0 && (
    <div class="project-card__tags">
      {tags.map(t => (
        <span class="tag-chip">{t}</span>
      ))}
    </div>
  )}
</div>

<style>
  .project-card {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.02);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard);
  }

  .project-card__name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .project-card__desc {
    font-size: 0.72rem;
    line-height: 1.6;
    color: rgba(192, 220, 215, 0.85);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
  }

  .tag-chip {
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: rgba(192, 220, 215, 0.85);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 1px;
  }
</style>

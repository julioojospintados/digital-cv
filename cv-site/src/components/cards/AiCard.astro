---
interface Props {
  tool: string;
  title: string;
  desc: string;
  impact: string;
  tags: string;
}

const { tool, title, desc, impact } = Astro.props;
---

<!-- Niente cv-card/data-tags: la sezione AI Workflow è sempre visibile a
     piena opacità, indipendentemente dal mode (vedi mcp-architecture skill).
     Con cv-card[data-tags] applyCardStates() la trattava come le altre card
     e la sbiadiva su qualunque mode privo del tag corrispondente (es. management). -->
<div class="ai-card">
  <span class="ai-clip" aria-label="AI-augmented workflow">
    <span class="ai-clip__pin" aria-hidden="true"></span>
    <span class="ai-clip__text" aria-hidden="true">⚡ AI</span>
  </span>
  <div class="ai-card__header">
    <span class="ai-card__tool">{tool}</span>
    <span class="ai-card__impact">{impact}</span>
  </div>
  <h3 class="ai-card__title">{title}</h3>
  <p class="ai-card__desc">{desc}</p>
</div>

<style>
  .ai-card {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.025);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard);
  }

  .ai-clip {
    position: absolute;
    top: -13px;
    right: 1.1rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    z-index: 4;
    pointer-events: none;
    user-select: none;
  }

  .ai-clip__pin {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.55;
    box-shadow: 0 0 4px var(--color-accent);
  }

  .ai-clip__text {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.55rem;
    /* Outline style: ottanio bg + accent border/text.
       Il filled-accent originale falliva WCAG in management (viola → ottanio ~2.65:1)
       e in creative (arancio → ottanio ~3.2:1). Con ottanio bg l'accent text
       supera sempre 4.5:1 su tutti i 4 mode. */
    background: rgba(8, 73, 67, 0.95);
    border: 1px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    border-radius: 2px;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow:
      0 0 10px color-mix(in srgb, var(--color-accent) 28%, transparent),
      0 2px 8px rgba(0, 0, 0, 0.5);
    animation: ai-clip-breathe 2.6s ease-in-out infinite;
  }

  @keyframes ai-clip-breathe {
    0%,
    100% {
      border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
      box-shadow:
        0 0 10px color-mix(in srgb, var(--color-accent) 28%, transparent),
        0 2px 8px rgba(0, 0, 0, 0.5);
    }
    50% {
      border-color: color-mix(in srgb, var(--color-accent) 85%, transparent);
      box-shadow:
        0 0 18px color-mix(in srgb, var(--color-accent) 45%, transparent),
        0 2px 8px rgba(0, 0, 0, 0.5);
    }
  }

  .ai-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .ai-card__tool {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(192, 220, 215, 0.85);
  }

  .ai-card__impact {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    padding: 0.15rem 0.45rem;
    border-radius: 1px;
    font-variant-numeric: tabular-nums;
  }

  .ai-card__title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.3;
  }

  .ai-card__desc {
    font-size: 0.75rem;
    line-height: 1.6;
    color: rgba(192, 220, 215, 0.85);
    margin: 0;
  }
</style>

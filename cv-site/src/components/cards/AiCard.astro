---
interface Props {
  tool: string;
  title: string;
  desc: string;
  impact: string;
  tags: string;
}

const { tool, title, desc, impact } = Astro.props;
---

<!-- Niente cv-card/data-tags: la sezione AI Workflow è sempre visibile a
     piena opacità, indipendentemente dal mode (vedi mcp-architecture skill).
     Con cv-card[data-tags] applyCardStates() la trattava come le altre card
     e la sbiadiva su qualunque mode privo del tag corrispondente (es. management). -->
<div class="ai-card">
  <span class="ai-clip" aria-label="AI-augmented workflow">
    <span class="ai-clip__pin" aria-hidden="true"></span>
    <span class="ai-clip__text" aria-hidden="true">AI</span>
  </span>
  <div class="ai-card__header">
    <span class="ai-card__tool">{tool}</span>
    <span class="ai-card__impact">{impact}</span>
  </div>
  <h3 class="ai-card__title">{title}</h3>
  <p class="ai-card__desc">{desc}</p>
</div>

<style>
  .ai-card {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-16);
    background: rgba(255, 255, 255, 0.025);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard);
  }

  .ai-clip {
    position: absolute;
    top: -0.8125rem;
    right: 1.1rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    z-index: 4;
    pointer-events: none;
    user-select: none;
  }

  .ai-clip__pin {
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.55;
    box-shadow: 0 0 0.25rem var(--color-accent);
  }

  .ai-clip__text {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.55rem;
    /* Fill piatto nel colore del mode, niente glow pulsante (troppo
       "luminescente", poco leggibile). Accent puro fallirebbe comunque
       WCAG con testo ottanio in creative (~3.6:1) e management (~3:1),
       quindi resta schiarito 65/35 con bianco per stare sopra 4.5:1 su
       tutti i 4 mode — non tornare a var(--color-accent) puro senza
       riverificare il contrasto. */
    background: color-mix(in srgb, var(--color-accent) 65%, white 35%);
    border-radius: var(--radius-4);
    color: rgba(8, 73, 67, 1);
    font-size: var(--fs-12);
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 2px 0.5rem rgba(0, 0, 0, 0.5);
  }

  .ai-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .ai-card__tool {
    font-size: var(--fs-12);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .ai-card__impact {
    font-size: var(--fs-12);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    padding: 0.15rem 0.45rem;
    border-radius: 1px;
    font-variant-numeric: tabular-nums;
  }

  .ai-card__title {
    font-size: var(--fs-14);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.3;
  }

  .ai-card__desc {
    font-size: var(--fs-12);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>

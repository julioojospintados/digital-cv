---
// ConsentBanner.astro — banner minimale per il consenso a PostHog
// (statistiche di navigazione). Vercel Analytics/Speed Insights restano
// fuori dal gate: sono cookieless per dichiarazione del vendor, non
// impostano identificatori persistenti — vedi /privacy per il dettaglio.
// La scelta persiste in localStorage ("cv-consent": "granted" | "denied"):
// se assente il banner appare, altrimenti resta nascosto (nessun flash).
// Il gate reale sugli script (PostHog non parte finché non è "granted")
// vive in Layout.astro, non qui — questo componente legge/scrive la stessa
// chiave ma non è la fonte di verità sull'avvio del tracker.
// Microsoft Clarity è stato rimosso il 2026-07-30 (sostituito dalla
// notifica di engagement PostHog, vedi engagement-tracking.ts).
interface Props {
  lang?: "it" | "en";
  /** true sulle home (index/en/index): il banner non si mostra da solo al
   * load, aspetta l'evento "cv:wip-badge-shown" — sparato dalla timeline
   * GSAP del preloader nello stesso istante in cui compare la card
   * "ultime modifiche" (wip-badge, index-init.ts step 10), cioè per ultima
   * dopo nome/card/knolling. Richiesta 2026-07-28: il banner deve comparire
   * con lo stesso tempismo di quella card, non subito al parse. */
  waitForWipBadge?: boolean;
}
const { lang = "it", waitForWipBadge = false } = Astro.props;

const copy = {
  it: {
    label: "Consenso cookie",
    text: 'Uso PostHog per capire come navighi il sito (pagine viste, eventi). Niente pubblicità, niente vendita dati.<br /><strong class="consent-banner__emphasis">Solo un aiuto per migliorare.</strong>',
    more: "Scopri di più",
    morePath: "/privacy",
    reject: "Rifiuta",
    accept: "Accetta",
  },
  en: {
    label: "Cookie consent",
    text: 'I use PostHog to understand how you browse the site (page views, events). No ads, no data selling.<br /><strong class="consent-banner__emphasis">Just here to help me improve.</strong>',
    more: "Learn more",
    morePath: "/en/privacy",
    reject: "Reject",
    accept: "Accept",
  },
} as const;

const t = copy[lang];
---

<div
  id="consent-banner"
  class="consent-banner"
  role="region"
  aria-label={t.label}
  data-wait-for-wip={waitForWipBadge ? "true" : "false"}
  hidden
>
  <div class="consent-banner__inner">
    <img
      src="/knolling/plant.webp"
      alt=""
      class="consent-banner__icon"
      loading="lazy"
      style="aspect-ratio: 226 / 250;"
    />
    <p class="consent-banner__text">
      <span set:html={t.text} />
      <a href={t.morePath} class="consent-banner__link">{t.more}</a>
    </p>
    <div class="consent-banner__actions">
      <button
        type="button"
        class="consent-banner__btn consent-banner__btn--reject"
        id="consent-reject"
      >
        {t.reject}
      </button>
      <button
        type="button"
        class="consent-banner__btn consent-banner__btn--accept"
        id="consent-accept"
      >
        {t.accept}
      </button>
    </div>
  </div>
</div>

<style>
  .consent-banner {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 99998;
    width: 100%;
    display: flex;
    justify-content: center;
    background: var(--color-surface);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(100%);
    transition:
      opacity var(--duration-state) var(--ease-standard),
      transform var(--duration-state) var(--ease-standard);
    pointer-events: none;
  }

  .consent-banner[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Grid, non flex: su mobile "icona" e "azioni" devono stare sulla stessa
     riga in basso pur essendo due elementi non adiacenti nel markup (il
     testo sta in mezzo nel DOM) — un flex a wrap non può farli condividere
     una riga indipendente dal testo, una griglia con aree nominate sì:
     basta ridefinire `grid-template-areas` nel breakpoint sotto. */
  .consent-banner__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "icon text actions";
    align-items: center;
    gap: 0.75rem 1.5rem;
    width: 100%;
    max-width: 90rem;
    padding: 0.85rem 1.5rem;
  }

  /* Plant: "crescita, cura, impatto" nel vocabolario del progetto — lega
     "un aiuto per migliorare" alla stessa pianta che l'oggetto knolling
     della home ha già, ma che qui è coperto dal banner: la si ritrova qui. */
  .consent-banner__icon {
    grid-area: icon;
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
  }

  .consent-banner__text {
    grid-area: text;
    font-size: var(--fs-12);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* :global() necessario — questo <strong> vive dentro set:html={t.text},
     non nel template statico: Astro applica lo scoping (data-astro-cid-*)
     solo agli elementi che scrive lui a compile-time, quindi una regola
     scoped normale non l'avrebbe mai trovato (bug reale: il colore non
     arrivava mai, non era "poco visibile", proprio non applicato).
     Il badge con sfondo/bordo/glow (tentativo precedente) è stato bocciato
     ("terribile con quello sfondo") — tornato a testo semplice. Verde
     deliberatamente non legato a --color-accent: qui serve un segnale
     semantico di rassicurazione ("va tutto bene, nessun rischio"),
     indipendente dal mode attivo — un accent viola/oro/arancio non
     comunicherebbe la stessa cosa. Grassetto (già <strong>) + colore +
     dimensione = tre differenziatori, non solo il colore (WCAG 1.4.1). */
  :global(.consent-banner__emphasis) {
    color: #4ade80;
    font-size: var(--fs-14);
  }

  /* display:flex + min-height: target di tocco WCAG 2.2 SC 2.5.8 (min
     24×24px) — era testo nudo a 18px (solo line-height del font). */
  .consent-banner__link {
    display: flex;
    align-items: center;
    min-height: 1.5rem;
    text-align: left;
    margin-top: 0.35rem;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .consent-banner__actions {
    grid-area: actions;
    display: flex;
    gap: 0.5rem;
  }

  .consent-banner__btn {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-4);
    border: 1px solid var(--color-border);
    background: transparent;
    transition:
      transform 160ms var(--ease-standard),
      border-color var(--duration-micro) var(--ease-standard),
      opacity var(--duration-micro) var(--ease-standard);
  }

  .consent-banner__btn:active {
    transform: scale(0.97);
  }

  .consent-banner__btn--reject {
    color: var(--color-text-muted);
  }

  .consent-banner__btn--accept {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .consent-banner__btn--reject:hover {
      border-color: var(--color-text-muted);
    }
    .consent-banner__btn--accept:hover {
      opacity: 0.85;
    }
  }

  /* Stesso breakpoint di WIP_BADGE_MOBILE_QUERY in index-init.ts — sotto,
     il layout passa da una riga sola a due: testo sopra, pianta+azioni
     sotto (vedi il commento sul grid-template-areas qui sotto). */
  @media (max-width: 40rem) {
    /* Testo sopra su tutta la larghezza; sotto, pianta a sinistra e
       bottoni a destra sulla stessa riga — stesso `align-items: center`
       del container, quindi condividono l'allineamento verticale. */
    .consent-banner__inner {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "text text"
        "icon actions";
      padding: 0.85rem 1rem;
    }

    .consent-banner__actions {
      justify-self: end;
    }
  }
</style>

<script>
  const KEY = "cv-consent";
  const banner = document.getElementById("consent-banner");
  const acceptBtn = document.getElementById("consent-accept");
  const rejectBtn = document.getElementById("consent-reject");
  // Il FAB (floating-menu, z-index 99999) sta sopra il banner (99998) per
  // costruzione — deve restare sopra qualsiasi overlay del sito. A banner
  // visibile però le due cose si sovrappongono in scroll: invece di
  // abbassare lo z-index del FAB (che gli servirebbe altrove), lo si alza
  // dell'altezza del banner via --fab-lift, così restano entrambi visibili
  // senza toccarsi. Richiesta esplicita 2026-07-30.
  const fab = document.querySelector<HTMLElement>("floating-menu");

  function syncFabLift() {
    if (!fab || !banner) return;
    if (banner.getAttribute("data-visible") === "true") {
      fab.style.setProperty("--fab-lift", `${banner.offsetHeight + 12}px`);
    } else {
      fab.style.removeProperty("--fab-lift");
    }
  }

  function getConsent(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function setConsent(value: "granted" | "denied") {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      /* localStorage non disponibile (privato/bloccato) — il banner
         ricomparirà al prossimo load, non è un errore da gestire qui. */
    }
  }

  function hideBanner() {
    if (!banner) return;
    banner.removeAttribute("data-visible");
    syncFabLift();
    setTimeout(() => {
      banner.hidden = true;
    }, 320);
  }

  function showBannerIfUndecided() {
    if (!banner) return;
    if (getConsent() !== "granted" && getConsent() !== "denied") {
      banner.hidden = false;
      requestAnimationFrame(() => {
        banner.setAttribute("data-visible", "true");
        syncFabLift();
      });
    }
  }

  // Il banner può andare a capo su più righe se la finestra si ridimensiona
  // (rotazione mobile, resize desktop) mentre è aperto — ricalcola il lift
  // solo in quel caso, non c'è nulla da fare se è già chiuso.
  window.addEventListener("resize", () => {
    if (banner?.getAttribute("data-visible") === "true") syncFabLift();
  });

  if (banner?.dataset.waitForWip === "true") {
    // Sparato dalla timeline GSAP del preloader (index-init.ts) nello stesso
    // istante in cui compare la card "ultime modifiche" — non appena il
    // parse è pronto come nel caso di default sotto.
    window.addEventListener("cv:wip-badge-shown", showBannerIfUndecided, {
      once: true,
    });
  } else {
    showBannerIfUndecided();
  }

  acceptBtn?.addEventListener("click", () => {
    setConsent("granted");
    // Tipizzato in src/consent.d.ts — definito dallo script is:inline di
    // Layout.astro solo in build di produzione, da cui l'optional call.
    window.__cvInitPostHog?.();
    hideBanner();
  });

  rejectBtn?.addEventListener("click", () => {
    setConsent("denied");
    hideBanner();
  });
</script>

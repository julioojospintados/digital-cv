---
/**
 * Design System del Digital CV — sezione documentale per /work/digital-cv.
 * Tutti i valori sono i token REALI del progetto (global.css + design-system
 * skill): questa pagina li mostra, non li ridefinisce. I colori letterali
 * qui sotto sono dati documentali (la palette è il contenuto), non stile UI.
 *
 * Layout bento a 8 tile (righe 7/5 alternate, knolling: asimmetrico, gap
 * costante, tutto allineato alla griglia). Ogni tile è una sezione
 * richiudibile in stile pannello ispezione (Figma): header sempre visibile
 * con indice/titolo/tagline, corpo con la demo viva e la nota. Di default
 * TUTTI i tile sono chiusi, sia su desktop che su mobile: la sezione resta
 * corta e l'utente apre solo ciò che vuole ispezionare. Stesso meccanismo
 * dell'accordion dei cluster esperienza (cv-init.ts), "chiudi le altre"
 * forzato solo sotto i 900px per non allungare la pagina a colonna singola.
 * Animazioni solo transform/opacity/max-height, hover gated, reduced-motion
 * rispettato.
 */
interface Props {
  lang?: "it" | "en";
}
const { lang = "it" } = Astro.props;
const isEN = lang === "en";

const t = {
  title: "Design System",
  intro: isEN
    ? "I set the rules before the components: a fixed teal stage, one accent per mode, two typefaces, motion only where it carries meaning. Below, the site's real tokens: open a section, every demo is live, touch it."
    : "Ho fissato le regole prima dei componenti: palco ottanio fisso, un accent per mode, due famiglie tipografiche, animazione solo dove porta significato. Sotto, i token reali del sito: apri una sezione, ogni demo è viva, toccala.",
  colors: isEN ? "Color" : "Colore",
  colorsTag: isEN ? "One stage, four lights." : "Un palco, quattro luci.",
  colorsNote: isEN
    ? "The teal background never changes. Mode only changes the accent, like a stage light. Every accent has a muted variant for body text, verified at WCAG AA (≥4.5:1) on teal — press a light to preview it across the whole section."
    : "Lo sfondo ottanio non cambia mai. Il mode cambia solo l'accent, come una luce di scena. Ogni accent ha una variante muted per il testo, verificata WCAG AA (≥4.5:1) su ottanio — premi una luce per vederla applicata a tutta la sezione.",
  lightsHint: isEN ? "Press a light" : "Premi una luce",
  accentColHead: isEN ? "accent" : "accent",
  mutedColHead: isEN ? "muted (text)" : "muted (testo)",
  type: isEN ? "Typography" : "Tipografia",
  typeTag: isEN ? "Spoken and measured." : "Parlato e misurato.",
  typeNote: isEN
    ? "Two families, two jobs. Lexend speaks: titles and body. JetBrains Mono measures: labels, counts, impactScore. Both self-hosted via Fontsource, zero external requests."
    : "Due famiglie, due mestieri. Lexend copre il parlato: titoli e testo. JetBrains Mono copre il misurato: label, conteggi, impactScore. Entrambe self-hosted via Fontsource, zero richieste esterne.",
  fontLexendRole: isEN ? "Display + body" : "Display + testo",
  fontMonoRole: isEN ? "Data + labels" : "Dati + label",
  typeScale: isEN
    ? "hero clamp(2rem, 5vw, 4.5rem) · fixed scale --fs-12 → --fs-48 · 12px floor for readable text"
    : "hero clamp(2rem, 5vw, 4.5rem) · scala fissa --fs-12 → --fs-48 · pavimento 12px per il testo che si legge",
  typeFoot: isEN
    ? "800 weight with font-display: block, preloaded for the hero name — no FOUC during the preloader."
    : "Peso 800 con font-display: block, preloadato per il nome hero — niente FOUC nel preloader.",
  squares: isEN ? "Skill levels" : "Livelli skill",
  squaresTag: isEN ? "Square and glow, never bars." : "Square e glow, mai barre.",
  squaresNote: isEN
    ? "Percentage bars promise a precision that does not exist. Only the border encodes level — 1 to 4px, always visible (fixed to 1px on mobile, no room to spare). The glow is a different signal entirely: off at rest for everyone, it only lights up on hover or when that skill matches the mode you're browsing — and only Advanced/Expert are eligible to glow at all."
    : "Le barre percentuali promettono una precisione che non esiste. Solo il bordo codifica il livello — da 1 a 4px, sempre visibile (fisso a 1px su mobile, lo spazio non basta). Il glow è un segnale del tutto diverso: spento a riposo per tutti, si accende solo su hover o quando quello skill è pertinente al mode che stai guardando — e solo Avanzato/Esperto possono accendersi.",
  sqLevels: isEN
    ? ["Basic", "Intermediate", "Advanced", "Expert"]
    : ["Base", "Intermedio", "Avanzato", "Esperto"],
  sqActiveToggle: isEN ? "Simulate: relevant to mode" : "Simula: pertinente al mode",
  sqHoverHint: isEN ? "or hover a square" : "o passa il mouse su uno square",
  motion: "Motion",
  motionTag: isEN ? "Rules, not moods." : "Regole, non umori.",
  motionDemoHint: isEN
    ? "Hover the track: slow enter (300ms), fast exit (150ms)."
    : "Passa sul binario: entrata lenta (300ms), uscita veloce (150ms).",
  motionRules: isEN
    ? [
        "150ms for micro-interactions, 300ms for state changes. Beyond that, only hero and preloader.",
        "Only transform and opacity animate. Never width, height or margin.",
        "Hover gated behind (hover: hover): no sticky hovers on touch.",
        "prefers-reduced-motion always respected: I remove the motion, not the meaning.",
      ]
    : [
        "150ms per le micro-interazioni, 300ms per i cambi di stato. Oltre, solo hero e preloader.",
        "Si anima solo transform e opacity, mai width, height o margin.",
        "Hover dietro (hover: hover): niente hover appiccicosi su touch.",
        "prefers-reduced-motion sempre rispettato: tolgo il movimento, non il significato.",
      ],
  surfaces: isEN ? "Surfaces and signs" : "Superfici e segni",
  surfacesTag: isEN ? "This card is the sample." : "Questa card è il campione.",
  surfacesRules: isEN
    ? [
        "One SVG icon (caret-right-fill) via CSS mask and currentColor: one file, tinted by context in every mode.",
        "Chevrons are rotated CSS borders, never Unicode glyphs: the stroke would depend on the OS font.",
        "8 knolling objects in WebP, about 15KB each: every mode has its counterparts on the table.",
      ]
    : [
        "Un'icona SVG (caret-right-fill) via CSS mask e currentColor: un file solo, tinto dal contesto in ogni mode.",
        "I chevron sono bordi ruotati in CSS, mai glifi Unicode: il tratto dipenderebbe dal font di sistema.",
        "8 oggetti knolling in WebP, circa 15KB l'uno: ogni mode ha i suoi corrispettivi sul tavolo.",
      ],
  callouts: isEN
    ? {
        border: "1px --color-border",
        radius: "1rem --radius-16",
        surface: "surface rgba(255,255,255,0.02)",
      }
    : {
        border: "bordo 1px --color-border",
        radius: "raggio 1rem --radius-16",
        surface: "superficie rgba(255,255,255,0.02)",
      },
  modes: "Mode system",
  modesTag: isEN ? "Emphasis, never structure." : "Enfasi, mai struttura.",
  modesNote: isEN
    ? "Switching mode never changes template or content: active cards come forward, the others stay at low opacity. Whispers, not silences."
    : "Cambiare mode non cambia mai template né contenuti: le attive avanzano, le altre restano a bassa opacità. Sussurri, non silenzi.",
  modesHint: isEN ? "Pick a mode" : "Scegli un mode",

  radii: isEN ? "Radius and shape" : "Raggi e forme",
  radiiTag: isEN ? "Four curves, one rhythm." : "Quattro curve, un ritmo.",
  radiiNote: isEN
    ? "One radius per role: 1rem for cards and sections, 0.25rem for buttons, 1px for crisp tags, a full pill for mode toggles. Decided once, never by eye."
    : "Un raggio per ruolo: 1rem per card e sezioni, 0.25rem per i bottoni, 1px per i tag netti, pillola piena per i toggle di mode. Deciso una volta, mai a occhio.",

  buttons: isEN ? "Buttons and controls" : "Bottoni e controlli",
  buttonsTag: isEN ? "Hierarchy, not decoration." : "Gerarchia, non decorazione.",
  buttonsNote: isEN
    ? "One primary action per view — accent border and a glow that pulses until you engage. Secondary actions stay quiet, mode toggles fill only when active, tags read like inventory labels. All in JetBrains Mono, uppercase, tracked."
    : "Una sola azione primaria per vista — bordo accent e un glow che pulsa finché non ci interagisci. Le secondarie restano sobrie, i toggle di mode si riempiono solo da attivi, i tag sono etichette d'inventario. Tutto in JetBrains Mono, maiuscolo, spaziato.",
  btnPrimary: isEN ? "primary · CTA" : "primaria · CTA",
  btnSecondary: isEN ? "secondary" : "secondaria",
  btnActionLabel: isEN ? "My things" : "Cose mie",
  btnToggle: isEN ? "mode toggle" : "toggle mode",
  btnChip: isEN ? "skill tag" : "tag skill",
  btnChipAlt: isEN ? "Chess" : "Scacchi",
  btnChipAltCap: isEN ? "about chip" : "chip about",
};

const modes = [
  {
    key: "tech",
    label: "Software Developer",
    accent: "rgba(0, 255, 200, 1)",
    muted: "rgba(0, 255, 200, 0.70)",
    ratio: "4.8:1",
  },
  {
    key: "creative",
    label: "Web & UX Designer",
    accent: "rgba(255, 107, 53, 1)",
    muted: "rgba(255, 195, 155, 0.82)",
    ratio: "4.9:1",
  },
  {
    key: "human",
    label: "AI & Digital Specialist",
    accent: "rgba(240, 200, 127, 1)",
    muted: "rgba(240, 210, 148, 0.75)",
    ratio: "4.6:1",
  },
];

// Niente valore hardcodato: solo --color-bg è davvero invariante, gli altri
// 4 cambiano per [data-mode] sull'<html> che ospita questo componente (vedi
// global.css). Un rgba scritto a mano qui sarebbe sbagliato ogni volta che
// la pagina non gira nel mode "di default" — bug reale trovato il
// 2026-07-23: la tile mostrava i valori :root anche su /work/digital-cv,
// che va sempre in data-mode="tech" (project.primaryMode). Il valore vero
// viene letto dal vivo via getComputedStyle (script sotto).
const baseTokens = [
  {
    name: "--color-bg",
    note: isEN ? "teal — invariant across modes" : "ottanio — invariabile in ogni mode",
  },
  {
    name: "--color-surface",
    note: isEN ? "card surfaces · varies per mode" : "superfici card · cambia per mode",
  },
  {
    name: "--color-border",
    note: isEN ? "1px borders · varies per mode" : "bordi 1px · cambia per mode",
  },
  {
    name: "--color-text-primary",
    note: isEN ? "titles, body · varies per mode" : "titoli, testo · cambia per mode",
  },
  {
    name: "--color-text-muted",
    note: isEN ? "≥4.5:1 AA · varies per mode" : "≥4.5:1 AA · cambia per mode",
  },
];

// Card demo per il tile Mode system: contenuti reali del sito, un mode ciascuna
const demoCards = [
  { mode: "tech", label: "MCP Server" },
  { mode: "creative", label: "Knolling" },
  { mode: "human", label: isEN ? "Theatre" : "Teatro" },
];

// Scala dei raggi: i valori reali usati nel sito (global.css + decisione
// 2026-07-10). css = valore renderizzato nel box demo, token = come si
// chiama nel codice, role = a cosa si applica.
const radii = [
  { css: "1rem", token: "--radius-16", it: "card, sezioni", en: "cards, sections" },
  { css: "0.25rem", token: "--radius-4", it: "bottoni", en: "buttons" },
  { css: "1px", token: "1px", it: "tag netti", en: "crisp tags" },
  { css: "999px", token: "pill", it: "toggle mode", en: "mode toggles" },
];
---

<section class="work-section ds" id="design-system" aria-labelledby="work-ds-title">
  <h2 class="work-section__title" id="work-ds-title">{t.title}</h2>
  <p class="work-section__text ds__intro">{t.intro}</p>

  <div class="ds__bento">
    <!-- 01 · Colore — le luci cambiano davvero l'accent della sezione -->
    <article class="ds__tile ds__tile--w7">
      <button
        type="button"
        class="ds__tile-toggle"
        id="ds-toggle-colors"
        aria-controls="ds-body-colors"
        aria-expanded="false"
      >
        <span class="ds__idx" aria-hidden="true">01</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.colors}</span>
          <span class="ds__tagline">{t.colorsTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-colors">
        <div class="ds__tile-body-inner">
          <p class="ds__note">{t.colorsNote}</p>
          <!-- Ogni riga è già completa da ferma: accent + muted + a chi
               appartiene + ratio WCAG. Il click è un bonus (previsualizza
               l'accent su tutta la sezione), non l'unico modo per capire
               a cosa serve un colore — prima il tile lo richiedeva. -->
          <div class="ds__lights" role="group" aria-label={t.lightsHint}>
            {
              modes.map((m, i) => (
                <button
                  type="button"
                  class="ds__light"
                  style={`--light:${m.accent}; --light-muted:${m.muted}`}
                  data-ds-light={m.accent}
                  aria-pressed={i === 0 ? "true" : "false"}
                  aria-label={`${m.label} — accent ${m.key}`}
                >
                  <span class="ds__light-swatches" aria-hidden="true">
                    <span class="ds__light-dot" aria-hidden="true" />
                    <span class="ds__light-dot ds__light-dot--muted" aria-hidden="true" />
                  </span>
                  <span class="ds__light-text">
                    <span class="ds__light-key">{m.key}</span>
                    <span class="ds__light-label">{m.label}</span>
                  </span>
                  <span class="ds__light-ratio">
                    {m.ratio}
                    <span class="ds__light-ratio-aa"> AA</span>
                  </span>
                </button>
              ))
            }
          </div>
          <p class="ds__hint">{t.lightsHint} ↑ · {t.accentColHead} · {t.mutedColHead}</p>
          <div class="ds__tokens">
            {
              baseTokens.map((tok) => (
                <div class="ds__swatch">
                  <span class="ds__chip" style={`background:var(${tok.name})`} />
                  <span class="ds__tok">{tok.name}</span>
                  <span class="ds__val" data-tok-value={tok.name}>
                    {tok.note}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </article>

    <!-- 02 · Tipografia -->
    <article class="ds__tile ds__tile--w5">
      <button
        type="button"
        class="ds__tile-toggle"
        id="ds-toggle-type"
        aria-controls="ds-body-type"
        aria-expanded="false"
      >
        <span class="ds__idx" aria-hidden="true">02</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.type}</span>
          <span class="ds__tagline">{t.typeTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-type">
        <div class="ds__tile-body-inner">
          <div class="ds__type" aria-hidden="true">
            <!-- Lexend: crossfade 800 → 400 al hover (si anima solo opacity) -->
            <div class="ds__font ds__font--sans">
              <span class="ds__specimen-go">
                <span class="ds__specimen-heavy">GO</span>
                <span class="ds__specimen-light">GO</span>
              </span>
              <span class="ds__font-meta">
                <span class="ds__font-name">Lexend</span>
                <span class="ds__font-role">{t.fontLexendRole}</span>
                <span class="ds__font-weights">400 · 500 · 600 · 700 · <b>800</b></span>
              </span>
            </div>
            <!-- JetBrains Mono: stesso trattamento, crossfade 400 → 700 -->
            <div class="ds__font ds__font--mono">
              <span class="ds__specimen-mono-glyph">
                <span class="ds__specimen-mono-thin">-87%</span>
                <span class="ds__specimen-mono-bold">-87%</span>
              </span>
              <span class="ds__font-meta">
                <span class="ds__font-name">JetBrains&nbsp;Mono</span>
                <span class="ds__font-role">{t.fontMonoRole}</span>
                <span class="ds__font-weights">400 · 500 · 600 · 700</span>
              </span>
            </div>
          </div>
          <p class="ds__note ds__note--tight">{t.typeNote}</p>
          <p class="ds__val ds__scale-line">{t.typeScale}</p>
          <p class="ds__val ds__scale-line">{t.typeFoot}</p>
        </div>
      </div>
    </article>

    <!-- 03 · Livelli skill -->
    <article class="ds__tile ds__tile--w5">
      <button
        type="button"
        class="ds__tile-toggle"
        id="ds-toggle-squares"
        aria-controls="ds-body-squares"
        aria-expanded="false"
      >
        <span class="ds__idx" aria-hidden="true">03</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.squares}</span>
          <span class="ds__tagline">{t.squaresTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-squares">
        <div class="ds__tile-body-inner">
          <!-- data-ds-mode-active toggled da JS: rende visibile lo stesso
               glow che sul sito vero arriva da data-state="active" (mode
               match), separato dall'hover — border invece è sempre visibile,
               a riposo, per tutti: è l'unico segnale che scala col livello. -->
          <div class="ds__squares" id="ds-squares">
            {
              t.sqLevels.map((label, i) => (
                <div class="ds__square-wrap">
                  <span
                    class:list={["ds__square", { "ds__square--glow": i >= 2 }]}
                    style={`border-width:${i + 1}px`}
                  />
                  <span class="ds__val">{label}</span>
                  <span class="ds__val ds__val--dim">{i + 1}px</span>
                </div>
              ))
            }
          </div>
          <button
            type="button"
            class="ds__sim-toggle"
            id="ds-toggle-square-active"
            aria-pressed="false"
          >
            <span class="ds__sim-toggle-dot" aria-hidden="true"></span>
            {t.sqActiveToggle}
          </button>
          <span class="ds__hint ds__hint--inline">{t.sqHoverHint}</span>
          <p class="ds__note ds__note--tight">{t.squaresNote}</p>
        </div>
      </div>
    </article>

    <!-- 04 · Motion — demo viva enter/exit -->
    <article class="ds__tile ds__tile--w7">
      <button
        type="button"
        class="ds__tile-toggle"
        id="ds-toggle-motion"
        aria-controls="ds-body-motion"
        aria-expanded="false"
      >
        <span class="ds__idx" aria-hidden="true">04</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.motion}</span>
          <span class="ds__tagline">{t.motionTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-motion">
        <div class="ds__tile-body-inner">
          <div class="ds__track" aria-hidden="true">
            <span class="ds__runner"></span>
            <span class="ds__track-label ds__track-label--in">enter 300ms</span>
            <span class="ds__track-label ds__track-label--out">exit 150ms</span>
          </div>
          <p class="ds__hint">{t.motionDemoHint}</p>
          <ul class="ds__rules">
            {t.motionRules.map((r) => <li>{r}</li>)}
          </ul>
          <p class="ds__val ds__scale-line">
            --duration-micro 150ms · --duration-state 300ms · --ease-standard cubic-bezier(0.4, 0,
            0.2, 1)
          </p>
        </div>
      </div>
    </article>

    <!-- 05 · Superfici — la card si annota da sola -->
    <article class="ds__tile ds__tile--w5">
      <button
        type="button"
        class="ds__tile-toggle"
        id="ds-toggle-surfaces"
        aria-controls="ds-body-surfaces"
        aria-expanded="false"
      >
        <span class="ds__idx" aria-hidden="true">05</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.surfaces}</span>
          <span class="ds__tagline">{t.surfacesTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-surfaces">
        <div class="ds__tile-body-inner ds__tile-body-inner--annotated">
          <span class="ds__callout ds__callout--tl" aria-hidden="true">{t.callouts.radius}</span>
          <span class="ds__callout ds__callout--r" aria-hidden="true">{t.callouts.border}</span>
          <span class="ds__callout ds__callout--b" aria-hidden="true">{t.callouts.surface}</span>
          <ul class="ds__rules">
            {t.surfacesRules.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </article>

    <!-- 06 · Mode system — sussurri cliccabili -->
    <article class="ds__tile ds__tile--w7">
      <button
        type="button"
        class="ds__tile-toggle"
        id="ds-toggle-modes"
        aria-controls="ds-body-modes"
        aria-expanded="false"
      >
        <span class="ds__idx" aria-hidden="true">06</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.modes}</span>
          <span class="ds__tagline">{t.modesTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-modes">
        <div class="ds__tile-body-inner">
          <p class="ds__note">{t.modesNote}</p>
          <div class="ds__mode-pills" role="group" aria-label={t.modesHint}>
            {
              modes.map((m, i) => (
                <button
                  type="button"
                  class="ds__mode-pill"
                  style={`--pill-accent:${m.accent}`}
                  data-ds-mode={m.key}
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  {m.key}
                </button>
              ))
            }
          </div>
          <div class="ds__demo-cards" data-ds-demo="tech">
            {
              demoCards.map((c) => (
                <div class="ds__demo-card" data-demo-mode={c.mode}>
                  <span class="ds__demo-dot" aria-hidden="true" />
                  <span class="ds__tok">{c.label}</span>
                  <span class="ds__val">{c.mode}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </article>

    <!-- 07 · Raggi & forme — un raggio per ruolo -->
    <article class="ds__tile ds__tile--w5">
      <button
        type="button"
        class="ds__tile-toggle"
        id="ds-toggle-radii"
        aria-controls="ds-body-radii"
        aria-expanded="false"
      >
        <span class="ds__idx" aria-hidden="true">07</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.radii}</span>
          <span class="ds__tagline">{t.radiiTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-radii">
        <div class="ds__tile-body-inner">
          <div class="ds__radii" aria-hidden="true">
            {
              radii.map((r) => (
                <div class="ds__radius-item">
                  <span class="ds__radius-box" style={`border-radius:${r.css}`} />
                  <span class="ds__tok">{r.css}</span>
                  <span class="ds__val">{isEN ? r.en : r.it}</span>
                </div>
              ))
            }
          </div>
          <p class="ds__note ds__note--tight">{t.radiiNote}</p>
        </div>
      </div>
    </article>

    <!-- 08 · Bottoni & controlli — la gerarchia reale delle azioni del CV -->
    <article class="ds__tile ds__tile--w7">
      <button
        type="button"
        class="ds__tile-toggle"
        id="ds-toggle-buttons"
        aria-controls="ds-body-buttons"
        aria-expanded="false"
      >
        <span class="ds__idx" aria-hidden="true">08</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.buttons}</span>
          <span class="ds__tagline">{t.buttonsTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-buttons">
        <div class="ds__tile-body-inner">
          <p class="ds__note">{t.buttonsNote}</p>
          <div class="ds__buttons" aria-hidden="true">
            <span class="ds__btn-demo">
              <span class="ds__btn ds__btn--cta">GO<span class="ds__btn-arrow"></span></span>
              <span class="ds__val ds__val--dim">{t.btnPrimary}</span>
            </span>
            <span class="ds__btn-demo">
              <span class="ds__btn ds__btn--action"
                ><span class="ds__btn-star">✦</span>{t.btnActionLabel}</span
              >
              <span class="ds__val ds__val--dim">{t.btnSecondary}</span>
            </span>
            <span class="ds__btn-demo">
              <span class="ds__btn-toggles">
                <span class="ds__btn ds__btn--toggle ds__btn--toggle-on">tech</span>
                <span class="ds__btn ds__btn--toggle">human</span>
              </span>
              <span class="ds__val ds__val--dim">{t.btnToggle}</span>
            </span>
            <span class="ds__btn-demo">
              <span class="ds__chips-row">
                <span class="ds__chip-sample">MCP</span>
                <span class="ds__chip-sample ds__chip-sample--dashed">{t.btnChipAlt}</span>
              </span>
              <span class="ds__val ds__val--dim">{t.btnChip} · {t.btnChipAltCap}</span>
            </span>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  // Demo vive del design system: nessuna dipendenza, solo class/attribute
  // toggling. Le transizioni le fa il CSS (transform/opacity/max-height).
  const ds = document.getElementById("design-system");
  if (ds) {
    // 01 · Token: valore letto dal vivo, mai hardcodato — questi 5 (tranne
    // --color-bg) ereditano da [data-mode] sull'<html> della pagina che
    // ospita il componente, non sono costanti del componente stesso.
    const rootStyle = getComputedStyle(document.documentElement);
    ds.querySelectorAll<HTMLElement>("[data-tok-value]").forEach((el) => {
      const propName = el.dataset.tokValue;
      const live = propName ? rootStyle.getPropertyValue(propName).trim() : "";
      if (live) el.textContent = `${live} · ${el.textContent}`;
    });

    // 01 · Luci: l'accent scelto guida tutta la sezione via --ds-accent
    const lights = ds.querySelectorAll<HTMLButtonElement>("[data-ds-light]");
    lights.forEach((btn) => {
      btn.addEventListener("click", () => {
        (ds as HTMLElement).style.setProperty("--ds-accent", btn.dataset.dsLight ?? "");
        lights.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      });
    });

    // 03 · Simula "pertinente al mode": stesso trigger di data-state="active"
    // sulle card vere, ma esplicito e utilizzabile anche da touch (l'hover
    // da solo non è raggiungibile su mobile/tablet).
    const squareToggle = ds.querySelector<HTMLButtonElement>("#ds-toggle-square-active");
    const squares = ds.querySelector<HTMLElement>("#ds-squares");
    squareToggle?.addEventListener("click", () => {
      const isOn = squareToggle.getAttribute("aria-pressed") === "true";
      squareToggle.setAttribute("aria-pressed", String(!isOn));
      if (squares) squares.toggleAttribute("data-mode-active", !isOn);
    });

    // 06 · Sussurri: il mode attivo porta avanti le card corrispondenti
    const pills = ds.querySelectorAll<HTMLButtonElement>("[data-ds-mode]");
    const demo = ds.querySelector<HTMLElement>("[data-ds-demo]");
    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        if (demo) demo.dataset.dsDemo = pill.dataset.dsMode;
        pills.forEach((p) => p.setAttribute("aria-pressed", String(p === pill)));
      });
    });

    // Accordion dei tile: stesso meccanismo di .exp-cluster (cv-init.ts).
    // Sotto i 900px (breakpoint del bento) aprirne uno chiude gli altri,
    // così la pagina a colonna singola resta corta. Sopra i 900px più tile
    // possono restare aperti insieme, come i pannelli di Figma.
    const tiles = Array.from(ds.querySelectorAll<HTMLElement>(".ds__tile"));
    tiles.forEach((tile) => {
      const toggle = tile.querySelector<HTMLButtonElement>(".ds__tile-toggle");
      if (!toggle) return;
      toggle.addEventListener("click", () => {
        const isOpen = tile.hasAttribute("data-open");
        const isMobile = window.matchMedia("(max-width: 56.24rem)").matches;

        if (isOpen) {
          tile.removeAttribute("data-open");
          toggle.setAttribute("aria-expanded", "false");
          return;
        }

        if (isMobile) {
          tiles.forEach((other) => {
            if (other === tile) return;
            other.removeAttribute("data-open");
            other
              .querySelector<HTMLButtonElement>(".ds__tile-toggle")
              ?.setAttribute("aria-expanded", "false");
          });
        }

        tile.setAttribute("data-open", "");
        toggle.setAttribute("aria-expanded", "true");
      });
    });
  }
</script>

<style>
  /* L'accent della sezione: parte dal mode della pagina, poi lo comandano
     le luci del tile 01. Tutto ciò che è accent qui sotto usa --ds-accent. */
  .ds {
    --ds-accent: var(--color-accent);
  }

  .ds__intro {
    margin-bottom: 2rem;
    max-width: 44rem;
  }

  /* ── Bento ── */
  .ds__bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 56.25rem) {
    .ds__bento {
      grid-template-columns: repeat(12, 1fr);
      /* Breakout dalla colonna 48rem di .work-main (stesso pattern del
         journey: html ha overflow-x clip). Il bento respira fino a 72rem. */
      --bento-w: min(72rem, 100vw - 3rem);
      width: var(--bento-w);
      margin-left: calc(50% - var(--bento-w) / 2);
      /* I tile aperti/chiusi hanno altezze diverse: ogni riga segue la
         propria altezza, non si stira dietro al vicino più alto. */
      align-items: start;
    }

    .ds__tile--w7 {
      grid-column: span 7;

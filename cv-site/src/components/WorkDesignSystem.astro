    .ds__tile--w5 {
      grid-column: span 5;
    }
  }

  .ds__tile {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-16);
    background: rgba(255, 255, 255, 0.02);
    transition: border-color var(--duration-state) var(--ease-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    .ds__tile:hover {
      border-color: color-mix(in srgb, var(--ds-accent) 45%, transparent);
    }
  }

  .ds__tile[data-open] {
    border-color: color-mix(in srgb, var(--ds-accent) 30%, var(--color-border));
  }

  /* ── Header/toggle: riga sempre visibile, stile pannello ispezione ── */
  .ds__tile-toggle {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    background: none;
    border: none;
    text-align: left;
    /* Cursore nativo nascosto: lo indica il cursore custom (Layout.astro) */
    cursor: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .ds__tile-toggle:hover {
      background: rgba(255, 255, 255, 0.03);
    }
  }

  .ds__idx {
    font-family: var(--font-mono);
    font-size: var(--fs-16);
    font-weight: 800;

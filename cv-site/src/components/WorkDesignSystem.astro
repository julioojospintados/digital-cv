    font-variant-numeric: tabular-nums;
    transition: color var(--duration-state) var(--ease-standard);
  }

  .ds__light-ratio-aa {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  /* Lista token in righe, stile pannello variabili: label mono a sinistra,
     valore a destra, un separatore 1px per riga (Figma, non più chip 2 col). */
  .ds__tokens {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .ds__swatch {

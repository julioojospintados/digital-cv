  }

  /* Muted: stessa luce, versione da testo — si sovrappone di poco alla
     accent piena per leggere le due come "stessa famiglia, due mestieri". */
  .ds__light-dot--muted {
    background: var(--light-muted);
    margin-left: -0.6rem;
  }

  .ds__light[aria-pressed="true"] .ds__light-dot {
    transform: scale(1.15);
    box-shadow: 0 0 1.125rem 2px color-mix(in srgb, var(--light) 55%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {

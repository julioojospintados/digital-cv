  /* ── 04 · Motion demo: enter lento, exit veloce ── */
  .ds__track {
    position: relative;
    height: 3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-16);
    background: rgba(255, 255, 255, 0.02);

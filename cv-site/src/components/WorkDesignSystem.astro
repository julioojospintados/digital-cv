  .ds__runner {
    position: absolute;
    top: 50%;
    left: 0.6rem;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.45rem;
    background: var(--ds-accent);
    /* exit: veloce (150ms) — è la transizione di default */

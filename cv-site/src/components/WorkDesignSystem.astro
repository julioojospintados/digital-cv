    transition: color var(--duration-state) var(--ease-standard);
  }

  .ds__idx::after {
    content: " /";
    font-weight: 400;
    color: rgba(192, 220, 215, 0.35);
  }

  .ds__tile[data-open] .ds__idx {
    color: var(--ds-accent);
  }

  .ds__tile-headtext {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ds__name {
    font-family: var(--font-display);
    font-size: var(--fs-18);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .ds__tagline {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ds-accent);
    transition: color var(--duration-state) var(--ease-standard);
  }

  /* Chevron in CSS puro (bordo ad angolo ruotato): stessa tecnica di
     .exp-cluster__chevron in cv-page.css, mai un glifo Unicode. */
  .ds__chevron {
    width: 0.5rem;
    height: 0.5rem;

---
/**
 * Design System del Digital CV — sezione documentale per /work/digital-cv.
 * Tutti i valori sono i token REALI del progetto (global.css + design-system
 * skill): questa pagina li mostra, non li ridefinisce. I colori letterali
 * qui sotto sono dati documentali (la palette è il contenuto), non stile UI.
 *
 * Layout bento a 6 tile (7/5, knolling: asimmetrico, gap costante, tutto
 * allineato alla griglia). Ogni tile è una sezione richiudibile in stile
 * pannello ispezione (Figma): header sempre visibile con indice/titolo/
 * tagline, corpo con la demo viva e la nota. Di default solo la prima
 * (Colore) è aperta, le altre sono chiuse, sia su desktop che su mobile:
 * stesso meccanismo dell'accordion dei cluster esperienza (cv-init.ts),
 * "chiudi le altre" forzato solo sotto i 900px per non allungare la pagina
 * a colonna singola. Animazioni solo transform/opacity/max-height, hover
 * gated, reduced-motion rispettato.
 */
interface Props {
  lang?: "it" | "en";
}
const { lang = "it" } = Astro.props;
const isEN = lang === "en";

const t = {
  title: "Design System",
  intro: isEN
    ? "I set the rules before the components: a fixed teal stage, one accent per mode, two typefaces, motion only where it carries meaning. Below, the site's real tokens: open a section, every demo is live, touch it."
    : "Ho fissato le regole prima dei componenti: palco ottanio fisso, un accent per mode, due famiglie tipografiche, animazione solo dove porta significato. Sotto, i token reali del sito: apri una sezione, ogni demo è viva, toccala.",
  colors: isEN ? "Color" : "Colore",
  colorsTag: isEN ? "One stage, four lights." : "Un palco, quattro luci.",
  colorsNote: isEN
    ? "The teal background never changes. Mode only changes the accent, like a stage light. Every accent has a muted variant at WCAG AA contrast, ≥4.5:1 on teal."
    : "Lo sfondo ottanio non cambia mai. Il mode cambia solo l'accent, come una luce di scena. Ogni accent ha una variante muted a contrasto WCAG AA, ≥4.5:1 su ottanio.",
  lightsHint: isEN ? "Press a light" : "Premi una luce",
  type: isEN ? "Typography" : "Tipografia",
  typeTag: isEN ? "Spoken and measured." : "Parlato e misurato.",
  typeNote: isEN
    ? "Lexend speaks: titles and body. JetBrains Mono measures: labels, counts, impactScore. Self-hosted via Fontsource, zero external requests."
    : "Lexend copre il parlato: titoli e testo. JetBrains Mono copre il misurato: label, conteggi, impactScore. Self-hosted via Fontsource, zero richieste esterne.",
  typeScale: isEN
    ? "hero clamp(2rem, 5vw, 4.5rem) · fixed scale --fs-12 → --fs-48 · 12px floor for readable text"
    : "hero clamp(2rem, 5vw, 4.5rem) · scala fissa --fs-12 → --fs-48 · pavimento 12px per il testo che si legge",
  squares: isEN ? "Skill levels" : "Livelli skill",
  squaresTag: isEN ? "Square and glow, never bars." : "Square e glow, mai barre.",
  squaresNote: isEN
    ? "Percentage bars promise a precision that does not exist. The border grows from 1 to 4px with the level, the glow marks mastery. Whispers, even here."
    : "Le barre percentuali promettono una precisione che non esiste. Il bordo cresce da 1 a 4px col livello, il glow segna la padronanza. Sussurri anche qui.",
  sqLevels: isEN
    ? ["Basic", "Intermediate", "Advanced", "Expert"]
    : ["Base", "Intermedio", "Avanzato", "Esperto"],
  motion: "Motion",
  motionTag: isEN ? "Rules, not moods." : "Regole, non umori.",
  motionDemoHint: isEN
    ? "Hover the track: slow enter (300ms), fast exit (150ms)."
    : "Passa sul binario: entrata lenta (300ms), uscita veloce (150ms).",
  motionRules: isEN
    ? [
        "150ms for micro-interactions, 300ms for state changes. Beyond that, only hero and preloader.",
        "Only transform and opacity animate. Never width, height or margin.",
        "Hover gated behind (hover: hover): no sticky hovers on touch.",
        "prefers-reduced-motion always respected: I remove the motion, not the meaning.",
      ]
    : [
        "150ms per le micro-interazioni, 300ms per i cambi di stato. Oltre, solo hero e preloader.",
        "Si anima solo transform e opacity, mai width, height o margin.",
        "Hover dietro (hover: hover): niente hover appiccicosi su touch.",
        "prefers-reduced-motion sempre rispettato: tolgo il movimento, non il significato.",
      ],
  surfaces: isEN ? "Surfaces and signs" : "Superfici e segni",
  surfacesTag: isEN ? "This card is the sample." : "Questa card è il campione.",
  surfacesRules: isEN
    ? [
        "One SVG icon (touch-icon) via CSS mask and currentColor: one file, tinted by context in every mode.",
        "Chevrons are rotated CSS borders, never Unicode glyphs: the stroke would depend on the OS font.",
        "8 knolling objects in WebP, about 15KB each: every mode has its counterparts on the table.",
      ]
    : [
        "Un'icona SVG (touch-icon) via CSS mask e currentColor: un file solo, tinto dal contesto in ogni mode.",
        "I chevron sono bordi ruotati in CSS, mai glifi Unicode: il tratto dipenderebbe dal font di sistema.",
        "8 oggetti knolling in WebP, circa 15KB l'uno: ogni mode ha i suoi corrispettivi sul tavolo.",
      ],
  callouts: isEN
    ? { border: "1px --color-border", radius: "1rem --radius-16", surface: "surface rgba(255,255,255,0.02)" }
    : { border: "bordo 1px --color-border", radius: "raggio 1rem --radius-16", surface: "superficie rgba(255,255,255,0.02)" },
  modes: "Mode system",
  modesTag: isEN ? "Emphasis, never structure." : "Enfasi, mai struttura.",
  modesNote: isEN
    ? "Switching mode never changes template or content: active cards come forward, the others stay at low opacity. Whispers, not silences."
    : "Cambiare mode non cambia mai template né contenuti: le attive avanzano, le altre restano a bassa opacità. Sussurri, non silenzi.",
  modesHint: isEN ? "Pick a mode" : "Scegli un mode",
};

const modes = [
  { key: "tech", label: "Software Developer", accent: "rgba(0, 255, 200, 1)", muted: "rgba(0, 255, 200, 0.70)", ratio: "4.8:1" },
  { key: "creative", label: "Web & UX Designer", accent: "rgba(255, 107, 53, 1)", muted: "rgba(255, 195, 155, 0.82)", ratio: "4.9:1" },
  { key: "human", label: "AI & Digital Specialist", accent: "rgba(240, 200, 127, 1)", muted: "rgba(240, 210, 148, 0.75)", ratio: "4.6:1" },
  { key: "management", label: "Project Manager", accent: "rgba(180, 100, 255, 1)", muted: "rgba(200, 170, 255, 0.78)", ratio: "4.6:1" },
];

const baseTokens = [
  { name: "--color-bg", value: "rgba(8, 73, 67, 1)", note: isEN ? "teal — invariant" : "ottanio — invariabile" },
  { name: "--color-surface", value: "rgba(12, 95, 87, 0.5)", note: isEN ? "card surfaces" : "superfici card" },
  { name: "--color-border", value: "rgba(255, 255, 255, 0.12)", note: isEN ? "1px borders" : "bordi 1px" },
  { name: "--color-text-primary", value: "rgba(245, 240, 230, 1)", note: isEN ? "titles, body" : "titoli, testo" },
  { name: "--color-text-muted", value: "rgba(192, 220, 215, 0.85)", note: "~5.7:1 AA" },
];

// Card demo per il tile Mode system: contenuti reali del sito, un mode ciascuna
const demoCards = [
  { mode: "tech", label: "MCP Server" },
  { mode: "creative", label: "Knolling" },
  { mode: "management", label: "Sprint 1–2w" },
  { mode: "human", label: isEN ? "Theatre" : "Teatro" },
];
---

<section class="work-section ds" id="design-system" aria-labelledby="work-ds-title">
  <h2 class="work-section__title" id="work-ds-title">{t.title}</h2>
  <p class="work-section__text ds__intro">{t.intro}</p>

  <div class="ds__bento">
    <!-- 01 · Colore — le luci cambiano davvero l'accent della sezione -->
    <article class="ds__tile ds__tile--w7" data-open>
      <button type="button" class="ds__tile-toggle" id="ds-toggle-colors" aria-controls="ds-body-colors" aria-expanded="true">
        <span class="ds__idx" aria-hidden="true">01</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.colors}</span>
          <span class="ds__tagline">{t.colorsTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-colors">
        <div class="ds__tile-body-inner">
          <p class="ds__note">{t.colorsNote}</p>
          <div class="ds__lights" role="group" aria-label={t.lightsHint}>
            {modes.map((m, i) => (
              <button
                type="button"
                class="ds__light"
                style={`--light:${m.accent}`}
                data-ds-light={m.accent}
                aria-pressed={i === 0 ? "true" : "false"}
                aria-label={`Accent ${m.key}`}
              >
                <span class="ds__light-dot" aria-hidden="true"></span>
                <span class="ds__light-key">{m.key}</span>
              </button>
            ))}
            <span class="ds__hint" aria-hidden="true">{t.lightsHint} ↑</span>
          </div>
          <div class="ds__tokens">
            {baseTokens.map((tok) => (
              <div class="ds__swatch">
                <span class="ds__chip" style={`background:${tok.value}`}></span>
                <span class="ds__tok">{tok.name}</span>
                <span class="ds__val">{tok.value} · {tok.note}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </article>

    <!-- 02 · Tipografia -->
    <article class="ds__tile ds__tile--w5">
      <button type="button" class="ds__tile-toggle" id="ds-toggle-type" aria-controls="ds-body-type" aria-expanded="false">
        <span class="ds__idx" aria-hidden="true">02</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.type}</span>
          <span class="ds__tagline">{t.typeTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-type">
        <div class="ds__tile-body-inner">
          <div class="ds__specimen" aria-hidden="true">
            <span class="ds__specimen-go">
              <span class="ds__specimen-heavy">GO</span>
              <span class="ds__specimen-light">GO</span>
            </span>
            <span class="ds__specimen-weights">Lexend 400 · 500 · 600 · 700 · <b>800</b></span>
            <span class="ds__specimen-mono">JetBrains Mono · -87% · 04 / · impactScore</span>
          </div>
          <p class="ds__note ds__note--tight">{t.typeNote}</p>
          <p class="ds__val ds__scale-line">{t.typeScale}</p>
        </div>
      </div>
    </article>

    <!-- 03 · Livelli skill -->
    <article class="ds__tile ds__tile--w5">
      <button type="button" class="ds__tile-toggle" id="ds-toggle-squares" aria-controls="ds-body-squares" aria-expanded="false">
        <span class="ds__idx" aria-hidden="true">03</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.squares}</span>
          <span class="ds__tagline">{t.squaresTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-squares">
        <div class="ds__tile-body-inner">
          <div class="ds__squares">
            {t.sqLevels.map((label, i) => (
              <div class="ds__square-wrap">
                <span class:list={["ds__square", { "ds__square--glow": i >= 2 }]} style={`border-width:${i + 1}px`}></span>
                <span class="ds__val">{label}</span>
                <span class="ds__val ds__val--dim">{i + 1}px</span>
              </div>
            ))}
          </div>
          <p class="ds__note ds__note--tight">{t.squaresNote}</p>
        </div>
      </div>
    </article>

    <!-- 04 · Motion — demo viva enter/exit -->
    <article class="ds__tile ds__tile--w7">
      <button type="button" class="ds__tile-toggle" id="ds-toggle-motion" aria-controls="ds-body-motion" aria-expanded="false">
        <span class="ds__idx" aria-hidden="true">04</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.motion}</span>
          <span class="ds__tagline">{t.motionTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-motion">
        <div class="ds__tile-body-inner">
          <div class="ds__track" aria-hidden="true">
            <span class="ds__runner"></span>
            <span class="ds__track-label ds__track-label--in">enter 300ms</span>
            <span class="ds__track-label ds__track-label--out">exit 150ms</span>
          </div>
          <p class="ds__hint">{t.motionDemoHint}</p>
          <ul class="ds__rules">
            {t.motionRules.map((r) => <li>{r}</li>)}
          </ul>
          <p class="ds__val ds__scale-line">--duration-micro 150ms · --duration-state 300ms · --ease-standard cubic-bezier(0.4, 0, 0.2, 1)</p>
        </div>
      </div>
    </article>

    <!-- 05 · Superfici — la card si annota da sola -->
    <article class="ds__tile ds__tile--w5">
      <button type="button" class="ds__tile-toggle" id="ds-toggle-surfaces" aria-controls="ds-body-surfaces" aria-expanded="false">
        <span class="ds__idx" aria-hidden="true">05</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.surfaces}</span>
          <span class="ds__tagline">{t.surfacesTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-surfaces">
        <div class="ds__tile-body-inner ds__tile-body-inner--annotated">
          <span class="ds__callout ds__callout--tl" aria-hidden="true">{t.callouts.radius}</span>
          <span class="ds__callout ds__callout--r" aria-hidden="true">{t.callouts.border}</span>
          <span class="ds__callout ds__callout--b" aria-hidden="true">{t.callouts.surface}</span>
          <ul class="ds__rules">
            {t.surfacesRules.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </article>

    <!-- 06 · Mode system — sussurri cliccabili -->
    <article class="ds__tile ds__tile--w7">
      <button type="button" class="ds__tile-toggle" id="ds-toggle-modes" aria-controls="ds-body-modes" aria-expanded="false">
        <span class="ds__idx" aria-hidden="true">06</span>
        <span class="ds__tile-headtext">
          <span class="ds__name">{t.modes}</span>
          <span class="ds__tagline">{t.modesTag}</span>
        </span>
        <span class="ds__chevron" aria-hidden="true"></span>
      </button>
      <div class="ds__tile-body" id="ds-body-modes">
        <div class="ds__tile-body-inner">
          <p class="ds__note">{t.modesNote}</p>
          <div class="ds__mode-pills" role="group" aria-label={t.modesHint}>
            {modes.map((m, i) => (
              <button
                type="button"
                class="ds__mode-pill"
                style={`--pill-accent:${m.accent}`}
                data-ds-mode={m.key}
                aria-pressed={i === 0 ? "true" : "false"}
              >{m.key}</button>
            ))}
          </div>
          <div class="ds__demo-cards" data-ds-demo="tech">
            {demoCards.map((c) => (
              <div class="ds__demo-card" data-demo-mode={c.mode}>
                <span class="ds__demo-dot" aria-hidden="true"></span>
                <span class="ds__tok">{c.label}</span>
                <span class="ds__val">{c.mode}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  // Demo vive del design system: nessuna dipendenza, solo class/attribute
  // toggling. Le transizioni le fa il CSS (transform/opacity/max-height).
  const ds = document.getElementById("design-system");
  if (ds) {
    // 01 · Luci: l'accent scelto guida tutta la sezione via --ds-accent
    const lights = ds.querySelectorAll<HTMLButtonElement>("[data-ds-light]");
    lights.forEach((btn) => {
      btn.addEventListener("click", () => {
        (ds as HTMLElement).style.setProperty("--ds-accent", btn.dataset.dsLight ?? "");
        lights.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      });
    });

    // 06 · Sussurri: il mode attivo porta avanti le card corrispondenti
    const pills = ds.querySelectorAll<HTMLButtonElement>("[data-ds-mode]");
    const demo = ds.querySelector<HTMLElement>("[data-ds-demo]");
    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        if (demo) demo.dataset.dsDemo = pill.dataset.dsMode;
        pills.forEach((p) => p.setAttribute("aria-pressed", String(p === pill)));
      });
    });

    // Accordion dei tile: stesso meccanismo di .exp-cluster (cv-init.ts).
    // Sotto i 900px (breakpoint del bento) aprirne uno chiude gli altri,
    // così la pagina a colonna singola resta corta. Sopra i 900px più tile
    // possono restare aperti insieme, come i pannelli di Figma.
    const tiles = Array.from(ds.querySelectorAll<HTMLElement>(".ds__tile"));
    tiles.forEach((tile) => {
      const toggle = tile.querySelector<HTMLButtonElement>(".ds__tile-toggle");
      if (!toggle) return;
      toggle.addEventListener("click", () => {
        const isOpen = tile.hasAttribute("data-open");
        const isMobile = window.matchMedia("(max-width: 56.24rem)").matches;

        if (isOpen) {
          tile.removeAttribute("data-open");
          toggle.setAttribute("aria-expanded", "false");
          return;
        }

        if (isMobile) {
          tiles.forEach((other) => {
            if (other === tile) return;
            other.removeAttribute("data-open");
            other.querySelector<HTMLButtonElement>(".ds__tile-toggle")?.setAttribute("aria-expanded", "false");
          });
        }

        tile.setAttribute("data-open", "");
        toggle.setAttribute("aria-expanded", "true");
      });
    });
  }
</script>

<style>
  /* L'accent della sezione: parte dal mode della pagina, poi lo comandano
     le luci del tile 01. Tutto ciò che è accent qui sotto usa --ds-accent. */
  .ds {
    --ds-accent: var(--color-accent);
  }

  .ds__intro {
    margin-bottom: 2rem;
    max-width: 44rem;
  }

  /* ── Bento ── */
  .ds__bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 56.25rem) {
    .ds__bento {
      grid-template-columns: repeat(12, 1fr);
      /* Breakout dalla colonna 48rem di .work-main (stesso pattern del
         journey: html ha overflow-x clip). Il bento respira fino a 72rem. */
      --bento-w: min(72rem, 100vw - 3rem);
      width: var(--bento-w);
      margin-left: calc(50% - var(--bento-w) / 2);
      /* I tile aperti/chiusi hanno altezze diverse: ogni riga segue la
         propria altezza, non si stira dietro al vicino più alto. */
      align-items: start;
    }

    .ds__tile--w7 {
      grid-column: span 7;
    }

    .ds__tile--w5 {
      grid-column: span 5;
    }
  }

  .ds__tile {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-16);
    background: rgba(255, 255, 255, 0.02);
    transition:
      border-color var(--duration-state) var(--ease-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    .ds__tile:hover {
      border-color: color-mix(in srgb, var(--ds-accent) 45%, transparent);
    }
  }

  .ds__tile[data-open] {
    border-color: color-mix(in srgb, var(--ds-accent) 30%, var(--color-border));
  }

  /* ── Header/toggle: riga sempre visibile, stile pannello ispezione ── */
  .ds__tile-toggle {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    background: none;
    border: none;
    text-align: left;
    /* Cursore nativo nascosto: lo indica il cursore custom (Layout.astro) */
    cursor: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .ds__tile-toggle:hover {
      background: rgba(255, 255, 255, 0.03);
    }
  }

  .ds__idx {
    font-family: var(--font-mono);
    font-size: var(--fs-16);
    font-weight: 800;
    line-height: 1;
    flex-shrink: 0;
    color: rgba(192, 220, 215, 0.45);
    transition: color var(--duration-state) var(--ease-standard);
  }

  .ds__idx::after {
    content: " /";
    font-weight: 400;
    color: rgba(192, 220, 215, 0.35);
  }

  .ds__tile[data-open] .ds__idx {
    color: var(--ds-accent);
  }

  .ds__tile-headtext {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ds__name {
    font-family: var(--font-display);
    font-size: var(--fs-18);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .ds__tagline {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ds-accent);
    transition: color var(--duration-state) var(--ease-standard);
  }

  /* Chevron in CSS puro (bordo ad angolo ruotato): stessa tecnica di
     .exp-cluster__chevron in cv-page.css, mai un glifo Unicode. */
  .ds__chevron {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border: solid rgba(192, 220, 215, 0.55);
    border-width: 0 1.5px 1.5px 0;
    rotate: 45deg;
    transition:
      rotate 0.4s var(--ease-standard),
      border-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ds__tile-toggle:hover .ds__chevron {
      border-color: var(--color-text-primary);
    }
  }

  .ds__tile[data-open] .ds__chevron {
    rotate: 225deg;
    border-color: var(--ds-accent);
  }

  /* ── Body: collassa in altezza, il padding vive sul figlio interno così
     non lascia un bordo/spazio residuo a tile chiuso (stessa tecnica di
     .exp-cluster__body + .exp-grid). ── */
  .ds__tile-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.55s var(--ease-standard);
  }

  .ds__tile[data-open] .ds__tile-body {
    max-height: 3000px;
  }

  .ds__tile-body-inner {
    border-top: 1px solid var(--color-border);
    padding: 0.9rem 1.15rem 1.25rem;
  }

  .ds__note {
    font-size: var(--fs-16);
    line-height: 1.7;
    color: rgba(192, 220, 215, 0.9);
    max-width: 38rem;
    margin: 0 0 1.2rem;
  }

  .ds__note--tight {
    margin-bottom: 0.6rem;
  }

  .ds__hint {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }


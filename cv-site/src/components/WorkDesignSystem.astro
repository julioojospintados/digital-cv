    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .ds__font-name {
    font-size: var(--fs-16);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .ds__font--sans .ds__font-name {

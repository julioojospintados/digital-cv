<script>
  // ── Selezione del pannello ────────────────────────────────────────────
  // Un componente per volta, come in Storybook. A nascondere è questo
  // script: il markup servito non ha nessun `hidden`, quindi senza
  // JavaScript restano visibili tutti i pannelli in sequenza e le voci
  // dell'indice funzionano come normali ancore. Degrado verboso, non vuoto —
  // la stessa regola scritta in testa a lab-home-scroll.ts.
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-ds-panel]"));
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-ds-nav]"));
  const side = document.getElementById("ds-side") as HTMLDetailsElement | null;
  const wide = window.matchMedia("(min-width: 60rem)");

  if (panels.length && navLinks.length) {
    const show = (id: string, push: boolean) => {
      const target = panels.some((p) => p.dataset.dsPanel === id) ? id : panels[0].dataset.dsPanel!;
      panels.forEach((p) => {
        p.hidden = p.dataset.dsPanel !== target;
      });
      navLinks.forEach((a) => {
        // aria-current e non una classe: lo stato corrente deve arrivare
        // anche a chi il filo d'accento non lo vede.
        if (a.dataset.dsNav === target) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
      if (push && location.hash.slice(1) !== target) {
        history.replaceState(null, "", `#${target}`);
      }
      // Su schermo stretto l'indice è un cassetto: scelto il componente si
      // richiude da solo, altrimenti resterebbe a coprire proprio ciò che si
      // è appena chiesto di vedere.
      if (side && !wide.matches) side.open = false;
    };

    navLinks.forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        show(a.dataset.dsNav!, true);
        // Il pannello cambia sotto una barra fissa: senza questo, scegliendo
        // una voce da metà lista si resta a metà pagina su un pannello che
        // comincia più in alto.
        document.querySelector(".ds-main")?.scrollIntoView({ block: "start", behavior: "smooth" });
      });
    });

    // Indirizzo condivisibile: /design-system#lente-tendina apre direttamente
    // quel componente, e il tasto indietro continua a funzionare.
    window.addEventListener("hashchange", () => show(location.hash.slice(1), false));
    show(location.hash.slice(1), false);

    // Passando la soglia il cassetto torna aperto: su desktop l'indice è una
    // colonna, e lasciarlo chiuso lo renderebbe invisibile senza motivo.
    wide.addEventListener("change", (e) => {
      if (side && e.matches) side.open = true;
    });
  }

  // ── Selettore di mode ──────────────────────────────────────────────────
  // Scrive data-mode sulla radice della vetrina: le custom properties dei tre
  // accenti sono ereditate, quindi ogni demo cambia insieme senza che nessuna
  // sappia del selettore. È lo stesso meccanismo del sito.
  const root = document.querySelector<HTMLElement>("[data-ds-root]");
  const modeButtons = document.querySelectorAll<HTMLButtonElement>("[data-ds-mode]");
  // Le sezioni di /lab/home non leggono --color-accent: prendono --accent da
  // `.lh-section[data-mode="…"]`, perché nella pagina vera ogni sezione porta
  // la propria lente ed è quello a decidere il colore. Scrivere il mode solo
  // sulla radice quindi non le raggiunge.
  const labSections = document.querySelectorAll<HTMLElement>(".ds-stage .lh-section[data-mode]");

  if (root && modeButtons.length) {
    modeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.dsMode;
        if (!mode) return;
        root.dataset.mode = mode;
        labSections.forEach((s) => (s.dataset.mode = mode));
        modeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      });
    });
  }

  // ── Il comando +N delle chip, identico a /lab/<lente> ──────────────────
  document.querySelectorAll<HTMLUListElement>(".lc-chips").forEach((lista) => {
    const piu = lista.querySelector<HTMLButtonElement>(".lc-chip--more");
    const quante = lista.querySelectorAll(".lc-chip--extra").length;
    if (!piu || quante === 0) return;

    const segno = piu.querySelector<HTMLElement>(".lc-more__sign");
    const voce = piu.querySelector<HTMLElement>(".lc-sr");
    const en = document.documentElement.lang === "en";
    lista.classList.add("is-collapsed");
    piu.hidden = false;

    piu.addEventListener("click", () => {
      const aperto = lista.classList.toggle("is-collapsed") === false;
      piu.setAttribute("aria-expanded", String(aperto));
      if (segno) segno.textContent = aperto ? `−${quante}` : `+${quante}`;
      // Anche il nome accessibile cambia con lo stato: senza, chi usa uno
      // screen reader sentiva "mostra le altre 2" su un comando che ormai le
      // stava già mostrando.
      if (voce) {
        voce.textContent = en
          ? aperto
            ? ` — hide the other ${quante} technologies`
            : ` — show the other ${quante} technologies`
          : aperto
            ? ` — nascondi le altre ${quante} tecnologie`
            : ` — mostra le altre ${quante} tecnologie`;
      }
    });
  });
</script>

<div class="ds" data-ds-root data-mode="creative">
  <header class="ds-bar">
    <a class="ds-mark" href={it ? "/" : "/en"}>GO</a>
    <nav class="ds-bar__links" aria-label={it ? "Collegamenti" : "Links"}>
      <a href={it ? "/" : "/en"}>{t.backHome}</a>
      <a href={it ? "/work" : "/en/work"}>/work</a>
      <a href="/lab/home">/lab</a>
      <a href={it ? "/en/design-system" : "/design-system"}>{it ? "EN" : "IT"}</a>
    </nav>
  </header>

  <div class="ds-shell">
    {
      /* L'indice. <details open> e non un <nav> semplice: sotto i 60rem si
        richiude in un comando solo, sopra resta una colonna sempre aperta
        (il CSS nasconde il summary). Le voci sono <a href="#id">, quindi
        senza JavaScript restano ancore che portano al pannello giusto — e
        nessun pannello è nascosto, perché a nascondere è lo script. */
    }
    <details class="ds-side" id="ds-side" open>
      <summary class="ds-side__summary">
        {t.tocTitle}
        <span class="ds-side__chevron" aria-hidden="true">›</span>
      </summary>
      <nav aria-label={t.tocTitle}>
        {
          NAV.map((group) => (
            <div class="ds-side__group">
              <p class="ds-side__title">{group.label}</p>
              <ul class="ds-side__list">
                {group.items.map((item) => (
                  <li>
                    <a class="ds-side__link" href={`#${item.id}`} data-ds-nav={item.id}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </details>

    <main class="ds-main" id="main-content">
      <div class="ds-head">
        <h1 class="ds-head__title">{t.title}</h1>
        <p class="ds-head__lead">{t.lead}</p>
        <div class="ds-head__meta">
          {t.pills.map((p) => <span class="ds-pill">{p}</span>)}
        </div>

        <div class="ds-modes" role="group" aria-label={t.modeLabel}>
          {
            MODES.map((m, i) => (
              <button
                class="ds-mode-btn"
                type="button"
                data-ds-mode={m.key}
                aria-pressed={i === 0 ? "true" : "false"}
                style={`--ds-dot:${m.hex}`}
              >
                <span class="ds-mode-btn__dot" aria-hidden="true" />
                {m.label}
              </button>
            ))
          }
        </div>
        <p class="ds-sub__note">{t.modeHint}</p>
      </div>

      <section class="ds-panel" data-ds-panel="colore" aria-labelledby="colore-t">
        <div class="ds-panel__head">
          <span class="ds-panel__group">{t.secFoundations}</span>
          <h2 class="ds-section__title" id="colore-t">{t.secColour}</h2>
        </div>

        <p class="ds-sub__note">
          {
            it
              ? "Quattro accenti, uno per lente. Cambia solo l'accento: sfondo, struttura e template restano identici."
              : "Four accents, one per lens. Only the accent changes: background, structure and template stay identical."
          }
        </p>

        <div class="ds-stage">
          <ul class="ds-swatches">
            {
              MODES.map((m) => (
                <li class="ds-swatch">
                  <div class="ds-swatch__chip" style={`--ds-swatch:${m.hex}`} />
                  <div class="ds-swatch__body">
                    <span class="ds-swatch__name">{m.label}</span>
                    <span class="ds-swatch__value">{m.hex}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="ds-stage">
          <p class="ds-label">{it ? "Token di base" : "Base tokens"}</p>
          <ul class="ds-swatches">
            {
              BASE_TOKENS.map((tok) => (
                <li class="ds-swatch">
                  <div class="ds-swatch__chip" style={`--ds-swatch:${tok.value}`} />
                  <div class="ds-swatch__body">
                    <span class="ds-swatch__name">{tok.name}</span>
                    <span class="ds-swatch__value">{tok.value}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="ds-callout">
          <p>
            <strong

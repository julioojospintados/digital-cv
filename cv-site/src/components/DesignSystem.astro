            <button class="ds-anatomy__toggle" type="button" data-ds-replay>{t.moPlay}</button>
          </div>
          <ul class="ds-runners" role="list" data-ds-motion>
            {
              [
                { token: "--duration-micro", ms: "150ms" },
                { token: "--duration-state", ms: "300ms" },
                { token: "--duration-page", ms: "360ms" },
                { token: "--duration-page-out", ms: "140ms" },
              ].map((d) => (
                <li class="ds-runner">
                  <span class="ds-runner__label">
                    <code>{d.token}</code> · {d.ms}
                  </span>
                  <span class="ds-runner__track">
                    <span class="ds-runner__dot" style={`--ds-dur:var(${d.token})`} />
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="ds-sub__note">{t.moDurNote}</p>
        </div>

        <div class="ds-stage">
          <p class="ds-sub__title">{t.moEase}</p>
          <ul class="ds-runners" role="list" data-ds-motion>
            <li class="ds-runner">
              <span class="ds-runner__label"><code>--ease-standard</code></span>
              <span class="ds-runner__track">
                <span class="ds-runner__dot" style="--ds-dur:600ms"></span>
              </span>
            </li>
            <li class="ds-runner">
              <span class="ds-runner__label"><code>--ease-flight</code></span>
              <span class="ds-runner__track">
                <span
                  class="ds-runner__dot"
                  style="--ds-dur:600ms;--ds-ease:cubic-bezier(0.32,0.72,0,1)"></span>
              </span>
            </li>
            <li class="ds-runner">
              <span class="ds-runner__label">{t.moLinear}</span>
              <span class="ds-runner__track">
                <span class="ds-runner__dot" style="--ds-dur:600ms;--ds-ease:linear"></span>
              </span>
            </li>
          </ul>
          <p class="ds-sub__note">{t.moEaseNote}</p>
        </div>

        <div class="ds-table-wrap">
          <table class="ds-table">
            <caption class="ds-sr">{t.secMotionTok}</caption>
            <thead>
              <tr>
                <th>{t.colToken}</th>
                <th>{t.colValue}</th>
                <th>{t.colUse}</th>
              </tr>
            </thead>
            <tbody>
              {
                MOTION_TOKENS.map((row) => (
                  <tr>
                    <td>
                      <code>{row.name}</code>
                    </td>
                    <td class="ds-table__num">
                      <code>{row.value}</code>
                    </td>
                    <td>{row.use}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="ds-panel" data-ds-accent data-ds-panel="logo" aria-labelledby="logo-t">
        <div class="ds-panel__head">
          <h2 class="ds-section__title" id="logo-t">{it ? "Il logo" : "The logo"}</h2>
          <span class="ds-panel__group"
            >{t.secFoundations}<span class="ds-origin">go-logo</span></span
          >
        </div>

        <p class="ds-sub__note">
          {
            it
              ? "L'unico componente del sistema che è un web component e non una classe. Reagisce alla lente attiva e, al click, riporta all'ingresso — anche da qui: è il comportamento vero, non l'ho disinnescato per la vetrina."
              : "The system's only component that is a web component rather than a class. It reacts to the active lens and, on click, returns to the entry — from here too: that is the real behaviour, not defused for the showcase."
          }
        </p>
        <div class="ds-stage">
          <div class="lc">
            <go-logo data-ds-snippet></go-logo>
          </div>
        </div>
        <div class="ds-spec">
          <div class="ds-spec__row ds-spec__row--wide">
            <span class="ds-spec__k">{t.specClass}</span>
            <p class="ds-spec__v"><code>go-logo</code></p>
          </div>
          <div class="ds-spec__row">
            <span class="ds-spec__k">{t.specUse}</span>
            <p class="ds-spec__v">
              {
                it
                  ? "Una volta per pagina, in cima. Nella barra del CV e in quella dei case study."
                  : "Once per page, at the top. In the CV bar and in the case-study bar."
              }
            </p>
          </div>
          <div class="ds-spec__row ds-spec__row--dont">
            <span class="ds-spec__k">{t.specDont}</span>
            <p class="ds-spec__v">
              {
                it
                  ? "Non usarlo come decorazione ripetuta: è il comando che riporta all'ingresso, e due comandi identici sulla stessa schermata non si sa più quale premere."
                  : "Do not use it as repeated decoration: it is the control that returns to the entry, and two identical controls on one screen leave you guessing which to press."
              }

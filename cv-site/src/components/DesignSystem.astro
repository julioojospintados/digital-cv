---
/**
 * DesignSystem.astro — la vetrina del linguaggio nuovo.
 *
 * ── Perché un componente e non due pagine ────────────────────────────────
 * AGENTS.md § "IT ↔ EN parity" chiede che le pagine EN differiscano dalle IT
 * **solo per la lingua**: non l'ordine, non lo stato iniziale, non il
 * comportamento. Con due file paralleli quella regola si rispetta a
 * disciplina, e la disciplina è già venuta meno in passato su questo
 * progetto. Qui la struttura è una sola e la lingua è un parametro: la
 * divergenza non è improbabile, è impossibile.
 *
 * ── Cosa c'è dentro ──────────────────────────────────────────────────────
 * Il sistema **nuovo**: /lab/home (`lh-*`), /lab/<lente> (`lc-*`),
 * /lab/hero (`lab-*`) e /work (`work-*`). Il sito storico è fuori per
 * decisione esplicita del 2026-08-16.
 *
 * ── La regola delle demo ─────────────────────────────────────────────────
 * Il CSS non è ricopiato: la pagina importa i fogli veri. Il markup invece
 * sì, perché i componenti di /lab vivono inline nelle loro pagine e non sono
 * ancora estratti. È il debito noto di questa vetrina: il CSS non può
 * divergere, il markup sì. L'unico componente importato davvero è
 * WorkIndexCard, che esiste come componente.
 */
import WorkIndexCard from "./cards/WorkIndexCard.astro";
import "../styles/lab-home.css";
import "../styles/lab-cv.css";
import "../styles/lab-hero.css";
import "../styles/work-page.css";
import "../styles/design-system.css";

interface Props {
  lang?: "it" | "en";
}
const { lang = "it" } = Astro.props;
const it = lang === "it";

/* ── I quattro accenti. Unica fonte per tutte le tabelle colore. ────────── */
const MODES = [
  { key: "creative", label: "Web & UX Designer", hex: "rgba(255,107,53,1)", ratio: "3.62:1" },
  { key: "tech", label: "Software Developer", hex: "rgba(0,255,200,1)", ratio: "7.89:1" },
  { key: "human", label: "AI & Digital Specialist", hex: "rgba(240,200,127,1)", ratio: "6.49:1" },
  { key: "management", label: "Project Manager", hex: "rgba(180,100,255,1)", ratio: "3.04:1" },
] as const;

/* ── Token di base, condivisi da tutto il sistema (global.css). ─────────── */
const BASE_TOKENS = [
  { name: "--color-bg", value: "rgba(8, 73, 67, 1)" },
  { name: "--color-surface", value: "rgba(12, 95, 87, 0.5)" },
  { name: "--color-border", value: "rgba(255, 255, 255, 0.12)" },
  { name: "--color-text-primary", value: "rgba(245, 240, 230, 1)" },
  { name: "--color-text-muted", value: "rgba(192, 220, 215, 0.85)" },
  { name: "--color-accent", value: "rgba(255, 255, 255, 0.9)" },
];

/* ── I tre vocabolari di /lab. La sovrapposizione è il punto della tabella. */
const LAB_TOKENS = [
  { concept: it ? "Inchiostro" : "Ink", lh: "--lh-ink", lc: "--lc-ink", lab: "--lab-ink" },
  {
    concept: it ? "Testo attenuato" : "Muted text",
    lh: "--lh-muted",
    lc: "--lc-muted",
    lab: "--lab-muted",
  },
  { concept: it ? "Linea" : "Line", lh: "--lh-line", lc: "--lc-line", lab: "--lab-line" },
  {
    concept: it ? "Accento" : "Accent",

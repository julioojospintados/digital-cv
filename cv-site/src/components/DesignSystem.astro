    mob: it
      ? "Una colonna: testo (order 1), oggetto (order 2)"
      : "One column: text (order 1), object (order 2)",
  },
  {
    what: it ? "Oggetti dell'ingresso" : "Entry objects",
    desk: it ? "Posizionati in assoluto con --x/--y" : "Absolutely positioned with --x/--y",
    mob: it ? "Griglia 15 colonne × 2 righe, in flusso" : "15-column × 2-row grid, in flow",
  },
  {
    what: it ? "Esperienze" : "Experience entries",
    desk: it ? "Tutti i <details> aperti" : "All <details> open",
    mob: it
      ? "Sotto i 1024px resta aperto solo il primo"
      : "Below 1024px only the first stays open",
  },
  {
    what: it ? "Sezione «Chi sono»" : "«About me» section",
    desk: it ? "Visibile" : "Visible",
    mob: it
      ? "Sospesa (temporanea): 925px in una finestra da 667"
      : "Suspended (temporary): 925px in a 667 window",
  },
];

/* ── Animazioni. Chi le esegue e con quale regola. ──────────────────────── */
const MOTION = [
  {
    name: it ? "Ingresso dell'oggetto" : "Object entrance",
    how: "GSAP · back.out(1.7) · 0.9s",
    rule: it
      ? "Rigiocata a ogni ingresso della sezione (toggleActions restart). Solo sull'oggetto: le parole entrano una volta sola."
      : "Replayed on every section entry (toggleActions restart). Object only: the words enter once.",
  },
  {
    name: it ? "Parallasse" : "Parallax",
    how: "GSAP ScrollTrigger · scrub 0.8",
    rule: it
      ? "Tre distanze diverse (sigla 90, oggetto 40, testo 14). Solo su y, così l'ingresso può usare scale senza contendersela."
      : "Three different depths (initial 90, object 40, text 14). On y only, so the entrance can use scale without fighting for it.",
  },
  {
    name: it ? "Aggancio delle sezioni" : "Section snapping",
    how: it ? "Lenis · 0.8s · ease-out-back" : "Lenis · 0.8s · ease-out-back",
    rule: it
      ? "Una scrollata, una sezione. I pannelli più alti della finestra si leggono liberi e agganciano solo al bordo."
      : "One scroll, one section. Panels taller than the window scroll freely and only snap at the edge.",
  },
  {
    name: it ? "Luce d'ambiente" : "Ambient light",
    how: "IntersectionObserver · @property · 800ms",
    rule: it
      ? "La scheda attiva tinge la stanza. @property serve perché una custom property non registrata non si può interpolare."
      : "The active panel tints the room. @property is required because an unregistered custom property cannot be interpolated.",
  },
  {
    name: it ? "Deriva degli oggetti" : "Object drift",
    how: "CSS · animation-timeline: view()",
    rule: it
      ? "Zero JavaScript, dietro @supports e reduced-motion: dove non c'è si vede una scena ferma e completa."
      : "Zero JavaScript, behind @supports and reduced-motion: where unsupported you get a still, complete scene.",
  },
];

/* ── Contrasti misurati sui pixel resi, non sui valori dichiarati. ──────── */
const A11Y = [
  {
    what: it ? "Testo scuro su CTA piena (creative)" : "Dark text on filled CTA (creative)",
    need: "4.5:1",
    got: "5.65:1",
    ok: true,
  },
  {
    what: it ? "Testo scuro su CTA piena (tech)" : "Dark text on filled CTA (tech)",
    need: "4.5:1",
    got: "12.10:1",
    ok: true,
  },
  {
    what: it ? "Testo scuro su CTA piena (human)" : "Dark text on filled CTA (human)",
    need: "4.5:1",
    got: "10.03:1",
    ok: true,
  },
  {
    what: it ? "Testo chiaro su CTA ghost" : "Light text on ghost CTA",
    need: "4.5:1",
    got: "9.64:1",
    ok: true,
  },
  {
    what: it ? "Bordo del bottone vs pagina" : "Button border vs page",
    need: "3:1",
    got: "3.97:1",
    ok: true,
  },
  {
    what: it ? "Anello di focus vs pagina" : "Focus ring vs page",
    need: "3:1",
    got: "8.36–9.91:1",
    ok: true,
  },
];

const t = it
  ? {
      title: "Design System",
      lead: "Il linguaggio visivo del CV nuovo: token, componenti, stati, comportamento mobile e movimento. Ogni demo qui sotto usa il CSS vero dei componenti, non una copia — se il sistema cambia, cambia anche questa pagina.",
      pills: ["/lab/home", "/lab/<lente>", "/lab/hero", "/work"],
      tocTitle: "Indice",
      modeLabel: "Guarda il sistema in:",
      modeHint:
        "Cambia l'accento di tutte le demo, tranne il prototipo hero: quello ha l'accento fissato su Web & UX Designer nel suo stesso foglio di stile, ed è fedele lasciarlo così.",
      backHome: "Home",
      secFoundations: "Fondamenta",
      secColour: "Colore",
      secType: "Tipografia",
      secShape: "Forma e spazio",
      secMotionTok: "Movimento",
      secHome: "Componenti — ingresso",
      secLens: "Componenti — CV per lente",
      secHero: "Componenti — prototipo hero",
      secWork: "Componenti — case study",
      secStates: "Stati",
      secMobile: "Mobile",
      secMotion: "Animazioni",
      secA11y: "Accessibilità",
      colToken: "Token",
      colValue: "Valore",
      colUse: "Uso",
      colConcept: "Concetto",
      colWhere: "Dove",
      colWhy: "Perché esiste",
      colState: "Stato",
      colRule: "Regola",
      colWhat: "Elemento",
      colDesk: "Desktop",
      colMob: "Mobile",
      colHow: "Come",
      colNeed: "Richiesto",
      colGot: "Misurato",
      restingState: "riposo",
      pressedState: "premuto",
      openState: "aperto",
    }
  : {
      title: "Design System",
      lead: "The visual language of the new CV: tokens, components, states, mobile behaviour and motion. Every demo below uses the components' real CSS, not a copy — if the system changes, this page changes with it.",
      pills: ["/lab/home", "/lab/<lens>", "/lab/hero", "/work"],
      tocTitle: "Contents",
      modeLabel: "View the system in:",
      modeHint:
        "Switches the accent for every demo except the hero prototype: that one pins its accent to Web & UX Designer in its own stylesheet, and leaving it there is the faithful choice.",
      backHome: "Home",
      secFoundations: "Foundations",
      secColour: "Colour",
      secType: "Typography",
      secShape: "Shape and space",
      secMotionTok: "Motion",
      secHome: "Components — entry",
      secLens: "Components — CV per lens",
      secHero: "Components — hero prototype",
      secWork: "Components — case study",
      secStates: "States",
      secMobile: "Mobile",
      secMotion: "Animation",
      secA11y: "Accessibility",
      colToken: "Token",
      colValue: "Value",
      colUse: "Use",
      colConcept: "Concept",
      colWhere: "Where",
      colWhy: "Why it exists",
      colState: "State",
      colRule: "Rule",
      colWhat: "Element",
      colDesk: "Desktop",
      colMob: "Mobile",
      colHow: "How",
      colNeed: "Required",
      colGot: "Measured",
      restingState: "resting",
      pressedState: "pressed",
      openState: "open",
    };

const toc = [
  { id: "fondamenta", label: t.secFoundations },
  { id: "colore", label: t.secColour },
  { id: "tipografia", label: t.secType },
  { id: "forma", label: t.secShape },
  { id: "movimento-token", label: t.secMotionTok },
  { id: "ingresso", label: t.secHome },
  { id: "lente", label: t.secLens },
  { id: "hero", label: t.secHero },
  { id: "case-study", label: t.secWork },
  { id: "stati", label: t.secStates },
  { id: "mobile", label: t.secMobile },
  { id: "animazioni", label: t.secMotion },
  { id: "accessibilita", label: t.secA11y },
];
---

<div class="ds" data-ds-root data-mode="creative">
  <header class="ds-bar">
    <a class="ds-mark" href={it ? "/" : "/en"}>GO</a>
    <nav class="ds-bar__links" aria-label={it ? "Collegamenti" : "Links"}>
      <a href={it ? "/" : "/en"}>{t.backHome}</a>
      <a href={it ? "/work" : "/en/work"}>/work</a>
      <a href="/lab/home">/lab</a>
      <a href={it ? "/en/design-system" : "/design-system"}>{it ? "EN" : "IT"}</a>
    </nav>
  </header>

  <main class="ds-main" id="main-content">
    <div class="ds-head">
      <h1 class="ds-head__title">{t.title}</h1>
      <p class="ds-head__lead">{t.lead}</p>
      <div class="ds-head__meta">
        {t.pills.map((p) => <span class="ds-pill">{p}</span>)}
      </div>

      <div class="ds-modes" role="group" aria-label={t.modeLabel}>
        {
          MODES.map((m, i) => (
            <button
              class="ds-mode-btn"
              type="button"
              data-ds-mode={m.key}
              aria-pressed={i === 0 ? "true" : "false"}
              style={`--ds-dot:${m.hex}`}
            >
              <span class="ds-mode-btn__dot" aria-hidden="true" />
              {m.label}
            </button>
          ))
        }
      </div>
      <p class="ds-sub__note">{t.modeHint}</p>

      <nav class="ds-toc" aria-labelledby="ds-toc-title">
        <p class="ds-toc__title" id="ds-toc-title">{t.tocTitle}</p>
        <ul class="ds-toc__list">
          {
            toc.map((s) => (
              <li>
                <a href={`#${s.id}`}>{s.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/* ══ FONDAMENTA ══════════════════════════════════════════════════════ */}
    <section class="ds-section" aria-labelledby="fondamenta">
      <h2 class="ds-section__title" id="fondamenta">{t.secFoundations}</h2>
      <p class="ds-section__note">
        {
          it
            ? "Lo sfondo ottanio è l'unico valore davvero invariante del sistema: non cambia mai, in nessuna lente e in nessuna pagina. Tutto il resto si muove attorno a quello."
            : "The teal background is the system's only truly invariant value: it never changes, in any lens or page. Everything else moves around it."
        }
      </p>

      <div class="ds-sub">
        <h3 class="ds-sub__title" id="colore">{t.secColour}</h3>
        <p class="ds-sub__note">
          {
            it
              ? "Quattro accenti, uno per lente. Cambia solo l'accento: sfondo, struttura e template restano identici."
              : "Four accents, one per lens. Only the accent changes: background, structure and template stay identical."
          }
        </p>

        <div class="ds-stage">
          <ul class="ds-swatches">
            {
              MODES.map((m) => (
                <li class="ds-swatch">
                  <div class="ds-swatch__chip" style={`--ds-swatch:${m.hex}`} />
                  <div class="ds-swatch__body">
                    <span class="ds-swatch__name">{m.label}</span>
                    <span class="ds-swatch__value">{m.hex}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="ds-stage">
          <p class="ds-label">{it ? "Token di base" : "Base tokens"}</p>
          <ul class="ds-swatches">
            {
              BASE_TOKENS.map((tok) => (
                <li class="ds-swatch">
                  <div class="ds-swatch__chip" style={`--ds-swatch:${tok.value}`} />
                  <div class="ds-swatch__body">
                    <span class="ds-swatch__name">{tok.name}</span>
                    <span class="ds-swatch__value">{tok.value}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="ds-callout">
          <p>
            <strong
              >{it ? "L'accento non porta mai testo." : "The accent never carries text."}</strong
            >{" "}
            {
              it
                ? "Misurato sull'ottanio: ciano 7,89:1 e oro 6,49:1 passano, arancione 3,62:1 e viola 3,04:1 no. Per questo i bottoni del sistema sono pieni con inchiostro scuro sopra, non fantasma con testo colorato: con il testo colorato due lenti su quattro sarebbero fuori norma."
                : "Measured on teal: cyan 7.89:1 and gold 6.49:1 pass, orange 3.62:1 and purple 3.04:1 do not. That is why the system's buttons are filled with dark ink on top, not ghosted with coloured text: with coloured text two lenses out of four would be non-compliant."
            }
          </p>
        </div>

        <div class="ds-sub">
          <p class="ds-label">{it ? "I tre vocabolari di /lab" : "The three /lab vocabularies"}</p>
          <p class="ds-sub__note">
            {
              it
                ? "Lo stesso concetto porta tre nomi diversi, uno per prova. È un debito noto: quando /lab diventa il sito, questi prefissi spariscono e restano i nomi di base."
                : "The same concept carries three different names, one per prototype. It is known debt: when /lab becomes the site, these prefixes disappear and the base names remain."
            }
          </p>
          <div class="ds-table-wrap">
            <table class="ds-table">
              <thead>
                <tr>
                  <th>{t.colConcept}</th>
                  <th>/lab/home</th>
                  <th>/lab/{it ? "lente" : "lens"}</th>
                  <th>/lab/hero</th>
                </tr>
              </thead>
              <tbody>
                {
                  LAB_TOKENS.map((row) => (
                    <tr>
                      <td>{row.concept}</td>
                      <td>
                        <code>{row.lh}</code>
                      </td>
                      <td>
                        <code>{row.lc}</code>
                      </td>
                      <td>
                        <code>{row.lab}</code>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div class="ds-sub">
          <p class="ds-label">
            {it ? "Token che esistono solo qui" : "Tokens that exist only here"}
          </p>
          <p class="ds-sub__note">
            {
              it
                ? "Tre token nati nel sistema nuovo per risolvere altrettanti difetti di contrasto del vecchio."
                : "Three tokens born in the new system to fix as many contrast defects in the old one."
            }
          </p>
          <div class="ds-table-wrap">
            <table class="ds-table">
              <thead>
                <tr>
                  <th>{t.colToken}</th>
                  <th>{t.colWhere}</th>
                  <th>{t.colWhy}</th>
                </tr>
              </thead>
              <tbody>
                {

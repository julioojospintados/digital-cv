            <span class="ds-spec__k">{t.specA11y}</span>
            <p class="ds-spec__v">
              {
                it
                  ? "alt vuoto: l'oggetto è decorativo e non aggiunge nulla al testo accanto."
                  : "Empty alt: the object is decorative and adds nothing to the adjacent text."
              }

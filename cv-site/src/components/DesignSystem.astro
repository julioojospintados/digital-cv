      <section
        class="ds-panel"
        data-ds-panel="transizione-di-pagina"
        aria-labelledby="transizione-di-pagina-t"
      >
        <div class="ds-panel__head">
          <h2 class="ds-section__title" id="transizione-di-pagina-t">
            {it ? "Transizione di pagina" : "Page transition"}
          </h2>
          <span class="ds-panel__group"
            >{it ? "Sistema" : "System"}<span class="ds-origin">view-transition</span></span
          >
        </div>

        <p class="ds-sub__note">
          {
            it
              ? "L'unico movimento del sistema che attraversa due pagine. Dall'ingresso a una lente, la fotocamera della sezione «design» è la stessa che accoglie su /design: dandole lo stesso nome sui due lati, il browser la tratta come UN oggetto che cambia posto invece che come due immagini scorrelate. È l'oggetto a portare la continuità — e deve portarla da solo, perché fra due schermate dello stesso ottanio una dissolvenza non si legge come una dissolvenza: si legge come «il testo se n'è andato»."
              : "The only motion in the system that crosses two pages. From the entry to a lens, the camera in the «design» section is the same one that greets you on /design: give it the same name on both sides and the browser treats it as ONE object changing place, not two unrelated images. The object carries the continuity — and it has to carry it alone, because between two screens of the same ottanio a cross-fade does not read as a cross-fade: it reads as «the text went away»."
          }
        </p>

        <div class="ds-stage">
          <div class="ds-flight">
            <div class="ds-flight__track">
              <span class="ds-flight__from" aria-hidden="true"></span>
              <img
                class="ds-flight__obj"
                src="/knolling/camera.webp"
                alt=""
                aria-hidden="true"
                data-ds-snippet
              />
            </div>
            <button class="ds-mode-btn" type="button" data-ds-flight-replay>
              {it ? "Rigioca il volo" : "Replay the flight"}
            </button>
          </div>
        </div>
        <p class="ds-sub__note">
          {
            it
              ? "La dimostrazione anima posizione e misura per riprodurre i tempi: durata e curva sono quelle vere, lette dagli stessi token. Nella pagina reale a muoversi è il gruppo ::view-transition-group, che costruisce il browser — qui non è riproducibile, perché richiede due documenti."
              : "The demo animates position and size to reproduce the timing: duration and curve are the real ones, read from the same tokens. On the real page what moves is the ::view-transition-group the browser builds itself — not reproducible here, because it takes two documents."
          }
        </p>

        <div class="ds-spec">
          <div class="ds-spec__row ds-spec__row--wide">
            <span class="ds-spec__k">{t.specClass}</span>
            <p class="ds-spec__v">
              <code>view-transition-name: lens-object</code> · <code>portfolio-hero</code>
            </p>
          </div>
          <div class="ds-spec__row">
            <span class="ds-spec__k">{t.specUse}</span>
            <p class="ds-spec__v">
              {
                it
                  ? "Solo quando lo stesso oggetto esiste davvero su tutte e due le pagine. Vale nei due versi: andando, l'oggetto della sezione vola nella testata della lente; tornando col logo GO, rivola al suo posto nel piano knolling dell'ingresso — dove camera, laptop e bussola sono già a schermo, quindi l'atterraggio è un posto vero e non serve spostare lo scorrimento. Sulla pagina di partenza il nome si assegna al clic (lens-transition.ts), mai nel CSS: lo stesso oggetto compare in tre sezioni, e un nome fisso farebbe leggere al browser qualunque navigazione come «stesso oggetto, nuova posizione». Sulla pagina di arrivo invece è statico, e lì è corretto: non c'è nessun clic da intercettare e il primo fotogramma deve già portarlo."
                  : "Only when the same object genuinely exists on both pages. It holds both ways: going, the section's object flies into the lens header; coming back via the GO logo, it flies back to its place in the entry's knolling layout — where camera, laptop and compass are already on screen, so the landing is a real place and no scroll has to move. On the departing page the name is assigned on click (lens-transition.ts), never in CSS: the same object appears in three sections, and a static name would make the browser read any navigation as «same object, new position». On the arriving page it is static, and there it is correct: there is no click to intercept and the first frame must already carry it."
              }
            </p>
          </div>
          <div class="ds-spec__row">
            <span class="ds-spec__k">{t.specMotion}</span>
            <p class="ds-spec__v">
              {
                it
                  ? "--duration-page (360ms) con --ease-flight, la sola curva del sistema diversa da --ease-standard: su 640px di percorso quella standard si legge come uno strappo iniziale. La radice NON viene fotografata (view-transition-name: none), quindi la pagina d'arrivo si disegna dal vivo e dove non c'è un oggetto condiviso la navigazione è un salto. E il volo parte in pausa: riparte quando la pagina d'arrivo consegna quattro fotogrammi di fila in tempo, non dopo un'attesa fissa."
                  : "--duration-page (360ms) with --ease-flight, the system's only curve other than --ease-standard: over 640px of travel the standard one reads as an initial jolt. The root is NOT photographed (view-transition-name: none), so the arriving page paints live and where there is no shared object the navigation is a cut. And the flight starts paused: it resumes when the arriving page delivers four frames in a row on time, not after a fixed wait."
              }
            </p>
          </div>
          <div class="ds-spec__row ds-spec__row--dont">
            <span class="ds-spec__k">{t.specDont}</span>
            <p class="ds-spec__v">
              {
                it
                  ? "Non lasciare un filtro sull'oggetto che parte: drop-shadow fa parte del suo inchiostro, quindi allarga il riquadro fotografato e l'oggetto vola più grande di sé, con un alone che scurisce quello che sorvola. Non mettere il nome nel CSS di una pagina che è anche sorgente di altre navigazioni. E non rimettere una dissolvenza sulla radice: è stata provata sovrapposta (due testi leggibili insieme) e sfalsata (un fotogramma vuoto in mezzo), e scartata due volte."
                  : "Do not leave a filter on the departing object: drop-shadow is part of its ink, so it widens the captured box and the object flies bigger than itself, with a halo that darkens whatever it passes over. Do not put the name in the CSS of a page that is also the source of other navigations. And do not bring back a cross-fade on the root: it was tried overlapping (two readable texts at once) and staggered (an empty frame in between), and rejected twice."
              }
            </p>
          </div>
          <div class="ds-spec__row ds-spec__row--wide">
            <span class="ds-spec__k">{t.specA11y}</span>
            <p class="ds-spec__v">
              {
                it
                  ? "A movimento ridotto il nome non viene assegnato da nessuna delle due parti: nessun oggetto attraversa lo schermo e la pagina cambia e basta. Riduzione, non eliminazione — la navigazione resta identica, solo senza volo. E la transizione non trattiene mai il contenuto: la pagina d'arrivo è completa e leggibile dal primo fotogramma, è solo la decorazione ad arrivare dopo."
                  : "With reduced motion the name is assigned on neither side: no object crosses the screen and the page simply changes. Reduction, not removal — navigation is identical, just without the flight. And the transition never withholds content: the arriving page is complete and readable from the first frame; only the decoration arrives later."
              }
            </p>
          </div>
        </div>

        <div class="ds-callout">
          <p>
            <strong>{it ? "Per guardarla." : "To watch it."}</strong>{" "}
            {
              it
                ? "Su qualunque indirizzo del sito: ?vt=slow rallenta il passaggio dieci volte, ?vt=debug stampa in console il buco più lungo, i fotogrammi persi e le posizioni toccate dall'oggetto, ?vt=slowdebug tutti e due, ?vt=off spegne. Restano accesi per la sessione. Servono perché mezzo secondo non si guarda, si subisce — e di questa transizione si è discusso tre volte a memoria di un'impressione."
                : "On any address on the site: ?vt=slow slows the passage ten times, ?vt=debug prints the worst gap, the dropped frames and the positions the object touched to the console, ?vt=slowdebug both, ?vt=off turns it off. They stay on for the session. They exist because half a second cannot be watched, only endured — and this transition was argued about three times from memory of an impression."
            }
          </p>
        </div>
      </section>

      <section class="ds-panel" data-ds-panel="animazioni" aria-labelledby="animazioni-t">
        <div class="ds-panel__head">
          <h2 class="ds-section__title" id="animazioni-t">{t.secMotion}</h2>
        </div>

        <p class="ds-section__note">
          {
            it
              ? "La regola che tiene insieme tutto il movimento del sistema: sta sulla decorazione, mai sulle parole. Nessun testo parte invisibile e nessuno aspetta un trigger di scroll."
              : "The rule that holds all the system's motion together: it lives on the decoration, never on the words. No text starts invisible and none waits for a scroll trigger."
          }
        </p>
        <div class="ds-table-wrap">
          <table class="ds-table">
            <thead>
              <tr>
                <th>{t.colWhat}</th>
                <th>{t.colHow}</th>
                <th>{t.colRule}</th>
              </tr>
            </thead>
            <tbody>
              {
                MOTION.map((row) => (
                  <tr>
                    <td>{row.name}</td>
                    <td>
                      <code>{row.how}</code>
                    </td>
                    <td>{row.rule}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="ds-callout">
          <p>
            <strong>{it ? "Movimento ridotto." : "Reduced motion."}</strong>{" "}
            {
              it
                ? "Riduzione non vuol dire eliminazione: restano opacità e colore, spariscono le trasformazioni. L'affondo alla pressione resta anche lì, perché non è decorazione — è l'informazione che il comando ha risposto."
                : "Reduction is not removal: opacity and colour remain, transforms go. The tactile press survives even there, because it is not decoration — it is the information that the control responded."
            }
          </p>
        </div>
      </section>

      <section class="ds-panel" data-ds-panel="accessibilita" aria-labelledby="accessibilita-t">
        <div class="ds-panel__head">
          <h2 class="ds-section__title" id="accessibilita-t">{t.secA11y}</h2>
        </div>

        <p class="ds-section__note">
          {
            it
              ? "Riferimento: WCAG 2.2 livello AA. I valori qui sotto sono misurati sui pixel realmente resi, veli di luce inclusi, non sui colori dichiarati."
              : "Reference: WCAG 2.2 level AA. The values below are measured on actually rendered pixels, light veils included, not on declared colours."
          }
        </p>
        <div class="ds-table-wrap">
          <table class="ds-table">
            <thead>
              <tr>
                <th>{t.colWhat}</th>
                <th>{t.colNeed}</th>
                <th>{t.colGot}</th>
              </tr>
            </thead>
            <tbody>
              {
                A11Y.map((row) => (
                  <tr>
                    <td>{row.what}</td>
                    <td class="ds-table__num">{row.need}</td>
                    <td class="ds-table__num">
                      <span class={row.ok ? "ds-ok" : "ds-ko"}>{row.ok ? "✓" : "✗"}</span> {row.got}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        {
          /* Un limite noto, scritto invece che nascosto — come l'anello di
            focus qui sotto. Toglierlo significherebbe far mentire lo
            snippet, che è la garanzia su cui questa pagina è costruita. */
        }
        <div class="ds-callout">
          <p>
            <strong>
              {it ? "Una demo può contenere il proprio h1." : "A demo may contain its own h1."}
            </strong>{" "}
            {
              it
                ? "L'intestazione del CV e le due testate di /work nella pagina vera sono h1, e la demo le riproduce tali e quali perché lo snippet dev'essere vero. Dentro la vetrina finiscono quindi sotto l'h2 del pannello. L'h1 della pagina esiste comunque, sempre, fuori dai pannelli: è per screen reader, perché i pannelli si scambiano con hidden e un titolo che vive dentro uno di loro sparisce appena se ne sceglie un altro."
                : "The CV header and the two /work headers are h1 on the real pages, and the demo reproduces them exactly because the snippet has to be true. Inside the showcase they therefore sit under the panel's h2. The page's own h1 exists regardless, always, outside the panels: it is screen-reader only, because panels are swapped with hidden and a title living inside one disappears the moment another is chosen."
            }
          </p>
        </div>
        <div class="ds-callout">
          <p>
            <strong
              >{
                it
                  ? "L'anello di focus non è un elemento di marca."
                  : "The focus ring is not a brand element."
              }</strong
            >{" "}
            {
              it
                ? "È l'unica cosa che dice a chi naviga da tastiera dove si trova. Colorarlo con l'accento lo rende coerente esteticamente e inutile funzionalmente: sul fondale illuminato l'arancione scende a 2,57:1. Qui è inchiostro, staccato di 4px, e tiene 8,4–9,9:1."
                : "It is the only thing that tells a keyboard user where they are. Colouring it with the accent makes it aesthetically consistent and functionally useless: on the lit backdrop orange drops to 2.57:1. Here it is ink, offset by 4px, and holds 8.4–9.9:1."
            }
          </p>
        </div>
      </section>
    </main>
  </div>
</div>

<script>
  // Il logo è un web component, non una classe: va registrato o la vetrina
  // mostrerebbe un elemento vuoto dove dovrebbe esserci il componente.
  import "../islands/GoLogo.lit";
  import "../islands/FloatingMenu.lit";
  import { initLensDropdownAutoClose } from "../scripts/lens-dropdown";

  // .ds-stage esclude la demo statica del pannello "Tendina di lente":
  // quella resta aperta apposta per mostrare lo stato, e un click altrove
  // sulla pagina non deve richiuderla. Il selettore d'accento nella barra
  // (.ds-lens) non è dentro un .ds-stage: è un comando vero, e va chiuso
  // come quello della pagina reale.
  initLensDropdownAutoClose(".ds-stage");

  // ── Selezione del pannello ────────────────────────────────────────────
  // Un componente per volta, come in Storybook. A nascondere è questo
  // script: il markup servito non ha nessun `hidden`, quindi senza
  // JavaScript restano visibili tutti i pannelli in sequenza e le voci
  // dell'indice funzionano come normali ancore. Degrado verboso, non vuoto —
  // la stessa regola scritta in testa a lab-home-scroll.ts.
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-ds-panel]"));
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-ds-nav]"));
  const side = document.getElementById("ds-side") as HTMLDetailsElement | null;
  const wide = window.matchMedia("(min-width: 60rem)");

  if (panels.length && navLinks.length) {
    const toolbar = document.querySelector<HTMLElement>("[data-ds-toolbar]");

    const show = (id: string, push: boolean) => {
      // Senza hash si atterra sull'introduzione, non sul primo componente:
      // chi arriva deve prima sapere cos'è questa pagina.
      const target = panels.some((p) => p.dataset.dsPanel === id) ? id : "intro";
      panels.forEach((p) => {
        p.hidden = p.dataset.dsPanel !== target;
      });
      // Il selettore d'accento esiste solo dove cambia qualcosa: sugli altri
      // pannelli sarebbe un comando che non fa niente, e un comando inerte è
      // peggio di un comando assente.
      const active = panels.find((p) => p.dataset.dsPanel === target);
      if (toolbar) {
        const wanted = !!active?.hasAttribute("data-ds-accent");
        toolbar.hidden = !wanted;
        // Il selettore viene spostato DENTRO il pannello attivo, subito sotto
        // l'intestazione: prima stava sopra tutto, e il titolo del componente
        // — "Colore", "Tipografia" — finiva sotto un comando, come se ne
        // fosse una conseguenza. Il titolo viene prima, sempre; il comando è
        // uno strumento del pannello, non il suo cappello.
        if (wanted && active) active.querySelector(".ds-panel__head")?.after(toolbar);
      }
      navLinks.forEach((a) => {
        // aria-current e non una classe: lo stato corrente deve arrivare
        // anche a chi il filo d'accento non lo vede.
        if (a.dataset.dsNav === target) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
      // L'indice è una colonna alta 2073px dentro un riquadro da 712: aprendo
      // /design-system#work-decisione la voce attiva restava 1097px sotto il
      // bordo, con scrollTop a 0. Il pannello giusto c'era, ma l'indice non
      // diceva più dove ci si trovava. `nearest` perché muova il riquadro solo
      // se serve — e non è scrollIntoView sulla pagina, che porterebbe via
      // anche il pannello appena scelto.
      navLinks.find((a) => a.dataset.dsNav === target)?.scrollIntoView({ block: "nearest" });
      if (push && location.hash.slice(1) !== target) {
        history.replaceState(null, "", `#${target}`);
      }
      // Su schermo stretto l'indice è un cassetto: scelto il componente si
      // richiude da solo, altrimenti resterebbe a coprire proprio ciò che si
      // è appena chiesto di vedere.
      if (side && !wide.matches) side.open = false;
    };

    navLinks.forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        show(a.dataset.dsNav!, true);
        // Il pannello cambia sotto una barra fissa: senza questo, scegliendo
        // una voce da metà lista si resta a metà pagina su un pannello che
        // comincia più in alto.
        document.querySelector(".ds-main")?.scrollIntoView({ block: "start", behavior: "smooth" });
      });
    });

    // Indirizzo condivisibile: /design-system#lente-tendina apre direttamente
    // quel componente, e il tasto indietro continua a funzionare.
    window.addEventListener("hashchange", () => show(location.hash.slice(1), false));
    show(location.hash.slice(1), false);

    // Passando la soglia il cassetto torna aperto: su desktop l'indice è una
    // colonna, e lasciarlo chiuso lo renderebbe invisibile senza motivo.
    wide.addEventListener("change", (e) => {
      if (side && e.matches) side.open = true;
    });
  }

  // ── Il volo, rigiocabile ───────────────────────────────────────────────
  // Un movimento che dura tre decimi di secondo non si giudica vedendolo una
  // volta sola, e nella pagina vera per rivederlo bisogna navigare avanti e
  // indietro. Qui basta un bottone.
  //
  // La classe si toglie, si forza un riflusso leggendo offsetWidth, e si
  // rimette: senza quella lettura il browser accorpa le due modifiche nello
  // stesso fotogramma, non vede nessun cambiamento e l'animazione non
  // riparte. E' il modo canonico di rigiocare un'animazione CSS.
  document.querySelectorAll<HTMLButtonElement>("[data-ds-flight-replay]").forEach((btn) => {
    const scena = btn.closest<HTMLElement>(".ds-flight");
    if (!scena) return;
    btn.addEventListener("click", () => {
      scena.classList.remove("is-playing");
      void scena.offsetWidth;
      scena.classList.add("is-playing");
    });
  });

  // ── Selettore di mode ──────────────────────────────────────────────────
  // Scrive data-mode sulla radice della vetrina: le custom properties dei tre
  // accenti sono ereditate, quindi ogni demo cambia insieme senza che nessuna
  // sappia del selettore. È lo stesso meccanismo del sito.
  const root = document.querySelector<HTMLElement>("[data-ds-root]");
  const modeButtons = document.querySelectorAll<HTMLButtonElement>("[data-ds-mode]");
  // Le sezioni della home non leggono --color-accent: prendono --accent da
  // `.lh-section[data-mode="…"]`, perché nella pagina vera ogni sezione porta
  // la propria lente ed è quello a decidere il colore. Scrivere il mode solo
  // sulla radice quindi non le raggiunge.
  const labSections = document.querySelectorAll<HTMLElement>(".ds-stage .lh-section[data-mode]");

  const lens = document.querySelector<HTMLDetailsElement>("[data-ds-lens]");
  const lensLabel = document.querySelector<HTMLElement>("[data-ds-lens-current]");

  if (root && modeButtons.length) {
    modeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.dsMode;
        if (!mode) return;
        root.dataset.mode = mode;
        labSections.forEach((s) => (s.dataset.mode = mode));
        modeButtons.forEach((b) => {
          b.setAttribute("aria-pressed", String(b === btn));
          // is-current e non solo aria-pressed: nel componente vero è la
          // classe a portare il grassetto, e il grassetto è il secondo
          // segnale oltre al colore (1.4.1).
          b.classList.toggle("is-current", b === btn);
        });
        // L'etichetta del comando dice sempre la lente attiva: una tendina
        // che dopo la scelta continua a dire quella di prima è un comando
        // che mente sul proprio stato.
        if (lensLabel) lensLabel.textContent = btn.textContent?.trim() ?? "";
        // Scelta fatta, la tendina si chiude: nel CV le voci sono link e la
        // pagina cambia, qui no — resterebbe aperta a coprire il componente
        // che si è appena chiesto di vedere.
        if (lens) lens.open = false;
      });
    });
  }

  // ── Rigioca gli esempi di movimento ────────────────────────────────────
  // Un'animazione in ciclo non si può "far ripartire": si toglie e si
  // rimette. Serve perché chi arriva sul pannello a metà ciclo vede tre
  // punti in posizioni scorrelate, e il confronto fra le durate — che è
  // tutto il punto di questa demo — si legge solo partendo insieme.
  document.querySelectorAll<HTMLButtonElement>("[data-ds-replay]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll<HTMLElement>("[data-ds-motion]").forEach((list) => {
        list.classList.add("is-paused");
        // Doppio rAF: uno solo non basta a garantire che il browser abbia
        // davvero ricalcolato lo stile senza animazione prima di rimetterla.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => list.classList.remove("is-paused")),
        );
      });
    });
  });

  // ── Anatomia ───────────────────────────────────────────────────────────
  // L'elenco numerato delle parti è servito dall'HTML e si legge da solo:
  // classe più ruolo, nell'ordine del markup. Il comando aggiunge sopra la
  // demo i numeri corrispondenti e un contorno tratteggiato su ogni parte —
  // utile, ma non indispensabile, ed è per questo che nasce `hidden` e lo
  // scopre lo script: senza JavaScript resta l'elenco, che è la sostanza.
  //
  // I numeri sono elementi inseriti qui e non `::before` sul componente: le
  // parti hanno già i propri pseudo-elementi (la barra del titolo di
  // sezione, la stanghetta del link, il chevron) e sovrascriverli avrebbe
  // rotto proprio i pezzi che l'anatomia deve mostrare. Nascono dopo la
  // generazione degli snippet, quindi non finiscono nel codice da copiare.
  document.querySelectorAll<HTMLElement>("[data-ds-anatomy]").forEach((block) => {
    const panel = block.closest<HTMLElement>("[data-ds-panel]");
    const toggle = block.querySelector<HTMLButtonElement>(".ds-anatomy__toggle");
    const parts = panel?.querySelectorAll<HTMLElement>(".ds-stage [data-ds-part]");
    if (!panel || !toggle || !parts || parts.length === 0) return;

    const en = document.documentElement.lang === "en";
    toggle.hidden = false;

    toggle.addEventListener("click", () => {
      const on = panel.dataset.anatomy === undefined;
      if (on) {
        panel.dataset.anatomy = "";
        parts.forEach((part) => {
          const badge = document.createElement("span");
          badge.className = "ds-anatomy__badge";
          badge.dataset.dsBadge = "";
          // aria-hidden: il numero è un rimando visivo all'elenco, e letto
          // ad alta voce dentro il componente lo spezzerebbe a metà.
          badge.setAttribute("aria-hidden", "true");
          badge.textContent = part.dataset.dsPart ?? "";
          part.append(badge);
        });
      } else {
        delete panel.dataset.anatomy;
        panel.querySelectorAll("[data-ds-badge]").forEach((b) => b.remove());
      }
      toggle.setAttribute("aria-pressed", String(on));
      toggle.textContent = on
        ? en
          ? "Hide the numbers"
          : "Nascondi i numeri"
        : en
          ? "Show the numbers"
          : "Mostra i numeri";
    });
  });

  // ── La parallasse della scena knolling ─────────────────────────────────
  // Riscritta qui e non importata da lab-hero.ts: quello lavora sulla
  // finestra intera, qui il riferimento è il riquadro della demo. La
  // sostanza è la stessa, ed è l'unica cosa che la demo deve dimostrare —
  // lo script scrive due variabili normalizzate fra -0.5 e 0.5, e il resto
  // (di quanto si sposta ogni oggetto, in che direzione) lo decide il CSS
  // moltiplicandole per il --depth di quell'oggetto.
  const scena = document.querySelector<HTMLElement>("[data-ds-scena]");
  if (scena && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    scena.addEventListener("pointermove", (e) => {
      const box = scena.getBoundingClientRect();
      scena.style.setProperty("--mx", String((e.clientX - box.left) / box.width - 0.5));
      scena.style.setProperty("--my", String((e.clientY - box.top) / box.height - 0.5));
    });
    // Uscendo la scena torna dritta invece di restare inclinata sull'ultima
    // posizione del puntatore, che si legge come un difetto di render.
    scena.addEventListener("pointerleave", () => {
      scena.style.setProperty("--mx", "0");
      scena.style.setProperty("--my", "0");
    });
  }

  // La still-life del prototipo hero ha una parallasse diversa: là gli
  // oggetti si spostano uno per uno, qui è l'intero palco a inclinarsi in
  // prospettiva. Due meccanismi diversi che vanno visti diversi.
  const scenaHero = document.querySelector<HTMLElement>("[data-ds-scena-hero]");
  if (scenaHero && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const box = () => scenaHero.getBoundingClientRect();
    scenaHero.addEventListener("pointermove", (e) => {
      const b = box();
      scenaHero.style.setProperty("--mx", String(((e.clientX - b.left) / b.width - 0.5) * 2));
      scenaHero.style.setProperty("--my", String(((e.clientY - b.top) / b.height - 0.5) * 2));
    });
    scenaHero.addEventListener("pointerleave", () => {
      scenaHero.style.setProperty("--mx", "0");
      scenaHero.style.setProperty("--my", "0");
    });
  }

  // ── Snippet HTML ───────────────────────────────────────────────────────
  // Lo stesso patto che il foglio di stile fa per il CSS, applicato al
  // markup: lo snippet non è riscritto a mano, è il DOM della demo
  // serializzato. Se la demo cambia, il codice da copiare cambia con lei —
  // una copia scritta a parte sarebbe invecchiata al primo ritocco.
  //
  // Cosa entra e cosa no:
  //   • `data-ds-snippet`  marca la radice del componente. Un pannello può
  //     averne più d'una (le due varianti di CTA, le due misure del badge):
  //     escono in sequenza, separate da una riga vuota.
  //   • gli attributi `data-ds-*` spariscono: sono impalcatura della vetrina.
  //   • `data-ds-drop="…"` toglie dallo snippet attributi che servono solo
  //     alla demo — la tendina qui è mostrata `open`, nella pagina vera nasce
  //     chiusa, e uno snippet che dicesse il contrario insegnerebbe l'errore.
  //
  // Gira PRIMA del comando +N più sotto: quello aggiunge classi e scopre il
  // pulsante, e ciò che va copiato è il markup servito, non quello a cui lo
  // script è già arrivato.
  {
    const en = document.documentElement.lang === "en";
    // I tag che in HTML non hanno chiusura: senza questo elenco lo snippet
    // stampa `</img>`, che non esiste.
    const VOID = new Set([
      "area",
      "base",
      "br",
      "col",
      "embed",
      "hr",
      "img",
      "input",
      "link",
      "meta",
      "source",
      "track",
      "wbr",
    ]);

    // Gli attributi che in HTML si scrivono senza valore. Fuori da questo
    // elenco un valore vuoto resta `alt=""`: è la forma che un frontend si
    // aspetta di copiare, e `alt` nudo sembrerebbe una dimenticanza invece
    // della scelta esplicita "immagine decorativa".
    const BOOLEAN = new Set([
      "open",
      "hidden",
      "disabled",
      "required",
      "checked",
      "selected",
      "readonly",
      "multiple",
      "autofocus",
      "defer",
      "async",
      "controls",
      "loop",
      "muted",
      "playsinline",
      "novalidate",
      "reversed",
    ]);

    const flat = (node: Node) => (node.textContent ?? "").replace(/\s+/g, " ").trim();

    const attrs = (el: Element) => {
      const drop = new Set((el.getAttribute("data-ds-drop") ?? "").split(/\s+/).filter(Boolean));
      return Array.from(el.attributes)
        .filter(
          (a) =>
            // `data-ds-*`: impalcatura della vetrina.
            // `data-astro-source-*`: iniettati SOLO in `astro dev` per la
            // barra degli strumenti, e portano il percorso assoluto del file
            // sulla macchina di chi sviluppa. Nel build non esistono, quindi
            // il difetto si vedeva solo in dev — cioè esattamente dove si
            // guarda la vetrina mentre la si costruisce.
            !a.name.startsWith("data-ds-") &&
            !a.name.startsWith("data-astro-") &&
            !drop.has(a.name),
        )
        .map((a) =>
          a.value === "" && BOOLEAN.has(a.name) ? ` ${a.name}` : ` ${a.name}="${a.value}"`,
        )
        .join("");
    };

    const walk = (node: Node, depth: number, out: string[]) => {
      const pad = "  ".repeat(depth);
      if (node.nodeType === Node.TEXT_NODE) {
        const text = flat(node);
        if (text) out.push(pad + text);
        return;
      }
      if (node.nodeType !== Node.ELEMENT_NODE) return;

      const el = node as Element;
      const tag = el.tagName.toLowerCase();
      const open = `<${tag}${attrs(el)}>`;
      if (VOID.has(tag)) {
        out.push(pad + open);
        return;
      }

      const kids = Array.from(el.childNodes).filter(
        (n) => n.nodeType === Node.ELEMENT_NODE || (n.nodeType === Node.TEXT_NODE && flat(n)),
      );
      if (kids.length === 0) {
        out.push(`${pad}${open}</${tag}>`);
        return;
      }
      // Un elemento con solo testo dentro resta su una riga: spezzarlo
      // renderebbe illeggibile un elenco di chip senza guadagnare nulla.
      if (kids.length === 1 && kids[0].nodeType === Node.TEXT_NODE) {
        out.push(`${pad}${open}${flat(kids[0])}</${tag}>`);
        return;
      }
      out.push(pad + open);
      kids.forEach((k) => walk(k, depth + 1, out));
      out.push(`${pad}</${tag}>`);
    };

    document.querySelectorAll<HTMLElement>("[data-ds-panel]").forEach((panel) => {
      const roots = panel.querySelectorAll<HTMLElement>("[data-ds-snippet]");
      if (roots.length === 0) return;

      const source = Array.from(roots)
        .map((root) => {
          const out: string[] = [];
          walk(root, 0, out);
          return out.join("\n");
        })
        .join("\n\n");

      const box = document.createElement("div");
      box.className = "ds-code";

      const head = document.createElement("div");
      head.className = "ds-code__head";
      const label = document.createElement("p");
      label.className = "ds-code__label";
      label.textContent = en ? "HTML — from the demo above" : "HTML — dalla demo qui sopra";
      head.append(label);

      // Il pulsante esiste solo dove gli appunti esistono (contesto sicuro).
      // Senza, resta il codice selezionabile a mano: meglio niente comando
      // che un comando che non copia.
      if (navigator.clipboard) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "ds-code__copy";
        button.textContent = en ? "Copy" : "Copia";

        // L'etichetta che cambia si vede; chi usa uno screen reader ha
        // bisogno che qualcuno glielo dica.
        const status = document.createElement("span");
        status.className = "ds-sr";
        status.setAttribute("role", "status");

        let timer = 0;
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(source);
          } catch {
            return;
          }
          button.textContent = en ? "Copied" : "Copiato";
          status.textContent = en ? "HTML copied to the clipboard" : "HTML copiato negli appunti";
          window.clearTimeout(timer);
          timer = window.setTimeout(() => {
            button.textContent = en ? "Copy" : "Copia";
            status.textContent = "";
          }, 2000);
        });
        head.append(button, status);
      }

      const pre = document.createElement("pre");
      pre.className = "ds-code__pre";
      // Il riquadro scorre: senza tabindex il codice lungo è irraggiungibile
      // da tastiera (2.1.1). Con il tabindex serve un nome, da cui role e
      // aria-label.
      pre.tabIndex = 0;
      pre.setAttribute("role", "region");
      pre.setAttribute("aria-label", en ? "HTML of the component" : "HTML del componente");
      // Lenis (Layout.astro) intercetta la rotellina su tutta la pagina per
      // il suo scroll smussato, e senza questo attributo lo scorrimento di
      // un riquadro lungo come quello della riga esperienza (61 righe)
      // finiva sulla pagina invece che sul codice sotto il puntatore —
      // stesso motivo per cui #ds-side lo porta.
      pre.setAttribute("data-lenis-prevent", "");
      const code = document.createElement("code");
      // textContent e non innerHTML: è il browser a fare l'escape, così un
      // `<` nello snippet resta un `<` invece di aprire un tag.
      code.textContent = source;
      pre.append(code);

      box.append(head, pre);
      panel.append(box);
    });
  }

  // ── Il comando +N delle chip, identico a /<lente> ─────────────────────
  document.querySelectorAll<HTMLUListElement>(".lc-chips").forEach((lista) => {
    const piu = lista.querySelector<HTMLButtonElement>(".lc-chip--more");
    const quante = lista.querySelectorAll(".lc-chip--extra").length;
    if (!piu || quante === 0) return;

    const segno = piu.querySelector<HTMLElement>(".lc-more__sign");
    const voce = piu.querySelector<HTMLElement>(".lc-sr");
    const en = document.documentElement.lang === "en";
    lista.classList.add("is-collapsed");
    piu.hidden = false;

    piu.addEventListener("click", () => {
      const aperto = lista.classList.toggle("is-collapsed") === false;
      piu.setAttribute("aria-expanded", String(aperto));
      if (segno) segno.textContent = aperto ? `−${quante}` : `+${quante}`;
      // Anche il nome accessibile cambia con lo stato: senza, chi usa uno
      // screen reader sentiva "mostra le altre 2" su un comando che ormai le
      // stava già mostrando.
      if (voce) {
        voce.textContent = en
          ? aperto
            ? ` — hide the other ${quante} technologies`
            : ` — show the other ${quante} technologies`
          : aperto
            ? ` — nascondi le altre ${quante} tecnologie`
            : ` — mostra le altre ${quante} tecnologie`;
      }
    });
  });
</script>

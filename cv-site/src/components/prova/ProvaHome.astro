---
// "/" sul ramo di prova `test/new-layout`: il primo schermo del redesign.
//
// Lettore: chi assume, spesso su un portatile da 1366×610 o dal telefono.
// Nel primo schermo, senza attese: nome, ruolo, la frase di posizionamento,
// le aziende e le tre azioni. A destra GO, per ora una sagoma provvisoria.
//
// Il ruolo ruota fra i tre delle lenti. L'HTML statico contiene già il primo:
// senza JS e con reduced motion resta quello. Un lettore di schermo sente
// tutti e tre, e il bottone «tutti i ruoli» ferma la rotazione e li mostra
// insieme (WCAG 2.2.2: chi non vuole il movimento lo ferma).
import Layout from "../../layouts/Layout.astro";
import { cvData } from "@cv-data";
import { lensPath } from "../../lib/cv-i18n";
import { PROVA_HOME as t, PROVA_ROLES } from "../../lib/prova-copy";
import ProvaCareer from "./ProvaCareer.astro";
import "../../styles/prova/prova-home.css";

const { name } = cvData.personal;
const mail = cvData.social.find((s) => s.platform === "Email")?.url ?? "";
const linkedin = cvData.social.find((s) => s.platform === "LinkedIn")?.url ?? "";
const labels = PROVA_ROLES.map((r) => r.label);
const roles = PROVA_ROLES.map((r) => ({ ...r, href: lensPath(r.mode, "it") }));
---

<Layout
  title={`${name} — ${labels.join(" · ")}`}
  description={t.statement}
  mode="creative"
  lang="it"
  preloadLegacyFonts={false}
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Instrument+Sans:wght@400;500;600&display=swap"
  />

  <main id="main-content" class="ph">
    <header class="ph-bar">
      <a class="ph-bar__link" href="/work">{t.work}</a>
    </header>

    <section class="ph-hero" aria-labelledby="ph-title">
      <div class="ph-hero__text">
        <h1 id="ph-title" class="ph-title">
          <span class="ph-title__name">{name}</span>
          <span class="ph-title__role">
            <span class="ph-rotator" aria-hidden="true" data-roles={JSON.stringify(labels)}
              >{labels[0]}</span
            >
            <span class="ph-all" aria-hidden="true">{labels.join(" · ")}</span>
            <span class="ph-sr">{t.rolesSr}</span>
          </span>
        </h1>
        <button class="ph-roles-toggle" type="button" aria-pressed="false" hidden
          >{t.rolesAll}</button
        >

        <p class="ph-statement">{t.statement}</p>

        <p class="ph-proof">
          {t.proofEnterprise}: {t.proofCompanies.map((c) => <strong class="ph-co">{c}</strong>)}.
          Con {t.proofCerts}.
        </p>

        <div class="ph-actions">
          <a class="ph-btn ph-btn--primary" href="/cv/Giulio_Occhipinti_CV.pdf" download
            >{t.ctaCv}</a
          >
          <a class="ph-btn" href={mail}>{t.ctaMail}</a>
          <a class="ph-btn" href={linkedin} rel="noopener" target="_blank">{t.ctaLinkedin}</a>
        </div>

        <nav class="ph-lenses" aria-label={t.lensIntro}>
          <span class="ph-lenses__intro">{t.lensIntro}</span>
          <ul>
            {
              roles.map((r) => (
                <li>
                  <a href={r.href}>
                    {r.label} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <figure class="ph-go" aria-hidden="true">
        <!-- GO provvisorio: una sagoma per provare lo spazio. Il personaggio
             vero si disegna dopo (prova/decisioni.md). -->
        <svg viewBox="0 0 240 300" role="presentation" focusable="false">
          <rect class="ph-go__body" x="50" y="170" width="140" height="130" rx="60"></rect>
          <path class="ph-go__arm" d="M186 200 C 215 185, 222 150, 210 128"></path>
          <circle class="ph-go__hand" cx="210" cy="122" r="12"></circle>
          <circle class="ph-go__head" cx="120" cy="110" r="72"></circle>
          <circle class="ph-go__eye" cx="96" cy="104" r="7"></circle>
          <circle class="ph-go__eye" cx="144" cy="104" r="7"></circle>
          <path class="ph-go__smile" d="M98 132 Q120 150 142 132"></path>
          <text class="ph-go__mark" x="120" y="252" text-anchor="middle">GO</text>
        </svg>
      </figure>
    </section>

    <ProvaCareer />
  </main>
</Layout>

<script>
  // La rotazione del ruolo. Parte solo senza movimento ridotto; si ferma col
  // mouse sopra, col focus dentro il titolo e, per sempre, col bottone che
  // mostra tutti i ruoli insieme.
  const el = document.querySelector<HTMLElement>(".ph-rotator");
  const toggle = document.querySelector<HTMLButtonElement>(".ph-roles-toggle");
  const title = document.querySelector<HTMLElement>(".ph-title");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (el && toggle && title && !reduce.matches) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? "[]");
    let i = 0;
    let hover = false;
    let stopped = false;
    toggle.hidden = false;
    title.addEventListener("pointerenter", () => (hover = true));
    title.addEventListener("pointerleave", () => (hover = false));
    toggle.addEventListener("click", () => {
      stopped = !stopped;
      toggle.setAttribute("aria-pressed", String(stopped));
      title.classList.toggle("is-all", stopped);
    });
    window.setInterval(() => {
      if (hover || stopped || document.hidden || roles.length < 2) return;
      el.classList.add("is-out");
      window.setTimeout(() => {
        i = (i + 1) % roles.length;
        el.textContent = roles[i];
        el.classList.remove("is-out");
      }, 220);
    }, 2600);
  }
</script>

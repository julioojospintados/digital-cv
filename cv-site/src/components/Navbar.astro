---
const links = [
  { label: 'Esperienze', href: '#experience' },
  { label: 'Competenze', href: '#skills' },
  { label: 'Formazione', href: '#education' },
  { label: 'Progetti', href: '#projects' },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300"
  aria-label="Navigazione principale"
>
  <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#" class="text-sm font-semibold text-neutral-200 hover:text-indigo-400 transition-colors">
      ← Top
    </a>
    <div class="flex gap-6">
      {links.map(link => (
        <a
          href={link.href}
          class="text-sm text-neutral-500 hover:text-neutral-200 transition-colors hidden sm:block"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  // Show navbar with backdrop when scrolled past hero
  const navbar = document.getElementById('navbar');
  if (navbar) {
    const onScroll = () => {
      if (window.scrollY > 80) {
        navbar.classList.add('bg-neutral-950/80', 'backdrop-blur-md', 'border-b', 'border-neutral-800/60');
      } else {
        navbar.classList.remove('bg-neutral-950/80', 'backdrop-blur-md', 'border-b', 'border-neutral-800/60');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

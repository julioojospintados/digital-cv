---
/**
 * WorkNav.astro — la barra di /work e della vetrina del design system.
 *
 * Marchio GO a sinistra (l'isola <go-logo>, non un testo), ritorno al CV
 * pieno d'accento e interruttore di lingua a destra. Prima del 2026-10-14
 * questo markup era scritto a mano in sei posti: le quattro pagine /work
 * (IT e EN, indice e case study), la barra della vetrina e la sua demo. La
 * vetrina, a forza di copie, era finita con una barra sua — «GO» come testo,
 * «Home», «/work» ed «EN» come link — diversa da quella che documentava.
 * Un componente solo, e la divergenza non si può più ripetere.
 *
 * Cosa cambia da una pagina all'altra:
 *   - `back`: dove riporta il ritorno. Sale di un livello: dall'indice e
 *     dalla vetrina alla lente design (tutta /work parla arancione, lo
 *     calcola chi chiama con lensPath, perché lo slug dell'URL non è la
 *     chiave interna), da un case study all'indice /work.
 *   - `backLabel`: l'etichetta del ritorno, dalla tabella delle stringhe.
 *     «Torna al CV» se non la passa nessuno, «Case study» sui case study,
 *     cioè il nome dell'indice a cui porta. Fino al 2026-10-22 anche il case study diceva «Torna al CV», e
 *     chi arrivava dall'indice, cioè quasi tutti, perdeva la strada per gli
 *     altri progetti (Giulio). Il CV resta a un clic dal fondo della pagina.
 *   - `langHref`: la stessa pagina nell'altra lingua.
 */
import LangSwitch from "./LangSwitch.astro";
import { LOCALES, type Locale } from "../lib/cv-i18n";

interface Props {
  locale: Locale;
  back: string;
  backLabel?: string;
  langHref: string;
  /** Attributi in più per il contenitore (le demo della vetrina li usano). */
  [attr: string]: unknown;
}

const { locale, back, backLabel, langHref, ...rest } = Astro.props;
const t = LOCALES[locale];
---

<nav class="work-nav" {...rest}>
  <go-logo>GO</go-logo>
  <div class="work-nav__right">
    <a href={back} class="work-back"
      ><span class="work-chevron work-chevron--left" aria-hidden="true"></span>{
        backLabel ?? t.ui.backToCv
      }</a
    >
    <LangSwitch locale={locale} href={langHref} />
  </div>
</nav>

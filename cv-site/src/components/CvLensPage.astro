---
// /<lente> — la pagina CV per come legge un recruiter,
// con la faccia del progetto addosso.
//
// ── I due vincoli, che convivono ─────────────────────────────────────────
//
// LEGGIBILITÀ. Strato 1 (7,4 secondi): i sei dati che l'eye-tracking dice
// che vengono cercati — nome, ruolo e azienda attuali, date, ruolo
// precedente, contatti — stanno sopra la piega, senza scroll. Strato 2
// (30 secondi): le esperienze della lente, aperte, più la cronologia
// completa.
//
// I testi di voce — il paragrafo per lente ("Come ci arrivo") e la bio
// "Chi sono" — NON stanno qui: vivono nella home ("/"), dove servono a
// far scegliere. Su questa pagina la scelta è già fatta, e il visitatore
// vuole le prove.
//
// Il motivo non è dottrinale, è misurato: la bio è di 678 caratteri, e
// tenerla sopra i ruoli attuali spingeva "dove lavora ora" a 987px e i
// pulsanti a 1150px dentro una finestra da 844px — su telefono la prima
// schermata non conteneva più né l'azienda né il pulsante del PDF.
//
// CARATTERE. Colore della lente, oggetto knolling con la sua ombra
// ricostruita, sigla grande in filigrana, luce ambientale, i testi della
// home. Tutto questo è **statico**: c'è al primo paint e non costa un
// millisecondo di attesa a chi legge.
//
// La regola che tiene insieme le due cose:
//   IL MOVIMENTO STA SULLA DECORAZIONE, MAI SULLE PAROLE.
// Gli oggetti derivano allo scroll (animation-timeline CSS, zero JS); il
// testo non compare mai in dissolvenza, non parte mai invisibile, non
// aspetta mai un trigger. È il pet peeve numero uno degli hiring manager
// ("content should load as quickly as possible") ed è anche la ragione per
// cui, sulla pagina vera, alcune sezioni esistono solo dopo uno scroll.
//
// Cosa NON c'è, rispetto a /tech e /creative: stamp fullscreen, laser di
// scansione, scroll automatico, riordino client-side, card dimmate al 20%
// di opacità. Il cambio lente è navigazione fra tre pagine statiche.
//
// TESTI: cv.ts, cv-i18n e lab-copy.ts (verbatim da index.astro). Nessuna
// copy scritta qui.
import Layout from "../layouts/Layout.astro";
import { cvData } from "@cv-data";
import { cvDataEn } from "@cv-data-en";
import { buildCvViewModel } from "../lib/cv-view-model";
import { EXP_CLUSTER_DEFS } from "../lib/exp-clusters";
import { LANE_DEFS, EXP_LANES, isoToYear, mergeSpans } from "../lib/exp-lanes";
import { issuerMark } from "../lib/issuer-marks";
import { LOCALES, MODES, lensPath, type Locale, type Mode } from "../lib/cv-i18n";
import { TAGLINE, profileCopy } from "../lib/lab-copy";
import "../styles/lab-cv.css";

interface Props {
  /** Chiave interna della lente, già risolta dallo slug dalla rotta. */
  lens: Mode;
  locale: Locale;
}

const { lens, locale } = Astro.props;
const t = LOCALES[locale];
const data = locale === "en" ? cvDataEn : cvData;
const profile = profileCopy(lens, locale);
const tagline = TAGLINE[locale];
// I percorsi cambiano con la lingua: l'inglese vive sotto /en.
const homeHref = locale === "en" ? "/en" : "/";
const workHref = locale === "en" ? "/en/work" : "/work";
const cvPdf = locale === "en" ? "/cv/Giulio_Occhipinti_CV_EN.pdf" : "/cv/Giulio_Occhipinti_CV.pdf";
// La stessa lente nell'altra lingua, non la home: chi cambia lingua vuole
// continuare a leggere quello che stava leggendo.
const otherLocale = locale === "en" ? "it" : "en";
const otherHref = lensPath(lens, otherLocale);
const otherLabel = locale === "en" ? "IT" : "EN";
const otherTitle = locale === "en" ? LOCALES.it.ui.switchToIt : LOCALES.en.ui.switchToEn;

const { modeLabel, heroTitle, expClusters, timelineItems } = buildCvViewModel({
  data,
  locale,
  mode: lens,
});

const cluster = expClusters.find((c) => c.key === lens);
const clusterLabel = cluster?.label ?? modeLabel;

// ── Descrizione: quella base di cv.ts, non la variante per lente ─────────
// `buildCvViewModel` restituisce, per ogni card, la `facets[<lente>]`
// dell'esperienza quando esiste: ruolo, descrizione e highlight raccontati
// da quell'angolo. Qui sostituiamo **solo** la descrizione con
// `experience[i].description`, quella base. Ruolo e highlight restano
// quelli della lente (scelta esplicita del 2026-08-13).
//
// Conseguenza da tenere presente: il ruolo di ogni card resta quello della
// lente anche quando il paragrafo sotto parla d'altro — le due righe non si
// contraddicono, ma nemmeno si rispondono sempre. Per tornare indietro basta
// togliere questo blocco.
//
// L'override sta qui e non in `lib/cv-view-model.ts` di proposito: quel
// file serve anche /en/cv e le pagine di /old-version, che devono continuare
// a mostrare la descrizione della lente. Questa scelta vale solo qui.
const clusterRefs = EXP_CLUSTER_DEFS.find((c) => c.key === lens)?.refs ?? [];
const rawItems = cluster?.items ?? [];

// L'allineamento posizionale regge solo se nessun ref è caduto durante la
// costruzione (refToCard può restituire null su un indice inesistente). Se
// i conti non tornano non indoviniamo: si lasciano i testi come sono.
const aligned = rawItems.length === clusterRefs.length;

const items = rawItems.map((item, i) => {
  if (!aligned) return { ...item, clients: [] };
  const ref = clusterRefs[i];
  if (!ref || !("exp" in ref)) return { ...item, clients: [] };
  const src = data.experience[ref.exp];
  return {
    ...item,
    description: src?.description ?? item.description,
    // Incarichi presso clienti (oggi solo ALTEN). Quando ci sono, prendono
    // il posto degli highlight: dicono le stesse cose ma con il nome del
    // cliente davanti, che per una consulenza e' il dato piu' cercato.
    clients: src?.clients ?? [],
  };
});

// ── Strato 1: le due righe di intestazione ───────────────────────────────
// Prima i ruoli ancora in corso (è il dato più cercato: "dove lavora ora"),
// nell'ordine curato di exp-clusters.ts; se ce n'è meno di due si completa
// col più recente. Escono sempre da `items`, mai scritti a mano.
const current = items.filter((i) => i.endYear === t.present);
const byRecency = [...items].sort((a, b) => Number(b.startYear) - Number(a.startYear));
const headline = [...current, ...byRecency.filter((i) => !current.includes(i))].slice(0, 2);

// Il portfolio è la prova decisiva per il ruolo di design, e solo per
// quello: su /tech o /human diventa un'uscita laterale che porta via
// dal CV proprio nei secondi in cui si sta decidendo.
const showPortfolio = lens === "creative";

// ── Strato 2b: la cronologia completa ────────────────────────────────────
const yearsLabel = (start: string, end: string): string => {
  const s = start.slice(0, 4);
  const e = end === "present" ? t.present : end.slice(0, 4);
  return s === e ? s : `${s} — ${e}`;
};

const lensExpIdx = new Set(
  (EXP_CLUSTER_DEFS.find((c) => c.key === lens)?.refs ?? [])
    .filter((r): r is { exp: number; facet?: Mode } => "exp" in r)
    .map((r) => r.exp),
);

// Le date non sono piu' solo una stringa: diventano una barra su un asse
// condiviso da tutte le righe. Il perche' delle tre corsie, e l'eccezione
// sui due accenti accesi insieme, stanno in lib/exp-lanes.ts.
//
// "Adesso" e' il momento della build, non una data scritta a mano: il sito
// si ricostruisce a ogni deploy e le barre dei ruoli aperti si allungano da
// sole. Una costante qui invecchierebbe in silenzio.
const ora = new Date();
const annoOra = ora.getFullYear() + (ora.getMonth() + 1) / 12;
const tlDa = Math.floor(Math.min(...data.experience.map((e) => isoToYear(e.startDate))));
const tlA = Math.ceil(annoOra);
const pct = (anno: number): number => ((anno - tlDa) / (tlA - tlDa)) * 100;

const laneRows = data.experience.map((e, i) => {
  const da = isoToYear(e.startDate);
  const a = e.endDate === "present" ? annoOra : isoToYear(e.endDate, true);
  return {
    company: e.company,
    role: e.role,
    years: yearsLabel(e.startDate, e.endDate),
    // Su telefono la corsia si stringe al solo anno d'inizio: l'intervallo
    // intero non ci sta, e la freccia dice "ancora aperto" al posto di
    // ripetere "oggi" su sei righe. Vedi .lc-all__from in lab-cv.css.
    startYear: e.startDate.substring(0, 4),
    inProgress: e.endDate === "present",
    sort: e.startDate,
    inLens: lensExpIdx.has(i),
    lane: EXP_LANES[i] ?? "off",
    // Una barra sotto lo 0,8% e' un trattino invisibile: i sei mesi da
    // Starbucks contano quanto gli altri, nel racconto della continuita'.
    left: pct(da),
    width: Math.max(pct(a) - pct(da), 0.8),
    da,
    a,
  };
});

const lanes = LANE_DEFS.map((def) => {
  const items = laneRows
    .filter((r) => r.lane === def.key)
    .sort((x, y) => y.sort.localeCompare(x.sort));
  return {
    key: def.key,
    label: def.labels[locale],
    count: items.length,
    items,
    // La barra della corsia chiusa: gli intervalli uniti, non il primo
    // giorno attaccato all'ultimo. I buchi veri devono restare buchi.
    merged: mergeSpans(items.map((r) => [r.da, r.a] as const)).map(([da, a]) => ({
      left: pct(da),
      width: Math.max(pct(a) - pct(da), 0.8),
    })),
  };
});

const tlTicks = Array.from({ length: Math.ceil((tlA - tlDa) / 4) }, (_, k) => tlDa + k * 4).map(
  (anno) => ({ anno, left: pct(anno) }),
);
const tlNow = pct(annoOra);

const email = data.social.find((s) => s.platform === "Email");
const linkedin = data.social.find((s) => s.platform === "LinkedIn");
// Le lingue non stanno piu' nella riga dei puntini: sono una fila di
// pastiglie, una per lingua, col livello staccato dal nome. Prima erano
// quattro delle sei voci di un unico elenco puntato che mescolava luogo,
// disponibilita' e lingue con lo stesso separatore e lo stesso peso —
// niente diceva dove finiva un tipo di dato e cominciava l'altro.
const langChips = data.languages.map((l) => ({ name: l.name, level: l.level }));

// ── Strato 2c: percorso e voci ───────────────────────────────────────────
// timelineItems arriva già unito e ordinato dal piu recente da
// buildCvViewModel — lo stesso che serve le pagine vere. Qui si separa per
// tipo e basta: due elenchi si leggono meglio di uno misto, perché un
// diploma e un attestato Coursera non si confrontano fra loro, e senza la
// separazione ogni riga avrebbe avuto bisogno di un'etichetta per dire
// quale delle due cose è.
//
// Nessun filtro per lente, a differenza delle esperienze: la formazione è
// una garanzia di completezza, e mostrarne una parte diversa a seconda
// della lente è esattamente il sospetto che la sezione deve togliere.
const formazione = timelineItems.filter((i) => i.type === "edu");
const certificazioni = timelineItems.filter((i) => i.type === "cert");

const MAX_CHIPS = 6;
---

<Layout
  title={`CV ${modeLabel} — Giulio Occhipinti`}
  description={t.modeDescriptions[lens] ?? t.fallbackDescription}
  mode={lens}
  lang={locale}
>
  <!-- L'oggetto della lente è il pezzo grafico più pesante sopra la piega:
       va chiesto subito, non scoperto a fine parsing. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href={`/knolling/${profile.object}.webp`}
    fetchpriority="high"
  />

  <div class="lc">
    <!-- Barra. Non sticky: una barra fissa mangia proprio la fascia alta in
         cui si giocano i primi sette secondi. -->
    <header class="lc-bar">
      <a href={homeHref} class="lc-bar__home" aria-label={t.ui.backHome}>
        <go-logo></go-logo>
      </a>
      <p class="lc-bar__tagline">{tagline}</p>
      <a
        class="lc-bar__lang"
        href={otherHref}
        lang={otherLocale}
        hreflang={otherLocale}
        aria-label={otherTitle}
      >
        {otherLabel}
      </a>
    </header>

    <main id="main-content" class="lc-main">
      <!-- ══ STRATO 1 — 7,4 secondi ═══════════════════════════════════════
           Colonna del testo a sinistra (l'occhio scende lungo quel margine:
           pattern a F), oggetto e sigla a destra — la zona a bassa
           attenzione, che è esattamente il posto giusto per la decorazione:
           riempie senza contendere. -->
      <section class="lc-head" aria-label={t.ui.headerAria}>
        <div class="lc-head__glow" aria-hidden="true"></div>

        <div class="lc-head__text">
          <h1 class="lc-name">{data.personal.name}</h1>
          <p class="lc-role">{modeLabel}</p>

          <p class="lc-claim">{heroTitle}</p>

          <p class="lc-meta">{data.personal.location} · {t.ui.availableRemote}</p>

          <!-- "Dove lavora ora, e prima": il dato più fissato in assoluto
               nello screening iniziale. -->
          <dl class="lc-now">
            {
              headline.map((h) => (
                <div class="lc-now__row">
                  <dt class="lc-now__years">
                    {h.startYear ? `${h.startYear} — ${h.endYear}` : ""}
                  </dt>
                  <dd class="lc-now__what">
                    <b>{h.company}</b>
                    <span class="lc-now__sep"> · </span>
                    {h.role}
                  </dd>
                </div>
              ))
            }
          </dl>

          <!-- Il PDF per primo: è l'oggetto che il recruiter inoltra
               all'hiring manager, e sulla pagina CV attuale non è linkato
               da nessuna parte pur esistendo in public/cv/. -->
          <div class="lc-actions">
            <a class="lc-btn lc-btn--primary" href={cvPdf} download>
              {t.ui.downloadCv}
            </a>
            {
              showPortfolio && (
                <a class="lc-btn" href={workHref}>
                  {t.ui.portfolioCta}
                  <span class="lc-btn__arrow" aria-hidden="true" />
                </a>
              )
            }
          </div>

          {
            /* Le lingue come pastiglie: il livello CEFR resta scritto per
              esteso perche' e' una credenziale, non un punteggio — tradurlo
              in "tre pallini su cinque" perderebbe l'unico dato che un
              recruiter cerca davvero. Il grafico qui separa i tipi di
              informazione, non misura il livello.

              Stanno DOPO i bottoni e prima dei contatti, non su in alto con
              luogo e disponibilita': la fascia dei primi secondi porta gia'
              nome, ruolo, claim e i due incarichi in corso, e le lingue non
              competono con quelli. Qui invece chiudono il blocco insieme a
              mail e LinkedIn — sono tutte informazioni di contatto e di
              contesto, cioe' quello che si guarda dopo aver deciso che il
              profilo interessa. */
          }
          <ul class="lc-langs" role="list">
            {
              langChips.map((l) => (
                <li class="lc-lang">
                  {l.name}
                  <b class="lc-lang__lvl">{l.level}</b>
                </li>
              ))
            }
          </ul>

          <!-- Contatti in chiaro, non dentro un FAB: "no treasure hunts for
               contact information". -->
          <p class="lc-contacts">
            {email && <a href={email.url}>{email.label}</a>}
            <span class="lc-contacts__sep" aria-hidden="true">·</span>
            {
              linkedin && (
                <a href={linkedin.url} target="_blank" rel="noopener noreferrer">
                  LinkedIn
                </a>
              )
            }
          </p>

          <!-- Selettore di lente retrocesso: non tre pulsanti di pari peso
               in cima. Chi arriva da un annuncio UX non deve leggere "sono
               anche altre due cose" nei sette secondi in cui sta decidendo.
               <details> nativo, opzioni = link veri. -->
          <details class="lc-lens">
            <summary class="lc-lens__trigger">
              <span class="lc-lens__dot" aria-hidden="true"></span>
              <span class="lc-lens__label">{t.ui.youAreViewing} <b>{modeLabel}</b></span>
              <span class="lc-lens__chevron tick" aria-hidden="true"></span>
            </summary>
            <ul class="lc-lens__list" role="list">
              {
                MODES.map((m) => (
                  <li>
                    <a
                      href={lensPath(m, locale)}
                      class:list={["lc-lens__opt", { "is-current": m === lens }]}
                      data-lens={m}
                      aria-current={m === lens ? "page" : undefined}
                    >
                      <span class="lc-lens__opt-dot" aria-hidden="true" />
                      {t.modeLabels[m]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>

        <!-- Oggetto + sigla. L'ombra è la stessa immagine annerita, sfocata
             e inclinata sotto all'originale: eredita l'alpha del webp,
             quindi segue la sagoma invece di essere un rettangolo sfumato
             (stessa tecnica di lab-home.css). -->
        <div class="lc-head__deco" aria-hidden="true">
          <span class="lc-initial">{profile.initial}</span>
          <span class="lc-obj" style={`--ratio:${profile.ratio}`}>
            <img class="lc-obj__shadow" src={`/knolling/${profile.object}.webp`} alt="" />
            <img
              class="lc-obj__img"
              src={`/knolling/${profile.object}.webp`}
              alt=""
              fetchpriority="high"
              decoding="async"
            />
          </span>
        </div>
      </section>

      <!-- ══ STRATO 2 — 30 secondi ════════════════════════════════════════ -->
      <section class="lc-exp" aria-labelledby="lc-exp-title">
        <img
          class="lc-bg-knoll"
          src="/knolling/multitool.webp"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />

        <div class="lc-sec-head">
          <h2 class="lc-sec-title" id="lc-exp-title">{t.ui.experienceOf} — {clusterLabel}</h2>
          <p class="lc-sec-note">
            {
              t.ui.lensNote
                .replace("{n}", String(items.length))
                .replace("{tot}", String(data.experience.length))
            }
          </p>
        </div>

        <div class="lc-jobs">
          {
            items.map((job) => {
              // Le chip ci sono **tutte** nell'HTML: quelle oltre MAX_CHIPS
              // portano una classe in più e le nasconde il CSS, ma solo dopo
              // che lo script ha acceso l'interruttore (.is-collapsed). Senza
              // JavaScript non si nasconde niente e il pulsante resta
              // `hidden`: si vedono tutte le tecnologie e non c'è nessun
              // comando morto. È la stessa regola dell'ingresso di
              // la home — a nascondere è il codice che sa anche riaprire.
              const primi = job.skills.slice(0, MAX_CHIPS);
              const oltre = job.skills.slice(MAX_CHIPS);

              // Ogni esperienza che ha qualcosa dentro diventa una scheda
              // apribile — anche quelle senza highlights (Fotografo, Corriere
              // di Chieri, Satispay), che hanno comunque le chip.
              //
              // Qui c'era la scelta opposta, con un argomento buono: aprire un
              // <details> per scoprire tre chip di tecnologie e' "un'affordance
              // che mente". Reggeva finche' le schede nascevano APERTE, perche'
              // allora una riga piatta era indistinguibile dalle altre. Da
              // quando sono tutte chiuse il contesto e' cambiato: chi guarda si
              // aspetta che ogni riga si apra, e due righe che non lo fanno
              // sembrano rotte, non sobrie. Fra un'affordance dal premio
              // modesto e un elenco che si comporta in due modi diversi, la
              // seconda confonde di piu'.
              //
              // Se un domani una riga non ha proprio niente — ne' highlights,
              // ne' clienti, ne' chip — il ramo piatto e' ancora qui e la
              // prende. Non e' codice morto: e' il caso limite giusto.
              const hasBody =
                job.highlights.length > 0 || job.clients.length > 0 || primi.length > 0;

              const chipList =
                primi.length > 0 ? (
                  <ul
                    class="lc-chips"
                    role="list"
                    aria-label={t.ui.toolsAria}
                    data-show={t.ui.showOtherTech}
                    data-hide={t.ui.hideOtherTech}
                  >
                    {primi.map((s) => (
                      <li class="lc-chip">{s}</li>
                    ))}
                    {oltre.map((s) => (
                      <li class="lc-chip lc-chip--extra">{s}</li>
                    ))}
                    {oltre.length > 0 && (
                      <li>
                        {/* Il segno "+4" resta parte del nome accessibile, non
                            aria-hidden con un'etichetta al suo posto: il
                            criterio 2.5.3 (Label in Name) chiede che il nome
                            contenga il testo che si vede, o chi comanda a voce
                            dice "+4" e non succede niente. */}
                        <button
                          class="lc-chip lc-chip--more"
                          type="button"
                          aria-expanded="false"
                          hidden
                        >
                          <span class="lc-more__sign">+{oltre.length}</span>
                          <span class="lc-sr"> — mostra le altre {oltre.length} tecnologie</span>
                        </button>
                      </li>
                    )}
                  </ul>
                ) : null;

              const head = (
                <>
                  <span class="lc-job__years">
                    {job.startYear ? `${job.startYear} — ${job.endYear}` : ""}
                  </span>
                  <span class="lc-job__main">
                    <h3 class="lc-job__title">
                      <b>{job.company}</b>
                      <span class="lc-job__role"> — {job.role}</span>
                      {/* aiAugmented lo calcola gia' cv-view-model.ts dai tag
                          e dalle tecnologie dell'esperienza: qui si rende,
                          non si ricalcola. */}
                      {job.aiAugmented && (
                        <span class="lc-ai">
                          AI
                          <span class="lc-sr">{t.ui.aiInFlow}</span>
                        </span>
                      )}
                    </h3>
                    {job.location && (
                      <span class="lc-job__where">
                        {job.location}
                        {job.remote ? " · Remote" : ""}
                      </span>
                    )}
                    <span class="lc-job__lead">{job.description}</span>
                  </span>
                </>
              );

              if (!hasBody) {
                return (
                  <article class="lc-job lc-job--flat">
                    <div class="lc-job__summary">{head}</div>
                    {chipList && <div class="lc-job__body lc-job__body--flat">{chipList}</div>}
                  </article>
                );
              }

              return (
                <details class="lc-job">
                  {/* Il <summary> è volutamente ricco, e da quando le schede
                      nascono chiuse è diventato il pezzo che regge tutto:
                      azienda, ruolo, anni e una riga di prova restano
                      leggibili senza aprire niente. È la ragione per cui
                      chiudere di default non ricade nel "treasure hunt" che
                      gli hiring manager citano fra i motivi di scarto — da
                      chiuso non resta un elenco di sole intestazioni, resta
                      un elenco che si legge. Se un domani il summary si
                      assottiglia, questa scelta va rivista con lui.
                      <h3> dentro <summary> è valido (heading content) e tiene
                      le esperienze navigabili col tasto H. */}
                  <summary class="lc-job__summary">
                    {head}
                    <span class="lc-job__chevron tick" aria-hidden="true" />
                  </summary>

                  <div class="lc-job__body">
                    {job.clients.length > 0 ? (
                      <ul class="lc-clients" role="list">
                        {job.clients.map((c) => (
                          <li class="lc-client">
                            <p class="lc-client__who">
                              <b>{c.client}</b>
                              <span class="lc-client__role">{c.role}</span>
                              {c.ai && (
                                <span class="lc-ai lc-ai--sm">
                                  AI
                                  <span class="lc-sr">{t.ui.aiInFlowClient}</span>
                                </span>
                              )}
                            </p>
                            <p class="lc-client__text">{c.description}</p>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <ul class="lc-job__points" role="list">
                        {job.highlights.map((h) => (
                          <li>{h}</li>
                        ))}
                      </ul>
                    )}
                    {chipList}
                  </div>
                </details>
              );
            })
          }
        </div>
      </section>

      <!-- Qui c'era uno script inline che sotto i 1024px chiudeva tutte le
           schede tranne la prima: serviva perché il markup nasceva `open`, e
           su mobile una lista tutta aperta era una colonna infinita. Da
           quando nasce chiusa non ha più niente da fare, e toglierlo è
           meglio che lasciarlo: era anche l'unico punto che riapriva le
           schede al cambio di orientamento, sovrascrivendo quelle che
           l'utente aveva chiuso a mano.

           Senza JavaScript ora il degrado è "tutto chiuso" invece di "tutto
           aperto". Regge perché il <summary> è ricco (vedi sopra): resta
           azienda, ruolo, anni e una riga di prova, e <details> si apre da
           sé anche senza script. -->

      <!-- ── 2b. La cronologia completa ───────────────────────────────────
           Il costo del filtro: cinque card dal 2019 fanno sembrare il tuo un
           CV da cinque anni. Questa sezione è la garanzia di completezza:
           date, traiettoria, assenza di buchi.

           Era un elenco di ventiquattro righe, e la garanzia bisognava
           calcolarsela leggendo le date una per una. Ora le stesse date sono
           barre su un asse condiviso, raggruppate in tre corsie: quello che
           l'elenco non riusciva a dire — dal 2009 mai meno di tre ruoli in
           parallelo, otto nel 2017 — si vede senza contare niente.

           Le corsie sono <details> e non JavaScript: si aprono da sole anche
           senza script, come le schede qui sopra, e chiuse mostrano la
           copertura unita della corsia invece di sparire. Le barre sono
           aria-hidden: il dato resta nel testo di ogni riga, che è quello che
           legge uno screen reader. -->
      <section class="lc-all" aria-labelledby="lc-all-title">
        <div class="lc-sec-head">
          <h2 class="lc-sec-title" id="lc-all-title">
            {t.ui.allRoles}
            <span class="lc-sec-count"
              >{t.ui.sinceCount.replace("{n}", String(data.experience.length))}</span
            >
          </h2>
        </div>
        <div class="lc-tl">
          <div class="lc-tl__axisrow" aria-hidden="true">
            <span class="lc-tl__scale">
              {
                tlTicks.map((tk) => (
                  <span class="lc-tl__tick" style={`left:${tk.left}%`}>
                    {tk.anno}
                  </span>
                ))
              }
              <span class="lc-tl__now" style={`left:${tlNow}%`}></span>
            </span>
          </div>

          {
            lanes.map((lane) => (
              <details class="lc-lane">
                <summary class="lc-lane__head">
                  <span class="lc-lane__name">
                    <span class="tick" aria-hidden="true" />
                    <span
                      class:list={["lc-lane__key", `lc-lane__key--${lane.key}`]}
                      aria-hidden="true"
                    />
                    {lane.label}
                    <span class="lc-lane__n">{lane.count}</span>
                  </span>
                  <span class="lc-tl__track" aria-hidden="true">
                    {lane.merged.map((m) => (
                      <span
                        class:list={["lc-tl__bar", `lc-tl__bar--${lane.key}`]}
                        style={`left:${m.left}%;width:${m.width}%`}
                      />
                    ))}
                    <span class="lc-tl__now" style={`left:${tlNow}%`} />
                  </span>
                </summary>

                <ul class="lc-lane__list" role="list">
                  {lane.items.map((e) => (
                    <li class:list={["lc-all__row", { "is-lens": e.inLens }]}>
                      <span class="lc-all__years">
                        <span class="lc-all__span">{e.years}</span>
                        <span class="lc-all__from">
                          {e.startYear}
                          {e.inProgress && (
                            <span class="lc-all__on" aria-hidden="true">
                              →
                            </span>
                          )}
                          <span class="lc-sr">{e.years}</span>
                        </span>
                      </span>
                      <span class="lc-all__what">
                        <b>{e.company}</b>
                        <span class="lc-all__sep" aria-hidden="true">
                          {" "}
                          ·{" "}
                        </span>
                        <span class="lc-all__role">{e.role}</span>
                      </span>
                      {e.inLens && (
                        <>
                          <span class="lc-all__mark" aria-hidden="true" />
                          <span class="lc-sr">
                            {t.ui.highlightedFor} {clusterLabel}
                          </span>
                        </>
                      )}
                      <span class="lc-tl__track" aria-hidden="true">
                        <span
                          class:list={["lc-tl__bar", `lc-tl__bar--${lane.key}`]}
                          style={`left:${e.left}%;width:${e.width}%`}
                        />
                        <span class="lc-tl__now" style={`left:${tlNow}%`} />
                      </span>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </div>
      </section>

      <!-- ── 2c. Le voci ──────────────────────────────────────────────────
           Fin qui ha parlato solo lui. Due persone che ci hanno lavorato
           insieme dicono la stessa cosa da fuori, ed è l'unico pezzo di
           pagina che un candidato non può scriversi da solo.

           Sta dopo le esperienze e non prima: una testimonianza letta senza
           sapere che cosa ha fatto è un complimento; letta dopo, è una
           conferma. Statiche, tutte e due in pagina, nessun carosello —
           qui non si nasconde metà della prova dietro un gesto. -->
      <section class="lc-voices" aria-labelledby="lc-voices-title">
        <div class="lc-sec-head">
          <h2 class="lc-sec-title" id="lc-voices-title">{t.ui.voices}</h2>
        </div>
        <ul class="lc-voices__list" role="list">
          {
            data.feedbacks
              .filter((f) => f.quote)
              .map((f) => (
                <li class="lc-voice">
                  <blockquote class="lc-voice__quote">{f.quote}</blockquote>
                  <p class="lc-voice__who">
                    {f.name}
                    {f.role && <span class="lc-voice__role"> · {f.role}</span>}
                  </p>
                </li>
              ))
          }
        </ul>
      </section>

      <!-- ── 2d. Il percorso ──────────────────────────────────────────────
           Formazione e certificazioni per intero, senza filtro di lente:
           qui il valore è la completezza, non la pertinenza. Stessa griglia
           di "Tutte le esperienze" — data sul binario mono a sinistra,
           contenuto a destra — perché sono la stessa cosa per il lettore:
           un elenco verificabile che si scorre con l'occhio, non si legge. -->
      <section class="lc-path" aria-labelledby="lc-path-title">
        <div class="lc-sec-head">
          <h2 class="lc-sec-title" id="lc-path-title">{t.ui.pathTitle}</h2>
        </div>

        <div class="lc-path__group">
          <h3 class="lc-path__group-title">
            {t.ui.education}
            <span class="lc-sec-count">{formazione.length}</span>
          </h3>
          <ul class="lc-path__list" role="list">
            {
              formazione.map((e) => (
                <li class="lc-path__row">
                  <span
                    class:list={["lc-path__mark", { "is-logo": issuerMark(e.institution).logo }]}
                    style={
                      issuerMark(e.institution).logo
                        ? `--lc-mark: url("/logos/${issuerMark(e.institution).logo}.svg")`
                        : undefined
                    }
                    aria-hidden="true"
                  >
                    {!issuerMark(e.institution).logo && issuerMark(e.institution).sigla}
                  </span>
                  <span class="lc-path__what">
                    <b>{e.title}</b>
                    <span class="lc-path__where"> · {e.institution}</span>
                  </span>
                  <span class="lc-path__date">{e.dateLabel}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lc-path__group">
          <h3 class="lc-path__group-title">
            {t.ui.certifications}
            <span class="lc-sec-count">{certificazioni.length}</span>
          </h3>
          <ul class="lc-path__list" role="list">
            {
              certificazioni.map((c) => (
                <li class="lc-path__row">
                  <span
                    class:list={["lc-path__mark", { "is-logo": issuerMark(c.institution).logo }]}
                    style={
                      issuerMark(c.institution).logo
                        ? `--lc-mark: url("/logos/${issuerMark(c.institution).logo}.svg")`
                        : undefined
                    }
                    aria-hidden="true"
                  >
                    {!issuerMark(c.institution).logo && issuerMark(c.institution).sigla}
                  </span>
                  <span class="lc-path__what">
                    <b>{c.title}</b>
                    <span class="lc-path__where"> · {c.institution}</span>
                    {c.inProgress && <span class="lc-path__wip">{t.ui.inProgress}</span>}
                    {c.credentialId && (
                      <span class="lc-path__id">
                        <span class="lc-sr">{t.ui.credentialId} </span>
                        {c.credentialId}
                      </span>
                    )}
                  </span>
                  <span class="lc-path__date">{c.dateLabel}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ══ STRATO 3 — 3-5 minuti. Qui solo gli imbocchi: chi arriva fin
           qui ha già deciso di approfondire, e vuole dove, non altro testo.
           ═══════════════════════════════════════════════════════════════ -->
      <section class="lc-more" aria-labelledby="lc-more-title">
        <h2 class="lc-sec-title" id="lc-more-title">{t.ui.goDeeper}</h2>
        <ul class="lc-more__list" role="list">
          <li>
            <a href={workHref}>{t.ui.caseStudiesLink}</a>
          </li>
          {
            /* Qui c'era il rimando a `/{lens}` — "competenze, metodo e
              formazione, versione attuale del CV". Quella pagina è sospesa
              su questo branch. Della sua roba, formazione e certificazioni
              adesso stanno in pagina (2d): non erano un approfondimento da
              rimandare altrove, erano una verifica, e una verifica la si
              vuole dove si sta già guardando. Restano fuori competenze e
              metodo, che un posto nel linguaggio nuovo non ce l'hanno
              ancora: finché non ce l'hanno, lo strato 3 tiene un imbocco
              solo. Un link a una pagina che non c'è sarebbe peggio di un
              imbocco in meno. */
          }
        </ul>
      </section>
    </main>
  </div>
</Layout>

<script>
  // Solo la firma GO della barra: l'island si autoregistra come <go-logo>
  // e reagisce da sé al mode della pagina.
  import "../islands/GoLogo.lit";
  import { initLensDropdownAutoClose } from "../scripts/lens-dropdown";

  initLensDropdownAutoClose();

  // ── "+4" — da etichetta morta a comando vero ──────────────────────────
  // L'HTML servito contiene già tutte le tecnologie. Qui si richiude ciò che
  // avanza e si accende il pulsante: l'ordine conta, perché è ciò che rende
  // impossibile il caso "nascoste e nessun modo di riaprirle". Se questo
  // codice non gira, restano tutte in vista e il pulsante resta `hidden` —
  // niente da cliccare, niente da cercare.
  document.querySelectorAll<HTMLUListElement>(".lc-chips").forEach((lista) => {
    const piu = lista.querySelector<HTMLButtonElement>(".lc-chip--more");
    const quante = lista.querySelectorAll(".lc-chip--extra").length;
    if (!piu || quante === 0) return;

    const segno = piu.querySelector<HTMLElement>(".lc-more__sign");
    const voce = piu.querySelector<HTMLElement>(".lc-sr");

    lista.classList.add("is-collapsed");
    piu.hidden = false;

    piu.addEventListener("click", () => {
      const aperto = lista.classList.toggle("is-collapsed") === false;
      piu.setAttribute("aria-expanded", String(aperto));
      // Il testo visibile cambia insieme allo stato, restando nello stesso
      // linguaggio del segno: "+4" apre, "−4" richiude — stesso numero,
      // segno invertito, non una parola isolata che sembra una chip rotta.
      // Resta il primo pezzo del nome accessibile (2.5.3), quindi chi
      // comanda a voce legge sempre un segno che è davvero lì.
      if (segno) segno.textContent = aperto ? `−${quante}` : `+${quante}`;
      if (voce) {
        // Le due etichette arrivano dal server via data-*: questo script è
        // condiviso da italiano e inglese e non può conoscere la lingua.
        const modello = aperto ? lista.dataset.hide : lista.dataset.show;
        voce.textContent = (modello ?? "").replace("{n}", String(quante));
      }
    });
  });
</script>

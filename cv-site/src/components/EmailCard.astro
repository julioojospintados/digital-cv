---
/**
 * EmailCard.astro — il comando per scrivere a Giulio, dentro "Chi sono".
 *
 * Nasce il 2026-09-02 dallo smontaggio del footer d'ingresso. Fino a quel
 * giorno la home aveva SEI schermate e l'ultima era il congedo: titolo
 * "Tocca a te.", card email, card LinkedIn, firma, megafono. Quella schermata
 * è stata tolta, e di tutto il blocco è sopravvissuto questo comando, risalito
 * alla seconda schermata.
 *
 * Il perché sta in due misure prese sulla pagina vera. La chiusura era alta
 * quanto lo schermo e il suo contenuto ne riempiva un terzo: una schermata
 * dimensionata per una quantità di roba che non c'era. "Chi sono", invece,
 * arrivava a circa metà, con l'aria distribuita sopra il titolo e sotto i
 * pulsanti, quindi lo spazio c'era già ed è dove ora sta il bottone.
 *
 * Cosa si è perso, e va saputo: **LinkedIn non è più raggiungibile
 * dall'ingresso** (resta sulle pagine della lente, dove c'è `lc-contacts`),
 * "Tocca a te." non esiste più, e con il riquadro se ne sono andati anche
 * l'indirizzo in chiaro e il pulsante che lo copiava. Quest'ultima è la
 * perdita che pesa: su un desktop senza client di posta configurato `mailto:`
 * non apre niente e il clic fallisce in silenzio, e adesso non resta un
 * secondo modo di prendere l'indirizzo. È una scelta di Giulio del
 * 2026-09-02, fatta sapendo questo.
 *
 * ── Perché qui non c'è nemmeno una riga di CSS ──────────────────────────
 * Il bottone è `.lh-cta--ghost`, cioè LO STESSO delle tre sezioni lente
 * ("GO to Web & UX Designer"), non una sua imitazione. `.lh-cta` è una classe
 * libera in `lab-home.css`, non annidata sotto `.lh`, e la vetrina importa
 * quel foglio: funziona in tutti e due i posti senza copiare niente. Un
 * secondo blocco di regole che rifà lo stesso bottone sarebbe divergito alla
 * prima modifica, e nessuno se ne sarebbe accorto finché i due non fossero
 * finiti uno accanto all'altro.
 *
 * Stessa ragione per il contenitore: `.lh-section__actions` è la fascia che
 * porta le CTA delle altre sezioni, e da lì arriva gratis il comportamento su
 * telefono, cioè colonna a tutta larghezza col testo centrato sotto le 56rem.
 *
 * E per la stessa ragione qui **non c'è la stanghetta**: `.lh-cta` non ne ha,
 * e questo deve essere quel bottone, non quel bottone più qualcosa.
 */
import { cvData } from "@cv-data";
import { cvDataEn } from "@cv-data-en";

interface Props {
  lang?: "it" | "en";
  /** Tutto il resto finisce sul contenitore: serve alla vetrina, che marca la
   *  radice dei componenti con `data-ds-snippet` per serializzarli. */
  [key: string]: unknown;
}

const { lang = "it", ...rest } = Astro.props;
const data = lang === "en" ? cvDataEn : cvData;

const email = data.social.find((s) => s.platform === "Email");

const t =
  lang === "en"
    ? { action: "Write to me", aria: "Write an email to Giulio", subject: "Hello Giulio" }
    : { action: "Scrivimi", aria: "Scrivi una email a Giulio", subject: "Ciao Giulio" };
---

{
  email && (
    <div class="lh-section__actions" {...rest}>
      {/* _blank anche sul mailto: se il gestore di posta è webmail (Gmail nel
          browser), _self sostituirebbe il CV con la pagina di composizione.
          Con il client nativo la scheda transitoria si chiude da sola. */}
      <a
        class="lh-cta lh-cta--ghost"
        href={`${email.url}?subject=${encodeURIComponent(t.subject)}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.aria}
      >
        {t.action}
      </a>
    </div>
  )
}

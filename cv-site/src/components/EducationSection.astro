---
import type { Education, Certification } from '@cv-data';

interface Props {
  education: Education[];
  certifications: Certification[];
}

const { education, certifications } = Astro.props;

function formatDate(date: string): string {
  const [year, month] = date.split('-');
  if (!month) return year;
  const d = new Date(Number(year), Number(month) - 1);
  return d.toLocaleDateString('it-IT', { month: 'short', year: 'numeric' });
}
---

<section id="education" class="py-24">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="reveal text-3xl font-bold mb-16 text-neutral-100">
      <span class="text-indigo-400">/</span> Formazione
    </h2>

    {education.length > 0 && (
      <div class="space-y-6 mb-16">
        {education.map((edu, i) => (
          <div class={`reveal delay-${Math.min((i + 1) * 100, 500)} bg-neutral-900/60 border border-neutral-800 rounded-2xl p-6`}>
            <div class="flex flex-wrap justify-between gap-2 mb-2">
              <div>
                <h3 class="font-semibold text-neutral-100">{edu.degree}</h3>
                {edu.field && <p class="text-indigo-400 text-sm">{edu.field}</p>}
                <p class="text-neutral-400 text-sm">{edu.institution}</p>
              </div>
              <div class="text-right text-sm text-neutral-500">
                <p>{formatDate(edu.startDate)} — {formatDate(edu.endDate)}</p>
                {edu.location && <p class="mt-0.5">{edu.location}</p>}
                {edu.grade && <p class="mt-0.5 text-indigo-300">{edu.grade}</p>}
              </div>
            </div>
            {edu.description && (
              <p class="text-sm text-neutral-500 leading-relaxed mt-3">{edu.description}</p>
            )}
          </div>
        ))}
      </div>
    )}

    {certifications.length > 0 && (
      <>
        <h3 class="reveal text-sm uppercase tracking-widest text-neutral-500 mb-6">Certificazioni</h3>
        <div class="grid sm:grid-cols-2 gap-4">
          {certifications.map((cert, i) => (
            <div class={`reveal delay-${Math.min((i + 1) * 100, 500)} bg-neutral-900/60 border border-neutral-800 rounded-xl p-4 hover:border-indigo-500/40 transition-colors duration-300`}>
              <p class="font-medium text-neutral-200">{cert.name}</p>
              <p class="text-sm text-neutral-500 mt-1">{cert.issuer} · {formatDate(cert.date)}</p>
              {cert.url && (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs text-indigo-400 mt-2 hover:text-indigo-300 transition-colors"
                >
                  Verifica credenziale ↗
                </a>
              )}
            </div>
          ))}
        </div>
      </>
    )}
  </div>
</section>

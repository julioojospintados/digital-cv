---
import type { WorkExperience } from '@cv-data';

interface Props {
  experience: WorkExperience[];
}

const { experience } = Astro.props;

function formatDate(date: string): string {
  if (date === 'present') return 'Presente';
  const [year, month] = date.split('-');
  const d = new Date(Number(year), Number(month) - 1);
  return d.toLocaleDateString('it-IT', { month: 'short', year: 'numeric' });
}
---

<section id="experience" class="py-24">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="reveal text-3xl font-bold mb-16 text-neutral-100">
      <span class="text-indigo-400">/</span> Esperienze
    </h2>

    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-4 top-2 bottom-2 w-px bg-gradient-to-b from-indigo-500/60 via-purple-500/30 to-transparent hidden md:block" aria-hidden="true"></div>

      <div class="space-y-12">
        {experience.map((job, i) => (
          <div class={`reveal delay-${Math.min((i + 1) * 100, 500)} md:pl-14 relative`}>
            <!-- Timeline dot -->
            <div class="hidden md:block absolute left-0 top-1 w-8 h-8 rounded-full bg-neutral-900 border-2 border-indigo-500/60 flex items-center justify-center">
              <div class="w-2 h-2 rounded-full bg-indigo-400"></div>
            </div>

            <div class="bg-neutral-900/60 border border-neutral-800 rounded-2xl p-6 hover:border-indigo-500/40 transition-colors duration-300">
              <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
                <div>
                  <h3 class="text-lg font-semibold text-neutral-100">{job.role}</h3>
                  <p class="text-indigo-400 font-medium">{job.company}</p>
                </div>
                <div class="text-right text-sm text-neutral-500">
                  <p>{formatDate(job.startDate)} — {formatDate(job.endDate)}</p>
                  {job.location && (
                    <p class="mt-0.5">
                      {job.location}
                      {job.remote && <span class="ml-1 text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full">Remote</span>}
                    </p>
                  )}
                </div>
              </div>

              <p class="text-neutral-400 text-sm leading-relaxed mb-4">{job.description}</p>

              {job.highlights && job.highlights.length > 0 && (
                <ul class="space-y-1 mb-4">
                  {job.highlights.map(h => (
                    <li class="text-sm text-neutral-300 flex gap-2">
                      <span class="text-indigo-400 mt-0.5 shrink-0">▸</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}

              {job.skills && job.skills.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {job.skills.map(s => (
                    <span class="text-xs bg-neutral-800 text-neutral-400 px-2.5 py-1 rounded-full border border-neutral-700">
                      {s}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

---
// / — la home: ingresso a schermo pieno, senza le card.
//
// L'ingresso diventa una sola schermata piena di oggetti grandi, con nome e
// ruolo al centro. Nessuna scelta da fare: si scorre, e le sezioni arrivano
// una alla volta a schermo intero. Le modalità non spariscono, smettono di
// essere un bivio all'ingresso e diventano un percorso.
//
// Rispetto alla home vera questa prova resta spoglia dove non serve: niente
// preloader GO. I cassetti delle foto invece ci sono — "Fun fact / Cose mie
// / Viaggio", gli stessi della home vera, dal componente MemoryDrawers —
// perché è qui che hanno senso: all'ingresso, dove chi legge sta ancora
// decidendo chi sei e ha tempo di aprirli.
//
// La sezione "Chi sono" sta prima delle lenti: la persona, poi le
// maschere. Ci è arrivata dalle pagine CV per lente (/<lente>), dove
// occupava la fascia dei primi sette secondi con 678 caratteri e spingeva
// sotto la piega ruoli attuali e pulsanti.
//
// TESTI: tutti da cv-i18n e @cv-data, nessuna copy scritta qui.
import Layout from "../layouts/Layout.astro";
import { cvData } from "@cv-data";
import { cvDataEn } from "@cv-data-en";
import { LOCALES, MODES, lensPath, type Locale } from "../lib/cv-i18n";
import {
  ABOUT_CARDS,
  ABOUT_CARD_PHOTOS,
  ABOUT_OBJECT,
  ABOUT_TEXT,
  PROFILE_TEXT,
  TAGLINE,
  photoThumb,
} from "../lib/lab-copy";
import MemoryDrawers from "../components/MemoryDrawers.astro";
import EntryFooter from "../components/EntryFooter.astro";
import "../styles/lab-home.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale];
const data = locale === "en" ? cvDataEn : cvData;
const about = ABOUT_TEXT[locale];
// Le tre card di "Chi sono": la bio tagliata a fine frase, un pezzo per card.
// La foto sta in un array a parte perché non cambia con la lingua.
const aboutCards = ABOUT_CARDS[locale];
// I percorsi cambiano con la lingua: l'inglese vive sotto /en.
const workHref = locale === "en" ? "/en/work" : "/work";
const otherLocale = locale === "en" ? "it" : "en";
const otherHomeHref = locale === "en" ? "/" : "/en";
const otherLabel = locale === "en" ? "IT" : "EN";
const otherTitle = locale === "en" ? LOCALES.it.ui.switchToIt : LOCALES.en.ui.switchToEn;

// ── La composizione dell'ingresso ────────────────────────────────────────
// Otto oggetti grandi disposti attorno al centro, che resta libero per il
// nome. Le dimensioni sono in vmin (la minore fra larghezza e altezza della
// finestra), così la composizione tiene le proporzioni sia su schermo largo
// che stretto invece di appiattirsi.
//
// depth = quanto insegue il puntatore  ·  sh-* = direzione e morbidezza
// dell'ombra portata (vedi lab-home.css)
const composition = [
  { src: "megaphone", x: "13%", y: "20%", w: "17vmin", r: "-9deg", depth: 0.5, blur: 0 },
  // Scacchi e pianta si sono scambiati di posto. Posizione e depth sono del
  // posto, non dell'oggetto: la profondità cresce scendendo (in alto la scena
  // si muove poco, in basso molto), quindi resta 0.3 qui e 1 in fondo.
  // Larghezza e rotazione invece viaggiano con l'oggetto.
  // 10.5vmin e non 14: quassù pesava quanto il megafono e i pezzi sono alti,
  // quindi occupano molto più di quanto la larghezza lasci pensare. È anche
  // il webp più piccolo del set (177 px), quindi meno lo si ingrandisce
  // meglio tiene.
  { src: "chess", x: "35%", y: "12%", w: "10.5vmin", r: "-3deg", depth: 0.3, blur: 0 },
  { src: "laptop", x: "76%", y: "19%", w: "26vmin", r: "4deg", depth: 0.65, blur: 0 },
  // 13% e non 8%: sotto quella soglia la torcia veniva tagliata dal bordo
  // sinistro e sembrava un errore, non una scelta di inquadratura.
  // -190deg e non -4deg: girata quasi a mezzo giro, la testa della torcia
  // punta verso il centro invece che fuori dall'inquadratura. 26vmin perché
  // è l'oggetto più allungato della scena: alla larghezza degli altri
  // spariva, ed è la sorgente più grande che abbiamo (1187px).
  { src: "flashlight", x: "13%", y: "52%", w: "26vmin", r: "-190deg", depth: 0.9, blur: 0 },
  { src: "compass", x: "89%", y: "54%", w: "15vmin", r: "8deg", depth: 0.8, blur: 0 },
  { src: "multitool", x: "20%", y: "84%", w: "19vmin", r: "12deg", depth: 1.15, blur: 0 },
  // 62% e non 50%: al centro questo posto finisce esattamente sotto
  // l'indicatore "Scorri", che ci si sovrappone.
  { src: "plant", x: "62%", y: "88%", w: "12vmin", r: "5deg", depth: 1, blur: 0 },
  { src: "camera", x: "80%", y: "85%", w: "20vmin", r: "-7deg", depth: 1.25, blur: 0 },
];

// ── Le sezioni ───────────────────────────────────────────────────────────
// Una per modalità, nell'ordine di MODES (cv-i18n.ts): design-first in testa.
// Sigla, oggetto, etichetta e descrizione sono quelli già scritti in cv-i18n.
const initials: Record<string, string> = {
  creative: "WD",
  tech: "SD",
  human: "AI",
};

const sectionObject: Record<string, string> = {
  creative: "camera",
  tech: "laptop",
  human: "compass",
};

// Larghezza reale in pixel di ogni webp, convertita in rem (÷16).
// Serve a non disegnare mai un oggetto più grande dei pixel che ha davvero:
// gli scacchi sono 177 px e venivano stirati a 352, da cui lo sgranato.
// Questo tetto risolve il sintomo; la cura è riesportare le sorgenti più
// grandi, perché così alcuni oggetti restano piccoli per forza.
const NATIVE_REM: Record<string, number> = {
  camera: 327 / 16,
  chess: 177 / 16,
  compass: 208 / 16,
  flashlight: 1187 / 16,
  laptop: 524 / 16,
  megaphone: 389 / 16,
  multitool: 226 / 16,
  plant: 226 / 16,
};

// I testi delle sezioni, copiati **verbatim** da index.astro
// (§ .profile-section): titolo su due righe, occhiello, paragrafo. Nel giro
// precedente avevo usato modeLabels/modeDescriptions di cv-i18n, che sono
// un'altra cosa — servono all'hero delle pagine CV e ai meta, non a questa
// sezione. Qui la voce deve essere quella della home.

// La pianta: 226px di larghezza nativa, come gli altri (vedi NATIVE_REM).
const ABOUT_NATIVE_REM = 226 / 16;

const sections = MODES.map((mode) => ({
  mode,
  initial: initials[mode],
  object: sectionObject[mode],
  nativeRem: NATIVE_REM[sectionObject[mode]],
  title: PROFILE_TEXT[locale][mode].title,
  eyebrow: t.modeLabels[mode],
  desc: PROFILE_TEXT[locale][mode].desc,
  // Il portfolio è la prova più importante per il ruolo target: nella
  // sezione design la sua CTA deve esserci, accanto a quella del CV.
  portfolio: mode === "creative",
}));
---

<Layout title={t.ui.homeTitle} description={t.ui.homeDescription} mode="creative" lang={locale}>
  <link slot="head" rel="preload" as="image" href="/knolling/laptop.webp" fetchpriority="high" />

  {
    /* Anti-lampo. Senza questo l'ingresso viene disegnato tutto visibile, resta
      così finché il bundle non arriva (misurati ~600ms in sviluppo), e solo
      allora lab-home-intro.ts lo nasconde per farlo entrare: si vede la pagina,
      sparisce, e ricompare. È lo stesso rimedio della home vera, che nasconde
      da CSS ciò che poi anima.

      Qui però la classe la mette uno script inline, non il foglio di stile, e
      la differenza è il motivo per cui questo non viola la regola scritta in
      lab-home-scroll.ts ("a nascondere è GSAP, non il CSS"): se JavaScript non
      c'è, questo script non gira, l'attributo non arriva mai e l'ingresso resta
      visibile e fermo — che è esattamente il comportamento voluto. E se invece
      lo script inline gira ma il modulo non arriva mai (rete che cade a metà),
      il timer lo toglie da solo dopo 3 secondi invece di lasciare la pagina
      bianca per sempre. is:inline = eseguito durante il parse, prima del primo
      disegno; un modulo partirebbe troppo tardi, cioè a lampo già avvenuto. */
  }
  <script slot="head" is:inline>
    document.documentElement.setAttribute("data-lh-armed", "");
    setTimeout(function () {
      document.documentElement.removeAttribute("data-lh-armed");
    }, 3000);
  </script>

  <div class="lh">
    <header class="lh-bar">
      <a href={locale === "en" ? "/en" : "/"} class="lh-mark" aria-label={t.ui.backToEntry}> GO </a>
      <nav class="lh-nav lh-nav--lang">
        <a href={otherHomeHref} lang={otherLocale} hreflang={otherLocale} aria-label={otherTitle}>
          {otherLabel}
        </a>
      </nav>
    </header>

    <!-- ── Ingresso: una schermata, nessuna card ── -->
    <section class="lh-hero">
      <div class="lh-stage" data-lab-stage aria-hidden="true">
        {
          composition.map((o) => (
            <div
              class="lh-obj"
              data-obj={o.src}
              style={`--x:${o.x};--y:${o.y};--w:${o.w};--r:${o.r};--depth:${o.depth}`}
            >
              {/* Ombra portata: la stessa immagine annerita, sfocata e
                  inclinata. Segue la sagoma perché ne eredita l'alpha. */}
              <img
                class="lh-obj__shadow"
                src={`/knolling/${o.src}.webp`}
                alt=""
                aria-hidden="true"
              />
              <img
                class="lh-obj__img"
                src={`/knolling/${o.src}.webp`}
                alt=""
                loading={o.src === "laptop" ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
          ))
        }
      </div>

      {
        /* Testi dell'ingresso: gli stessi di index.astro (§ .entry-header),
          verbatim. Anche qui avevo sostituito di mia iniziativa — occhiello,
          tagline e riga dei ruoli sono quelli scritti da Giulio. */
      }
      <div class="lh-copy">
        {
          /* Il nome è diviso in parole, e lab-home-intro.ts scende poi al
            singolo carattere: serve alla comparsa lettera per lettera, con G e
            O che atterrano prima delle altre. aria-label tiene il nome intero
            per chi legge con uno screen reader — le parole spezzate sono
            decorazione, non contenuto. Stesso schema di index.astro. */
        }
        <h1 class="lh-name" aria-label={data.personal.name}>
          {
            data.personal.name.split(" ").map((word, i) => (
              <Fragment>
                {i > 0 && " "}
                <span class="name-word" aria-hidden="true">
                  {word}
                </span>
              </Fragment>
            ))
          }
        </h1>
        <p class="lh-tagline">{TAGLINE[locale]}</p>
        <p class="lh-cred">{t.ui.entryRoles}</p>
      </div>

      <a class="lh-scroll" href="#main-content">
        <span>{t.ui.scrollHint}</span>
        <span class="lh-scroll__line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- ── Le sezioni, una schermata ciascuna ── -->
    <main id="main-content">
      {
        /* Chi sono — prima delle lenti: la persona, poi le maschere
           (stesso ordine di index.astro). Non è un profilo in più: niente
           data-mode, quindi l'ambiente resta neutro invece di prendere il
           colore di una lente, e niente CTA, perché non porta da nessuna
           parte. È il posto in cui questa bio è utile — all'ingresso, dove
           chi legge sta ancora decidendo chi sei; sulla pagina CV di una
           lente occupava la fascia dei primi sette secondi con 678 caratteri,
           spingendo sotto la piega ruoli attuali e pulsanti. */
      }
      <section class="lh-section lh-section--about" id="about">
        <div class="lh-section__object" style={`--nat:${ABOUT_NATIVE_REM}rem`}>
          <img
            class="lh-obj__shadow"
            src={`/knolling/${ABOUT_OBJECT.object}.webp`}
            alt=""
            aria-hidden="true"
          />
          <img
            src={`/knolling/${ABOUT_OBJECT.object}.webp`}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="lh-section__copy">
          <p class="lh-section__initial" aria-hidden="true">IO</p>
          <h2 class="lh-section__title">{about.title}</h2>
          <p class="lh-section__eyebrow">{about.eyebrow}</p>
          {
            /* La bio non è più un paragrafo: è tagliata a fine frase in tre
               card, e ognuna apre una modale a schermo pieno. Due problemi
               risolti insieme — il paragrafo intero faceva un pannello da
               ~930px in una finestra da 667 (per questo la sezione era spenta
               su mobile), e la foto dentro la colonna della scheda stava a
               80px, un francobollo. A schermo pieno ne prende 335.

               Nessuno script nuovo: `data-drawer-open="X"` apre `#dialog-X`,
               lo stesso meccanismo dei cassetti qui sotto (memory-drawer.ts).
               Focus trap, ESC e clic sul fondo arrivano dal <dialog> nativo. */
          }
          <div class="about-cards">
            {
              aboutCards.map((c, i) => (
                <button class="about-card__b" type="button" data-drawer-open={`about-${i}`}>
                  <span class="about-card__t">{c.label}</span>
                  <span class="about-card__p tick" aria-hidden="true" />
                </button>
              ))
            }
          </div>
          {
            /* I tre cassetti della home vera, non le etichette: qui c'e' spazio
              e c'e' tempo — chi sta scorrendo l'ingresso puo' aprirli. Le
              chip dicevano le stesse cose senza mostrarle; questi le
              mostrano (foto, racconto). Il markup dei <dialog> arriva da
              <MemoryDrawers lang={locale} />, in fondo alla pagina. */
          }
          <div class="about-actions" role="group" aria-label={t.ui.aboutMore}>
            <button class="about-action" type="button" data-drawer-open="funfact">
              <span class="about-action__icon" aria-hidden="true">✦</span>
              {t.ui.drawerFunFact}
            </button>
            <button class="about-action" type="button" data-drawer-open="trip">
              <span class="about-action__icon" aria-hidden="true">✦</span>
              {t.ui.drawerTrip}
            </button>
            <button class="about-action" type="button" data-drawer-open="belongings">
              <span class="about-action__icon" aria-hidden="true">✦</span>
              {t.ui.drawerBelongings}
            </button>
          </div>
        </div>
      </section>

      {
        sections.map((s) => (
          <section class="lh-section" data-mode={s.mode}>
            <div class="lh-section__object" style={`--nat:${s.nativeRem}rem`}>
              <img
                class="lh-obj__shadow"
                src={`/knolling/${s.object}.webp`}
                alt=""
                aria-hidden="true"
              />
              <img src={`/knolling/${s.object}.webp`} alt="" loading="lazy" decoding="async" />
            </div>

            {/* La sigla sta dentro la colonna di testo, non ancorata al bordo
                della pagina: così si allinea al margine destro del titolo e
                gli resta dietro, invece di entrargli addosso di lato. */}
            <div class="lh-section__copy">
              <p class="lh-section__initial" aria-hidden="true">
                {s.initial}
              </p>
              <h2 class="lh-section__title">
                {s.title[0]}
                <br />
                {s.title[1]}
              </h2>
              <p class="lh-section__eyebrow">{s.eyebrow}</p>
              <p class="lh-section__text">{s.desc}</p>
              <div class="lh-section__actions">
                {/* lensPath e non una stringa: lo slug dell'URL (/design,
                    /tech, /ai) non coincide con la chiave interna del mode,
                    e la mappa che li tiene insieme sta in cv-i18n.ts. */}
                <a class="lh-cta" href={lensPath(s.mode, locale)}>
                  {t.ui.goTo} {s.eyebrow}
                </a>
                {s.portfolio && (
                  <a class="lh-cta lh-cta--ghost" href={workHref}>
                    {t.ui.explorePortfolio}
                  </a>
                )}
              </div>
            </div>
          </section>
        ))
      }
    </main>

    {/* Il footer della home vera: stesso componente, stesso stile. */}
    <EntryFooter lang={locale} emphasis />
  </div>

  {
    /* Le tre modali di "Chi sono" — una per card. Stesse classi dei cassetti
       (`.memory-dialog`), quindi stesso aspetto, stesso comportamento e niente
       CSS nuovo: `memory-drawer.ts` le trova da sé, perché per ogni
       `[data-drawer-open]` cerca `#dialog-<chiave>`.

       `--reading` e non lo scatter: qui dentro c'è una foto sola e un
       paragrafo, non quattordici foto — la variante stretta è la colonna di
       lettura giusta per un testo, invece dei 64rem pensati per la griglia. */
  }
  {
    aboutCards.map((c, i) => (
      <dialog
        class="memory-dialog memory-dialog--reading memory-dialog--about"
        id={`dialog-about-${i}`}
        aria-labelledby={`dialog-about-${i}-title`}
        data-lenis-prevent
      >
        <div class="memory-dialog__header">
          <p class="memory-dialog__eyebrow" id={`dialog-about-${i}-title`}>
            {c.label}
          </p>
          <button
            class="memory-dialog__close"
            type="button"
            data-drawer-close
            aria-label={t.ui.closeLabel}
          >
            ✕
          </button>
        </div>
        <div class="memory-dialog__scroll">
          <figure class="about-modal">
            <img
              src={photoThumb(ABOUT_CARD_PHOTOS[i])}
              alt={c.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{c.text}</figcaption>
          </figure>
        </div>
      </dialog>
    ))
  }

  <MemoryDrawers lang={locale} />
</Layout>

<script>
  import { initLabHero } from "../scripts/lab-hero";
  import { initLabHomeIntro } from "../scripts/lab-home-intro";
  import { initLabHomeScroll, initLabHomeSnap, initLabHomeMood } from "../scripts/lab-home-scroll";
  import { initLensTransition } from "../scripts/lens-transition";

  // Per prima: è l'unica che nasconde qualcosa, e deve farlo prima che le
  // altre inizino a muoverlo.
  initLabHomeIntro();
  initLabHero();
  initLabHomeScroll();
  initLabHomeSnap();
  initLabHomeMood();
  // Nessuna animazione: assegna solo il nome condiviso al clic. Vedi il file.
  initLensTransition();
</script>

<script>
  // Apre/chiude i cassetti, anima lo scatter, gestisce la lightbox.
  import "../scripts/memory-drawer.ts";
</script>

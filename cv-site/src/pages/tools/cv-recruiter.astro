---
import "../../styles/global.css";

// Pagina privata, non linkata, esclusa da sitemap.xml e robots.txt (vedi
// astro.config.mjs e public/robots.txt). La pagina resta statica: solo
// /api/cv-recruiter.ts è una funzione serverless. Nessuna Layout.astro qui
// di proposito — niente PostHog/JSON-LD/cursor custom, è un tool interno,
// non una pagina del CV pubblico.
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>CV Recruiter — tool privato</title>
    <style>
      body {
        background: var(--color-bg);
        color: var(--color-text-primary);
        font-family: var(--font-sans);
        min-height: 100dvh;
        padding: 1.5rem 1rem 4rem;
      }
      main {
        max-width: 40rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      h1 {
        font-size: var(--fs-24);
        font-weight: 700;
      }
      p.lead {
        color: var(--color-text-muted);
        font-size: var(--fs-14);
        line-height: 1.5;
      }
      label {
        display: block;
        font-size: var(--fs-12);
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin-bottom: 0.4rem;
      }
      label .optional {
        text-transform: none;
        font-weight: 400;
        opacity: 0.7;
      }
      .field {
        display: flex;
        flex-direction: column;
      }
      input,
      textarea {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-4);
        color: var(--color-text-primary);
        padding: 0.75rem 0.9rem;
        font-size: var(--fs-16);
        width: 100%;
      }
      input[type="file"] {
        padding: 0.6rem 0.7rem;
        font-size: var(--fs-14);
      }
      input:focus,
      textarea:focus,
      button:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
      }
      textarea {
        min-height: 9rem;
        resize: vertical;
        line-height: 1.5;
      }
      #extraContextField {
        display: none;
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      /* Nasconde il campo username senza usare display:none né hidden: i
         password manager ignorano i campi realmente rimossi dal layout, e
         serve invece che restino nel DOM per associare la credenziale. */
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }
      .thumbs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.5rem;
      }
      .thumbs img {
        width: 4.5rem;
        height: 4.5rem;
        object-fit: cover;
        border-radius: var(--radius-4);
        border: 1px solid var(--color-border);
      }
      button[type="submit"] {
        background: var(--color-accent);
        color: var(--color-bg);
        font-weight: 700;
        font-size: var(--fs-16);
        padding: 0.85rem 1.2rem;
        border-radius: var(--radius-4);
        text-align: center;
      }
      button[type="submit"]:disabled {
        opacity: 0.6;
      }
      button.secondary {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        color: var(--color-text-primary);
        font-weight: 600;
        font-size: var(--fs-14);
        padding: 0.75rem 1rem;
        border-radius: var(--radius-4);
        width: 100%;
        text-align: center;
      }
      #status {
        font-size: var(--fs-14);
        color: var(--color-text-muted);
      }
      #result {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      .card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-16);
        padding: 1.1rem 1.25rem;
      }
      .card h2 {
        font-size: var(--fs-18);
        font-weight: 700;
        margin-bottom: 0.6rem;
      }
      .match {
        font-size: var(--fs-40);
        font-weight: 800;
        color: var(--color-accent);
        line-height: 1;
      }
      .anomalies li,
      .strengths li {
        font-size: var(--fs-14);
        line-height: 1.5;
        padding-left: 1rem;
        position: relative;
      }
      .anomalies li::before,
      .strengths li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55rem;
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 50%;
        background: var(--color-accent);
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--fs-12);
      }
      th,
      td {
        text-align: left;
        padding: 0.5rem 0.5rem;
        border-bottom: 1px solid var(--color-border);
        vertical-align: top;
      }
      .severity-high {
        color: #ff8a80;
      }
      .severity-medium {
        color: #ffc266;
      }
      .severity-low {
        color: var(--color-text-muted);
      }
      .actions {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .pdf-note {
        font-size: var(--fs-12);
        color: var(--color-text-muted);
        margin-top: 0.6rem;
      }
      .hidden {
        display: none;
      }
    </style>
  </head>
  <body>
    <main>
      <div>
        <h1>Generatore CV mirato</h1>
        <p class="lead">
          Paese e job description (testo, screenshot, o entrambi): ricevi un report di compatibilità
          e il CV tarato, PDF pronti da scaricare quando il rendering server-side va a buon fine —
          altrimenti solo il JSON, da rendere poi con
          <code>npm run pdf:targeted -- &lt;file.json&gt;</code>.
        </p>
      </div>

      <form id="cv-form">
        {
          /* I password manager (soprattutto iOS Safari e Chrome Android) associano
            una credenziale a una coppia username+password: con il solo campo
            password molti non propongono affatto il salvataggio, ed è proprio il
            salvataggio su mobile il motivo per cui questo campo è un `password`.
            Valore fisso e non modificabile: qui l'utente è sempre lo stesso, serve
            solo a dare un'identità alla credenziale salvata. Fuori dal tab order e
            nascosto agli screen reader perché non è un campo da compilare. */
        }
        <input
          type="text"
          name="username"
          value="cv-recruiter"
          autocomplete="username"
          class="visually-hidden"
          tabindex="-1"
          aria-hidden="true"
          readonly
        />
        <div class="field">
          <label for="passphrase">Passphrase</label>
          <input
            type="password"
            id="passphrase"
            name="password"
            autocomplete="current-password"
            required
          />
        </div>
        <div class="field">
          <label for="country">Paese</label>
          <input
            type="text"
            id="country"
            placeholder="USA, Canada, Germania, Italia…"
            autocomplete="off"
            required
          />
        </div>
        <div class="field">
          <label for="company"
            >Azienda <span class="optional">(opzionale — provo a capirlo da JD/screenshot)</span
            ></label
          >
          <input type="text" id="company" autocomplete="off" />
        </div>
        <div class="field">
          <label for="jobTitle">Titolo ruolo <span class="optional">(opzionale)</span></label>
          <input type="text" id="jobTitle" autocomplete="off" />
        </div>
        <div class="field">
          <label for="jobDescription"
            >Job description <span class="optional"
              >(testo, o lascia vuoto se alleghi screenshot)</span
            ></label
          >
          <textarea id="jobDescription"></textarea>
        </div>
        <div class="field">
          <label for="images"
            >Screenshot annuncio <span class="optional">(opzionale, più immagini)</span></label
          >
          <input type="file" id="images" accept="image/*" multiple />
          <div class="thumbs" id="thumbs"></div>
        </div>
        <div class="field" id="extraContextField">
          <label for="extraContext">Contesto aggiuntivo / risposte alle anomalie</label>
          <textarea id="extraContext"></textarea>
        </div>
        <button type="submit" id="submitBtn">Genera</button>
      </form>

      <p id="status" role="status"></p>

      <div id="result"></div>
    </main>

    <script>
      const form = document.getElementById("cv-form") as HTMLFormElement;
      const passphraseInput = document.getElementById("passphrase") as HTMLInputElement;
      const countryInput = document.getElementById("country") as HTMLInputElement;
      const companyInput = document.getElementById("company") as HTMLInputElement;
      const jobTitleInput = document.getElementById("jobTitle") as HTMLInputElement;
      const jdInput = document.getElementById("jobDescription") as HTMLTextAreaElement;
      const imagesInput = document.getElementById("images") as HTMLInputElement;
      const thumbsEl = document.getElementById("thumbs") as HTMLDivElement;
      const extraContextField = document.getElementById("extraContextField") as HTMLDivElement;
      const extraContextInput = document.getElementById("extraContext") as HTMLTextAreaElement;
      const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
      const statusEl = document.getElementById("status") as HTMLParagraphElement;
      const resultEl = document.getElementById("result") as HTMLDivElement;

      const STORAGE_KEY = "cv-recruiter-passphrase";
      const savedPassphrase = sessionStorage.getItem(STORAGE_KEY);
      if (savedPassphrase) passphraseInput.value = savedPassphrase;

      // Ridimensiona/ricomprime ogni screenshot lato client prima dell'invio:
      // il body della funzione Vercel ha un limite fisso di 4.5MB non
      // aggirabile, e uno screenshot da telefono a piena risoluzione può
      // superarlo da solo. Lato lungo max 1600px, JPEG qualità 0.75.
      async function compressImage(file: File): Promise<{ mimeType: string; data: string }> {
        const bitmap = await createImageBitmap(file);
        const maxSide = 1600;
        const scale = Math.min(1, maxSide / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(bitmap.width * scale);
        canvas.height = Math.round(bitmap.height * scale);
        const ctx = canvas.getContext("2d")!;
        ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        const dataUrl = canvas.toDataURL("image/jpeg", 0.75);
        return { mimeType: "image/jpeg", data: dataUrl.split(",")[1] };
      }

      let compressedImages: Array<{ mimeType: string; data: string }> = [];

      imagesInput.addEventListener("change", async () => {
        const files = Array.from(imagesInput.files ?? []).slice(0, 4);
        thumbsEl.innerHTML = "";
        statusEl.textContent = files.length ? "Comprimo gli screenshot…" : "";
        compressedImages = await Promise.all(files.map(compressImage));
        statusEl.textContent = "";
        for (const img of compressedImages) {
          const el = document.createElement("img");
          el.src = `data:${img.mimeType};base64,${img.data}`;
          thumbsEl.appendChild(el);
        }
      });

      function downloadBlob(filename: string, content: BlobPart, mime: string) {
        const blob = new Blob([content], { type: mime });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
      }

      function downloadBase64(filename: string, base64: string, mime: string) {
        const bytes = Uint8Array.from(atob(base64), (c) => c.charCodeAt(0));
        downloadBlob(filename, bytes, mime);
      }

      function escapeHtml(s: string): string {
        return s.replace(
          /[&<>"']/g,
          (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
        );
      }

      function renderAnomalies(anomalies: string[]) {
        extraContextField.style.display = "flex";
        extraContextField.style.flexDirection = "column";
        resultEl.innerHTML = `
          <div class="card">
            <h2>Prima di generare, chiarisci questi punti</h2>
            <ul class="anomalies">
              ${anomalies.map((a) => `<li>${escapeHtml(a)}</li>`).join("")}
            </ul>
          </div>
        `;
        extraContextInput.focus();
      }

      interface ReportView {
        matchPercentage: number;
        requirementBreakdown: Array<{
          requirement: string;
          weight: string;
          score: string;
          note: string;
        }>;
        strengths: string[];
        painPoints: Array<{ issue: string; severity: string; suggestedAction: string }>;
        salaryEstimate: { text: string; sources: string[] } | null;
        companyProfile: string | null;
      }
      interface CvView {
        file: string;
        lang: "it" | "en";
        _meta: { countryBucket: string };
      }
      interface PdfView {
        designed: string;
        atsDraft: string;
        coverLetter: string | null;
      }
      interface CoverLetterView {
        date: string;
        salutation: string;
        paragraphs: string[];
        closing: string;
      }

      function renderReport(
        report: ReportView,
        cv: CvView,
        insightEntry: string,
        pdf: PdfView | null,
        researchAvailable: boolean,
        coverLetter: CoverLetterView | null,
      ) {
        const breakdownRows = report.requirementBreakdown
          .map(
            (r) => `
              <tr>
                <td>${escapeHtml(r.requirement)}</td>
                <td>${r.weight}</td>
                <td>${r.score}</td>
                <td>${escapeHtml(r.note)}</td>
              </tr>`,
          )
          .join("");

        const painPoints = report.painPoints
          .map(
            (p) => `
              <li class="severity-${p.severity}">
                <strong>${escapeHtml(p.issue)}</strong> (${p.severity}) — ${escapeHtml(p.suggestedAction)}
              </li>`,
          )
          .join("");

        const langLabel = cv.lang === "it" ? "IT" : "EN";

        const salary = report.salaryEstimate
          ? `${escapeHtml(report.salaryEstimate.text)}${
              report.salaryEstimate.sources.length
                ? ` — fonti: ${report.salaryEstimate.sources.map(escapeHtml).join(", ")}`
                : ""
            }`
          : researchAvailable === false
            ? "Ricerca web non disponibile (quota Google Search esaurita sulla chiave Gemini): il resto del report è comunque calcolato sulla job description."
            : "Non stimabile con fonti pubbliche affidabili.";

        resultEl.innerHTML = `
          <div class="card">
            <div class="match">${report.matchPercentage}%</div>
            <p class="lead">Compatibilità con la job description</p>
          </div>
          <div class="card">
            <h2>Requisiti</h2>
            <table>
              <thead><tr><th>Requisito</th><th>Peso</th><th>Score</th><th>Perché</th></tr></thead>
              <tbody>${breakdownRows}</tbody>
            </table>
          </div>
          <div class="card">
            <h2>Punti di forza</h2>
            <ul class="strengths">${report.strengths.map((s: string) => `<li>${escapeHtml(s)}</li>`).join("")}</ul>
          </div>
          <div class="card">
            <h2>Pain point</h2>
            <ul class="anomalies">${painPoints}</ul>
          </div>
          <div class="card">
            <h2>Azienda</h2>
            <p>${report.companyProfile ? escapeHtml(report.companyProfile) : "Profilo non disponibile per questa ricerca."}</p>
          </div>
          <div class="card">
            <h2>Stipendio stimato</h2>
            <p>${salary}</p>
          </div>
          ${
            coverLetter
              ? `<div class="card">
                   <h2>Lettera di presentazione</h2>
                   <p>${escapeHtml(coverLetter.date)}</p>
                   <p style="margin-top:0.75rem">${escapeHtml(coverLetter.salutation)}</p>
                   ${coverLetter.paragraphs.map((p) => `<p style="margin-top:0.75rem">${escapeHtml(p)}</p>`).join("")}
                   <p style="margin-top:0.75rem">${escapeHtml(coverLetter.closing)}</p>
                 </div>`
              : ""
          }
          <div class="actions">
            ${
              pdf
                ? `<button type="button" class="secondary" id="downloadDesigned">Versione ${langLabel} — Grafica</button>
                   <button type="button" class="secondary" id="downloadAts">Versione ${langLabel} — ATS</button>`
                : ""
            }
            ${
              pdf?.coverLetter
                ? `<button type="button" class="secondary" id="downloadCoverLetter">Scarica Cover Letter (PDF)</button>`
                : ""
            }
            <button type="button" class="secondary" id="downloadJson">Scarica JSON CV</button>
            <button type="button" class="secondary" id="saveInsight">Salva voce in memoria</button>
          </div>
          <p class="pdf-note hidden" id="insightStatus"></p>
          ${!pdf ? `<p class="pdf-note">Il rendering PDF server-side non è andato a buon fine questa volta — scarica il JSON e genera il PDF da desktop con <code>npm run pdf:targeted</code>.</p>` : ""}
        `;

        if (pdf) {
          document.getElementById("downloadDesigned")?.addEventListener("click", () => {
            downloadBase64(cv.file, pdf.designed, "application/pdf");
          });
          document.getElementById("downloadAts")?.addEventListener("click", () => {
            downloadBase64(
              cv.file.replace(".pdf", "_ATS_DRAFT.pdf"),
              pdf.atsDraft,
              "application/pdf",
            );
          });
          if (pdf.coverLetter) {
            const coverLetterPdf = pdf.coverLetter;
            document.getElementById("downloadCoverLetter")?.addEventListener("click", () => {
              downloadBase64(
                cv.file.replace(".pdf", "_Cover_Letter.pdf"),
                coverLetterPdf,
                "application/pdf",
              );
            });
          }
        }
        document.getElementById("downloadJson")?.addEventListener("click", () => {
          downloadBlob(
            cv.file.replace(".pdf", ".json"),
            JSON.stringify(cv, null, 2),
            "application/json",
          );
        });
        const saveInsightBtn = document.getElementById("saveInsight") as HTMLButtonElement | null;
        const insightStatusEl = document.getElementById("insightStatus") as HTMLParagraphElement;
        saveInsightBtn?.addEventListener("click", async () => {
          saveInsightBtn.disabled = true;
          insightStatusEl.classList.remove("hidden");
          insightStatusEl.textContent = "Salvataggio in corso…";
          try {
            const res = await fetch("/api/cv-recruiter-insight", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                passphrase: passphraseInput.value,
                bucket: cv._meta.countryBucket,
                insightEntry,
              }),
            });
            const data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.error || `Errore (${res.status}).`);
            }
            saveInsightBtn.textContent = "Salvato in memoria ✓";
            insightStatusEl.textContent = "";
            insightStatusEl.classList.add("hidden");
          } catch (err) {
            insightStatusEl.textContent = `Salvataggio non riuscito (${err instanceof Error ? err.message : "errore"}) — scarico il file per salvarlo a mano.`;
            downloadBlob(`${cv._meta.countryBucket}-insight.md`, insightEntry, "text/markdown");
            saveInsightBtn.disabled = false;
          }
        });
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!jdInput.value.trim() && compressedImages.length === 0) {
          statusEl.textContent =
            "Incolla il testo della job description o allega almeno uno screenshot.";
          return;
        }

        submitBtn.disabled = true;
        statusEl.textContent = "Analisi in corso — può richiedere fino a un minuto…";
        resultEl.innerHTML = "";

        sessionStorage.setItem(STORAGE_KEY, passphraseInput.value);

        try {
          const res = await fetch("/api/cv-recruiter", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              passphrase: passphraseInput.value,
              country: countryInput.value,
              company: companyInput.value,
              jobTitle: jobTitleInput.value,
              jobDescription: jdInput.value,
              extraContext: extraContextInput.value,
              images: compressedImages,
            }),
          });
          const data = await res.json();

          if (!res.ok || !data.ok) {
            statusEl.textContent = data.error || `Errore (${res.status}).`;
            return;
          }

          statusEl.textContent = "";
          if (data.anomalies?.length) {
            renderAnomalies(data.anomalies);
          } else {
            extraContextField.style.display = "none";
            renderReport(
              data.report,
              data.cv,
              data.insightEntry,
              data.pdf,
              data.researchAvailable !== false,
              data.coverLetter,
            );
          }
        } catch {
          statusEl.textContent = "Errore di rete. Riprova.";
        } finally {
          submitBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>

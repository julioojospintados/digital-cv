---
import Layout from '../layouts/Layout.astro';
import { cvData } from '@cv-data';

// ── Skill mode-tag sets ────────────────────────────────────────────────────
const TECH_SKILL_SET = new Set([
  'Angular', 'HTML5', 'CSS / SCSS', 'TypeScript', 'JavaScript', 'Lit',
  'RXJS', 'NGRX', 'WebComponents', 'React', 'Git', 'Bootstrap',
  'Material Design', 'GraphQL', 'SQL', 'Jest', 'Node.js', 'REST API', 'Spring', 'JSF',
]);
const CREATIVE_SKILL_SET = new Set([
  'Figma', 'SEO', 'SEM', 'UX Research', 'Wireframing', 'Video editing',
  'Wordpress', 'Adobe Suite', 'Typography',
]);
const DUAL_SKILL_SET = new Set(['Accessibility / WCAG', 'UX Research', 'Wireframing', 'Figma']);

function skillModeTags(name: string): string {
  const isT = TECH_SKILL_SET.has(name);
  const isC = CREATIVE_SKILL_SET.has(name) || DUAL_SKILL_SET.has(name);
  if (isT && isC) return 'tech creative';
  if (isT) return 'tech';
  if (isC) return 'creative';
  return 'tech creative human';
}

// Pre-compute skill squares
const LEVEL_BORDERS: Record<string, number> = {
  'Base': 1, 'Intermedio': 2, 'Avanzato': 3, 'Esperto': 4,
};
const skillSquares = cvData.technicalSkills.map(skill => ({
  name: skill.name,
  level: skill.level,
  borderPx: LEVEL_BORDERS[skill.level] ?? 1,
  isGlow: skill.level === 'Avanzato' || skill.level === 'Esperto',
  isLarge: skill.level === 'Esperto',
  modeTags: skillModeTags(skill.name),
}));

// ── Experience mode tags (indexed to match cv.ts order) ──────────────────
const EXP_MODE_TAGS = [
  'tech',           // 0 ALTEN Italia
  'creative human', // 1 Music Agency
  'creative',       // 2 Freelance (Videomaker)
  'tech human',     // 3 ForgeLab
  'tech',           // 4 Consoft
  'tech human',     // 5 Satispay
  'human creative', // 6 Festival ed eventi
  'creative',       // 7 Freelance (Fotografo)
];

const featuredExpData = cvData.experience.slice(0, 8).map((exp, i) => ({
  company: exp.company,
  role: exp.role,
  startYear: exp.startDate.substring(0, 4),
  endYear: exp.endDate === 'present' ? 'oggi' : exp.endDate.substring(0, 4),
  location: exp.location ?? '',
  remote: exp.remote ?? false,
  description: exp.description,
  highlights: exp.highlights ?? [],
  skills: exp.skills ?? [],
  modeTags: EXP_MODE_TAGS[i] ?? 'tech creative human',
}));

// ── Soft skills mode tags ─────────────────────────────────────────────────
const SOFT_MODE_TAGS = [
  'human creative',  // Comunicazione efficace
  'creative human',  // Creatività applicata
  'human',           // Adattabilità culturale
  'human',           // Intelligenza relazionale
  'tech human',      // Problem solving laterale
  'tech human',      // Autonomia e ownership
  'human',           // Resilienza
  'creative',        // Sensibilità estetica
  'tech creative human', // Pensiero T-shaped
];

const softSkillsData = cvData.softSkills.map((skill, i) => ({
  name: skill.name,
  description: skill.description ?? '',
  modeTags: SOFT_MODE_TAGS[i] ?? 'tech creative human',
}));

// ── AI Workflow items ────────────────────────────────────────────────────
const aiItems = [
  {
    tool: 'GitHub Copilot',
    title: 'Accelerazione sviluppo Angular enterprise',
    desc: "Generazione di boilerplate NGRX, testing Jest e pattern architetturali ripetitivi, con validazione critica dell'output.",
    impact: '-87% boilerplate',
    tags: 'tech',
  },
  {
    tool: 'ChatGPT / Claude',
    title: 'Prompt Engineering per prototipazione UX',
    desc: 'User personas, flussi di navigazione e scenari di test da brief testuali. Applicato nella fase UX Research IBM.',
    impact: '-90% discovery time',
    tags: 'creative tech',
  },
  {
    tool: 'Claude / GPT-4',
    title: 'Code review e architettura Angular',
    desc: 'Analisi di code smell, refactoring e revisione architetture a microfrontend con LLM come pair reviewer.',
    impact: '-60% debug time',
    tags: 'tech',
  },
  {
    tool: 'Midjourney',
    title: 'Visual exploration per brief UX/UI',
    desc: 'Moodboard e concept visivi veloci per allineare stakeholder prima del wireframing, senza iterazioni costose.',
    impact: '-70% cicli allineamento',
    tags: 'creative',
  },
  {
    tool: 'AI Tools',
    title: 'Copywriting e documentazione tecnica',
    desc: 'SEO copy, varianti A/B per landing page e documentazione tecnica da codice annotato.',
    impact: '+3x velocità contenuti',
    tags: 'creative',
  },
];

// ── Availability badge ───────────────────────────────────────────────────
const availLabel =
  cvData.personal.availability === 'available' ? 'Disponibile subito' :
  cvData.personal.availability === 'open' ? 'Open to opportunities' :
  'Non disponibile';

const availClass =
  cvData.personal.availability === 'available' ? 'badge--green' :
  cvData.personal.availability === 'open' ? 'badge--amber' :
  'badge--gray';

// ── Project mode tags ─────────────────────────────────────────────────────
const PROJECT_TAGS_MAP: Record<string, string> = {
  'Cinema': 'creative',
  'React': 'tech',
  'Lit': 'tech',
  'WebComponents': 'tech',
  'Event management': 'human',
  'Poesia': 'creative human',
  'Creativity': 'creative',
};

const projectsData = cvData.projects.slice(0, 6).map(p => {
  const tags = p.tags ?? [];
  const modes = new Set<string>();
  tags.forEach(t => {
    const mapped = PROJECT_TAGS_MAP[t];
    if (mapped) mapped.split(' ').forEach(m => modes.add(m));
  });
  const modeTags = modes.size > 0 ? Array.from(modes).join(' ') : 'tech creative human';
  return { name: p.name, description: p.description, tags, modeTags };
});
---

<Layout title="CV — Giulio Occhipinti" description="CV interattivo: Senior Frontend Developer, UX Designer, Creative Technologist.">

  <!-- ────────────────────────────────────────────────────────── NAV -->
  <nav class="cv-nav" id="cv-nav" aria-label="Navigazione principale">
    <go-logo></go-logo>
    <div class="mode-buttons" role="group" aria-label="Scegli modalità di visualizzazione">
      <button class="mode-btn" data-nav-mode="tech" type="button" aria-pressed="false">Tech</button>
      <button class="mode-btn" data-nav-mode="creative" type="button" aria-pressed="false">Creative</button>
      <button class="mode-btn" data-nav-mode="human" type="button" aria-pressed="false">Human</button>
    </div>
    <a href="/en/cv" class="cv-nav__lang" aria-label="English version">EN</a>
  </nav>

  <!-- ────────────────────────────────────────────────────────── MAIN -->
  <main class="cv-main" id="main-content">

    <!-- ── HERO ────────────────────────────────────────────────────── -->
    <section class="hero-section" id="hero">
      <div class="hero-badges">
        <span class={`avail-badge ${availClass}`}>{availLabel}</span>
        <span class="loc-badge">{cvData.personal.location}</span>
      </div>
      <h1 class="hero-name" id="hero-name" aria-label={cvData.personal.name}>
        {cvData.personal.name.split('').map((char, i) => (
          <span
            class:list={['hero-char', { 'hero-char--go': i === 0 || i === 7 }]}
          >{char === ' ' ? '\u00A0' : char}</span>
        ))}
      </h1>
      <p class="hero-title">{cvData.personal.title}</p>
      <p class="hero-summary">{cvData.personal.summary}</p>

      <div class="hero-footer">
        <div class="hero-socials">
          {cvData.social.map(s => (
            <a href={s.url} class="social-link" target="_blank" rel="noopener noreferrer">
              {s.platform}
            </a>
          ))}
        </div>
        <div class="hero-langs">
          {cvData.languages.map(l => (
            <span class="lang-chip">
              <b>{l.name}</b>
              <span class="lang-level">{l.level}</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- ── SKILLS BENTO ─────────────────────────────────────────────── -->
    <section class="skills-section reveal delay-100" aria-label="Competenze tecniche">
      <h2 class="section-title">
        <span>Skills</span>
        <span class="section-subtitle">Dimensione e glow proporzionali al livello</span>
      </h2>
      <div class="skills-grid">
        {skillSquares.map(skill => (
          <div
            class={`skill-sq cv-card${skill.isLarge ? ' skill-sq--lg' : ''}${skill.isGlow ? ' skill-sq--glow' : ''}`}
            data-tags={skill.modeTags}
            style={`--skill-border: ${skill.borderPx}px`}
            title={`${skill.name} — ${skill.level}`}
          >
            <span class="skill-sq__name">{skill.name}</span>
            <span class="skill-sq__level">{skill.level.substring(0, 3).toUpperCase()}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ── EXPERIENCE ─────────────────────────────────────────────── -->
    <section class="exp-section reveal delay-200" aria-label="Esperienze lavorative">
      <h2 class="section-title">
        <span>Esperienze</span>
        <span class="section-subtitle">{cvData.experience.length} ruoli in 5 paesi</span>
      </h2>
      <div class="exp-grid">
        {featuredExpData.map(exp => (
          <article class="exp-card cv-card" data-tags={exp.modeTags}>
            <header class="exp-card__header">
              <div class="exp-card__top">
                <span class="exp-card__company">{exp.company}</span>
                <span class="exp-card__dates">{exp.startYear} — {exp.endYear}</span>
              </div>
              <h3 class="exp-card__role">{exp.role}</h3>
              {exp.location && (
                <p class="exp-card__location">{exp.location}{exp.remote ? ' · Remote' : ''}</p>
              )}
            </header>
            <p class="exp-card__desc">{exp.description}</p>
            {exp.highlights.length > 0 && (
              <ul class="exp-card__highlights">
                {exp.highlights.slice(0, 3).map(h => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {exp.skills.length > 0 && (
              <div class="exp-card__skills">
                {exp.skills.slice(0, 7).map(s => (
                  <span class="skill-chip">{s}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- ── AI WORKFLOW ─────────────────────────────────────────────── -->
    <section class="ai-section reveal delay-300" aria-label="AI-Enhanced Workflow">
      <h2 class="section-title">
        <span>AI-Enhanced Workflow</span>
        <span class="section-subtitle">Come l'AI moltiplica l'output senza sostituire il giudizio</span>
      </h2>
      <div class="ai-grid">
        {aiItems.map(item => (
          <div class="ai-card cv-card" data-tags={item.tags}>
            <div class="ai-card__header">
              <span class="ai-card__tool">{item.tool}</span>
              <span class="ai-card__impact">{item.impact}</span>
            </div>
            <h3 class="ai-card__title">{item.title}</h3>
            <p class="ai-card__desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── SOFT SKILLS + METODOLOGIA ───────────────────────────────── -->
    <section class="soft-section reveal" aria-label="Soft skills e metodologia">
      <div class="two-col-grid">
        <!-- Soft skills -->
        <div class="soft-block">
          <h2 class="section-title"><span>Soft Skills</span></h2>
          <ul class="soft-list">
            {softSkillsData.map(skill => (
              <li class="soft-item cv-card" data-tags={skill.modeTags}>
                <span class="soft-item__name">{skill.name}</span>
                <p class="soft-item__desc">{skill.description}</p>
              </li>
            ))}
          </ul>
        </div>
        <!-- Metodologia -->
        <div class="method-block">
          <h2 class="section-title"><span>Mindset</span></h2>
          <ul class="method-list">
            {cvData.methodology.map(m => (
              <li class="method-item cv-card" data-tags="tech creative human">
                <span class="method-item__name">{m.name}</span>
                <p class="method-item__desc">{m.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ── PROJECTS ────────────────────────────────────────────────── -->
    <section class="projects-section reveal" aria-label="Progetti personali">
      <h2 class="section-title"><span>Progetti</span></h2>
      <div class="projects-grid">
        {projectsData.map(project => (
          <div class="project-card cv-card" data-tags={project.modeTags}>
            <h3 class="project-card__name">{project.name}</h3>
            <p class="project-card__desc">{project.description}</p>
            {project.tags.length > 0 && (
              <div class="project-card__tags">
                {project.tags.map(t => (
                  <span class="tag-chip">{t}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ── FORMAZIONE & CERTIFICAZIONI ────────────────────────────── -->
    <section class="edu-section reveal" aria-label="Formazione e certificazioni">
      <div class="two-col-grid">
        <div class="edu-block cv-card" data-tags="tech creative human">
          <h2 class="section-title"><span>Formazione</span></h2>
          <ul class="edu-list">
            {cvData.education.slice(0, 4).map(edu => (
              <li class="edu-item">
                <span class="edu-item__inst">{edu.institution}</span>
                <span class="edu-item__degree">
                  {edu.degree}{edu.field ? ` — ${edu.field}` : ''}
                </span>
                <span class="edu-item__dates">
                  {edu.startDate.substring(0, 4)}–{edu.endDate.substring(0, 4)}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="cert-block cv-card" data-tags="tech creative human">
          <h2 class="section-title"><span>Certificazioni</span></h2>
          <ul class="edu-list">
            {cvData.certifications.map(cert => (
              <li class="edu-item">
                <span class="edu-item__inst">{cert.issuer}</span>
                <span class="edu-item__degree">
                  {cert.name}{cert.inProgress ? ' ↗' : ''}
                </span>
                <span class="edu-item__dates">{cert.date.substring(0, 4)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

  </main>

  <!-- ────────────────────────────────────────────────────────── FOOTER -->
  <footer class="cv-footer">
    <p class="cv-footer__credit">
      Giulio Occhipinti · <a href="mailto:giulio.occhipinti.g@gmail.com">giulio.occhipinti.g@gmail.com</a>
    </p>
    <a href="/" class="cv-footer__back">← Torna all'ingresso</a>
  </footer>

</Layout>

<style>
  /* ── Navigation ─────────────────────────────────────────────── */
  .cv-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    height: 3.25rem;
    background: rgba(8, 73, 67, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .cv-nav__logo {
    text-decoration: none;
  }

  /* go-logo web component in navbar */
  go-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* Placeholder mentre l'elemento non è ancora definito (evita layout shift) */
  go-logo:not(:defined) {
    display: inline-block;
    width: 1.8rem;
    height: 1.2rem;
  }

  .logo-initials {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
    opacity: 0.9;
  }

  .mode-buttons {
    display: flex;
    gap: 0.25rem;
  }

  .mode-btn {
    padding: 0.3rem 0.75rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 1px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .mode-btn:hover,
  .mode-btn.is-active {
    color: var(--color-text-primary);
    border-color: var(--color-accent);
    background: rgba(255, 255, 255, 0.06);
  }

  .mode-btn.is-active {
    color: var(--color-accent);
  }

  .cv-nav__lang {
    padding: 0.3rem 0.75rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 1px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .cv-nav__lang:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent);
    background: rgba(255, 255, 255, 0.06);
  }

  /* ── Main layout ─────────────────────────────────────────────── */
  .cv-main {
    padding-top: 5rem;
    padding-bottom: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  /* ── Section title ────────────────────────────────────────────── */
  .section-title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem 0;
  }

  .section-title > span:first-child {
    color: var(--color-text-primary);
  }

  .section-subtitle {
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: none;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  /* ── Hero ────────────────────────────────────────────────────── */
  /* ── Hero initial state (pre-JS) — prevents flash of visible content ── */
  .hero-section {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 3rem;
    opacity: 0; /* GSAP animates to 1 */
  }

  .hero-badges,
  .hero-title,
  .hero-summary,
  .hero-footer {
    opacity: 0; /* GSAP animates to 1 */
    transform: translateY(14px);
  }

  .hero-badges {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .avail-badge {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 1px;
    border: 1px solid;
  }

  .badge--green {
    color: rgba(0, 220, 140, 1);
    border-color: rgba(0, 220, 140, 0.4);
    background: rgba(0, 220, 140, 0.08);
  }

  .badge--amber {
    color: rgba(255, 190, 80, 1);
    border-color: rgba(255, 190, 80, 0.4);
    background: rgba(255, 190, 80, 0.08);
  }

  .badge--gray {
    color: var(--color-text-muted);
    border-color: var(--color-border);
    background: transparent;
  }

  .loc-badge {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.92;
    color: var(--color-text-primary);
    margin: 0 0 0.75rem 0;
  }

  /* ── Hero name — char animation ─────────── */
  .hero-char {
    display: inline-block;
    white-space: pre;
    opacity: 0;           /* GSAP animates to 1 */
    transform: translateY(18px);
    will-change: transform, opacity;
  }

  .hero-char--go {
    color: var(--color-accent);
  }

  .hero-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.02em;
    margin: 0 0 1.5rem 0;
  }

  .hero-summary {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 72ch;
    margin: 0 0 2rem 0;
  }

  .hero-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .hero-socials {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social-link {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent);
  }

  .hero-langs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .lang-chip {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .lang-chip b {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .lang-level {
    opacity: 0.6;
  }

  /* ── Skills bento ────────────────────────────────────────────── */
  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: flex-end;
  }

  .skill-sq {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    width: 4rem;
    height: 4rem;
    border: var(--skill-border, 1px) solid var(--color-accent);
    border-radius: 2px;
    padding: 0.25rem;
    cursor: default;
    transition:
      opacity var(--duration-state) var(--ease-standard),
      transform var(--duration-state) var(--ease-standard),
      border-color var(--duration-state) var(--ease-standard),
      box-shadow var(--duration-state) var(--ease-standard);
    text-align: center;
  }

  .skill-sq--lg {
    width: 5rem;
    height: 5rem;
  }

  .skill-sq--glow {
    box-shadow: 0 0 8px rgba(0, 0, 0, 0), 0 0 0px var(--color-accent);
  }

  .skill-sq--glow:hover,
  .skill-sq--glow[data-state="active"] {
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .skill-sq__name {
    font-size: 0.5rem;

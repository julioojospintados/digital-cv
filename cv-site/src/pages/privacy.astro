---
import Layout from "../layouts/Layout.astro";
import "../styles/privacy-page.css";
import LangSwitch from "../components/LangSwitch.astro";
import { DEFAULT_MODE, lensPath } from "../lib/cv-i18n";
import { PRIVACY_BACK_LINK } from "../lib/flags";

// Il ritorno va alla lente predefinita, costruito e non scritto a mano: la
// versione italiana puntava ancora a /tech, la predefinita di prima.
const back = lensPath(DEFAULT_MODE, "it");
---

<Layout
  title="Privacy — Giulio Occhipinti"
  description="Informativa privacy del CV digitale di Giulio Occhipinti: quali dati raccoglie il sito, con quali strumenti e come gestire il consenso."
>
  <nav class="privacy-nav">
    <go-logo>GO</go-logo>
    <div class="privacy-nav__right">
      {
        PRIVACY_BACK_LINK && (
          <a href={back} class="privacy-back">
            ← Torna al CV
          </a>
        )
      }
      <LangSwitch locale="it" href="/en/privacy" />
    </div>
  </nav>

  <main class="privacy-main" id="main-content">
    <header class="privacy-hero">
      <p class="privacy-hero__eyebrow">Privacy</p>
      <h1 class="privacy-hero__title">Cosa raccoglie questo sito.</h1>
      <p class="privacy-section__text">
        Poche righe, non un documento legale infinito: questo sito è il mio CV personale, non un
        prodotto commerciale.
      </p>
    </header>

    <section class="privacy-section">
      <h2 class="privacy-section__title">Titolare del trattamento</h2>
      <p class="privacy-section__text">
        Giulio Occhipinti — <a class="privacy-link" href="mailto:giulio.occhipinti.g@gmail.com"
          >giulio.occhipinti.g@gmail.com</a
        >.
      </p>
    </section>

    <section class="privacy-section">
      <h2 class="privacy-section__title">Cosa raccolgo e con cosa</h2>
      <ul class="privacy-list">
        <li>
          <strong>PostHog</strong> — statistiche di navigazione (pagine viste, eventi) e registrazione
          della sessione (session replay, dai 10 secondi in su) per capire dove il sito crea attrito.
          Attivo dal primo caricamento della pagina.
        </li>
        <li>
          <strong>Vercel Analytics &amp; Speed Insights</strong> — statistiche aggregate di traffico e
          performance, dichiarate cookieless dal fornitore: restano attive senza richiedere consenso preventivo.
        </li>
      </ul>
    </section>

    <section class="privacy-section">
      <h2 class="privacy-section__title">Perché</h2>
      <p class="privacy-section__text">
        Solo per capire come si naviga il sito e migliorarne l'usabilità. Nessuna pubblicità,
        nessuna profilazione a scopo commerciale, nessuna vendita di dati a terzi.
      </p>
    </section>

    <section class="privacy-section">
      <h2 class="privacy-section__title">Conservazione</h2>
      <p class="privacy-section__text">
        Il sito è statico: non ho un database mio dove i tuoi dati vengono salvati. Tutto quello che
        viene raccolto resta nei sistemi dei fornitori sopra elencati, secondo i loro tempi di
        conservazione predefiniti.
      </p>
    </section>

    <section class="privacy-section">
      <h2 class="privacy-section__title">I tuoi diritti</h2>
      <p class="privacy-section__text">
        Accesso, rettifica, cancellazione, opposizione: scrivimi all'email sopra e rispondo
        direttamente io. Puoi anche rivolgerti al <a
          class="privacy-link"
          href="https://www.garanteprivacy.it"
          target="_blank"
          rel="noopener noreferrer">Garante per la protezione dei dati personali</a
        >.
      </p>
    </section>
  </main>
</Layout>

<script>
  import "../islands/GoLogo.lit.ts";
</script>

---
import Layout from "../../layouts/Layout.astro";
import WorkDesignSystem from "../../components/WorkDesignSystem.astro";
import { cvData } from "@cv-data";
import "../../styles/work-page.css";

export function getStaticPaths() {
  return cvData.projects.filter((p) => !!p.slug).map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = cvData.projects.find((p) => p.slug === slug)!;

const KNOLL_ICON: Record<string, string> = {
  tech: "laptop.webp",
  creative: "camera.webp",
  human: "plant.webp",
};
const mode = project.primaryMode ?? "tech";
const icon = KNOLL_ICON[mode];
// Rapporto larghezza/altezza reale dei file — riserva lo spazio corretto
// (CLS) prima che l'immagine carichi. Stessa mappa in WorkIndexCard.astro.
const KNOLL_RATIO: Record<string, string> = {
  "laptop.webp": "524 / 476",
  "camera.webp": "327 / 221",
  "plant.webp": "226 / 250",
  "chess.webp": "177 / 274",
  "compass.webp": "208 / 341",
};
const iconRatio = KNOLL_RATIO[icon];
const email =
  cvData.social.find((s) => s.platform === "Email")?.url ?? "mailto:giulio.occhipinti.g@gmail.com";

// Gli step in cv.ts seguono il formato "Ricerca — testo...": il prefisso
// diventa il nome della tappa lungo la strada. Se un giorno uno step non
// avesse il prefisso, resta senza titolo — nessuna rottura.
const SEP = " — ";
const processSteps = (project.process ?? []).map((step) => {
  const i = step.indexOf(SEP);
  return i > 0 && i < 48
    ? { title: step.slice(0, i), body: step.slice(i + SEP.length) }
    : { title: null, body: step };
});
const totalSteps = String(processSteps.length).padStart(2, "0");
---

<Layout
  title={`${project.name} — Case Study — Giulio Occhipinti`}
  description={project.description}
  mode={mode}
  showFab
>
  <nav class="work-nav">
    <go-logo></go-logo>
    <div class="work-nav__right">
      <a href={`/lab/${mode}`} class="work-back">← Torna al CV</a>
      <a href={`/en/work/${slug}`} class="work-lang" lang="en" aria-label="Switch to English">EN</a>
    </div>
  </nav>

  <main class="work-main" id="main-content">
    <header class="work-hero">
      <img
        class="work-hero__icon"
        src={`/knolling/${icon}`}
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        style={`aspect-ratio: ${iconRatio};`}
      />
      <p class="work-hero__eyebrow">Case Study</p>
      <h1 class="work-hero__title">{project.name}</h1>
      {project.role && <p class="work-hero__role">{project.role}</p>}
      {
        project.tags && project.tags.length > 0 && (
          <div class="work-hero__tags">
            {project.tags.map((t) => (
              <span class="work-tag">{t}</span>
            ))}
          </div>
        )
      }
      {
        slug === "digital-cv" && (
          <a href="#design-system" class="work-hero__ds-link">
            Esplora il design system
            <span class="work-chevron work-chevron--down" aria-hidden="true" />
          </a>
        )
      }
    </header>

    <!-- Journey orizzontale: la spina temporale del progetto è la strada —
         Problema (partenza) → step del processo (tappe) → Risultato
         misurabile (arrivo). Senza JS o con reduced-motion resta uno stack
         verticale di sezioni. -->
    {
      processSteps.length > 0 && (
        <section
          class="journey"
          data-journey
          aria-label="Dal problema al risultato: il percorso del progetto"
        >
          <div class="journey__hud" aria-hidden="true">
            <span>
              Step <b data-j-current>00</b>/{totalSteps}
            </span>
            <span class="journey__hud-bar">
              <b data-j-bar />
            </span>
            <span class="journey__hud-km" data-j-km>
              0 m
            </span>
          </div>

          <img
            class="journey__traveler"
            data-j-traveler
            src="/knolling/compass.webp"
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            style="aspect-ratio: 208 / 341;"
          />

          <div class="journey__track" data-j-track>
            <svg
              class="journey__road"
              data-j-road
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path class="journey__road-base" data-j-road-base d="" />
              <path class="journey__road-progress" data-j-road-progress d="" />
            </svg>

            {project.problem && (
              <article class="journey__panel journey__panel--start">
                <img
                  class="journey__stop-icon"
                  data-j-parallax
                  src={`/knolling/${icon}`}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  style={`aspect-ratio: ${iconRatio};`}
                />
                <p class="journey__eyebrow">Partenza</p>
                <h2 class="journey__start-title">Il problema</h2>
                <p class="journey__text">{project.problem}</p>
                <p class="journey__hint" aria-hidden="true">
                  Scrolla per partire <span class="work-chevron" />
                </p>
              </article>
            )}

            {processSteps.map((step, i) => (
              <article class="journey__panel journey__stop" data-stop>
                <p class="journey__step-num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </p>
                <p class="journey__eyebrow">
                  Step {String(i + 1).padStart(2, "0")}/{totalSteps}
                </p>
                {step.title && <h3 class="journey__stop-title">{step.title}</h3>}
                <p class="journey__text">{step.body}</p>
              </article>
            ))}

            {project.outcomes && project.outcomes.length > 0 && (
              <article class="journey__panel journey__panel--end">
                <p class="journey__eyebrow">Arrivo</p>
                <h2 class="journey__end-title">Risultato misurabile</h2>
                <ul class="journey__outcomes">
                  {project.outcomes.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
              </article>
            )}
          </div>
        </section>
      )
    }

    {
      project.decisions && project.decisions.length > 0 && (
        <section class="work-section" aria-labelledby="work-decisions-title">
          <h2 class="work-section__title" id="work-decisions-title">
            Decisioni chiave
          </h2>
          <div class="work-decisions">
            {project.decisions.map((d) => (
              <article class="work-decision">
                <h3 class="work-decision__title">{d.title}</h3>
                <p class="work-decision__body">{d.body}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {slug === "digital-cv" && <WorkDesignSystem lang="it" />}

    {
      project.learnings && project.learnings.length > 0 && (
        <section class="work-section" aria-labelledby="work-learnings-title">
          <h2 class="work-section__title" id="work-learnings-title">
            Cosa ho imparato
          </h2>
          <ul class="work-learnings">
            {project.learnings.map((l) => (
              <li class="work-learnings__item">{l}</li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="work-cta">
      <p class="work-cta__text">Ti interessa lavorare insieme?</p>
      <div class="work-cta__actions">
        <a
          href={email}
          target="_blank"
          rel="noopener"
          class="work-cta__link work-cta__link--primary">Scrivimi</a
        >
        <a href={`/lab/${mode}`} class="work-cta__link work-cta__link--secondary">Torna al CV</a>
      </div>
    </footer>
  </main>
</Layout>

<script>
  import "../../islands/GoLogo.lit.ts";
  import "../../islands/FloatingMenu.lit.ts";
  import "../../scripts/work-journey.ts";
</script>

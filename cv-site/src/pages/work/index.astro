---
import Layout from "../../layouts/Layout.astro";
import { cvData } from "@cv-data";
import "../../styles/work-page.css";

const KNOLL_ICON: Record<string, string> = {
  tech: "laptop.webp",
  creative: "camera.webp",
  human: "plant.webp",
  management: "chess.webp",
};

const caseStudies = cvData.projects.filter((p) => !!p.slug);
const totalStops = String(caseStudies.length).padStart(2, "0");
---

<Layout
  title="Portfolio — Giulio Occhipinti"
  description="Case study: analisi UX/UI, decisioni tecniche e workflow AI-augmented dietro ai progetti di Giulio Occhipinti — dal problema al risultato misurabile."
  showFab
>
  <nav class="work-nav">
    <go-logo></go-logo>
    <div class="work-nav__right">
      <a href="/tech" class="work-back">← Torna al CV</a>
      <a href="/en/work" class="work-lang" lang="en" aria-label="Switch to English">EN</a>
    </div>
  </nav>

  <main class="work-main" id="main-content">
    <header class="work-index-hero">
      <p class="work-hero__eyebrow">Portfolio</p>
      <h1 class="work-index-hero__title">Case study, non un elenco.</h1>
      <p class="work-section__text">
        Ogni progetto qui sotto è raccontato dal problema al risultato misurabile: analisi UX/UI, decisioni tecniche, workflow AI-augmented — tutto ciò che sta dietro al "com'è andata".
      </p>
    </header>

    <!-- Journey orizzontale: scroll verticale → strada da percorrere.
         Senza JS o con reduced-motion resta uno stack verticale di card. -->
    <section class="journey" data-journey aria-label="Percorso dei case study">
      <div class="journey__hud" aria-hidden="true">
        <span>Tappa <b data-j-current>00</b>/{totalStops}</span>
        <span class="journey__hud-bar"><b data-j-bar></b></span>
        <span class="journey__hud-km" data-j-km>0 m</span>
      </div>

      <img
        class="journey__traveler"
        data-j-traveler
        src="/knolling/compass.webp"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />

      <div class="journey__track" data-j-track>
        <svg class="journey__road" data-j-road aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path class="journey__road-base" data-j-road-base d=""></path>
          <path class="journey__road-progress" data-j-road-progress d=""></path>
        </svg>

        <article class="journey__panel journey__panel--start">
          <p class="journey__eyebrow">Partenza</p>
          <p class="journey__go" aria-hidden="true">GO</p>
          <h2 class="journey__start-title">Segui la strada.</h2>
          <p class="journey__text">
            Ogni tappa è un case study: problema, decisioni, risultato misurabile.
          </p>
          <p class="journey__hint" aria-hidden="true">
            Scrolla per partire <span class="work-chevron"></span>
          </p>
        </article>

        {
          caseStudies.map((p, i) => (
            <a class="journey__panel journey__stop" href={`/work/${p.slug}`} data-stop>
              <img
                class="journey__stop-icon"
                data-j-parallax
                src={`/knolling/${KNOLL_ICON[p.primaryMode ?? "tech"]}`}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <p class="journey__eyebrow">Tappa {String(i + 1).padStart(2, "0")}</p>
              <h2 class="journey__stop-name">{p.name}</h2>
              {p.role && <p class="journey__stop-role">{p.role}</p>}
              {p.outcomes?.[0] && <p class="journey__stop-impact">{p.outcomes[0]}</p>}
              <span class="journey__stop-cta">
                Leggi il case study
                <span class="work-chevron" aria-hidden="true" />
              </span>
            </a>
          ))
        }

        <article class="journey__panel journey__panel--end">
          <p class="journey__eyebrow">Prossima tappa</p>
          <h2 class="journey__end-title">Il tuo progetto?</h2>
          <p class="journey__text">La strada continua fuori da questo sito.</p>
          <a class="journey__stop-cta" href="mailto:giulio.occhipinti.g@gmail.com">
            Scrivimi
            <span class="work-chevron" aria-hidden="true"></span>
          </a>
        </article>
      </div>
    </section>
  </main>
</Layout>

<script>
  import "../../islands/GoLogo.lit.ts";
  import "../../islands/FloatingMenu.lit.ts";
  import "../../scripts/work-journey.ts";
</script>

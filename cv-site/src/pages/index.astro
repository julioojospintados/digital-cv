---
import Layout from '../layouts/Layout.astro';
import ContactFooter from '../components/ContactFooter.astro';
import '../styles/index-page.css';
// .work-index-card / .work-chevron — stessa identità visiva della card
// hero-portfolio-card in [mode].astro (vedi sezione Web & UX Designer sotto).
import '../styles/work-page.css';

// Foto in cv-site/public/photos/{trip,belongings} — caricate dall'utente,
// elencate qui a mano perché sono in public/ (import.meta.glob non le vede,
// funziona solo su src/). Usate dai bottoni sotto "Chi sono" (memory-drawer.ts).
const tripPhotos = ["camp", "cave-light", "cave", "family-party", "ha-giang", "hoi-an", "lantern", "river"];
const belongingsPhotos = ["acting", "cheers", "square-festival", "giulia", "kid",  "concerto", "libreria","salone-del-libro", "opera-lirica", "stampa", "reading",  "songwriter", "lettera-natale",  "sunset"];

// Racconto lungo — card "featured" nello scatter, diviso in 2 "pagine" di
// libro (page-flip 3D, memory-drawer.ts). white-space:pre-line in CSS
// preserva i ritmi di riga dentro ogni pagina.
const funFactStoryTitle = "Budapest Drift";
const funFactPage1 = `Mi sono svegliato alle 10:06 a Budapest.
Il mio volo per tornare a casa era alle 11:10.
Ho guardato l'orologio, ho guardato il soffitto…
e la prima cosa che ho fatto è stata bestemmiare in tre lingue.
Sono balzato fuori dal letto, ho chiamato un Uber,
e non appena l'autista ha capito la situazione,
si è trasformato in Fast & Furious: Budapest Drift.
Eravamo io, lui e la mia ansia — che a quel punto aveva ormai la cittadinanza ungherese.
Sono arrivato all'aeroporto; il gate chiudeva alle 10:40.
Sono entrato correndo con lo zaino in spalla che sembravo un bambino delle elementari,
travolgendo carrelli, valigie e, forse, anche dei bambini.
Riuscivo solo a dire "Sorry, sorry, sorry..."
come se fosse una specie di incantesimo magico.
Ai controlli di sicurezza mi hanno chiesto:
"Ha qualcosa da dichiarare?"
E io, nel panico più totale, ho detto: "Sì."
Mi hanno fissato.
"No, no, scusi — niente. Solo un trauma."
Mi hanno fatto togliere le scarpe e la dignità.
Ero lì scalzo, a pregare Zeus.
Poi sono corso verso il gate.
Dagli altoparlanti:
"Ultimo bando per Giulio Occh..."
Ho urlato: "Sono io!" tra un polmone che cedeva e un attacco di panico.`;
const funFactPage2 = `L'assistente di volo, con il suo miglior accento italiano da film, fa:
"Mamma miaaaa Giulio!"
con tanto di gesto con le mani.
Avrei voluto dirle che io non vado in giro a salutare gli ungheresi dicendo
"Ehi Gulash!",
ma non c'era tempo.
Finalmente ho visto la fila al gate e mi sono rilassato —
per quanto ci si possa rilassare dopo aver fatto uno sprint in aeroporto
senza essersi fatti la doccia, lavati i denti o aver fatto la pipì.
Poi, il vuoto:
avevo lasciato il portafoglio ai controlli di sicurezza.
Ho ricominciato a correre, bestemmiando in Dolby Surround.
Per qualche miracolo, ho trovato l'agente che aveva ancora in mano il mio portafoglio.
L'ho afferrato, sono corso di nuovo al gate —
mi hanno fatto passare…
e la porta non si apriva.
A quel punto volevo urlare dentro un megafono.
Alla fine sono salito sull'aereo,
sudato, disidratato, spiritualmente distrutto.
Mi sono seduto, ho chiuso gli occhi e ho pensato:
Dio perdona.
Köszönöm.`;

// Rotazioni fisse (non-modulo, look scatter intenzionale, non casuale ad ogni build)
const SCATTER_ANGLES = [-6, 4, -3, 7, -8, 2, -5, 6, -4, 8, -7, 3, -2, 5];
const scatterAngle = (i: number) => SCATTER_ANGLES[i % SCATTER_ANGLES.length];
---

<Layout title="Giulio Occhipinti — Digital CV" description="CV interattivo di Giulio Occhipinti: UX/UI & Web Designer certificato IBM, Creative Technologist (Angular, Lit, GSAP), AI & Digital Specialist e Project Manager Agile." showFab>

  <!-- Preload LCP image — laptop è l'elemento più largo della knolling-mob (7/15 col) -->
  <link slot="head" rel="preload" as="image" href="/knolling/laptop.webp" fetchpriority="high" media="(max-width: 899px)" />
  <!-- Preload LCP image desktop — megaphone è il più grande (colonna sinistra riga 1) -->
  <link slot="head" rel="preload" as="image" href="/knolling/megaphone.webp" fetchpriority="high" media="(min-width: 900px)" />

  <!-- Anti-flash: su un ritorno in-sessione (intro GO già vista, flag settato
       da index-init.ts o dal click sul logo GO) il preloader non deve mai
       arrivare a schermo. is:inline = esecuzione sincrona durante il parse,
       PRIMA che #preloader qui sotto venga renderizzato — uno script modulo
       partirebbe a bundle già caricato, col GO gigante già visibile. La
       chiave duplica INTRO_SEEN_KEY di scripts/intro-seen.ts (gli inline non
       importano moduli): se cambia là, va cambiata anche qui. -->
  <script is:inline>
    try {
      if (sessionStorage.getItem("go-intro-seen") === "1")
        document.documentElement.setAttribute("data-intro-seen", "");
    } catch (_) {}
  </script>

  <div id="preloader" aria-hidden="true">
    <div class="pre-logo">
      <span id="pre-G" class="pre-go-letter">G</span>
      <span id="pre-O" class="pre-go-letter">O</span>
    </div>
    <div class="pre-bar"></div>
  </div>

  <div class="entry-root" id="entry-root">


    <div class="knolling-stage" id="knolling-stage" aria-hidden="true">
      <img class="knoll-item" data-modes="creative human"  src="/knolling/megaphone.webp"  alt="" loading="eager" fetchpriority="high" decoding="async" style="--kx:7%;--ky:14%;--kr:0deg;--ks:0.82;">
      <img class="knoll-item" data-modes="tech"            src="/knolling/flashlight.webp" alt="" loading="eager" decoding="async" style="--kx:9%;--ky:38%;--kr:0deg;--ks:1.2;--kfx:-1;">
      <img class="knoll-item" data-modes="management"      src="/knolling/multitool.webp"  alt="" loading="eager" decoding="async" style="--kx:7%;--ky:62%;--kr:0deg;--ks:0.85;">
      <img class="knoll-item" data-modes="creative"        src="/knolling/camera.webp"     alt="" loading="eager" decoding="async" style="--kx:7%;--ky:86%;--kr:0deg;--ks:0.8;">
      <img class="knoll-item" data-modes="management"      src="/knolling/chess.webp"      alt="" loading="eager" decoding="async" style="--kx:91%;--ky:14%;--kr:0deg;--ks:0.52;">
      <img class="knoll-item" data-modes="tech"            src="/knolling/laptop.webp"     alt="" loading="eager" decoding="async" style="--kx:91%;--ky:38%;--kr:0deg;--ks:0.75;">
      <img class="knoll-item" data-modes="management"      src="/knolling/compass.webp"    alt="" loading="eager" decoding="async" style="--kx:91%;--ky:62%;--kr:0deg;--ks:0.65;">
      <img class="knoll-item" data-modes="human"           src="/knolling/plant.webp"      alt="" loading="eager" decoding="async" style="--kx:91%;--ky:86%;--kr:0deg;--ks:0.72;">
    </div>


<main class="entry-main" id="main-content">

      <header class="entry-header" id="entry-header">
        <p class="entry-label" id="entry-label">Digital CV</p>
        <h1 class="entry-name" id="entry-name" aria-label="Giulio Occhipinti">
          <span class="name-word" aria-hidden="true">Giulio</span>
          <span class="name-word" aria-hidden="true">Occhipinti</span>
        </h1>
        <p class="entry-tagline" id="entry-tagline">
          Se esiste una verità assoluta, dev'essere molto annoiata.
        </p>
        <p class="entry-cred" id="entry-cred">
          Web Designer · UX/UI · Software Developer · Comunicazione Digitale &amp; AI Workflow
        </p>
      </header>

      <!-- Mobile knolling zone — grid 15 col, 3+5, visible only below 640px -->
      <!-- Riga 1 (4+7+4): Megafono · Laptop · Bussola -->
      <!-- Riga 2 (3×5):   Pianta · Torcia(120°→laptop) · Scacchi · Camera · Multitool -->
      <div class="knolling-mob" aria-hidden="true">
        <div class="knoll-wrap"><img class="knoll-m" data-modes="creative human"  src="/knolling/megaphone.webp"   alt="" loading="eager" decoding="async"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="tech"            src="/knolling/laptop.webp"      alt="" loading="eager" decoding="sync" fetchpriority="high"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="management"      src="/knolling/compass.webp"     alt="" loading="eager" decoding="async"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="human"           src="/knolling/plant.webp"       alt="" loading="eager" decoding="async"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="tech"            src="/knolling/flashlight.webp" alt="" loading="eager" decoding="async"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="management"      src="/knolling/chess.webp"       alt="" loading="eager" decoding="async"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="creative"        src="/knolling/camera.webp"      alt="" loading="eager" decoding="async"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="management"      src="/knolling/multitool.webp"   alt="" loading="eager" decoding="async"></div>
      </div>

      <section class="mode-cards" id="mode-cards" aria-label="Scegli prospettiva">
        <button class="mode-card" data-mode="tech" id="card-tech" type="button">
          <span class="mode-card__label">Software Developer</span>
          <span class="mode-card__desc">Automazione, AI e architetture.</span>
        </button>

        <button class="mode-card" data-mode="creative" id="card-creative" type="button">
          <span class="mode-card__label">Web &amp; UX Designer</span>
          <span class="mode-card__desc">Brand, estetica e interfacce.</span>
        </button>

        <button class="mode-card" data-mode="management" id="card-management" type="button">
          <span class="mode-card__label">Project Manager</span>
          <span class="mode-card__desc">Agile snello e sprint brevi.</span>
        </button>

        <button class="mode-card" data-mode="human" id="card-human" type="button">
          <span class="mode-card__label">AI &amp; Digital Specialist</span>
          <span class="mode-card__desc">Storie, comunicazione e strategia.</span>
        </button>
      </section>

    </main>
  </div>

  <!-- Dot-nav verticale — jump diretto tra i 4 profili, desktop only -->
  <nav class="section-dots" aria-label="Naviga tra i profili">
    <a href="#profile-about" class="section-dot" aria-label="Chi sono"><span class="section-dot__tip">Chi sono</span></a>
    <a href="#profile-tech" class="section-dot" data-mode="tech" aria-label="Software Developer"><span class="section-dot__tip">Software Developer</span></a>
    <a href="#profile-creative" class="section-dot" data-mode="creative" aria-label="Web & UX Designer"><span class="section-dot__tip">Web &amp; UX Designer</span></a>
    <a href="#profile-management" class="section-dot" data-mode="management" aria-label="Project Manager"><span class="section-dot__tip">Project Manager</span></a>
    <a href="#profile-human" class="section-dot" data-mode="human" aria-label="AI & Digital Specialist"><span class="section-dot__tip">AI &amp; Digital Specialist</span></a>
  </nav>

  <!-- ── PROFILE SECTIONS — below hero fold, scrollable ── -->
  <div class="profiles-root" aria-label="Profili professionali">

    <!-- Chi sono — sotto le mode-card, prima delle 4 lenti professionali:
         la persona prima delle maschere. Nessun mode/CTA, non è un quinto
         profilo cliccabile. -->
    <section class="profile-section profile-section--about" id="profile-about">
      <div class="profile-inner">
        <div class="profile-content">
          <h2 class="profile-title">Coltivatore di empatia e battute in tasca.</h2>
          <p class="profile-eyebrow">Chi sono</p>
          <p class="profile-desc">Tantissimi lavori diversi alle spalle, alcune piante in casa e un passaporto ben timbrato. Ho vissuto in tre Stati diversi prima di tornare in Italia, ma sono riuscito a fare il bagno nei tre oceani balneabili, gli altri due sono troppo freddi. Improvvisatore di battute e in viaggio, ho messo radici nel digitale, mantenendo una forte sensibilità, caratteristica che mi fanno notare spesso, verso le persone e se stessi, strizzando l'occhiolino alla poesia e alla fotografia. Attualmente cerco di unire i puntini nel mondo dello sviluppo software, applicando la stessa logica che serve negli scacchi. Gioco cercando la mossa geniale.</p>
          <!-- Etichette d'inventario, non bottoni (bordo dashed, nessun hover):
               fatti concreti da aggancio, non categorie generiche. -->
          <ul class="about-chips" aria-label="Fuori dal codice">
            <li class="about-chip">Film a San Francisco</li>
            <li class="about-chip">Improvvisazione teatrale</li>
            <li class="about-chip">Poesia</li>
            <li class="about-chip">Fotografia</li>
            <li class="about-chip">Scacchi</li>
            <li class="about-chip">Piante d'appartamento</li>
          </ul>
          <div class="about-actions" role="group" aria-label="Scopri di più su di me">
            <button class="about-action" type="button" data-drawer-open="funfact">
              <span class="about-action__icon" aria-hidden="true">✦</span>
              Fun fact
            </button>
            <button class="about-action" type="button" data-drawer-open="belongings">
              <span class="about-action__icon" aria-hidden="true">✦</span>
              Cose mie
            </button>
            <button class="about-action" type="button" data-drawer-open="trip">
              <span class="about-action__icon" aria-hidden="true">✦</span>
              Viaggio
            </button>
          </div>
        </div>
        <div class="profile-deco" aria-hidden="true"><span class="profile-deco__text">IO</span><img class="profile-knoll-img" src="/knolling/plant.webp" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>

    <section class="profile-section" id="profile-tech" data-mode="tech">
      <div class="profile-inner">
        <div class="profile-content">
          <h2 class="profile-title">Automazione,<br>AI e architetture.</h2>
          <p class="profile-eyebrow">Software Developer</p>
          <p class="profile-desc">Metto Angular, Lit e TypeScript al servizio del design: interfacce curate che arrivano in produzione. Costruisco AI workflow e automazione per realtà che vogliono scalare senza assumere un team intero.</p>
          <div class="skills-marquee" aria-hidden="true">
            <div class="skills-marquee__track">
              <span>Angular</span><span>TypeScript</span><span>Lit</span><span>Node.js</span><span>MCP</span><span>AI Workflow</span><span>GSAP</span><span>RxJS</span><span>REST API</span><span>GraphQL</span><span>PostgreSQL</span><span>MongoDB</span><span>Docker</span><span>Git</span><span>Agile</span><span>TDD</span><span>CI/CD</span><span>Microservices</span><span>WebSockets</span><span>PWA</span>
            </div>
          </div>
          <a href="/tech" class="profile-cta">GO to Software Developer </a>
        </div>
        <div class="profile-deco" aria-hidden="true"><span class="profile-deco__text">SD</span><img class="profile-knoll-img" src="/knolling/laptop.webp" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>

    <section class="profile-section" id="profile-creative" data-mode="creative">
      <div class="profile-inner">
        <div class="profile-content">
          <h2 class="profile-title">Brand,<br>estetica e interfacce.</h2>
          <p class="profile-eyebrow">Web &amp; UX Designer</p>
          <p class="profile-desc">Sono certificato IBM e SkillUp in UX/UI Design, con un percorso specifico su Generative AI applicata al design. UX research, wireframing, Figma, design system e animazioni GSAP. Progetto esperienze digitali che uniscono bellezza, usabilità e impatto misurabile sul brand.</p>
          <!-- Stessa identica card hero-portfolio-card di [mode].astro (stesse
               classi, stesso testo) — "Portfolio" vive come eyebrow dentro la
               card, non come link separato sopra. work-index-card--pulse
               (work-page.css) aggiunge bordo accent e pulse CSS con la stessa
               ricetta dei bottoni "GO to…" (.profile-cta). -->
          <a href="/work" class="work-index-card hero-portfolio-card work-index-card--pulse">
            <p class="work-index-card__eyebrow">Portfolio</p>
            <p class="work-index-card__role">Case study, non un elenco.<br/> Nel portfolio racconto il processo completo di ogni progetto: problema, decisioni, risultati misurabili.</p>
            <span class="work-index-card__cta">
              Esplora il portfolio
              <span class="work-chevron" aria-hidden="true"></span>
            </span>
          </a>
          <div class="skills-marquee" aria-hidden="true">
            <div class="skills-marquee__track">
              <span>Figma</span><span>Adobe XD</span><span>Sketch</span><span>UX Research</span><span>Wireframing</span><span>Prototyping</span><span>Design System</span><span>GSAP</span><span>CSS Animations</span><span>Responsive Design</span><span>Accessibility</span><span>Brand Identity</span><span>Typography</span><span>Color Theory</span><span>UI Design</span><span>User Testing</span><span>Photoshop</span><span>Illustrator</span><span>After Effects</span><span>Webflow</span>
            </div>
          </div>
          <a href="/creative" class="profile-cta">GO to Web &amp; UX Designer </a>
        </div>
        <div class="profile-deco" aria-hidden="true"><span class="profile-deco__text">WD</span><img class="profile-knoll-img" src="/knolling/camera.webp" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>

    <section class="profile-section" id="profile-management" data-mode="management">
      <div class="profile-inner">
        <div class="profile-content">
          <h2 class="profile-title">Agile snello<br>e sprint brevi.</h2>
          <p class="profile-eyebrow">Project Manager</p>
          <p class="profile-desc">Lavoro come Partner Tecnico per piccole e grandi realtà. Sprint da 1 a 2 settimane, backlog costruito sul business, impactScore reale a ogni rilascio. Il team diventa autonomo, nessuna dipendenza dal consulente.</p>
          <div class="skills-marquee" aria-hidden="true">
            <div class="skills-marquee__track">
              <span>Agile</span><span>Scrum</span><span>Kanban</span><span>Sprint 1–2 settimane</span><span>Backlog orientato al business</span><span>impactScore</span><span>Jira</span><span>Trello</span><span>Asana</span><span>Facilitatore</span><span>Risk Management</span><span>Budget Planning</span><span>Referente Unico</span><span>Lean</span><span>Rilasci misurabili</span><span>Velocità di rilascio</span><span>Retrospettive</span><span>Daily Standup</span><span>Aziende</span><span>Autonomia del team</span>
            </div>
          </div>
          <a href="/management" class="profile-cta">GO to Project Manager </a>
        </div>
        <div class="profile-deco" aria-hidden="true"><span class="profile-deco__text">PM</span><img class="profile-knoll-img" src="/knolling/chess.webp" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>

    <section class="profile-section" id="profile-human" data-mode="human">
      <div class="profile-inner">
        <div class="profile-content">
          <h2 class="profile-title">Storytelling<br>e strategia.</h2>
          <p class="profile-eyebrow">AI &amp; Digital Specialist</p>
          <p class="profile-desc">L'intelligenza artificiale non sostituirà le persone, ma premierà chi sa governarla. Costruisco workflow automatizzati per aumentare la produttività di un progetto, unendo la tecnica alla narrativa digitale che viene dal mio background nel marketing e nel teatro. Perché il codice senza una storia non va da nessuna parte.</p>
          <div class="skills-marquee" aria-hidden="true">
            <div class="skills-marquee__track">
              <span>Claude</span><span>ChatGPT</span><span>GitHub Copilot</span><span>Prompt Engineering</span><span>AI Workflow</span><span>Automation</span><span>Storytelling</span><span>Content Strategy</span><span>Digital Marketing</span><span>SEO</span><span>Copywriting</span><span>Social Media</span><span>Brand Strategy</span><span>Communication</span><span>Public Speaking</span><span>Theater</span><span>Creative Writing</span><span>Video Editing</span><span>Podcast</span><span>Community Building</span>
            </div>
          </div>
          <a href="/human" class="profile-cta">GO to AI &amp; Digital Specialist </a>
        </div>
        <div class="profile-deco" aria-hidden="true"><span class="profile-deco__text">AI</span><img class="profile-knoll-img" src="/knolling/compass.webp" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>

  </div>

  <!-- Footer contatti — email, LinkedIn e telefono come CTA (ContactFooter),
       stesso blocco delle pagine CV. Prima non c'era nessun contatto in home. -->
  <footer class="entry-footer">
    <ContactFooter lang="it" />
    <p class="entry-footer__credit">Giulio Occhipinti · Digital CV</p>
  </footer>

  <!-- Memory drawers — bottoni "Fun fact / Cose mie / Viaggio" sotto Chi sono.
       <dialog> nativo: focus trap, ESC e backdrop-click gestiti dal browser,
       nessun codice a11y custom da mantenere. Scatter in stile knolling
       animato all'apertura da memory-drawer.ts. data-lenis-prevent: senza,
       Lenis intercetta la rotellina e scrolla la pagina sotto invece del
       contenuto interno del dialog (regola già nota del design system). -->
  <dialog class="memory-dialog memory-dialog--book" id="dialog-funfact" aria-labelledby="dialog-funfact-title" data-lenis-prevent>
    <button class="memory-dialog__close" type="button" data-drawer-close aria-label="Chiudi">✕</button>
    <p class="memory-dialog__eyebrow" id="dialog-funfact-title">Fun fact</p>
    <div class="memory-scatter memory-scatter--facts">
      <article class="memory-fact memory-fact--story" style="--mr:0deg">
        <p class="memory-fact__title">{funFactStoryTitle}</p>
        <div class="story-book" aria-label="Racconto su due pagine, come un libro aperto">
          <div class="story-book__page story-book__page--left">
            <p class="memory-fact__body">{funFactPage1}</p>
            <span class="story-book__pagenum" aria-hidden="true">1</span>
          </div>
          <div class="story-book__spine" aria-hidden="true"></div>
          <div class="story-book__page story-book__page--right">
            <p class="memory-fact__body">{funFactPage2}</p>
            <span class="story-book__pagenum" aria-hidden="true">2</span>
          </div>
        </div>
      </article>
    </div>
  </dialog>

  <dialog class="memory-dialog" id="dialog-belongings" aria-labelledby="dialog-belongings-title" data-lenis-prevent>
    <button class="memory-dialog__close" type="button" data-drawer-close aria-label="Chiudi">✕</button>
    <p class="memory-dialog__eyebrow" id="dialog-belongings-title">Cose mie</p>
    <div class="memory-scatter">
      {belongingsPhotos.map((name, i) => (
        <button type="button" class="memory-photo-btn" aria-label="Espandi la foto">
          <img class="memory-photo" src={`/photos/belongings/${name}.webp`} alt="" loading="lazy" decoding="async" style={`--mr:${scatterAngle(i)}deg`} />
        </button>
      ))}
    </div>
  </dialog>

  <dialog class="memory-dialog" id="dialog-trip" aria-labelledby="dialog-trip-title" data-lenis-prevent>
    <button class="memory-dialog__close" type="button" data-drawer-close aria-label="Chiudi">✕</button>
    <p class="memory-dialog__eyebrow" id="dialog-trip-title">Viaggio</p>
    <div class="memory-scatter">
      {tripPhotos.map((name, i) => (
        <button type="button" class="memory-photo-btn" aria-label="Espandi la foto">
          <img class="memory-photo" src={`/photos/trip/${name}.webp`} alt="" loading="lazy" decoding="async" style={`--mr:${scatterAngle(i)}deg`} />
        </button>
      ))}
    </div>
  </dialog>

  <div id="launch-overlay" aria-hidden="true"></div>

  <!-- Language switch — fixed top-right, hidden until hero reveal -->
  <a href="/en" class="lang-switch" id="lang-switch" aria-label="Switch to English version">EN</a>


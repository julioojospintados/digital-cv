            class="knoll-m"
            data-modes="management"
            src="/knolling/compass.webp"
            alt=""
            loading="eager"
            decoding="async"
            style="aspect-ratio: 208 / 341;"
          />
        </div>
        <div class="knoll-wrap">
          <img

---
import Layout from '../layouts/Layout.astro';
import { cvData } from '@cv-data';

const { personal } = cvData;
---

<Layout
  title={`${personal.name} — Digital CV`}
  description="Scegli come vuoi scoprire il CV di Giulio Occhipinti: modalità Tech, Creative o Human."
>
  <main
    class="min-h-screen flex flex-col items-center justify-center px-6 py-16 gap-12"
    style="background-color: var(--color-bg); color: var(--color-text-primary);"
  >
    <!-- Header -->
    <header class="text-center space-y-3 reveal visible">
      <h1
        class="text-4xl sm:text-5xl font-bold tracking-tight"
        style="color: var(--color-text-primary);"
      >
        {personal.name}
      </h1>
      <p
        class="text-base sm:text-lg italic"
        style="color: var(--color-text-muted);"
      >
        "Chi sei, dipende da come mi guardi."
      </p>
    </header>

    <!-- Mode selection (Lit island) -->
    <entry-portal></entry-portal>

    <!-- Footer hint -->
    <p
      class="text-xs tracking-widest uppercase reveal visible delay-200"
      style="color: var(--color-text-muted); opacity: 0.5;"
    >
      Scegli una prospettiva
    </p>
  </main>
</Layout>

<script>
  import '../islands/EntryPortal.ts';
</script>

  <!-- Memory drawers — bottoni "Fun fact / Cose mie / Viaggio" sotto Chi sono.
       <dialog> nativo: focus trap, ESC e backdrop-click gestiti dal browser,
       nessun codice a11y custom da mantenere. Scatter in stile knolling
       animato all'apertura da memory-drawer.ts. data-lenis-prevent: senza,
       Lenis intercetta la rotellina e scrolla la pagina sotto invece del
       contenuto interno del dialog (regola già nota del design system).
       .memory-dialog__header sta FUORI da .memory-dialog__scroll apposta:
       lo scroll deve restare sul contenuto (testo/foto), mai su tutta la
       modale — memory-drawer.ts inoltra comunque il wheel dall'header al
       contenuto sotto, così scrollare "sulla modale" funziona lo stesso. -->
  <dialog
    class="memory-dialog memory-dialog--reading"
    id="dialog-funfact"
    aria-labelledby="dialog-funfact-title"
    data-lenis-prevent
  >
    <div class="memory-dialog__header">
      <p class="memory-dialog__eyebrow" id="dialog-funfact-title">Fun fact</p>
      <button class="memory-dialog__close" type="button" data-drawer-close aria-label="Chiudi"
        >✕</button
      >
    </div>
    <div class="memory-dialog__scroll">
      <article class="memory-fact memory-fact--story" style="--mr:0deg">
        <p class="memory-fact__title">{funFactStoryTitle}</p>
        <p class="memory-fact__body">{funFactPage1}</p>
        <p class="memory-fact__body">{funFactPage2}</p>
      </article>
    </div>
  </dialog>

  <dialog
    class="memory-dialog"
    id="dialog-belongings"
    aria-labelledby="dialog-belongings-title"
    data-lenis-prevent
  >
    <div class="memory-dialog__header">
      <p class="memory-dialog__eyebrow" id="dialog-belongings-title">Cose mie</p>
      <button class="memory-dialog__close" type="button" data-drawer-close aria-label="Chiudi"
        >✕</button
      >
    </div>
    <div class="memory-dialog__scroll">
      <div class="memory-scatter">
        {
          belongingsPhotos.map((name, i) => (
            <button type="button" class="memory-photo-btn" aria-label="Espandi la foto">
              <img
                class="memory-photo"
                src={`/photos/belongings/${name}.webp`}
                alt=""
                loading="lazy"
                decoding="async"
                style={`--mr:${scatterAngle(i)}deg`}
              />
            </button>
          ))
        }
      </div>
    </div>
  </dialog>

  <dialog
    class="memory-dialog"
    id="dialog-trip"
    aria-labelledby="dialog-trip-title"
    data-lenis-prevent
  >
    <div class="memory-dialog__header">
      <p class="memory-dialog__eyebrow" id="dialog-trip-title">Viaggio</p>
      <button class="memory-dialog__close" type="button" data-drawer-close aria-label="Chiudi"

            style="aspect-ratio: 389 / 393;"
          />
        </div>
        <div class="knoll-wrap">
          <img
            class="knoll-m"
            data-modes="tech"
            src="/knolling/laptop.webp"
            alt=""
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            style="aspect-ratio: 524 / 476;"
          />
        </div>
        <div class="knoll-wrap">

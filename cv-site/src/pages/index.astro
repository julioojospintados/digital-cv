            src="/knolling/plant.webp"
            alt=""
            loading="eager"
            decoding="async"
            style="aspect-ratio: 226 / 250;"
          />
        </div>
        <div class="knoll-wrap">
          <img
            class="knoll-m"
            data-modes="tech"
            src="/knolling/flashlight.webp"
            alt=""
            loading="eager"
            decoding="async"
            style="aspect-ratio: 1187 / 350;"
          />
        </div>
        <div class="knoll-wrap">
          <img
            class="knoll-m"
            data-modes="management"
            src="/knolling/chess.webp"
            alt=""
            loading="eager"
            decoding="async"
            style="aspect-ratio: 177 / 274;"
          />
        </div>
        <div class="knoll-wrap">
          <img
            class="knoll-m"
            data-modes="creative"
            src="/knolling/camera.webp"
            alt=""
            loading="eager"
            decoding="async"
            style="aspect-ratio: 327 / 221;"
          />
        </div>
        <div class="knoll-wrap">
          <img
            class="knoll-m"
            data-modes="management"
            src="/knolling/multitool.webp"
            alt=""
            loading="eager"
            decoding="async"
            style="aspect-ratio: 226 / 293;"
          />
        </div>
      </div>

      <section class="mode-cards" id="mode-cards" aria-label="Scegli prospettiva">
        <button class="mode-card" data-mode="creative" id="card-creative" type="button">
          <span class="mode-card__label">Web &amp; UX Designer</span>
          <span class="mode-card__desc">Brand, estetica e interfacce.</span>
        </button>

        <button class="mode-card" data-mode="tech" id="card-tech" type="button">
          <span class="mode-card__label">Software Developer</span>
          <span class="mode-card__desc">Automazione, AI e architetture.</span>
        </button>

        <button class="mode-card" data-mode="management" id="card-management" type="button">
          <span class="mode-card__label">Project Manager</span>
          <span class="mode-card__desc">Agile snello e sprint brevi.</span>
        </button>

        <button class="mode-card" data-mode="human" id="card-human" type="button">
          <span class="mode-card__label">AI &amp; Digital Specialist</span>
          <span class="mode-card__desc">Storie, comunicazione e strategia.</span>
        </button>
      </section>
    </main>

    <!-- Figlio diretto di #entry-root, non di .entry-main: quest'ultimo ha
         overflow:hidden (blocca la griglia touch a 100svh, "mai oltre il
         viewport" — vedi index-page.css), quindi qualunque figlio suo che
         sfori sarebbe tagliato. Da qui invece scompare da solo appena si
         scrolla oltre l'hero, senza coprire le mode-card: è ancorato al
         fondo di entry-root, non alla viewport (niente position:fixed). -->
    <div class="entry-scroll-cue" aria-hidden="true">Scroll</div>
  </div>

  <!-- Dot-nav verticale — jump diretto tra i 4 profili, desktop only -->
  <nav class="section-dots" aria-label="Naviga tra i profili">
    <a href="#profile-about" class="section-dot" aria-label="Chi sono"
      ><span class="section-dot__tip">Chi sono</span></a

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Giulio Occhipinti — Digital CV" description="CV interattivo di Giulio Occhipinti">


  <div id="preloader" aria-hidden="true">
    <div class="pre-logo">
      <span id="pre-G" class="pre-go-letter">G</span>
      <span id="pre-O" class="pre-go-letter">O</span>
    </div>
    <div class="pre-bar"></div>
  </div>

  <div class="entry-root" id="entry-root">


    <div class="knolling-stage" id="knolling-stage" aria-hidden="true">
      <img class="knoll-item" data-modes="creative human management" src="/knolling/megaphone.png"  alt="" loading="eager" style="--kx:7%;--ky:14%;--kr:0deg;--ks:0.82;">
      <img class="knoll-item" data-modes="tech management"           src="/knolling/flashlight.webp" alt="" loading="eager" style="--kx:9%;--ky:38%;--kr:0deg;--ks:1.2;--kfx:-1;">
      <img class="knoll-item" data-modes="tech creative management"  src="/knolling/multitool.png"  alt="" loading="eager" style="--kx:7%;--ky:62%;--kr:0deg;--ks:0.85;">
      <img class="knoll-item" data-modes="creative management"       src="/knolling/camera.png"     alt="" loading="eager" style="--kx:7%;--ky:86%;--kr:0deg;--ks:0.8;">
      <img class="knoll-item" data-modes="human management"          src="/knolling/chess.png"      alt="" loading="eager" style="--kx:91%;--ky:14%;--kr:0deg;--ks:0.52;">
      <img class="knoll-item" data-modes="tech management"           src="/knolling/laptop.png"     alt="" loading="eager" style="--kx:91%;--ky:38%;--kr:0deg;--ks:0.75;">
      <img class="knoll-item" data-modes="creative human management" src="/knolling/compass.png"    alt="" loading="eager" style="--kx:91%;--ky:62%;--kr:0deg;--ks:0.65;">
      <img class="knoll-item" data-modes="human management"          src="/knolling/plant.png"      alt="" loading="eager" style="--kx:91%;--ky:86%;--kr:0deg;--ks:0.72;">
    </div>


<main class="entry-main" id="main-content">

      <header class="entry-header" id="entry-header">
        <p class="entry-label" id="entry-label">Digital CV</p>
        <h1 class="entry-name" id="entry-name" aria-label="Giulio Occhipinti">
          <span class="name-word" aria-hidden="true">Giulio</span>
          <span class="name-word" aria-hidden="true">Occhipinti</span>
        </h1>
        <p class="entry-tagline" id="entry-tagline">
          "Chi sei, dipende da come mi guardi."
        </p>
      </header>

      <!-- Mobile knolling zone — grid 15 col, 3+5, visible only below 640px -->
      <!-- Riga 1 (4+7+4): Megafono · Laptop · Bussola -->
      <!-- Riga 2 (3×5):   Pianta · Torcia(120°→laptop) · Scacchi · Camera · Multitool -->
      <div class="knolling-mob" aria-hidden="true">
        <div class="knoll-wrap"><img class="knoll-m" data-modes="creative human management" src="/knolling/megaphone.png"   alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="tech management"           src="/knolling/laptop.png"      alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="creative human management" src="/knolling/compass.png"     alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="human management"          src="/knolling/plant.png"       alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="tech management"           src="/knolling/flashlight.webp" alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="human management"          src="/knolling/chess.png"       alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="creative management"       src="/knolling/camera.png"      alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="tech creative management"  src="/knolling/multitool.png"   alt="" loading="eager"></div>
      </div>

      <section class="mode-cards" id="mode-cards" aria-label="Scegli prospettiva">
        <button class="mode-card" data-mode="tech" id="card-tech" type="button">
          <span class="mode-card__label">Tech</span>
          <span class="mode-card__desc">Architetture, codice, sistemi</span>
          <span class="mode-card__go" data-href="/cv?mode=tech" role="link" tabindex="-1" aria-hidden="true"><span class="go-text">GO to Tech</span><span class="go-icon">↗</span></span>
          <span class="hold-indicator" aria-hidden="true"></span>
        </button>

        <button class="mode-card" data-mode="creative" id="card-creative" type="button">
          <span class="mode-card__label">Creative</span>
          <span class="mode-card__desc">Racconto, immagine, suono</span>
          <span class="mode-card__go" data-href="/cv?mode=creative" role="link" tabindex="-1" aria-hidden="true"><span class="go-text">GO to Creative</span><span class="go-icon">↗</span></span>
          <span class="hold-indicator" aria-hidden="true"></span>
        </button>

        <button class="mode-card" data-mode="human" id="card-human" type="button">
          <span class="mode-card__label">Human</span>
          <span class="mode-card__desc">Impatto, relazione, presenza</span>
          <span class="mode-card__go" data-href="/cv?mode=human" role="link" tabindex="-1" aria-hidden="true"><span class="go-text">GO to Human</span><span class="go-icon">↗</span></span>
          <span class="hold-indicator" aria-hidden="true"></span>
        </button>

        <button class="mode-card" data-mode="management" id="card-management" type="button">
          <span class="mode-card__label">Management</span>
          <span class="mode-card__desc">Tradurre la visione in risultati concreti.</span>
          <span class="mode-card__go" data-href="/cv?mode=management" role="link" tabindex="-1" aria-hidden="true"><span class="go-text">GO to Management</span><span class="go-icon">↗</span></span>
          <span class="hold-indicator" aria-hidden="true"></span>
        </button>
      </section>

    </main>
  </div>

  <div id="launch-overlay" aria-hidden="true"></div>

</Layout>

<style>
  /* ── Preloader ── */
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
  }

  .pre-logo {
    display: flex;
    align-items: baseline;
    gap: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--color-text-primary);
  }

  .pre-go-letter {
    display: inline-block;
    will-change: transform, opacity;
  }

  .pre-bar {
    width: 80px;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.12);
    position: relative;
    overflow: hidden;
  }

  .pre-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-text-primary);
    transform: scaleX(0);
    transform-origin: left;
    animation: preBarFill 1.0s cubic-bezier(0.4, 0, 0.2, 1) 0.2s forwards;
  }

  @keyframes preBarFill {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  /* ── Layout root ── */
  .entry-root {
    position: relative;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Knolling stage ── */
  .knolling-stage {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .knoll-item {
    position: absolute;
    left: var(--kx);
    top: var(--ky);
    transform: translate(-50%, -50%) rotate(var(--kr)) scaleX(var(--kfx, 1)) scale(var(--ks));
    width: clamp(80px, 12vw, 200px);
    object-fit: contain;
    opacity: 0;
    scale: 1; /* CSS scale — separato da transform, no conflitto GSAP */
    will-change: transform, opacity, scale;
    transition: filter 0.4s ease, opacity 0.5s ease, scale 0.5s ease;
  }

  .knoll-item.is-dim,
  .knoll-m.is-dim {
    filter: brightness(0.3) saturate(0.4);
    opacity: 0.18 !important;
    scale: 0.92;
  }

  .knoll-item.is-hero,
  .knoll-m.is-hero {
    filter: brightness(1.25) drop-shadow(0 8px 32px rgba(0,0,0,0.6)) saturate(1.1);
    z-index: 1;
    scale: 1.08;
  }

  @keyframes knollLand {
    0%   { opacity: 0; filter: blur(6px) brightness(0.4); }
    100% { opacity: 0.4; filter: none; }
  }

  .knoll-item.do-enter,
  .knoll-m.do-enter {
    animation: knollLand 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: var(--knoll-delay, 0ms);
  }

  /* ── Mobile inline knolling zone — desktop hidden ── */
  .knolling-mob { display: none; }

  @media (max-width: 639px) {
    /* Fixed stage sostituito dalla zona inline — nascosto su mobile */
    .knolling-stage { display: none; }

    /* ── Mobile knolling zone — grid 15 colonne, 2 righe ── */
    .knolling-mob {
      display: grid;
      grid-template-columns: repeat(15, 1fr);
      /* clamp per le altezze riga: proporzionate su tutti i mobile */
      grid-template-rows: 1fr 1fr;
      gap: 3px;
      width: 100%;
      flex: 0 0 auto; /* altezza determinata dalle righe grid */
    }

    .knoll-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: visible;
    }

    /* Riga 1: 4+7+4 = 15 — laptop centrale occupa 47% della larghezza */
    .knoll-wrap:nth-child(1) { grid-column: 1 / 5;   grid-row: 1; } /* megaphone */
    .knoll-wrap:nth-child(2) { grid-column: 5 / 12;  grid-row: 1; } /* laptop — 7 col */
    .knoll-wrap:nth-child(3) { grid-column: 12 / 16; grid-row: 1; } /* compass */

    /* Riga 2: 2+5+2+3+3 = 15 — flashlight dominante, chess e pianta piccoli */
    .knoll-wrap:nth-child(4) { grid-column: 1 / 4;   grid-row: 2; } /* plant — 2 col */
    .knoll-wrap:nth-child(5) { grid-column: 3 / 8;   grid-row: 2; } /* flashlight — 5 col */
    .knoll-wrap:nth-child(6) { grid-column: 7 / 9;  grid-row: 2; } /* chess — 2 col */
    .knoll-wrap:nth-child(7) { grid-column: 9 / 13; grid-row: 2; } /* camera — 3 col */
    .knoll-wrap:nth-child(8) { grid-column: 13 / 16; grid-row: 2; } /* multitool — 3 col */

    /* Immagini: % relative alla cella grid (più stabili di clamp qui) */
    .knoll-m {
      width: 100%;
      height: 100%;
      object-fit: contain;
      opacity: 0; /* GSAP gestisce entrance */
      transition: filter 0.4s ease, opacity 0.5s ease;
      transform-origin: center;
      display: block;
    }

    /* Padding wrapper per controllo visivo dimensione oggetto nella cella */
    .knoll-wrap:nth-child(3) { padding: 0% 10%; }       /* compass — più piccola della cella */
    .knoll-wrap:nth-child(5) { padding-bottom: 5%; }       /* compass — più piccola della cella */
    .knoll-wrap:nth-child(6) { padding: 4%; }        /* plant — leggero margine */
    .knoll-wrap:nth-child(7) { padding: 0% 8%; }  /* chess — piccoli nella cella 2-col */

    /* Torcia: ruotata 120° — luce verso il laptop (in alto a destra) */
    .knoll-wrap:nth-child(5) .knoll-m { transform: rotate(120deg); }
  }

  /* ── Main content ── */
  .entry-main {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 2rem 1.5rem;
    width: 100%;
    max-width: 520px;
  }

  /* Mobile: header + knolling zone + 2×2 cards nella viewport — niente scroll */
  @media (max-width: 639px) {
    .entry-main {
      height: 100svh;
      max-height: 100svh;
      overflow: hidden;
      padding: 1.25rem 1rem 1rem;
      gap: 0.75rem;
      justify-content: flex-start;
    }
  }

  /* ── Header ── */
  .entry-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    opacity: 0; /* GSAP gestisce */
  }

  .entry-label {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .entry-name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.92;
    color: var(--color-text-primary);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Desktop: -10% rispetto al default */
  @media (min-width: 640px) {
    .entry-name {
      font-size: clamp(2.7rem, 9vw, 6.3rem);
    }
  }

  .name-word {
    display: block;
  }

  .name-char {
    display: inline-block;
    will-change: transform;
  }

  /* ── GO initials nel nome — stessa logica di <go-logo> ── */
  .name-go-g,
  .name-go-o {
    transition:
      color 0.35s ease,
      text-shadow 0.35s ease,
      filter 0.35s ease,
      background 0.35s ease;
    will-change: color, text-shadow, filter;
  }

  /* TECH: G brilla cyan */
  #entry-name[data-mode-preview="tech"] .name-go-g {
    color: rgba(0, 255, 200, 1);
    text-shadow:
      0 0 6px rgba(0, 255, 200, 1),
      0 0 18px rgba(0, 255, 200, 0.55),
      0 0 36px rgba(0, 255, 200, 0.2);
  }

  /* CREATIVE: O con gradiente orange animato */
  #entry-name[data-mode-preview="creative"] .name-go-o {
    color: transparent;
    background: linear-gradient(
      135deg,
      rgba(255, 107, 53, 1) 0%,
      rgba(255, 200, 50, 1) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    animation: go-orange-pulse 2.2s ease-in-out infinite;
  }

  /* HUMAN: G e O entrambe gold */
  #entry-name[data-mode-preview="human"] .name-go-g,
  #entry-name[data-mode-preview="human"] .name-go-o {
    color: rgba(240, 200, 127, 1);
    text-shadow:
      0 0 5px rgba(240, 200, 127, 0.6),
      0 0 14px rgba(240, 200, 127, 0.3);
  }

  /* MANAGEMENT: G e O entrambe violet */
  #entry-name[data-mode-preview="management"] .name-go-g,
  #entry-name[data-mode-preview="management"] .name-go-o {
    color: rgba(180, 100, 255, 1);
    text-shadow:
      0 0 6px rgba(180, 100, 255, 1),
      0 0 18px rgba(180, 100, 255, 0.55),
      0 0 36px rgba(180, 100, 255, 0.2);
  }

  @keyframes go-orange-pulse {
    0%, 100% {
      filter: brightness(1) drop-shadow(0 0 0px rgba(255, 107, 53, 0));
    }
    50% {
      filter: brightness(1.3) drop-shadow(0 0 8px rgba(255, 107, 53, 0.75));
    }
  }

  .entry-tagline {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── Mode cards ── */
  .mode-cards {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  @media (max-width: 639px) {
    /* 2×2 knolling tile grid — come oggetti sistemati su tavola */
    .mode-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.4rem;
      flex: 1; /* prende lo spazio rimanente dopo header + zona knolling */
    }
  }

  @media (min-width: 640px) {
    .mode-cards {
      flex-direction: row;
      gap: 1rem;
    }
    .entry-main {
      max-width: 943px;
    }
  }

  /* ── Mode cards: padding ridotto su mobile (2×2 grid) ── */
  @media (max-width: 639px) {
    .mode-card {
      padding: 0.75rem 1rem;
    }
  }

  .mode-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    cursor: pointer;
    text-align: left;
    user-select: none;
    -webkit-user-select: none;
    opacity: 0; /* GSAP gestisce */
    will-change: transform, opacity;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .mode-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(ellipse at 50% 120%, var(--card-glow, transparent) 0%, transparent 70%);
  }

  /* "Launch" light sweep on hover — GO concept */
  .mode-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: -80%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 50%,
      transparent 100%
    );
    transform: skewX(-14deg);
    pointer-events: none;
    transition: left 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: left;
  }

  .mode-card:hover::after {
    left: 180%;
  }

  .mode-card:hover::before,
  .mode-card.is-selected::before {
    opacity: 1;
  }

  .mode-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .mode-card[data-mode="tech"]       { --card-glow: rgba(0, 255, 200, 0.15); }
  .mode-card[data-mode="creative"]   { --card-glow: rgba(255, 107, 53, 0.15); }
  .mode-card[data-mode="human"]      { --card-glow: rgba(240, 200, 127, 0.15); }
  .mode-card[data-mode="management"] { --card-glow: rgba(180, 100, 255, 0.15); }

  .mode-card.is-selected {
    background: rgba(255, 255, 255, 0.09);
  }

  .mode-card[data-mode="tech"].is-selected       { border-color: rgba(0, 255, 200, 0.5); }
  .mode-card[data-mode="creative"].is-selected   { border-color: rgba(255, 107, 53, 0.5); }
  .mode-card[data-mode="human"].is-selected      { border-color: rgba(240, 200, 127, 0.5); }
  .mode-card[data-mode="management"].is-selected { border-color: rgba(180, 100, 255, 0.5); }

  .mode-card.is-passive {
    opacity: 0.3 !important;
    transform: scale(0.96);
  }

  .mode-card__label {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .mode-card__desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Ripple effect su card */
  @keyframes ripple {
    from { transform: scale(0); opacity: 0.4; }
    to   { transform: scale(4); opacity: 0; }
  }

  .ripple {
    position: absolute;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    pointer-events: none;
    animation: ripple 0.6s ease-out forwards;
    transform-origin: center;
  }

  /* ── Mode card GO button — solo desktop, controllato da GSAP ── */
  .mode-card__go {
    display: none;
  }

  @media (min-width: 640px) {
    .mode-card__go {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1.1rem;
      padding: 0.55rem 0.8rem;
      border: 1px solid rgba(212, 168, 55, 0.45);
      border-radius: 2px;
      background: rgba(212, 168, 55, 0.07);
      width: 100%;
      color: #D4A837;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      user-select: none;
      transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .mode-card__go.is-ready {
      pointer-events: auto;
    }

    .mode-card__go.is-ready:hover {
      background: rgba(212, 168, 55, 0.16);
      border-color: rgba(212, 168, 55, 0.75);
      box-shadow: 0 0 16px rgba(212, 168, 55, 0.28);
    }

    .go-icon {
      display: inline-block;
      margin-left: auto;
      font-size: 0.95rem;
      transition: transform 0.22s ease;
    }

    .mode-card__go.is-ready:hover .go-icon {
      transform: translate(4px, -4px);
    }
  }

  /* ── Hold indicator — testo che morpha sulla card durante la pressione ── */
  .hold-indicator {
    position: absolute;
    bottom: 0.5rem;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    opacity: 0;
    pointer-events: none;
    z-index: 5;
  }

  /* ── Launch journey overlay ── */
  #launch-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000;
    pointer-events: none;
    opacity: 0;
    background: rgba(8, 73, 67, 1);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { setMode } from '../islands/stores/modeStore.ts';

  // ── DOM refs ─────────────────────────────────────────────
  const preloader    = document.getElementById('preloader')!;
  const header       = document.getElementById('entry-header')!;
  const nameEl       = document.getElementById('entry-name')!;
  const cards        = document.querySelectorAll<HTMLButtonElement>('.mode-card');
  const knolls       = document.querySelectorAll<HTMLImageElement>('.knoll-item, .knoll-m');

  let selectedMode: string | null = null;

  // ── Split nome in chars individuali — G di Giulio e O di Occhipinti sono le iniziali GO ──
  let firstGChar: HTMLElement | null = null;
  let firstOChar: HTMLElement | null = null;

  document.querySelectorAll<HTMLElement>('.name-word').forEach((word, wi) => {
    const text = word.textContent ?? '';
    word.textContent = '';
    text.split('').forEach((char, ci) => {
      const s = document.createElement('span');
      s.className = 'name-char';
      s.textContent = char === ' ' ? '\u00A0' : char;
      if (wi === 0 && ci === 0) firstGChar = s;
      if (wi === 1 && ci === 0) firstOChar = s;
      word.appendChild(s);
    });
  });

  const allChars   = Array.from(nameEl.querySelectorAll<HTMLElement>('.name-char'));
  const goChars    = [firstGChar, firstOChar].filter((c): c is HTMLElement => c !== null);
  const otherChars = allChars.filter(c => !goChars.includes(c));

  // ── Stato iniziale: tutto nascosto — GSAP gestisce la rivelazione ──────────
  // G e O: partono grandi e in alto (stessa fromTo della hero di cv.astro)
  gsap.set(goChars,   { opacity: 0, scale: 1.8, y: -20 });
  // Resto del nome: 18px sotto (semplice fade-up, senza clip)
  gsap.set(otherChars, { opacity: 0, y: 18 });
  // Label e tagline
  gsap.set(['#entry-label', '#entry-tagline'], { opacity: 0, y: 10 });

  // ── Preloader refs ────────────────────────────────────────────────────────
  const preGEl = document.getElementById('pre-G')!;
  const preOEl = document.getElementById('pre-O')!;

  // La barra CSS impiega 0.2s (delay) + 1.0s (fill) = 1.2s. Partiamo a 1.25s.
  gsap.delayedCall(1.25, () => {
    const tl = gsap.timeline();

    // 1. Glow flash sulle lettere del preloader — identità rivelata
    tl.to([preGEl, preOEl], {
      textShadow: '0 0 40px rgba(255,255,255,0.75)',
      duration: 0.2, stagger: 0.08, ease: 'power2.out',
    });
    tl.to([preGEl, preOEl], {
      textShadow: '0 0 0px transparent',
      duration: 0.15, ease: 'power2.in',
    });

    // 2. Preloader sfuma — G e O si "trasformano" nel nome
    tl.to(preloader, {
      opacity: 0, duration: 0.45, ease: 'power2.inOut',
      onComplete: () => { preloader.style.display = 'none'; },
    });

    // 3. Header torna visibile (era opacity:0 via CSS)
    tl.set(header, { opacity: 1 });

    // 4. G e O "atterrano" nel nome — punch identico alla hero di cv.astro
    tl.fromTo(goChars,
      { opacity: 0, scale: 1.8, y: -20 },
      { opacity: 1, scale: 1, y: 0, duration: 0.55, stagger: 0.18, ease: 'back.out(1.7)' },
      '+=0.02'
    );

    // 5. Glow pulse su G e O nel nome (identico cv.astro)
    tl.to(goChars, {
      textShadow: '0 0 28px rgba(255,255,255,0.65), 0 0 12px rgba(255,255,255,0.4)',
      duration: 0.3, ease: 'power2.out',
    }, '-=0.1');
    tl.to(goChars, {
      textShadow: '0 0 0px transparent',
      duration: 0.65, ease: 'power2.in',
    });

    // 6. "iulio" e "cchipinti" — stagger identico cv.astro hero
    tl.to(otherChars, {
      opacity: 1, y: 0,
      duration: 0.55,
      stagger: { each: 0.05, from: 'start' },
      ease: 'power3.out',
    }, '-=0.55');

    // 7. Tag G e O per il glow mode-reactive (hover sulle card)
    tl.call(() => {
      if (firstGChar) firstGChar.classList.add('name-go-g');
      if (firstOChar) firstOChar.classList.add('name-go-o');
    });

    // 8. Label + tagline
    tl.to(['#entry-label', '#entry-tagline'], {
      opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: 'power3.out',
    }, '-=0.3');

    // 9. Mode cards (GO concept — entrano dal basso)
    tl.fromTo(Array.from(cards),
      { y: 30, opacity: 0, scale: 0.94 },
      { y: 0, opacity: 1, scale: 1, duration: 0.65, stagger: 0.08, ease: 'back.out(1.4)' },
      '-=0.2'
    );

    // 10. Oggetti knolling atterrano sul tavolo
    tl.call(() => {
      knolls.forEach((knoll, i) => {
        knoll.style.setProperty('--knoll-delay', `${i * 65}ms`);
        knoll.classList.add('do-enter');
      });
    });
  });

  // ── Magnetic effect on mode cards ────────────────────────
  cards.forEach((card) => {
    const strength = 12;

    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = (e.clientX - cx) / rect.width * strength;
      const dy = (e.clientY - cy) / rect.height * strength;
      gsap.to(card, { x: dx, y: dy, duration: 0.4, ease: 'power2.out' });
    });

    card.addEventListener('mouseleave', () => {
      if (!card.classList.contains('is-selected')) {
        gsap.to(card, { x: 0, y: 0, scale: 1, duration: 0.5, ease: 'elastic.out(1, 0.4)' });
      }
      // Rimuovi preview mode solo se nessuna card è stata selezionata
      if (!selectedMode) nameEl.removeAttribute('data-mode-preview');
    });

    card.addEventListener('mouseenter', () => {
      if (selectedMode && card.dataset.mode !== selectedMode) return;
      gsap.to(card, { scale: 1.03, duration: 0.3, ease: 'power2.out' });
      // Anteprima: G e O del nome reagiscono come GoLogo
      nameEl.setAttribute('data-mode-preview', card.dataset.mode!);
    });
  });

  // ── Launch journey animation ──────────────────────────────
  function launchJourney(href: string) {
    document.body.style.pointerEvents = 'none';
    const overlay = document.getElementById('launch-overlay')!;
    const cx = window.innerWidth / 2;
    const cy = window.innerHeight / 2;
    const lineCount = 28;
    const lineEls: HTMLElement[] = [];

    for (let i = 0; i < lineCount; i++) {
      const angle = (i / lineCount) * 360;
      const rad   = (angle * Math.PI) / 180;
      const dist  = Math.random() * 60 + 10;
      const len   = Math.random() * 200 + 80;
      const thick = Math.random() * 1.5 + 0.5;
      const line  = document.createElement('div');
      Object.assign(line.style, {
        position:        'fixed',
        left:            `${cx + Math.cos(rad) * dist}px`,
        top:             `${cy + Math.sin(rad) * dist}px`,
        width:           `${len}px`,
        height:          `${thick}px`,
        background:      'rgba(255,255,255,0.12)',
        transform:       `rotate(${angle}deg)`,
        transformOrigin: 'left center',
        opacity:         '0',
        zIndex:          '99997',
        pointerEvents:   'none',
      });
      document.body.appendChild(line);
      lineEls.push(line);
    }

    const journey = gsap.timeline({
      onComplete: () => {
        lineEls.forEach(l => l.remove());
        window.location.href = href;
      },
    });

    // Speed lines sparano verso l'esterno (warp speed)
    // Fase 1: comparsa in 0.5s — rimangono visibili per ~1s totale
    journey.fromTo(lineEls,
      { scaleX: 0, opacity: 0 },
      { scaleX: 1, opacity: 0.85, duration: 0.6, stagger: { each: 0.018, from: 'random' }, ease: 'power2.out' }
    );
    // Fase 2: hold visibile (opacity stabile) per 0.5s prima di sparire
    journey.to(lineEls,
      { opacity: 0.85, duration: 0.5, ease: 'none' },
      '-=0'
    );
    // Fase 3: allontanamento warp e dissolvenza
    journey.to(lineEls,
      { scaleX: 6, opacity: 0, duration: 0.35, stagger: { each: 0.009, from: 'random' }, ease: 'power4.in' },
      '-=0'
    );

    // Il mondo si allontana mentre acceleri (parte dopo che le lines sono pienamente visibili)
    journey.to([header, cards],
      { opacity: 0, scale: 0.85, filter: 'blur(10px)', duration: 0.35, ease: 'power3.in' },
      0.5
    );
    journey.to(knolls,
      { opacity: 0, filter: 'blur(10px)', duration: 0.35, ease: 'power3.in' },
      0.5
    );

    // Vignette scura chiude la scena
    journey.to(overlay,
      { opacity: 1, duration: 0.5, ease: 'power2.inOut' },
      0.9
    );
  }

  // ── Seleziona mode: aggiorna card UI, knolling, modeStore ───────────────
  function selectMode(targetCard: HTMLButtonElement, mode: string) {
    selectedMode = mode;
    setMode(mode as 'tech' | 'creative' | 'human' | 'management');
    nameEl.setAttribute('data-mode-preview', mode);
    cards.forEach(c => {
      const goBtn = c.querySelector<HTMLElement>('.mode-card__go');
      if (c === targetCard) {
        c.classList.add('is-selected'); c.classList.remove('is-passive');
        gsap.to(c, { scale: 1.04, duration: 0.3, ease: 'back.out(2)' });
        if (goBtn) {
          goBtn.setAttribute('tabindex', '0');
          goBtn.removeAttribute('aria-hidden');
          gsap.timeline({ delay: 0.2 })
            .fromTo(goBtn,
              { opacity: 0, y: 28, scale: 0.82 },
              { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: 'back.out(3)',
                onStart: () => goBtn.classList.add('is-ready') }
            )
            .to(goBtn,
              { boxShadow: '0 0 24px 4px rgba(212,168,55,0.45)', duration: 0.28,
                ease: 'power2.out', yoyo: true, repeat: 1 },
              0.5
            );
        }
      } else {
        c.classList.add('is-passive'); c.classList.remove('is-selected');
        gsap.to(c, { scale: 0.96, duration: 0.25, ease: 'power2.out' });
        if (goBtn && goBtn.classList.contains('is-ready')) {
          goBtn.setAttribute('tabindex', '-1');
          goBtn.setAttribute('aria-hidden', 'true');
          gsap.to(goBtn, { opacity: 0, y: 5, duration: 0.2, ease: 'power2.in',
            onComplete: () => goBtn.classList.remove('is-ready') });
        }
      }
    });
    knolls.forEach(img => {
      const modes = img.dataset.modes?.split(' ') ?? [];
      const isRelated = modes.includes(mode);
      img.classList.remove('do-enter');
      img.classList.toggle('is-hero', isRelated);
      img.classList.toggle('is-dim', !isRelated);
      gsap.to(img, { opacity: isRelated ? 0.8 : 0.18, duration: 0.5, ease: 'power2.out' });
    });
  }

  // ── Hold-to-navigate (Pattern E) + click — direttamente sulla card ────────
  const HOLD_DURATION = 1500;
  const HOLD_ACCENT: Record<string, string> = {
    tech:       'rgba(0, 255, 200, 1)',
    creative:   'rgba(255, 107, 53, 1)',
    human:      'rgba(240, 200, 127, 1)',
    management: 'rgba(180, 100, 255, 1)',
  };

  // Rettangolo SVG che si disegna sul bordo della card in senso orario
  function buildSvgArc(card: HTMLElement, color: string) {
    const b = card.getBoundingClientRect();
    const w = b.width - 4, h = b.height - 4; // 2px inset per restare dentro overflow:hidden
    const perim = 2 * (w + h);
    const NS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(NS, 'svg') as SVGSVGElement;
    Object.assign(svg.style, {
      position: 'absolute', inset: '2px',
      width: 'calc(100% - 4px)', height: 'calc(100% - 4px)',
      pointerEvents: 'none', overflow: 'visible', zIndex: '20',
    });
    svg.setAttribute('aria-hidden', 'true');
    const rc = document.createElementNS(NS, 'rect') as SVGRectElement;
    rc.setAttribute('x', '1'); rc.setAttribute('y', '1');
    rc.setAttribute('width', String(w - 2)); rc.setAttribute('height', String(h - 2));
    rc.setAttribute('rx', '2'); rc.setAttribute('fill', 'none');
    rc.setAttribute('stroke', color); rc.setAttribute('stroke-width', '2');
    rc.setAttribute('stroke-dasharray', String(perim));
    rc.setAttribute('stroke-dashoffset', String(perim));
    rc.setAttribute('stroke-linecap', 'round');
    svg.appendChild(rc);
    card.appendChild(svg);
    return {
      svg, rc,
      kill: () => { gsap.killTweensOf(rc); gsap.to(svg, { opacity: 0, duration: 0.25, onComplete: () => svg.remove() }); },
    };
  }

  // ── Per-card: click (selezione) + hold (navigazione Pattern E) ────────────
  cards.forEach((card) => {
    const mode = card.dataset.mode ?? 'tech';
    const href = `/cv?mode=${mode}`;
    const color = HOLD_ACCENT[mode] ?? 'rgba(255,255,255,1)';
    const indicator = card.querySelector<HTMLElement>('.hold-indicator');
    let cancelFn: (() => void) | null = null;
    let holdCompleted = false;

    // Click breve: selezione mode + ripple
    card.addEventListener('click', (e) => {
      if (holdCompleted) { holdCompleted = false; return; }
      const rect = card.getBoundingClientRect();
      const ripple = document.createElement('span');
      ripple.className = 'ripple';
      ripple.style.left = `${(e as MouseEvent).clientX - rect.left - 30}px`;
      ripple.style.top  = `${(e as MouseEvent).clientY - rect.top - 30}px`;
      card.appendChild(ripple);
      ripple.addEventListener('animationend', () => ripple.remove());
      selectMode(card, mode);
    });

    // Hold lungo: bordo SVG che si chiude + text morph → navigate
    function startHold() {
      if (cancelFn) return;
      holdCompleted = false;
      if (!card.classList.contains('is-selected')) selectMode(card, mode);

      const phases = ['●', '●●', '●●●', '→'];
      const step = HOLD_DURATION / (phases.length + 1);
      const pTimers = phases.map((p, i) =>
        setTimeout(() => { if (indicator) indicator.textContent = p; }, step * (i + 1))
      );
      if (indicator) { indicator.textContent = ''; gsap.to(indicator, { opacity: 1, duration: 0.2 }); }

      const { svg, rc, kill } = buildSvgArc(card, color);
      gsap.to(rc, {
        attr: { 'stroke-dashoffset': 0 },
        duration: HOLD_DURATION / 1000, ease: 'none',
        onComplete: () => {
          holdCompleted = true;
          pTimers.forEach(clearTimeout);
          if (indicator) indicator.textContent = '→';
          gsap.to(svg, { opacity: 0, duration: 0.15, onComplete: () => { svg.remove(); launchJourney(href); } });
        },
      });

      cancelFn = () => {
        pTimers.forEach(clearTimeout);
        kill();
        cancelFn = null;
        if (indicator) gsap.to(indicator, { opacity: 0, duration: 0.2, onComplete: () => { if (indicator) indicator.textContent = ''; } });
      };
    }

    function endHold() { if (cancelFn && !holdCompleted) { cancelFn(); } }

    // Hold-to-navigate: SOLO mobile (touch). Desktop usa CTA button.
    card.addEventListener('touchstart', startHold, { passive: true });
    card.addEventListener('touchend', endHold);
    card.addEventListener('touchcancel', endHold);
  });

  // GO button desktop: click → naviga — stopPropagation evita il double-fire con card click
  document.querySelectorAll<HTMLElement>('.mode-card__go').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const href = btn.dataset.href ?? '/cv';
      launchJourney(href);
    });
  });

  // Bfcache restore (swipe-back mobile): forza ricaricamento pulito + replays GO animation
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) window.location.reload();
  });
</script>


    <a
      href="#profile-creative"
      class="section-dot"
      data-mode="creative"
      aria-label="Web & UX Designer"><span class="section-dot__tip">Web &amp; UX Designer</span></a
    >
    <a href="#profile-tech" class="section-dot" data-mode="tech" aria-label="Software Developer"
      ><span class="section-dot__tip">Software Developer</span></a
    >
    <a
      href="#profile-management"
      class="section-dot"
      data-mode="management"
      aria-label="Project Manager"><span class="section-dot__tip">Project Manager</span></a

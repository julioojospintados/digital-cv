---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Giulio Occhipinti — Digital CV" description="CV interattivo di Giulio Occhipinti">


  <div id="preloader" aria-hidden="true">
    <div class="pre-logo">
      <span id="pre-G" class="pre-go-letter">G</span>
      <span id="pre-O" class="pre-go-letter">O</span>
    </div>
    <div class="pre-bar"></div>
  </div>

  <div class="entry-root" id="entry-root">


    <div class="knolling-stage" id="knolling-stage" aria-hidden="true">
      <img class="knoll-item" data-modes="creative human" src="/knolling/megaphone.png"  alt="" loading="eager" style="--kx:7%;--ky:14%;--kr:0deg;--ks:0.82;">
      <img class="knoll-item" data-modes="tech"           src="/knolling/flashlight.webp" alt="" loading="eager" style="--kx:9%;--ky:38%;--kr:0deg;--ks:1.2;--kfx:-1;">
      <img class="knoll-item" data-modes="tech creative"  src="/knolling/multitool.png"  alt="" loading="eager" style="--kx:7%;--ky:62%;--kr:0deg;--ks:0.85;">
      <img class="knoll-item" data-modes="creative"       src="/knolling/camera.png"     alt="" loading="eager" style="--kx:7%;--ky:86%;--kr:0deg;--ks:0.8;">
      <img class="knoll-item" data-modes="human"          src="/knolling/chess.png"      alt="" loading="eager" style="--kx:91%;--ky:14%;--kr:0deg;--ks:0.52;">
      <img class="knoll-item" data-modes="tech"           src="/knolling/laptop.png"     alt="" loading="eager" style="--kx:91%;--ky:38%;--kr:0deg;--ks:0.75;">
      <img class="knoll-item" data-modes="creative human" src="/knolling/compass.png"    alt="" loading="eager" style="--kx:91%;--ky:62%;--kr:0deg;--ks:0.65;">
      <img class="knoll-item" data-modes="human"          src="/knolling/plant.png"      alt="" loading="eager" style="--kx:91%;--ky:86%;--kr:0deg;--ks:0.72;">
    </div>


    <main class="entry-main" id="entry-main">

      <header class="entry-header" id="entry-header">
        <p class="entry-label" id="entry-label">Digital CV</p>
        <h1 class="entry-name" id="entry-name" aria-label="Giulio Occhipinti">
          <span class="name-word" aria-hidden="true">Giulio</span>
          <span class="name-word" aria-hidden="true">Occhipinti</span>
        </h1>
        <p class="entry-tagline" id="entry-tagline">
          "Chi sei, dipende da come mi guardi."
        </p>
      </header>

      <section class="mode-cards" id="mode-cards" aria-label="Scegli prospettiva">
        <button class="mode-card" data-mode="tech" id="card-tech" type="button">
          <span class="mode-card__accent">01</span>
          <span class="mode-card__label">Tech</span>
          <span class="mode-card__desc">Architetture, codice, sistemi</span>
          <span class="mode-card__go" data-href="/cv?mode=tech" role="link" tabindex="-1" aria-hidden="true">
            <span class="go-text">GO to Tech</span>
            <span class="go-icon">↗</span>
          </span>
        </button>

        <button class="mode-card" data-mode="creative" id="card-creative" type="button">
          <span class="mode-card__accent">02</span>
          <span class="mode-card__label">Creative</span>
          <span class="mode-card__desc">Racconto, immagine, suono</span>
          <span class="mode-card__go" data-href="/cv?mode=creative" role="link" tabindex="-1" aria-hidden="true">
            <span class="go-text">GO to Creative</span>
            <span class="go-icon">↗</span>
          </span>
        </button>

        <button class="mode-card" data-mode="human" id="card-human" type="button">
          <span class="mode-card__accent">03</span>
          <span class="mode-card__label">Human</span>
          <span class="mode-card__desc">Impatto, relazione, presenza</span>
          <span class="mode-card__go" data-href="/cv?mode=human" role="link" tabindex="-1" aria-hidden="true">
            <span class="go-text">GO to Human</span>
            <span class="go-icon">↗</span>
          </span>
        </button>
      </section>

    </main>
  </div>

  <div id="launch-overlay" aria-hidden="true"></div>

</Layout>

<style>
  /* ── Preloader ── */
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
  }

  .pre-logo {
    display: flex;
    align-items: baseline;
    gap: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--color-text-primary);
  }

  .pre-go-letter {
    display: inline-block;
    will-change: transform, opacity;
  }

  .pre-bar {
    width: 80px;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.12);
    position: relative;
    overflow: hidden;
  }

  .pre-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-text-primary);
    transform: scaleX(0);
    transform-origin: left;
    animation: preBarFill 1.0s cubic-bezier(0.4, 0, 0.2, 1) 0.2s forwards;
  }

  @keyframes preBarFill {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  /* ── Layout root ── */
  .entry-root {
    position: relative;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Knolling stage ── */
  .knolling-stage {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .knoll-item {
    position: absolute;
    left: var(--kx);
    top: var(--ky);
    transform: translate(-50%, -50%) rotate(var(--kr)) scaleX(var(--kfx, 1)) scale(var(--ks));
    width: clamp(80px, 12vw, 200px);
    object-fit: contain;
    opacity: 0;
    scale: 1; /* CSS scale — separato da transform, no conflitto GSAP */
    will-change: transform, opacity, scale;
    transition: filter 0.4s ease, opacity 0.5s ease, scale 0.5s ease;
  }

  .knoll-item.is-dim {
    filter: brightness(0.3) saturate(0.4);
    opacity: 0.18 !important;
    scale: 0.92;
  }

  .knoll-item.is-hero {
    filter: brightness(1.25) drop-shadow(0 8px 32px rgba(0,0,0,0.6)) saturate(1.1);
    z-index: 1;
    scale: 1.08;
  }

  @keyframes knollLand {
    0%   { opacity: 0; filter: blur(6px) brightness(0.4); }
    100% { opacity: 0.4; filter: none; }
  }

  .knoll-item.do-enter {
    animation: knollLand 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: var(--knoll-delay, 0ms);
  }

  @media (max-width: 639px) {
    .knolling-stage .knoll-item:nth-child(1) {
      left: 8%; top: 16%;
      transform: translate(-50%, -50%) rotate(0deg) scale(0.40);
    }
    .knolling-stage .knoll-item:nth-child(2) {
      left: 8%; top: 33%;
      transform: translate(-50%, -50%) rotate(0deg) scaleX(-1) scale(0.54);
    }
    .knolling-stage .knoll-item:nth-child(3) {
      left: 8%; top: 54%;
      transform: translate(-50%, -50%) rotate(0deg) scale(0.38);
    }
    .knolling-stage .knoll-item:nth-child(4) {
      left: 8%; top: 72%;
      transform: translate(-50%, -50%) rotate(0deg) scale(0.42);
    }
    .knolling-stage .knoll-item:nth-child(5) {
      left: 92%; top: 16%;
      transform: translate(-50%, -50%) rotate(0deg) scale(0.30);
    }
    .knolling-stage .knoll-item:nth-child(6) {
      left: 92%; top: 33%;
      transform: translate(-50%, -50%) rotate(0deg) scale(0.44);
    }
    .knolling-stage .knoll-item:nth-child(7) {
      left: 92%; top: 54%;
      transform: translate(-50%, -50%) rotate(0deg) scale(0.38);
    }
    .knolling-stage .knoll-item:nth-child(8) {
      left: 92%; top: 72%;
      transform: translate(-50%, -50%) rotate(0deg) scale(0.38);
    }
  }

  /* ── Main content ── */
  .entry-main {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 2rem 1.5rem;
    width: 100%;
    max-width: 520px;
  }

  /* ── Header ── */
  .entry-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    opacity: 0; /* GSAP gestisce */
  }

  .entry-label {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .entry-name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.92;
    color: var(--color-text-primary);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .name-word {
    display: block;
    overflow: hidden;
  }

  .name-char {
    display: inline-block;
    will-change: transform;
  }

  .entry-tagline {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── Mode cards ── */
  .mode-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  @media (min-width: 640px) {
    .mode-cards {
      flex-direction: row;
      gap: 1rem;
    }
    .entry-main {
      max-width: 820px;
    }
  }

  .mode-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    cursor: pointer;
    text-align: left;
    opacity: 0; /* GSAP gestisce */
    will-change: transform, opacity;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .mode-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(ellipse at 50% 120%, var(--card-glow, transparent) 0%, transparent 70%);
  }

  /* "Launch" light sweep on hover — GO concept */
  .mode-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: -80%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 50%,
      transparent 100%
    );
    transform: skewX(-14deg);
    pointer-events: none;
    transition: left 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: left;
  }

  .mode-card:hover::after {
    left: 180%;
  }

  .mode-card:hover::before,
  .mode-card.is-selected::before {
    opacity: 1;
  }

  .mode-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .mode-card[data-mode="tech"]     { --card-glow: rgba(0, 255, 200, 0.15); }
  .mode-card[data-mode="creative"] { --card-glow: rgba(255, 107, 53, 0.15); }
  .mode-card[data-mode="human"]    { --card-glow: rgba(240, 200, 127, 0.15); }

  .mode-card.is-selected {
    background: rgba(255, 255, 255, 0.09);
  }

  .mode-card[data-mode="tech"].is-selected     { border-color: rgba(0, 255, 200, 0.5); }
  .mode-card[data-mode="creative"].is-selected { border-color: rgba(255, 107, 53, 0.5); }
  .mode-card[data-mode="human"].is-selected    { border-color: rgba(240, 200, 127, 0.5); }

  .mode-card.is-passive {
    opacity: 0.3 !important;
    transform: scale(0.96);
  }

  .mode-card__accent {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .mode-card__label {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .mode-card__desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Ripple effect su card */
  @keyframes ripple {
    from { transform: scale(0); opacity: 0.4; }
    to   { transform: scale(4); opacity: 0; }
  }

  .ripple {
    position: absolute;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    pointer-events: none;
    animation: ripple 0.6s ease-out forwards;
    transform-origin: center;
  }

  /* ── GO button inside card ── */
  .mode-card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgba(212, 168, 55, 0.45);
    border-radius: 2px;
    background: rgba(212, 168, 55, 0.07);
    width: 100%;
    color: #D4A837;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .mode-card__go.is-ready {
    pointer-events: auto;
  }

  .mode-card__go.is-ready:hover {
    background: rgba(212, 168, 55, 0.16);
    border-color: rgba(212, 168, 55, 0.75);
    box-shadow: 0 0 16px rgba(212, 168, 55, 0.28);
  }

  .go-icon {
    display: inline-block;
    margin-left: auto;
    font-size: 0.95rem;
    transition: transform 0.22s ease;
  }

  .mode-card__go.is-ready:hover .go-icon {
    transform: translate(4px, -4px);
  }

  /* ── Launch journey overlay ── */
  #launch-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000;
    pointer-events: none;
    opacity: 0;
    background: rgba(8, 73, 67, 1);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { setMode } from '../islands/stores/modeStore.ts';

  // ── DOM refs ─────────────────────────────────────────────
  const preloader    = document.getElementById('preloader')!;
  const header       = document.getElementById('entry-header')!;
  const nameEl       = document.getElementById('entry-name')!;
  const cards        = document.querySelectorAll<HTMLButtonElement>('.mode-card');
  const knolls       = document.querySelectorAll<HTMLImageElement>('.knoll-item');

  let selectedMode: string | null = null;

  // ── Split text: track G (Giulio) and O (Occhipinti) as brand initials ───────────
  let firstGChar: HTMLElement | null = null;
  let firstOChar: HTMLElement | null = null;

  document.querySelectorAll<HTMLElement>('.name-word').forEach((word, wi) => {
    const text = word.textContent ?? '';
    word.textContent = '';
    text.split('').forEach((char, ci) => {
      const s = document.createElement('span');
      s.className = 'name-char';
      s.textContent = char === ' ' ? '\u00A0' : char;
      if (wi === 0 && ci === 0) firstGChar = s;
      if (wi === 1 && ci === 0) firstOChar = s;
      word.appendChild(s);
    });
  });

  const allChars   = Array.from(nameEl.querySelectorAll<HTMLElement>('.name-char'));
  const otherChars = allChars.filter(c => c !== firstGChar && c !== firstOChar);

  // ── Initial hidden states ─────────────────────────────────
  // G and O initials: in natural position but invisible (will scale-pop in)
  gsap.set([firstGChar, firstOChar],            { y: '0%', opacity: 0 });
  // Other name chars: clipped below (slide-up via .name-word overflow:hidden)
  gsap.set(otherChars,                          { y: '110%' });
  gsap.set(['#entry-label', '#entry-tagline'],  { opacity: 0, y: 12 });

  // ── GO concept: G e O volano verso le iniziali del nome ──
  const preGEl = document.getElementById('pre-G')!;
  const preOEl = document.getElementById('pre-O')!;

  // La barra CSS impiega 0.2s (delay) + 1.0s (fill) = 1.2s. Partiamo a 1.25s.
  gsap.delayedCall(1.25, () => {
    const glowTl = gsap.timeline();
    glowTl
      .to([preGEl, preOEl], {
        textShadow: '0 0 35px rgba(255,255,255,0.55)',
        duration: 0.18, stagger: 0.06, ease: 'power2.out',
      })
      .to([preGEl, preOEl], { textShadow: 'none', duration: 0.14 })
      .call(() => {
        // Misura le posizioni RUNTIME: pre-G/O e firstGChar/firstOChar
        const preGRect = preGEl.getBoundingClientRect();
        const preORect = preOEl.getBoundingClientRect();
        const gRect    = firstGChar!.getBoundingClientRect();
        const oRect    = firstOChar!.getBoundingClientRect();

        // Delta per portare il centro di pre-G sul centro di firstGChar
        const gDx    = (gRect.left + gRect.width  / 2) - (preGRect.left + preGRect.width  / 2);
        const gDy    = (gRect.top  + gRect.height / 2) - (preGRect.top  + preGRect.height / 2);
        const gScale = gRect.height / preGRect.height;

        const oDx    = (oRect.left + oRect.width  / 2) - (preORect.left + preORect.width  / 2);
        const oDy    = (oRect.top  + oRect.height / 2) - (preORect.top  + preORect.height / 2);
        const oScale = oRect.height / preORect.height;

        // G vola verso la "G" di "Giulio"
        gsap.to(preGEl, {
          x: gDx, y: gDy, scale: gScale, duration: 0.52, ease: 'power3.inOut',
          onComplete: () => {
            gsap.set(header, { opacity: 1 });
            if (firstGChar) gsap.set(firstGChar, { opacity: 1 });
            gsap.set(preGEl, { opacity: 0 });
          },
        });

        // O vola verso la "O" di "Occhipinti" (lieve ritardo)
        gsap.to(preOEl, {
          x: oDx, y: oDy, scale: oScale, duration: 0.52, ease: 'power3.inOut', delay: 0.07,
          onComplete: () => {
            if (firstOChar) gsap.set(firstOChar, { opacity: 1 });
            gsap.set(preOEl, { opacity: 0 });
          },
        });

        // Overlay preloader sfuma mentre le lettere volano
        gsap.to(preloader, {
          opacity: 0, duration: 0.38, delay: 0.22, ease: 'power2.out',
          onComplete: () => { preloader.style.display = 'none'; },
        });

        // Restanti caratteri del nome scivolano su (dopo l'atterraggio di G)
        if (otherChars.length) {
          gsap.fromTo(otherChars, { y: '110%' }, {
            y: '0%', duration: 0.52, stagger: 0.018, ease: 'power4.out', delay: 0.62,
          });
        }

        // Label + tagline
        gsap.fromTo(['#entry-label', '#entry-tagline'], { opacity: 0, y: 12 }, {
          opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: 'power3.out', delay: 0.85,
        });

        // Cards lanciate verso l'alto (GO concept)
        gsap.fromTo(Array.from(cards),
          { y: -40, opacity: 0, scale: 0.94 },
          { y: 0, opacity: 1, scale: 1, duration: 0.65, stagger: 0.08, ease: 'back.out(1.4)', delay: 1.05 }
        );

        // Oggetti knolling atterrano sul tavolo
        gsap.delayedCall(1.25, () => {
          knolls.forEach((knoll, i) => {
            knoll.style.setProperty('--knoll-delay', `${i * 65}ms`);
            knoll.classList.add('do-enter');
          });
        });
      });
  });

  // ── Magnetic effect on mode cards ────────────────────────
  cards.forEach((card) => {
    const strength = 12;

    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = (e.clientX - cx) / rect.width * strength;
      const dy = (e.clientY - cy) / rect.height * strength;
      gsap.to(card, { x: dx, y: dy, duration: 0.4, ease: 'power2.out' });
    });

    card.addEventListener('mouseleave', () => {
      if (!card.classList.contains('is-selected')) {
        gsap.to(card, { x: 0, y: 0, scale: 1, duration: 0.5, ease: 'elastic.out(1, 0.4)' });
      }
    });

    card.addEventListener('mouseenter', () => {
      if (selectedMode && card.dataset.mode !== selectedMode) return;
      gsap.to(card, { scale: 1.03, duration: 0.3, ease: 'power2.out' });
    });
  });

  // ── Launch journey animation ──────────────────────────────
  function launchJourney(href: string) {
    document.body.style.pointerEvents = 'none';
    const overlay = document.getElementById('launch-overlay')!;
    const cx = window.innerWidth / 2;
    const cy = window.innerHeight / 2;
    const lineCount = 28;
    const lineEls: HTMLElement[] = [];

    for (let i = 0; i < lineCount; i++) {
      const angle = (i / lineCount) * 360;
      const rad   = (angle * Math.PI) / 180;
      const dist  = Math.random() * 60 + 10;
      const len   = Math.random() * 200 + 80;
      const thick = Math.random() * 1.5 + 0.5;
      const line  = document.createElement('div');
      Object.assign(line.style, {
        position:        'fixed',
        left:            `${cx + Math.cos(rad) * dist}px`,
        top:             `${cy + Math.sin(rad) * dist}px`,
        width:           `${len}px`,
        height:          `${thick}px`,
        background:      'rgba(255,255,255,0.12)',
        transform:       `rotate(${angle}deg)`,
        transformOrigin: 'left center',
        opacity:         '0',
        zIndex:          '99997',
        pointerEvents:   'none',
      });
      document.body.appendChild(line);
      lineEls.push(line);
    }

    const journey = gsap.timeline({
      onComplete: () => {
        lineEls.forEach(l => l.remove());
        window.location.href = href;
      },
    });

    // Speed lines sparano verso l'esterno (warp speed)
    journey.fromTo(lineEls,
      { scaleX: 0, opacity: 0 },
      { scaleX: 1, opacity: 0.8, duration: 0.25, stagger: { each: 0.008, from: 'random' }, ease: 'power2.out' }
    );
    journey.to(lineEls,
      { scaleX: 6, opacity: 0, duration: 0.45, stagger: { each: 0.006, from: 'random' }, ease: 'power4.in' },
      '-=0.05'
    );

    // Il mondo si allontana mentre acceleri
    journey.to([header, cards],
      { opacity: 0, scale: 0.85, filter: 'blur(10px)', duration: 0.45, ease: 'power3.in' },
      0.05
    );
    journey.to(knolls,
      { opacity: 0, filter: 'blur(10px)', duration: 0.45, ease: 'power3.in' },
      0.05
    );

    // Vignette scura chiude la scena
    journey.to(overlay,
      { opacity: 1, duration: 0.4, ease: 'power2.inOut' },
      0.2
    );
  }

  // ── Click card: selezione mode ────────────────────────────
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      // Se il click viene dal go button, ignora (gestito separatamente)
      if ((e.target as HTMLElement).closest('.mode-card__go')) return;

      const mode = card.dataset.mode as string;
      selectedMode = mode;

      // Ripple
      const rect = card.getBoundingClientRect();
      const ripple = document.createElement('span');
      ripple.className = 'ripple';
      ripple.style.left = `${(e as MouseEvent).clientX - rect.left - 30}px`;
      ripple.style.top  = `${(e as MouseEvent).clientY - rect.top - 30}px`;
      card.appendChild(ripple);
      ripple.addEventListener('animationend', () => ripple.remove());

      setMode(mode as 'tech' | 'creative' | 'human');

      // Animazione card: selected vs passive + GO button
      cards.forEach((c) => {
        const goBtn = c.querySelector<HTMLElement>('.mode-card__go');
        if (c === card) {
          c.classList.add('is-selected');
          c.classList.remove('is-passive');
          gsap.to(c, { scale: 1.04, duration: 0.3, ease: 'back.out(2)' });
          if (goBtn) {
            goBtn.setAttribute('tabindex', '0');
            goBtn.removeAttribute('aria-hidden');
            gsap.timeline({ delay: 0.2 })
              .fromTo(goBtn,
                { opacity: 0, y: 28, scale: 0.82 },
                { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: 'back.out(3)',
                  onStart: () => goBtn.classList.add('is-ready') }
              )
              .to(goBtn,
                { boxShadow: '0 0 24px 4px rgba(212,168,55,0.45)', duration: 0.28,
                  ease: 'power2.out', yoyo: true, repeat: 1 },
                0.5
              );
          }
        } else {
          c.classList.add('is-passive');
          c.classList.remove('is-selected');
          gsap.to(c, { scale: 0.96, duration: 0.25, ease: 'power2.out' });
          if (goBtn && goBtn.classList.contains('is-ready')) {
            goBtn.setAttribute('tabindex', '-1');
            goBtn.setAttribute('aria-hidden', 'true');
            gsap.to(goBtn, { opacity: 0, y: 5, duration: 0.2, ease: 'power2.in',
              onComplete: () => goBtn.classList.remove('is-ready') });
          }
        }
      });

      // Animazione knolling: hero vs dim
      knolls.forEach((img) => {
        const modes = img.dataset.modes?.split(' ') ?? [];
        const isRelated = modes.includes(mode);
        img.classList.toggle('is-hero', isRelated);
        img.classList.toggle('is-dim', !isRelated);
        gsap.to(img, { opacity: isRelated ? 0.9 : 0.18, duration: 0.5, ease: 'power2.out' });
        // scale gestito via CSS class is-hero/is-dim (no conflitto con CSS transform --kfx)
      });
    });
  });

  // ── GO button: lancia il journey ─────────────────────────
  document.querySelectorAll<HTMLElement>('.mode-card__go').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const href = btn.dataset.href ?? '/cv';
      launchJourney(href);
    });
  });

  // Bfcache restore (swipe-back mobile): forza ricaricamento pulito + replays GO animation
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) window.location.reload();
  });
</script>


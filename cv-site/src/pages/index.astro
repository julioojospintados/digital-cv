---
import Layout from "../layouts/Layout.astro";
import ContactFooter from "../components/ContactFooter.astro";
// In standby col badge "ciclo di sistemazione" sotto — richiesta 2026-07-29.
// import { getRecentCommits, formatRecentCommit } from "../lib/recent-commits";
import "../styles/index-page.css";

// Badge "ciclo di sistemazione" — ultimi 3 commit, letti da git in build
// (recent-commits.ts). Niente changelog scritto a mano da tenere aggiornato.
// const recentCommits = getRecentCommits(3);
// .work-index-card / .work-chevron — stessa identità visiva della card
// hero-portfolio-card in [mode].astro (vedi sezione Web & UX Designer sotto).
import "../styles/work-page.css";

// Foto in cv-site/public/photos/{trip,belongings} — caricate dall'utente,
// elencate qui a mano perché sono in public/ (import.meta.glob non le vede,
// funziona solo su src/). Usate dai bottoni sotto "Chi sono" (memory-drawer.ts).
const tripPhotos = [
  "camp",
  "cave-light",
  "cave",
  "family-party",
  "ha-giang",
  "hoi-an",
  "lantern",
  "river",
];
const belongingsPhotos = [
  "acting",
  "cheers",
  "square-festival",
  "giulia",
  "kid",
  "concerto",
  "libreria",
  "salone-del-libro",
  "opera-lirica",
  "stampa",
  "reading",
  "songwriter",
  "lettera-natale",
  "sunset",
];

// Racconto lungo — card "featured" nello scatter, diviso in due paragrafi
// per leggibilità. white-space:pre-line in CSS preserva i ritmi di riga.
const funFactStoryTitle = "Budapest Drift";
const funFactPage1 = `Mi sono svegliato alle 10:06 a Budapest.
Il mio volo per tornare a casa era alle 11:10.
Ho guardato l'orologio, ho guardato il soffitto…
e la prima cosa che ho fatto è stata bestemmiare in tre lingue.
Sono balzato fuori dal letto, ho chiamato un Uber,
e non appena l'autista ha capito la situazione,
si è trasformato in Fast & Furious: Budapest Drift.
Eravamo io, lui e la mia ansia — che a quel punto aveva ormai la cittadinanza ungherese.
Sono arrivato all'aeroporto; il gate chiudeva alle 10:40.
Sono entrato correndo con lo zaino in spalla che sembravo un bambino delle elementari,
travolgendo carrelli, valigie e, forse, anche dei bambini.
Riuscivo solo a dire "Sorry, sorry, sorry..."
come se fosse una specie di incantesimo magico.
Ai controlli di sicurezza mi hanno chiesto:
"Ha qualcosa da dichiarare?"
E io, nel panico più totale, ho detto: "Sì."
Mi hanno fissato.
"No, no, scusi — niente. Solo un trauma."
Mi hanno fatto togliere le scarpe e la dignità.
Ero lì scalzo, a pregare Zeus.
Poi sono corso verso il gate.
Dagli altoparlanti:
"Ultimo bando per Giulio Occh..."
Ho urlato: "Sono io!" tra un polmone che cedeva e un attacco di panico.`;
const funFactPage2 = `L'assistente di volo, con il suo miglior accento italiano da film, fa:
"Mamma miaaaa Giulio!"
con tanto di gesto con le mani.
Avrei voluto dirle che io non vado in giro a salutare gli ungheresi dicendo
"Ehi Gulash!",
ma non c'era tempo.
Finalmente ho visto la fila al gate e mi sono rilassato —
per quanto ci si possa rilassare dopo aver fatto uno sprint in aeroporto
senza essersi fatti la doccia, lavati i denti o aver fatto la pipì.
Poi, il vuoto:
avevo lasciato il portafoglio ai controlli di sicurezza.
Ho ricominciato a correre, bestemmiando in Dolby Surround.
Per qualche miracolo, ho trovato l'agente che aveva ancora in mano il mio portafoglio.
L'ho afferrato, sono corso di nuovo al gate —
mi hanno fatto passare…
e la porta non si apriva.
A quel punto volevo urlare dentro un megafono.
Alla fine sono salito sull'aereo,
sudato, disidratato, spiritualmente distrutto.
Mi sono seduto, ho chiuso gli occhi e ho pensato:
Dio perdona.
Köszönöm.`;

// Rotazioni fisse (non-modulo, look scatter intenzionale, non casuale ad ogni build)
const SCATTER_ANGLES = [-6, 4, -3, 7, -8, 2, -5, 6, -4, 8, -7, 3, -2, 5];
const scatterAngle = (i: number) => SCATTER_ANGLES[i % SCATTER_ANGLES.length];
---

<Layout
  title="Giulio Occhipinti — Digital CV"
  description="CV interattivo di Giulio Occhipinti: UX/UI & Web Designer certificato IBM, Creative Technologist (Angular, Lit, GSAP), AI & Digital Specialist e Project Manager Agile."
  showFab
  consentBannerWaitForWip
>
  <!-- Preload LCP image — laptop è l'elemento più largo della knolling-mob (7/15 col) -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/knolling/laptop.webp"
    fetchpriority="high"
    media="(max-width: 899px)"
  />
  <!-- Preload LCP image desktop — megaphone è il più grande (colonna sinistra riga 1) -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/knolling/megaphone.webp"
    fetchpriority="high"
    media="(min-width: 900px)"
  />

  <!-- Anti-flash: su un ritorno in-sessione (intro GO già vista, flag settato
       da index-init.ts o dal click sul logo GO) il preloader non deve mai
       arrivare a schermo. is:inline = esecuzione sincrona durante il parse,
       PRIMA che #preloader qui sotto venga renderizzato — uno script modulo
       partirebbe a bundle già caricato, col GO gigante già visibile. La
       chiave duplica INTRO_SEEN_KEY di scripts/intro-seen.ts (gli inline non
       importano moduli): se cambia là, va cambiata anche qui. -->
  <script is:inline>
    try {
      if (sessionStorage.getItem("go-intro-seen") === "1")
        document.documentElement.setAttribute("data-intro-seen", "");
    } catch (_) {}
  </script>

  <div id="preloader" aria-hidden="true">
    <div class="pre-logo">
      <span id="pre-G" class="pre-go-letter">G</span>
      <span id="pre-O" class="pre-go-letter">O</span>
    </div>
    <div class="pre-bar"></div>
  </div>

  <div class="entry-root" id="entry-root">
    <div class="knolling-stage" id="knolling-stage" aria-hidden="true">
      <img
        class="knoll-item"
        data-modes="creative human"
        src="/knolling/megaphone.webp"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style="--kx:7%;--ky:14%;--kr:0deg;--ks:0.82;aspect-ratio:389 / 393;"
      />
      <img
        class="knoll-item"
        data-modes="tech"
        src="/knolling/flashlight.webp"
        alt=""
        loading="eager"
        decoding="async"
        style="--kx:9%;--ky:38%;--kr:0deg;--ks:1.2;--kfx:-1;aspect-ratio:1187 / 350;"
      />
      <img
        class="knoll-item"
        data-modes="management"
        src="/knolling/multitool.webp"
        alt=""
        loading="eager"
        decoding="async"
        style="--kx:7%;--ky:62%;--kr:0deg;--ks:0.85;aspect-ratio:226 / 293;"
      />
      <img
        class="knoll-item"
        data-modes="creative"
        src="/knolling/camera.webp"
        alt=""
        loading="eager"
        decoding="async"
        style="--kx:7%;--ky:86%;--kr:0deg;--ks:0.8;aspect-ratio:327 / 221;"
      />
      <img
        class="knoll-item"
        data-modes="management"
        src="/knolling/chess.webp"
        alt=""
        loading="eager"
        decoding="async"
        style="--kx:91%;--ky:14%;--kr:0deg;--ks:0.52;aspect-ratio:177 / 274;"
      />
      <img
        class="knoll-item"
        data-modes="tech"
        src="/knolling/laptop.webp"
        alt=""
        loading="eager"
        decoding="async"
        style="--kx:91%;--ky:38%;--kr:0deg;--ks:0.75;aspect-ratio:524 / 476;"
      />
      <img
        class="knoll-item"
        data-modes="management"
        src="/knolling/compass.webp"
        alt=""
        loading="eager"
        decoding="async"
        style="--kx:91%;--ky:62%;--kr:0deg;--ks:0.65;aspect-ratio:208 / 341;"
      />
      <img
        class="knoll-item"
        data-modes="human"
        src="/knolling/plant.webp"
        alt=""
        loading="eager"
        decoding="async"
        style="--kx:91%;--ky:86%;--kr:0deg;--ks:0.72;aspect-ratio:226 / 250;"
      />
    </div>

    <main class="entry-main" id="main-content">
      <header class="entry-header" id="entry-header">
        <p class="entry-label" id="entry-label">Digital CV</p>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Giulio Occhipinti — Digital CV" description="CV interattivo di Giulio Occhipinti">

  <!-- ── PRELOADER ──────────────────────────────────────────── -->
  <div id="preloader" aria-hidden="true">
    <p class="pre-name">GO</p>
    <div class="pre-bar"></div>
  </div>

  <!-- ── SCROLL PROGRESS ────────────────────────────────────── -->
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <div class="entry-root" id="entry-root">

    <!-- ── KNOLLING STAGE (immagini sullo sfondo) ──────────── -->
    <div class="knolling-stage" id="knolling-stage" aria-hidden="true">
      <!-- Ogni oggetto ha: data-modes (spazio-separati), posizione CSS fissa, rotazione fissa -->
      <img class="knoll-item" data-modes="tech"           src="/knolling/laptop.png"     alt="" loading="eager" style="--kx:50%;--ky:74%;--kr:-1deg;--ks:0.9;">
      <img class="knoll-item" data-modes="tech"           src="/knolling/flashlight.png" alt="" loading="eager" style="--kx:14%;--ky:28%;--kr:0deg;--ks:0.88;">
      <img class="knoll-item" data-modes="tech creative"  src="/knolling/multitool.png"  alt="" loading="eager" style="--kx:82%;--ky:32%;--kr:-14deg;--ks:0.75;">
      <img class="knoll-item" data-modes="creative"       src="/knolling/camera.png"     alt="" loading="eager" style="--kx:18%;--ky:68%;--kr:7deg;--ks:0.9;">
      <img class="knoll-item" data-modes="creative human" src="/knolling/megaphone.png"  alt="" loading="eager" style="--kx:78%;--ky:70%;--kr:-8deg;--ks:0.8;">
      <img class="knoll-item" data-modes="human"          src="/knolling/chess.png"      alt="" loading="eager" style="--kx:12%;--ky:20%;--kr:-12deg;--ks:0.3;">
      <img class="knoll-item" data-modes="human"          src="/knolling/plant.png"      alt="" loading="eager" style="--kx:10%;--ky:82%;--kr:-4deg;--ks:0.7;">
      <img class="knoll-item" data-modes="creative human" src="/knolling/compass.png"    alt="" loading="eager" style="--kx:88%;--ky:13%;--kr:18deg;--ks:0.62;">
    </div>

    <!-- ── CONTENUTO PRINCIPALE ────────────────────────────── -->
    <main class="entry-main" id="entry-main">

      <!-- Header -->
      <header class="entry-header" id="entry-header">
        <p class="entry-label" id="entry-label">Portfolio interattivo</p>
        <h1 class="entry-name" id="entry-name" aria-label="Giulio Occhipinti">
          <span class="name-word" aria-hidden="true">Giulio</span>
          <span class="name-word" aria-hidden="true">Occhipinti</span>
        </h1>
        <p class="entry-tagline" id="entry-tagline">
          "Chi sei, dipende da come mi guardi."
        </p>
      </header>

      <!-- Mode cards -->
      <section class="mode-cards" id="mode-cards" aria-label="Scegli prospettiva">
        <button class="mode-card" data-mode="tech" id="card-tech" type="button">
          <span class="mode-card__accent">01</span>
          <span class="mode-card__label">Tech</span>
          <span class="mode-card__desc">Architetture, codice, sistemi</span>
          <span class="mode-card__go" data-href="/cv?mode=tech" role="link" tabindex="-1" aria-hidden="true">
            <span class="go-text">GO to Tech</span>
            <span class="go-icon">↗</span>
          </span>
        </button>

        <button class="mode-card" data-mode="creative" id="card-creative" type="button">
          <span class="mode-card__accent">02</span>
          <span class="mode-card__label">Creative</span>
          <span class="mode-card__desc">Racconto, immagine, suono</span>
          <span class="mode-card__go" data-href="/cv?mode=creative" role="link" tabindex="-1" aria-hidden="true">
            <span class="go-text">GO to Creative</span>
            <span class="go-icon">↗</span>
          </span>
        </button>

        <button class="mode-card" data-mode="human" id="card-human" type="button">
          <span class="mode-card__accent">03</span>
          <span class="mode-card__label">Human</span>
          <span class="mode-card__desc">Impatto, relazione, presenza</span>
          <span class="mode-card__go" data-href="/cv?mode=human" role="link" tabindex="-1" aria-hidden="true">
            <span class="go-text">GO to Human</span>
            <span class="go-icon">↗</span>
          </span>
        </button>
      </section>

    </main>
  </div>

</Layout>

<style>
  /* ── Layout root ── */
  .entry-root {
    position: relative;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Knolling stage ── */
  .knolling-stage {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .knoll-item {
    position: absolute;
    left: var(--kx);
    top: var(--ky);
    transform: translate(-50%, -50%) rotate(var(--kr)) scale(var(--ks));
    width: clamp(80px, 12vw, 200px);
    object-fit: contain;
    opacity: 0; /* GSAP gestisce */
    will-change: transform, opacity;
    transition: filter 0.4s ease, opacity 0.4s ease;
  }

  .knoll-item.is-dim {
    filter: brightness(0.3) saturate(0.4);
    opacity: 0.15 !important;
  }

  .knoll-item.is-hero {
    filter: brightness(1.15) drop-shadow(0 8px 24px rgba(0,0,0,0.5));
    z-index: 1;
  }

  /* ── Mobile: reposition all knoll items into safe corner zones ── */
  @media (max-width: 639px) {
    /* Safe zones: corners + edges, away from the centered card content */

    /* 1. laptop — bottom center-right, hero size */
    .knolling-stage .knoll-item:nth-child(1) {
      left: 76%;
      top: 88%;
      transform: translate(-50%, -50%) rotate(-2deg) scale(0.7);
    }
    /* 2. flashlight — top left edge */
    .knolling-stage .knoll-item:nth-child(2) {
      left: 7%;
      top: 17%;
      transform: translate(-50%, -50%) rotate(88deg) scale(0.42);
    }
    /* 3. multitool — right edge, middle height */
    .knolling-stage .knoll-item:nth-child(3) {
      left: 94%;
      top: 50%;
      transform: translate(-50%, -50%) rotate(-12deg) scale(0.42);
    }
    /* 4. camera — bottom left */
    .knolling-stage .knoll-item:nth-child(4) {
      left: 10%;
      top: 78%;
      transform: translate(-50%, -50%) rotate(5deg) scale(0.58);
    }
    /* 5. megaphone — bottom right */
    .knolling-stage .knoll-item:nth-child(5) {
      left: 92%;
      top: 74%;
      transform: translate(-50%, -50%) rotate(-7deg) scale(0.48);
    }
    /* 6. chess — top left, small */
    .knolling-stage .knoll-item:nth-child(6) {
      left: 10%;
      top: 20%;
      transform: translate(-50%, -50%) rotate(-14deg) scale(0.44);
    }
    /* 7. plant — extreme bottom left */
    .knolling-stage .knoll-item:nth-child(7) {
      left: 6%;
      top: 91%;
      transform: translate(-50%, -50%) rotate(-3deg) scale(0.48);
    }
    /* 8. compass — top right, prominent */
    .knolling-stage .knoll-item:nth-child(8) {
      left: 87%;
      top: 11%;
      transform: translate(-50%, -50%) rotate(18deg) scale(0.55);
    }
  }

  /* ── Main content ── */
  .entry-main {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 2rem 1.5rem;
    width: 100%;
    max-width: 520px;
  }

  /* ── Header ── */
  .entry-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    opacity: 0; /* GSAP gestisce */
  }

  .entry-label {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .entry-name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.92;
    color: var(--color-text-primary);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .name-word {
    display: block;
    overflow: hidden;
  }

  .name-char {
    display: inline-block;
    will-change: transform;
  }

  .entry-tagline {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── Mode cards ── */
  .mode-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  @media (min-width: 640px) {
    .mode-cards {
      flex-direction: row;
      gap: 1rem;
    }
    .entry-main {
      max-width: 820px;
    }
  }

  .mode-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    cursor: pointer;
    text-align: left;
    opacity: 0; /* GSAP gestisce */
    will-change: transform, opacity;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .mode-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(ellipse at 50% 120%, var(--card-glow, transparent) 0%, transparent 70%);
  }

  .mode-card:hover::before,
  .mode-card.is-selected::before {
    opacity: 1;
  }

  .mode-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .mode-card[data-mode="tech"]     { --card-glow: rgba(0, 255, 200, 0.15); }
  .mode-card[data-mode="creative"] { --card-glow: rgba(255, 107, 53, 0.15); }
  .mode-card[data-mode="human"]    { --card-glow: rgba(240, 200, 127, 0.15); }

  .mode-card.is-selected {
    background: rgba(255, 255, 255, 0.09);
  }

  .mode-card[data-mode="tech"].is-selected     { border-color: rgba(0, 255, 200, 0.5); }
  .mode-card[data-mode="creative"].is-selected { border-color: rgba(255, 107, 53, 0.5); }
  .mode-card[data-mode="human"].is-selected    { border-color: rgba(240, 200, 127, 0.5); }

  .mode-card.is-passive {
    opacity: 0.3 !important;
    transform: scale(0.96);
  }

  .mode-card__accent {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .mode-card__label {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .mode-card__desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Ripple effect su card */
  @keyframes ripple {
    from { transform: scale(0); opacity: 0.4; }
    to   { transform: scale(4); opacity: 0; }
  }

  .ripple {
    position: absolute;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    pointer-events: none;
    animation: ripple 0.6s ease-out forwards;
    transform-origin: center;
  }

  /* ── GO button inside card ── */
  .mode-card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgba(212, 168, 55, 0.45);
    border-radius: 2px;
    background: rgba(212, 168, 55, 0.07);
    width: 100%;
    color: #D4A837;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .mode-card__go.is-ready {
    pointer-events: auto;
  }

  .mode-card__go.is-ready:hover {
    background: rgba(212, 168, 55, 0.16);
    border-color: rgba(212, 168, 55, 0.75);
    box-shadow: 0 0 16px rgba(212, 168, 55, 0.28);
  }

  .go-icon {
    display: inline-block;
    margin-left: auto;
    font-size: 0.95rem;
    transition: transform 0.22s ease;
  }

  .mode-card__go.is-ready:hover .go-icon {
    transform: translate(4px, -4px);
  }

  /* ── Launch journey overlay ── */
  #launch-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000;
    pointer-events: none;
    opacity: 0;
    background: rgba(8, 73, 67, 1);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { setMode } from '../islands/stores/modeStore.ts';

  // ── DOM refs ─────────────────────────────────────────────
  const preloader    = document.getElementById('preloader')!;
  const header       = document.getElementById('entry-header')!;
  const nameEl       = document.getElementById('entry-name')!;
  const cards        = document.querySelectorAll<HTMLButtonElement>('.mode-card');
  const knolls       = document.querySelectorAll<HTMLImageElement>('.knoll-item');

  let selectedMode: string | null = null;

  // ── Split text: wrap each char in a span ─────────────────
  document.querySelectorAll<HTMLElement>('.name-word').forEach(word => {
    const text = word.textContent ?? '';
    word.textContent = '';
    text.split('').forEach(char => {
      const s = document.createElement('span');
      s.className = 'name-char';
      s.textContent = char === ' ' ? '\u00A0' : char;
      word.appendChild(s);
    });
  });
  const chars = nameEl.querySelectorAll<HTMLElement>('.name-char');

  // ── Set initial hidden states (prevent flash pre-GSAP) ────
  gsap.set(['#entry-label', '#entry-tagline'], { opacity: 0, y: 12 });

  // ── Preloader → Main timeline ─────────────────────────────
  const master = gsap.timeline();

  // Hide preloader after bar completes (1.6s)
  master.to(preloader, {
    opacity: 0,
    duration: 0.5,
    ease: 'power2.inOut',
    delay: 1.5,
    onComplete: () => { preloader.style.display = 'none'; },
  });

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 1.6 });

  // 0. Reveal header container (CSS mantiene opacity:0 durante il preloader)
  tl.set(header, { opacity: 1 });

  // 1. Name chars drop in with stagger (Awwwards-signature)
  tl.fromTo(chars,
    { y: '110%', opacity: 0 },
    {
      y: '0%', opacity: 1,
      duration: 0.8,
      stagger: { each: 0.03, from: 'start' },
      ease: 'power4.out',
    }
  );

  // 2. Label + tagline
  tl.fromTo('#entry-label, #entry-tagline',
    { opacity: 0, y: 12 },
    { opacity: 1, y: 0, duration: 0.5, stagger: 0.1 },
    '-=0.4'
  );

  // 3. Cards drop with knolling stagger
  tl.fromTo(cards,
    { y: -40, opacity: 0, rotation: (i) => [-3, 2, -2][i] ?? 0, scale: 0.94 },
    {
      y: 0, opacity: 1, rotation: 0, scale: 1,
      duration: 0.7,
      stagger: 0.1,
      ease: 'back.out(1.4)',
    },
    '-=0.2'
  );

  // 4. Knolling items land
  tl.fromTo(knolls,
    { scale: 0, opacity: 0, rotation: () => (Math.random() - 0.5) * 60, y: () => (Math.random() - 0.5) * 80 },
    {
      scale: 1, opacity: 0.18, rotation: 0, y: 0,
      duration: 0.7,
      stagger: { each: 0.07, from: 'random' },
      ease: 'back.out(1.8)',
    },
    '-=0.4'
  );

  // ── Magnetic effect on mode cards ────────────────────────
  cards.forEach((card) => {
    const strength = 12;

    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = (e.clientX - cx) / rect.width * strength;
      const dy = (e.clientY - cy) / rect.height * strength;
      gsap.to(card, { x: dx, y: dy, duration: 0.4, ease: 'power2.out' });
    });

    card.addEventListener('mouseleave', () => {
      if (!card.classList.contains('is-selected')) {
        gsap.to(card, { x: 0, y: 0, scale: 1, duration: 0.5, ease: 'elastic.out(1, 0.4)' });
      }
    });

    card.addEventListener('mouseenter', () => {
      if (selectedMode && card.dataset.mode !== selectedMode) return;
      gsap.to(card, { scale: 1.03, duration: 0.3, ease: 'power2.out' });
    });
  });

  // ── Launch journey animation ──────────────────────────────
  function launchJourney(href: string) {
    document.body.style.pointerEvents = 'none';
    const overlay = document.getElementById('launch-overlay')!;
    const cx = window.innerWidth / 2;
    const cy = window.innerHeight / 2;
    const lineCount = 28;
    const lineEls: HTMLElement[] = [];

    for (let i = 0; i < lineCount; i++) {
      const angle = (i / lineCount) * 360;
      const rad   = (angle * Math.PI) / 180;
      const dist  = Math.random() * 60 + 10;
      const len   = Math.random() * 200 + 80;
      const thick = Math.random() * 1.5 + 0.5;
      const line  = document.createElement('div');
      Object.assign(line.style, {
        position:        'fixed',
        left:            `${cx + Math.cos(rad) * dist}px`,
        top:             `${cy + Math.sin(rad) * dist}px`,
        width:           `${len}px`,
        height:          `${thick}px`,
        background:      'rgba(255,255,255,0.12)',
        transform:       `rotate(${angle}deg)`,
        transformOrigin: 'left center',
        opacity:         '0',
        zIndex:          '99997',
        pointerEvents:   'none',
      });
      document.body.appendChild(line);
      lineEls.push(line);
    }

    const journey = gsap.timeline({
      onComplete: () => {
        lineEls.forEach(l => l.remove());
        window.location.href = href;
      },
    });

    // Speed lines sparano verso l'esterno (warp speed)
    journey.fromTo(lineEls,
      { scaleX: 0, opacity: 0 },
      { scaleX: 1, opacity: 0.8, duration: 0.25, stagger: { each: 0.008, from: 'random' }, ease: 'power2.out' }
    );
    journey.to(lineEls,
      { scaleX: 6, opacity: 0, duration: 0.45, stagger: { each: 0.006, from: 'random' }, ease: 'power4.in' },
      '-=0.05'
    );

    // Il mondo si allontana mentre acceleri
    journey.to([header, cards, knolls],
      { opacity: 0, scale: 0.85, filter: 'blur(10px)', duration: 0.45, ease: 'power3.in' },
      0.05
    );

    // Vignette scura chiude la scena
    journey.to(overlay,
      { opacity: 1, duration: 0.4, ease: 'power2.inOut' },
      0.2
    );
  }

  // ── Click card: selezione mode ────────────────────────────
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      // Se il click viene dal go button, ignora (gestito separatamente)
      if ((e.target as HTMLElement).closest('.mode-card__go')) return;

      const mode = card.dataset.mode as string;
      selectedMode = mode;

      // Ripple
      const rect = card.getBoundingClientRect();
      const ripple = document.createElement('span');
      ripple.className = 'ripple';
      ripple.style.left = `${(e as MouseEvent).clientX - rect.left - 30}px`;
      ripple.style.top  = `${(e as MouseEvent).clientY - rect.top - 30}px`;
      card.appendChild(ripple);
      ripple.addEventListener('animationend', () => ripple.remove());

      setMode(mode as 'tech' | 'creative' | 'human');

      // Animazione card: selected vs passive + GO button
      cards.forEach((c) => {
        const goBtn = c.querySelector<HTMLElement>('.mode-card__go');
        if (c === card) {
          c.classList.add('is-selected');
          c.classList.remove('is-passive');
          gsap.to(c, { scale: 1.04, duration: 0.3, ease: 'back.out(2)' });
          if (goBtn) {
            goBtn.setAttribute('tabindex', '0');
            goBtn.removeAttribute('aria-hidden');
            gsap.timeline({ delay: 0.2 })
              .fromTo(goBtn,
                { opacity: 0, y: 28, scale: 0.82 },
                { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: 'back.out(3)',
                  onStart: () => goBtn.classList.add('is-ready') }
              )
              .to(goBtn,
                { boxShadow: '0 0 24px 4px rgba(212,168,55,0.45)', duration: 0.28,
                  ease: 'power2.out', yoyo: true, repeat: 1 },
                0.5
              );
          }
        } else {
          c.classList.add('is-passive');
          c.classList.remove('is-selected');
          gsap.to(c, { scale: 0.96, duration: 0.25, ease: 'power2.out' });
          if (goBtn && goBtn.classList.contains('is-ready')) {
            goBtn.setAttribute('tabindex', '-1');
            goBtn.setAttribute('aria-hidden', 'true');
            gsap.to(goBtn, { opacity: 0, y: 5, duration: 0.2, ease: 'power2.in',
              onComplete: () => goBtn.classList.remove('is-ready') });
          }
        }
      });

      // Animazione knolling: hero vs dim
      knolls.forEach((img) => {
        const modes = img.dataset.modes?.split(' ') ?? [];
        const isRelated = modes.includes(mode);
        img.classList.toggle('is-hero', isRelated);
        img.classList.toggle('is-dim', !isRelated);
        gsap.to(img, { opacity: isRelated ? 0.7 : 0.05, scale: isRelated ? 1.06 : 0.9, duration: 0.5, ease: 'power2.out' });
      });
    });
  });

  // ── GO button: lancia il journey ─────────────────────────
  document.querySelectorAll<HTMLElement>('.mode-card__go').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const href = btn.dataset.href ?? '/cv';
      launchJourney(href);
    });
  });
</script>


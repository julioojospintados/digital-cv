---
import Layout from "../layouts/Layout.astro";
import "../styles/not-found.css";

// Pagina 404 — prerenderizzata come statica di proposito.
//
// Vercel la serve per QUALSIASI URL inesistente: senza questo file la
// richiesta finiva sulla funzione serverless (vedi il routing in
// .vercel/output/config.json), che dopo l'aggiunta del rendering PDF pesa
// ~98MB — un cold start da secondi per un semplice link rotto. Come file
// statico viene servita dalla CDN, la funzione non parte mai.
//
// Astro genera un solo 404 per tutto il sito (non esiste un /en/404 servito
// da Vercel per gli URL rotti sotto /en/), quindi la lingua non può stare nel
// path: la sceglie uno script inline leggendo l'URL. È la stessa asimmetria
// già ammessa per /en/cv in AGENTS.md — la logica è condivisa, cambia solo
// da dove arriva la lingua.
---

<Layout
  title="Pagina non trovata — Giulio Occhipinti"
  description="La pagina cercata non esiste o è stata spostata."
  noindex
>
  <script is:inline>
    // Inline e in cima al contenuto: gira mentre il parser è ancora qui,
    // prima che il blocco IT/EN venga renderizzato — nessun lampo della
    // lingua sbagliata.
    (function () {
      const p = window.location.pathname.toLowerCase();
      const isEn = p === "/en" || p.indexOf("/en/") === 0;
      const root = document.documentElement;
      root.setAttribute("data-nf-lang", isEn ? "en" : "it");
      if (isEn) root.setAttribute("lang", "en");
    })();
  </script>

  <nav class="nf-nav">
    <go-logo>GO</go-logo>
  </nav>

  <main class="nf-main" id="main-content">
    <div class="nf-copy" data-nf="it">
      <p class="nf-eyebrow">404</p>
      <h1 class="nf-title">Qui non c'è niente.</h1>
      <p class="nf-text">
        Il link è rotto o la pagina si è spostata. Da qui torni dove volevi andare.
      </p>
      <div class="nf-links">
        <a class="nf-link nf-link--primary" href="/">Vai alla home</a>
        <a class="nf-link" href="/design">Apri il CV</a>
        <a class="nf-link" href="/work">Guarda i lavori</a>
      </div>
    </div>

    <div class="nf-copy" data-nf="en" lang="en">
      <p class="nf-eyebrow">404</p>
      <h1 class="nf-title">There's nothing here.</h1>
      <p class="nf-text">
        The link is broken, or the page moved. From here you can get back on track.
      </p>
      <div class="nf-links">
        <a class="nf-link nf-link--primary" href="/en/">Go to the homepage</a>
        <a class="nf-link" href="/en/design">Open the CV</a>
        <a class="nf-link" href="/en/work">See the work</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import "../islands/GoLogo.lit.ts";
</script>

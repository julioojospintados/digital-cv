---
import Layout from "../layouts/Layout.astro";
import { cvData } from "@cv-data";
import "../styles/cv-page.css";
// .work-index-card / .work-chevron — riusati dal CTA portfolio nell'hero,
// stessa identità visiva delle card di /work (vedi hero-portfolio-card sotto).
import "../styles/work-page.css";
import ExpCard from "../components/cards/ExpCard.astro";
import AiCard from "../components/cards/AiCard.astro";
import ProjectCard from "../components/cards/ProjectCard.astro";
import SkillSquare from "../components/cards/SkillSquare.astro";
import SoftItem from "../components/cards/SoftItem.astro";
import ContactFooter from "../components/ContactFooter.astro";
import {
  EXP_CLUSTER_DEFS,
  PROJ_CARD_META,
  type ClusterRef,
} from "../lib/exp-clusters";

export function getStaticPaths() {
  return [
    { params: { mode: "tech" } },
    { params: { mode: "creative" } },
    { params: { mode: "human" } },
    { params: { mode: "management" } },
  ];
}

const { mode } = Astro.params as {
  mode: "tech" | "creative" | "human" | "management";
};

type SkillSquareSource = {
  name: string;
  shortName?: string;
  domain?: "tech" | "human" | "creative" | "management" | "ai";
  level?: string;
  weight?: number;
  mastery?: number;
};

// ── Skill mode-tag sets ────────────────────────────────────────────────────
const TECH_SKILL_SET = new Set([
  "Angular",
  "HTML5",
  "CSS / SCSS",
  "TypeScript",
  "JavaScript",
  "Lit",
  "RXJS",
  "NGRX",
  "WebComponents",
  "React",
  "Git",
  "Bootstrap",
  "Material Design",
  "GraphQL",
  "SQL",
  "Jest",
  "Node.js",
  "REST API",
  "Spring",
  "JSF",
  "MCP Protocol",
  "Prompt Engineering",
  "GSAP",
  "Astro",
  "Hono",
]);
const CREATIVE_SKILL_SET = new Set([
  "Figma",
  "SEO",
  "SEM",
  "UX Research",
  "Wireframing",
  "Video editing",
  "Wordpress",
  "Adobe Suite",
  "Typography",
]);
const DUAL_SKILL_SET = new Set([
  "Accessibility / WCAG",
  "UX Research",
  "Wireframing",
  "Figma",
]);

function deriveSkillLevel(mastery = 65): string {
  if (mastery >= 85) return "Esperto";
  if (mastery >= 70) return "Avanzato";
  if (mastery >= 50) return "Intermedio";
  return "Base";
}

function skillModeTags(skill: SkillSquareSource): string {
  const tags = new Set<string>();

  if (skill.domain) {
    tags.add(skill.domain === "ai" ? "tech" : skill.domain);
  }

  if (TECH_SKILL_SET.has(skill.name)) {
    tags.add("tech");
  }

  if (CREATIVE_SKILL_SET.has(skill.name) || DUAL_SKILL_SET.has(skill.name)) {
    tags.add("creative");
  }

  if (tags.size === 0) {
    tags.add("tech");
    tags.add("creative");
    tags.add("human");
    tags.add("management");
  }

  return Array.from(tags).join(" ");
}

// ── Skill Grid ─────────────────────────────────────────────────────────────
const LEVEL_BORDERS: Record<string, number> = {
  Base: 1,
  Intermedio: 2,
  Avanzato: 3,
  Esperto: 4,
};
function toSkillSquare(skill: SkillSquareSource) {
  const level = skill.level ?? deriveSkillLevel(skill.mastery);
  return {
    name: skill.name,
    shortName: skill.shortName,
    level,
    borderPx: LEVEL_BORDERS[level] ?? 1,
    isGlow: level === "Avanzato" || level === "Esperto",
    modeTags: skillModeTags(skill),
    weight: skill.weight ?? 1,
  };
}

function isActiveSkill(modeTags: string): boolean {
  const tags = modeTags.split(" ");
  return tags.includes(mode) || (mode === "tech" && tags.includes("ai"));
}

const skillSquares = [
  ...cvData.technicalSkills.map((skill) => toSkillSquare(skill)),
  ...cvData.softSkills
    .filter(
      (skill) => skill.domain === "human" || skill.domain === "management",
    )
    .map((skill) => toSkillSquare(skill)),
  ...cvData.transversalSkills
    .filter(
      (skill) => skill.domain === "human" || skill.domain === "management",
    )
    .map((skill) => toSkillSquare(skill)),
].sort((a, b) => {
  const activeDelta =
    Number(isActiveSkill(b.modeTags)) - Number(isActiveSkill(a.modeTags));
  if (activeDelta !== 0) return activeDelta;

  const areaA = (a.weight ?? 1) * (LEVEL_BORDERS[a.level] ?? 1);
  const areaB = (b.weight ?? 1) * (LEVEL_BORDERS[b.level] ?? 1);
  if (areaA !== areaB) return areaB - areaA;

  return a.name.localeCompare(b.name);
});

// ── Experience clusters — definizione condivisa IT/EN in lib/exp-clusters.ts.
// Ogni ref diventa una card: la stessa esperienza può comparire in più
// cluster con la facet giusta (ruolo/descrizione/highlight per quella lente).
const AI_SKILL_HINTS = [
  "MCP Protocol",
  "Prompt Engineering",
  "GitHub Copilot",
  "Claude",
  "Cursor",
  "AI Orchestration",
  "MCP",
];

function refToCard(ref: ClusterRef, clusterTags: string) {
  if ("proj" in ref) {
    const p = cvData.projects[ref.proj];
    const meta = PROJ_CARD_META[ref.proj];
    if (!p) return null;
    return {
      company: p.name,
      role: meta?.role.it ?? "",
      startYear: meta?.startYear ?? "",
      endYear: meta?.endYear ?? meta?.startYear ?? "",
      location: meta?.location?.it ?? "",
      remote: false,
      description: p.description,
      highlights: [] as string[],
      skills: p.tags ?? [],
      modeTags: clusterTags,
      aiAugmented: false,
    };
  }
  const exp = cvData.experience[ref.exp];
  if (!exp) return null;
  const facet = ref.facet
    ? exp.facets?.find((f) => f.mode === ref.facet)
    : undefined;
  return {
    company: exp.company,
    role: facet?.role ?? exp.role,
    startYear: exp.startDate.substring(0, 4),
    endYear: exp.endDate === "present" ? "oggi" : exp.endDate.substring(0, 4),
    location: exp.location ?? "",
    remote: exp.remote ?? false,
    description: facet?.description ?? exp.description,
    highlights: facet?.highlights ?? exp.highlights ?? [],
    skills: exp.skills ?? [],
    modeTags: clusterTags,
    aiAugmented: !!(
      exp.tags?.includes("ai-orchestration") ||
      exp.skills?.some((s) => AI_SKILL_HINTS.includes(s))
    ),
  };
}

const FEATURED_N = 3;
const expClusters = EXP_CLUSTER_DEFS.map((cluster) => {
  const items = cluster.refs
    .map((r) => refToCard(r, cluster.tags))
    .filter((c): c is NonNullable<typeof c> => c !== null);
  return {
    key: cluster.key,
    label: cluster.labels.it,
    isDefaultOpen: cluster.openForModes.includes(mode),
    items,
    featured: items.slice(0, FEATURED_N),
    extra: items.slice(FEATURED_N),
  };
});

const skillViewLabels = {
  graph: "Grafico",
  cards: "Card",
} as const;

// Una voce per ogni elemento di cvData.softSkills, nello stesso ordine.
// Prima erano 9 tag per 11 skill: "Ascolto attivo" e "Assertività" (aggiunte
// dopo) rubavano i tag di "Sensibilità estetica" e "Pensiero T-shaped", e le
// ultime due finivano nel fallback attivo-ovunque.
const SOFT_MODE_TAGS = [
  "human creative", // Comunicazione efficace
  "creative human", // Creatività applicata
  "human", // Adattabilità culturale
  "human management", // Intelligenza relazionale
  "tech human management", // Problem solving laterale
  "tech human management", // Autonomia strategica
  "human management", // Resilienza e pensiero adattivo
  "human management", // Ascolto attivo
  "creative", // Sensibilità estetica
  "tech creative human management", // Pensiero T-shaped
];

// Le mappe per indice devono restare allineate ai dati: meglio far fallire
// la build che spedire un'enfasi visiva silenziosamente sbagliata.
for (const cluster of EXP_CLUSTER_DEFS)
  for (const ref of cluster.refs) {
    if ("exp" in ref && !cvData.experience[ref.exp])
      throw new Error(
        `Cluster "${cluster.key}": ref exp ${ref.exp} fuori da cvData.experience — aggiorna lib/exp-clusters.ts.`,
      );
    if ("proj" in ref && !cvData.projects[ref.proj])
      throw new Error(
        `Cluster "${cluster.key}": ref proj ${ref.proj} fuori da cvData.projects — aggiorna lib/exp-clusters.ts.`,
      );
    if ("exp" in ref && ref.facet && !cvData.experience[ref.exp].facets?.some((f) => f.mode === ref.facet))
      throw new Error(
        `Cluster "${cluster.key}": l'esperienza ${ref.exp} non ha la facet "${ref.facet}" — aggiungila in cv.ts.`,
      );
  }
if (SOFT_MODE_TAGS.length !== cvData.softSkills.length)
  throw new Error(
    `SOFT_MODE_TAGS (${SOFT_MODE_TAGS.length}) non allineato a cvData.softSkills (${cvData.softSkills.length}): aggiorna la mappa in [mode].astro.`,
  );

const softSkillsData = cvData.softSkills.map((skill, i) => ({
  name: skill.name,
  description: skill.description ?? "",
  modeTags: SOFT_MODE_TAGS[i] ?? "tech creative human",
}));

const MONTHS_IT = [
  "Gen",
  "Feb",
  "Mar",
  "Apr",
  "Mag",
  "Giu",
  "Lug",
  "Ago",
  "Set",
  "Ott",
  "Nov",
  "Dic",
];
function isoToLabel(iso: string): string {
  const [y, m] = iso.split("-");
  return m ? `${MONTHS_IT[parseInt(m, 10) - 1]} ${y}` : y;
}
const timelineItems = [
  ...cvData.education.map((e) => ({
    date: e.endDate,
    dateLabel: isoToLabel(e.endDate),
    title: `${e.degree}${e.field ? ` — ${e.field}` : ""}`,
    institution: e.institution,
    type: "edu" as const,
    inProgress: false,
    credentialId: undefined as string | undefined,
  })),
  ...cvData.certifications.map((c) => ({
    date: c.date,
    dateLabel: isoToLabel(c.date),
    title: c.name,
    institution: c.issuer,
    type: "cert" as const,
    inProgress: c.inProgress ?? false,
    credentialId: c.credentialId,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

const CEFR_STEPS: Record<string, number> = {
  Madrelingua: 6,
  Native: 6,
  C2: 6,
  C1: 5,
  B2: 4,
  B1: 3,
  A2: 2,
  A1: 1,
};
const langsWithSteps = cvData.languages.map((l) => ({
  ...l,
  steps: CEFR_STEPS[l.level] ?? 3,
}));

const PROJECT_TAGS_MAP: Record<string, string> = {
  Cinema: "creative",
  React: "tech",
  Lit: "tech",
  WebComponents: "tech",
  "Event management": "human",
  Poesia: "creative human",
  Creatività: "creative",
  "Tour management": "creative management",
  "Content Strategy": "creative",
  "Digital marketing": "creative management",
};

const projectsData = cvData.projects.slice(0, 6).map((p) => {
  const tags = p.tags ?? [];
  const modes = new Set<string>();
  tags.forEach((t) => {
    const mapped = PROJECT_TAGS_MAP[t];
    if (mapped) mapped.split(" ").forEach((m) => modes.add(m));
  });
  if (p.primaryMode) modes.add(p.primaryMode);
  const modeTags =
    modes.size > 0 ? Array.from(modes).join(" ") : "tech creative human";
  return { name: p.name, description: p.description, modeTags, slug: p.slug };
})
  // Mode first al primo paint (prima che il JS lato client riordini col
  // cambio mode): stessa logica di reorderProjectCards in mode-helpers.ts.
  .sort((a, b) => Number(b.modeTags.includes(mode)) - Number(a.modeTags.includes(mode)));

const MODE_LABELS: Record<string, string> = {
  tech: 'Software Developer',
  creative: 'Web & UX Designer',
  management: 'Project Manager',
  human: 'AI & Digital Specialist',
};
const modeLabel = MODE_LABELS[mode] ?? mode;

const modeDescriptions: Record<string, string> = {
  tech: "Sviluppo web con Angular, Lit e TypeScript al servizio del design: interfacce curate, AI workflow e automazione per realtà che vogliono risultati misurabili.",
  creative:
    "UX/UI & Web Designer certificato IBM, Creative Technologist. Progetto esperienze digitali che uniscono estetica, usabilità e impatto sul brand per realtà di ogni dimensione.",
  human:
    "Consulente per l'Innovazione Digitale con background multidisciplinare: design, sviluppo web, teatro e comunicazione. Lavoro per un impatto reale sulle persone e sui processi.",
  management:
    "Partner Tecnico Agile per piccole e grandi realtà. Sprint brevi, backlog orientato al business, autonomia del team. Design + Tecnologia + Metodo in ogni ingaggio.",
};
const modeDescription =
  modeDescriptions[mode] ??
  "CV interattivo di Giulio Occhipinti: Consulente per l'Innovazione Digitale & Partner Tecnico per piccole e grandi realtà.";

// Hero mode-aware: chi arriva su /tech o /creative cercando un profilo
// specifico non deve leggere il posizionamento generico da partner tecnico
// (quello resta su home e /management) — vedi memoria "posizionamento-ux-ui-first":
// Design/UX-UI sempre prima, Tecnologia come strumento, mai "Senior
// Frontend Developer" come identità.
const heroTitles: Record<string, string> = {
  tech: "Sviluppo al servizio del design: Angular, Lit, AI Workflow.",
  creative: "UX/UI & Web Designer certificato IBM, Creative Technologist.",
  human: "Consulente per l'Innovazione Digitale: comunicazione e impatto.",
  management: "Partner Tecnico Agile: Design, Tecnologia, Metodo.",
};
const heroTitle = heroTitles[mode] ?? cvData.personal.title;

const heroSummaries: Record<string, string> = {
  tech: "Costruisco interfacce con Angular, Lit e TypeScript, e integro strumenti AI per velocizzare senza perdere qualità. In ALTEN Italia ho sviluppato design system e architetture per Aruba e Intesa San Paolo. Questo sito, ad esempio, l'ho realizzato con GitHub Copilot e Claude come assistenti operativi.",
  creative: "Progetto esperienze digitali che uniscono estetica, usabilità e attenzione al dettaglio, con certificazioni IBM e SkillUp in UX/UI Design e in Generative AI applicata al design. Per Aruba ho sviluppato una libreria di componenti riutilizzabile cross-prodotto; in questo sito ho progettato animazioni GSAP e un sistema knolling documentato passo per passo nel design system.",
  human: "Il mio percorso unisce design, sviluppo, teatro e comunicazione. La formazione in improvvisazione teatrale con B-Teatro mi ha insegnato ad ascoltare prima di rispondere, un'attitudine che porto anche nella progettazione dei workflow AI. Ho condotto festival e panel con ospiti internazionali e ho progettato la comunicazione digitale del roster di un'agenzia musicale.",
  management: "Applico Scrum e Kanban in contesti diversi: team enterprise distribuiti come Intesa San Paolo e Aruba, e collaborazioni più snelle come il tour management per un'agenzia musicale, dove ho seguito booking e strategia digitale in autonomia. Lavoro in sprint brevi, con un backlog costruito sugli obiettivi di business.",
};
const heroSummary = heroSummaries[mode] ?? cvData.personal.summary;
---

<Layout
  title={`CV ${modeLabel} — Giulio Occhipinti`}
  description={modeDescription}
  mode={mode}
  showFab
>
  <!-- ────────────────────────────────────────────────────────── NAV -->
  <nav class="cv-nav" id="cv-nav" aria-label="Navigazione principale">
    <go-logo></go-logo>
    <div
      class="mode-buttons"
      role="group"
      aria-label="Scegli modalità di visualizzazione"
    >
      <button
        class:list={["mode-btn", { "is-active": mode === "tech" }]}
        data-nav-mode="tech"
        type="button"
        aria-pressed={mode === "tech" ? "true" : "false"}
      >
        <span class="mode-btn__abbr" aria-hidden="true">SD</span>
        <span class="mode-btn__label">Software Dev</span>
      </button>
      <button
        class:list={["mode-btn", { "is-active": mode === "creative" }]}
        data-nav-mode="creative"
        type="button"
        aria-pressed={mode === "creative" ? "true" : "false"}
      >
        <span class="mode-btn__abbr" aria-hidden="true">WD</span>
        <span class="mode-btn__label">Web &amp; UX</span>
      </button>
      <button
        class:list={["mode-btn", { "is-active": mode === "management" }]}
        data-nav-mode="management"
        type="button"
        aria-pressed={mode === "management" ? "true" : "false"}
      >
        <span class="mode-btn__abbr" aria-hidden="true">PM</span>
        <span class="mode-btn__label">Project Mgr</span>
      </button>
      <button
        class:list={["mode-btn", { "is-active": mode === "human" }]}
        data-nav-mode="human"
        type="button"
        aria-pressed={mode === "human" ? "true" : "false"}
      >
        <span class="mode-btn__abbr" aria-hidden="true">AI</span>
        <span class="mode-btn__label">AI &amp; Digital</span>
      </button>
      <!-- Voce di navigazione, non un mode: apre il cluster personale
           "Fuori orario" e ci scrolla (handler in cv-init.ts). Il divider
           CSS a sinistra segna che è un'altra categoria di azione. -->
      <button class="mode-btn mode-btn--personal" data-nav-personal type="button">
        <span class="mode-btn__label">Fuori orario</span>
      </button>
    </div>
    <!-- Mobile dropdown — sostituisce i 4 pulsanti su ≤640px -->
    <div class="mode-dropdown" id="mode-dropdown">
      <button
        class="mode-dropdown__trigger"
        id="mode-dropdown-btn"
        type="button"
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <span class="mode-dropdown__label" id="mode-dropdown-label">
          {mode === "tech" ? "Software Dev"
            : mode === "creative" ? "Web & UX"
            : mode === "management" ? "Project Manager"
            : "AI & Digital"}
        </span>
        <span class="mode-dropdown__chevron" aria-hidden="true">›</span>
      </button>
      <ul
        class="mode-dropdown__list"
        id="mode-dropdown-list"
        role="listbox"
        aria-labelledby="mode-dropdown-btn"
      >
        <li class:list={["mode-dropdown__option", { "is-selected": mode === "tech" }]} role="option" data-dropdown-mode="tech" tabindex="-1">Software Dev</li>
        <li class:list={["mode-dropdown__option", { "is-selected": mode === "creative" }]} role="option" data-dropdown-mode="creative" tabindex="-1">Web &amp; UX</li>
        <li class:list={["mode-dropdown__option", { "is-selected": mode === "management" }]} role="option" data-dropdown-mode="management" tabindex="-1">Project Manager</li>
        <li class:list={["mode-dropdown__option", { "is-selected": mode === "human" }]} role="option" data-dropdown-mode="human" tabindex="-1">AI &amp; Digital</li>
        <li class="mode-dropdown__option mode-dropdown__option--personal" role="option" data-dropdown-personal tabindex="-1">Fuori orario</li>
      </ul>
    </div>
    <!-- Desktop: switch a 2 chip, sempre entrambe le lingue visibili.
         Mobile: <details> nativo, zero JS — libera spazio per il mode-dropdown
         accanto, che su schermi stretti competeva con lo switch a 2 chip. -->
    <div class="lang-switch" aria-label="Lingua / Language">
      <span class="lang-switch__opt lang-switch__opt--active" aria-current="true">IT</span>
      <a href="/en/cv" class="lang-switch__opt" lang="en" aria-label="Switch to English">EN</a>
    </div>
    <details class="lang-dropdown">
      <summary class="lang-dropdown__trigger" aria-label="Lingua / Language">
        <span class="lang-dropdown__label">IT</span>
        <span class="lang-dropdown__chevron" aria-hidden="true">›</span>
      </summary>
      <ul class="lang-dropdown__list" role="list">
        <li class="lang-dropdown__option is-selected" aria-current="true">IT</li>
        <li class="lang-dropdown__option">
          <a href="/en/cv" lang="en" aria-label="Switch to English">EN</a>
        </li>
      </ul>
    </details>
  </nav>

  <!-- Dot-nav verticale — jump diretto tra le sezioni, desktop only -->
  <nav class="section-dots" aria-label="Naviga tra le sezioni">
    <a href="#hero" class="section-dot" aria-label="Home"><span class="section-dot__tip">Home</span></a>
    <a href="#skills" class="section-dot" aria-label="Competenze"><span class="section-dot__tip">Competenze</span></a>
    <a href="#experience" class="section-dot" aria-label="Esperienze"><span class="section-dot__tip">Esperienze</span></a>
    <a href="#ai-section" class="section-dot" aria-label="AI Workflow"><span class="section-dot__tip">AI Workflow</span></a>
    <a href="#worklife" class="section-dot" aria-label="Persona"><span class="section-dot__tip">Persona</span></a>
    {
      cvData.feedbacks.length > 0 && (
        <a href="#feedback" class="section-dot" aria-label="Dicono di me">
          <span class="section-dot__tip">Dicono di me</span>
        </a>
      )
    }
    <a href="#projects" class="section-dot" aria-label="Progetti"><span class="section-dot__tip">Progetti</span></a>
    <a href="#education" class="section-dot" aria-label="Formazione"><span class="section-dot__tip">Formazione</span></a>
  </nav>

  <!-- ────────────────────────────────────────────────────────── MAIN -->
  <main class="cv-main" id="main-content">
    <!-- ── HERO ────────────────────────────────────────────────────── -->
    <section class="hero-section" id="hero">
      <img
        class="bg-knoll bg-knoll--laptop"
        src="/knolling/laptop.webp"
        aria-hidden="true"
        alt=""
      />
      <h1 class="hero-name" id="hero-name" aria-label={cvData.personal.name}>
        {
          cvData.personal.name
            .split("")
            .map((char, i) => (
              <span
                class:list={[
                  "hero-char",
                  { "hero-char--go": i === 0 || i === 7 },
                  { "hero-char--space": char === " " },
                ]}
              >
                {char === " " ? "\u00A0" : char}
              </span>
            ))
        }
      </h1>
      <p class="hero-title">{heroTitle}</p>
      <p class="hero-summary">{heroSummary}</p>

      <!-- Come lavoro, in quattro frasi: principi argomentabili al colloquio.
           Le chip numeriche sono state rimosse su richiesta (2026-07-15):
           percentuali non misurate indebolivano la credibilità. -->
      <ul class="hero-stats" aria-label="In breve">
        <li class="hero-stat">Trovo soluzioni che velocizzano il lavoro a monte.</li>
        <li class="hero-stat">Ho lavorato da solo e in team di oltre 20 persone.</li>
        <li class="hero-stat">Cerco modi per facilitare il lavoro degli altri.</li>
        <li class="hero-stat">Parto dal perché: è lì la radice delle cose.</li>
      </ul>

      <!-- Card teaser, non un link testuale: il portfolio è la prova del
           lavoro, merita lo stesso peso visivo delle card su /work (stile
           .work-index-card, work-page.css) invece di sparire dentro il
           paragrafo come un link sottolineato qualunque. -->
      <a href="/work" class="work-index-card hero-portfolio-card work-index-card--pulse">
        <p class="work-index-card__eyebrow">Portfolio</p>
        <p class="work-index-card__role">Case study, non un elenco.<br/> Nel portfolio racconto il processo completo di ogni progetto: problema, decisioni, risultati misurabili.</p>
        <span class="work-index-card__cta">
          Esplora il portfolio
          <span class="work-chevron" aria-hidden="true"></span>
        </span>
      </a>


      <div class="hero-footer">
        <div class="hero-socials">
          {
            cvData.social.map((s) => (
              <a
                href={s.url}
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${s.platform}${s.label ? ` — ${s.label}` : ""} (apre in nuova scheda)`}
              >
                {s.platform}
              </a>
            ))
          }

        </div>
        <div class="hero-langs">
          {
            langsWithSteps.map((l) => (
              <span class="lang-chip">
                <b>{l.name}</b>
                <span class="lang-cefr" aria-label={l.level} title={l.level}>
                  {Array.from({ length: 6 }, (_, i) => (
                    <span
                      class:list={[
                        "lang-dot",
                        { "lang-dot--filled": i < l.steps },
                        { "lang-dot--native": l.steps === 6 },
                      ]}
                    />
                  ))}
                </span>
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── SKILLS BENTO + FORCE NETWORK ─────────────────────────── -->
    <!-- Default per viewport (cv-init.ts): CARD su mobile (scannabile in 5s,
         D3 caricato solo al primo switch), GRAFICO su desktop dove ci sono
         spazio e mouse per esplorarlo. -->

    <section
      class="skills-section reveal delay-100"
      id="skills"
      aria-label="Competenze tecniche"
      data-skills-view="cards"
    >
      <img
        class="bg-knoll bg-knoll--multitool"
        src="/knolling/multitool.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title">
        <span>Skills</span>
        <span class="section-subtitle"
          >Livello e glow proporzionali: apri il Grafico per esplorare le connessioni.</span
        >
      </h2>
      <h3 class="skills-sub-title">
        Competenze tecniche, management e human.
      </h3>
      <div
        class="skills-view-toggle"
        role="group"
        aria-label="Scegli vista competenze"
      >
        <button
          class="skills-view-btn is-active"
          type="button"
          data-skills-view-button="cards"
          aria-pressed="true">{skillViewLabels.cards}</button
        >
        <button
          class="skills-view-btn"
          type="button"
          data-skills-view-button="graph"
          aria-pressed="false">{skillViewLabels.graph}</button
        >
      </div>
      <div class="skills-stage">
        <div class="skills-stage__panel skills-stage__panel--graph">
          <skill-force-graph></skill-force-graph>
        </div>
        <div class="skills-stage__panel skills-stage__panel--cards">
          <div class="skills-collapsible" data-skills-expanded="false">
            <div
              class="skills-grid"
              role="list"
              aria-label="Competenze tecniche, creative e trasversali"
            >
              {skillSquares.map((skill) => <SkillSquare {...skill} />)}
            </div>
            <div class="skills-fade" aria-hidden="true" />
          </div>
          <button
            class="skills-expand-btn"
            type="button"
            data-skills-expand-toggle
            data-label-collapsed="Mostra tutte le competenze"
            data-label-expanded="Mostra meno"
            aria-expanded="false"
          >
            Mostra tutte le competenze
          </button>
        </div>
      </div>
    </section>

    <!-- ── EXPERIENCE ─────────────────────────────────────────────── -->
    <section
      class="exp-section reveal delay-200"
      id="experience"
      aria-label="Esperienze lavorative"
    >
      <img
        class="bg-knoll bg-knoll--flashlight"
        src="/knolling/flashlight.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title">
        <span>Esperienze</span>
        <span class="section-subtitle"
          >{cvData.experience.length} ruoli in 5 paesi: espandi il cluster per esplorare.</span
        >
      </h2>
      <div class="exp-clusters">
        {
          expClusters.map((cluster, clusterIdx) => (
            <div
              class="exp-cluster"
              data-cluster={cluster.key}
              {...(cluster.isDefaultOpen ? { "data-open": "" } : {})}
            >
              <button
                class="exp-cluster__header"
                type="button"
                aria-expanded={cluster.isDefaultOpen ? "true" : "false"}
                aria-controls={`cluster-body-${cluster.key}`}
              >
                <span class="exp-cluster__index" aria-hidden="true">
                  {String(clusterIdx + 1).padStart(2, "0")}
                </span>
                <span class="exp-cluster__name">{cluster.label}</span>
                <span class="exp-cluster__meta">
                  <span class="exp-cluster__count">
                    {cluster.items.length} ruoli
                  </span>
                  <span class="exp-cluster__chevron" aria-hidden="true" />
                </span>
              </button>
              <div class="exp-cluster__body" id={`cluster-body-${cluster.key}`}>
                <div class="exp-grid exp-grid--featured">
                  {cluster.featured.map((exp) => (
                    <ExpCard {...exp} />
                  ))}
                </div>
                {cluster.extra.length > 0 && (
                  <div
                    class="exp-drawer"
                    id={`exp-drawer-${cluster.key}`}
                  >
                    <div class="exp-grid">
                      {cluster.extra.map((exp) => (
                        <ExpCard {...exp} />
                      ))}
                    </div>
                  </div>
                )}
              </div>
              {cluster.extra.length > 0 && (
                <button
                  class="exp-deeper-btn"
                  type="button"
                  data-drawer={cluster.key}
                  aria-controls={`exp-drawer-${cluster.key}`}
                >
                  <span class="exp-deeper-btn__label">
                    Leggi altre {Math.min(3, cluster.extra.length)}
                  </span>
                  <span class="exp-deeper-btn__arrow" aria-hidden="true" />
                </button>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── AI WORKFLOW ─────────────────────────────────────────────── -->
    <!-- Prima .ai-grid avvolgeva <section> (solo titolo) e le card come
         fratelli: il titolo diventava una cella della grid invece che
         un'intestazione a piena larghezza sopra le card, e ::before
         (ambient glow) + il trigger GSAP del parallax (cv-init.ts)
         coprivano solo il riquadro del titolo. Ora .ai-section avvolge
         tutto, come ogni altra sezione (skills/exp/soft/projects/edu). -->
    <section
      class="ai-section reveal delay-300"
      id="ai-section"
      aria-label="AI-Enhanced Workflow"
    >
      <img
        class="bg-knoll bg-knoll--chess"
        src="/knolling/chess.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title ai-title">
        <span>AI-Enhanced Workflow <span class="ai-title__clip" aria-hidden="true">
          <span class="ai-title__clip-pin"></span>
          <span class="ai-title__clip-text">⚡ AI</span>
        </span></span>

        <span class="section-subtitle"
          >Come l'AI moltiplica l'output senza sostituire il giudizio.</span
        >

      </h2>
      <div class="ai-grid">
        {cvData.aiWorkflow.map((item) => <AiCard {...item} />)}
      </div>
    </section>

    <!-- ── PERSONA — soft skills, mindset e aree in evoluzione, sempre
         visibili. Prima <details> chiuso di default (materiale da "secondo
         colloquio"); header ora in stile catalogo come .exp-cluster__header
         ma statico — non è un accordion, niente chevron/toggle. -->
    <section class="worklife reveal" id="worklife" aria-label="Persona: soft skills, mindset e aree in evoluzione">
      <div class="section-title">
        <span >Persona</span>
        <span class="section-subtitle">Soft skills, mindset e aree in evoluzione</span>
      </div>
      <div class="soft-section" id="soft-skills" aria-label="Soft skills e metodologia">
        <img
          class="bg-knoll bg-knoll--plant"
          src="/knolling/plant.webp"
          aria-hidden="true"
          alt=""
        />
        <div class="worklife__grid">
          <div class="worklife-card">
            <p class="worklife-card__label">Soft Skills</p>
            <ul class="soft-list">
              {
                softSkillsData.map((skill) => (
                  <SoftItem
                    name={skill.name}
                    description={skill.description}
                    modeTags={skill.modeTags}
                    variant="soft"
                  />
                ))
              }
            </ul>
          </div>
          <div class="worklife-card">
            <p class="worklife-card__label">Mindset</p>
            <ul class="method-list">
              {
                cvData.methodology.map((m) => (
                  <SoftItem
                    name={m.name}
                    description={m.description ?? ""}
                    modeTags="tech creative human management"
                    variant="method"
                  />
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── GROWTH AREAS ─────────────────────────────────────────────── -->
    {
      cvData.growthAreas.length > 0 && (
        <section
          class="growth-section reveal"
          id="growth"
          aria-label="Aree di crescita consapevole"
        >
          <h2 class="section-title">
            <span>Consapevolezza</span>
            <span class="section-subtitle">
              Aree in evoluzione, reincorniciate come risorse.
            </span>
          </h2>
          <div class="growth-grid">
            {cvData.growthAreas.map((area) => (
              <article
                class="growth-card cv-card"
                data-tags="tech creative human management"
              >
                <p class="growth-card__label">Area in evoluzione</p>
                <p class="growth-card__name">{area.name}</p>
                <p class="growth-card__reframe">{area.reframe}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <!-- ── FEEDBACK — cosa dicono di me ─────────────────────────────── -->
    {
      cvData.feedbacks.length > 0 && (
        <section class="feedback-section reveal" id="feedback" aria-label="Cosa dicono di me">
          <h2 class="section-title">
            <span>Dicono di me</span>
            <span class="section-subtitle">Parole di chi ci ha lavorato insieme.</span>
          </h2>
          <div class="feedback-grid">
            {cvData.feedbacks.map((f) => (
              <figure class="feedback-card cv-card" data-tags="tech creative human management">
                {f.quote && <blockquote class="feedback-quote">"{f.quote}"</blockquote>}
                {!f.quote && f.keywords.length > 0 && (
                  <ul class="feedback-keywords" aria-label={`Le parole che ${f.name} ha usato per descrivermi`}>
                    {f.keywords.map((k) => (
                      <li class="feedback-kw">{k}</li>
                    ))}
                  </ul>
                )}
                <figcaption class="feedback-who">
                  <b>{f.name}</b>
                  {f.role && <span> · {f.role}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- ── PROJECTS ────────────────────────────────────────────────── -->
    <section class="projects-section reveal" id="projects" aria-label="Progetti personali">
      <img
        class="bg-knoll bg-knoll--compass"
        src="/knolling/compass.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title"><span>Progetti</span></h2>
      <div class="projects-grid">
        {projectsData.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>
    <!-- ── FORMAZIONE & CERTIFICAZIONI ────────────────────────────── -->
    <section class="edu-section reveal" id="education" aria-label="Formazione e certificazioni">
      <div class="edu-header">
        <h2 class="section-title">
          <span>Formazione &amp; Certificazioni</span>
          <span class="section-subtitle">Cronologia di completamento.</span>
        </h2>
        <div class="timeline-legend" aria-hidden="true">
          <span class="tl-legend-chip tl-legend-chip--cert">Certificazione</span>
          <span class="tl-legend-chip tl-legend-chip--edu">Formazione</span>
        </div>
      </div>
      <!-- Cronologia collassata: le voci recenti bastano al primo scan,
           il resto (fino al 2010) si apre con "Mostra tutta la cronologia". -->
      <div class="tl-collapsible" data-tl-expanded="false">
        <ol class="timeline" role="list">
          {
            timelineItems.map((item) => (
              <li class="tl-item" data-type={item.type}>
                <time class="tl-date" datetime={item.date} title={item.date}>
                  {item.dateLabel}
                </time>
                <span class="tl-dot-col" aria-hidden="true">
                  <span class="tl-dot" />
                </span>
                <div class="tl-body">
                  <p class="tl-title">
                    {item.title}
                    {item.inProgress && <span class="tl-wip">in corso</span>}
                  </p>
                  <p class="tl-inst">{item.institution}</p>
                  {item.credentialId && (
                    <p class="tl-cred">ID: {item.credentialId}</p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
        <div class="tl-fade" aria-hidden="true"></div>
      </div>
      <button
        class="skills-expand-btn"
        type="button"
        data-tl-expand-toggle
        data-label-collapsed="Mostra tutta la cronologia"
        data-label-expanded="Mostra meno"
        aria-expanded="false"
      >
        Mostra tutta la cronologia
      </button>
    </section>
  </main>

  <!-- ────────────────────────────────────────────────────────── FOOTER -->
  <footer class="cv-footer">
  {
    cvData.interests.length > 0 && (
      <div class="interests-strip">
        <p class="interests-label">Interessi</p>
        <ul class="interests-chips" role="list">
          {cvData.interests.map((interest) => (
            <li class="interest-chip">{interest}</li>
          ))}
        </ul>
      </div>
    )
  }
  <ContactFooter lang="it" />
  <p class="cv-footer__credit">{cvData.personal.name} · Digital CV</p>
</footer>
</Layout>

<script>
  import "../scripts/cv-init.ts";
</script>

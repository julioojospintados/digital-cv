---
import Layout from "../layouts/Layout.astro";
import { cvData } from "@cv-data";
import "../styles/cv-page.css";
// .work-index-card / .work-chevron — riusati dal CTA portfolio nell'hero,
// stessa identità visiva delle card di /work (vedi hero-portfolio-card sotto).
import "../styles/work-page.css";
import ExpCard from "../components/cards/ExpCard.astro";
import AiCard from "../components/cards/AiCard.astro";
import ProjectCard from "../components/cards/ProjectCard.astro";
import SkillSquare from "../components/cards/SkillSquare.astro";
import SoftItem from "../components/cards/SoftItem.astro";
import ContactFooter from "../components/ContactFooter.astro";
import { buildCvViewModel } from "../lib/cv-view-model";
import { MODES, type Mode } from "../lib/cv-i18n";

export function getStaticPaths() {
  return MODES.map((mode) => ({ params: { mode } }));
}

const { mode } = Astro.params as { mode: Mode };

// Skill, cluster esperienze, timeline, progetti e copy dell'hero arrivano da
// lib/cv-view-model.ts: la stessa logica serve en/cv.astro e ogni lingua
// futura, quindi qui restano solo il mode della route e il render.
// Vedi AGENTS.md → "IT ↔ EN parity".
const {
  modeLabel,
  modeDescription,
  heroTitle,
  heroSummary,
  heroTitles,
  heroSummaries,
  skillViewLabels,
  skillSquares,
  expClusters,
  softSkillsData,
  timelineItems,
  langsWithSteps,
  projectsData,
} = buildCvViewModel({ data: cvData, locale: "it", mode });
---

<Layout
  title={`CV ${modeLabel} — Giulio Occhipinti`}
  description={modeDescription}
  mode={mode}
  showFab
>
  <!-- ────────────────────────────────────────────────────────── NAV -->
  <nav class="cv-nav" id="cv-nav" aria-label="Navigazione principale">
    <go-logo></go-logo>
    <div class="mode-buttons" role="group" aria-label="Scegli modalità di visualizzazione">
      <button
        class:list={["mode-btn", { "is-active": mode === "creative" }]}
        data-nav-mode="creative"
        type="button"
        aria-pressed={mode === "creative" ? "true" : "false"}
      >
        <span class="mode-btn__abbr" aria-hidden="true">WD</span>
        <span class="mode-btn__label">Web &amp; UX</span>
      </button>
      <button
        class:list={["mode-btn", { "is-active": mode === "tech" }]}
        data-nav-mode="tech"
        type="button"
        aria-pressed={mode === "tech" ? "true" : "false"}
      >
        <span class="mode-btn__abbr" aria-hidden="true">SD</span>
        <span class="mode-btn__label">Software Dev</span>
      </button>
      <button
        class:list={["mode-btn", { "is-active": mode === "management" }]}
        data-nav-mode="management"
        type="button"
        aria-pressed={mode === "management" ? "true" : "false"}
      >
        <span class="mode-btn__abbr" aria-hidden="true">PM</span>
        <span class="mode-btn__label">Project Mgr</span>
      </button>
      <button
        class:list={["mode-btn", { "is-active": mode === "human" }]}
        data-nav-mode="human"
        type="button"
        aria-pressed={mode === "human" ? "true" : "false"}
      >
        <span class="mode-btn__abbr" aria-hidden="true">AI</span>
        <span class="mode-btn__label">AI &amp; Digital</span>
      </button>
      <!-- Voce di navigazione, non un mode: apre il cluster personale
           "Fuori orario" e ci scrolla (handler in cv-init.ts). Il divider
           CSS a sinistra segna che è un'altra categoria di azione. -->
      <button class="mode-btn mode-btn--personal" data-nav-personal type="button">
        <span class="mode-btn__label">Fuori orario</span>
      </button>
    </div>
    <!-- Mobile dropdown — sostituisce i 4 pulsanti su ≤640px.
         <details> nativo (stesso pattern del lang-dropdown accanto): le
         opzioni sono <button> reali dentro la lista, quindi Tab/Invio/Spazio
         funzionano senza handler keydown custom — bug di accessibilità
         corretto 2026-07-29 (prima erano <li role="option" tabindex="-1">
         raggiungibili solo dal mouse, con ruoli ARIA che promettevano
         una navigazione da tastiera mai implementata). -->
    <details class="mode-dropdown" id="mode-dropdown">
      <summary
        class="mode-dropdown__trigger"
        id="mode-dropdown-btn"
        aria-label="Scegli modalità di visualizzazione"
      >
        <span class="mode-dropdown__label" id="mode-dropdown-label">
          {
            mode === "tech"
              ? "Software Dev"
              : mode === "creative"
                ? "Web & UX"
                : mode === "management"
                  ? "Project Manager"
                  : "AI & Digital"
          }
        </span>
        <span class="mode-dropdown__chevron" aria-hidden="true">›</span>
      </summary>
      <ul class="mode-dropdown__list" id="mode-dropdown-list" role="list">
        <li>
          <button
            type="button"
            class:list={["mode-dropdown__option", { "is-selected": mode === "creative" }]}
            data-dropdown-mode="creative"
            aria-current={mode === "creative" ? "true" : undefined}
          >
            Web &amp; UX
          </button>
        </li>
        <li>
          <button
            type="button"
            class:list={["mode-dropdown__option", { "is-selected": mode === "tech" }]}
            data-dropdown-mode="tech"
            aria-current={mode === "tech" ? "true" : undefined}
          >
            Software Dev
          </button>
        </li>
        <li>
          <button
            type="button"
            class:list={["mode-dropdown__option", { "is-selected": mode === "management" }]}
            data-dropdown-mode="management"
            aria-current={mode === "management" ? "true" : undefined}
          >
            Project Manager
          </button>
        </li>
        <li>
          <button
            type="button"
            class:list={["mode-dropdown__option", { "is-selected": mode === "human" }]}
            data-dropdown-mode="human"
            aria-current={mode === "human" ? "true" : undefined}
          >
            AI &amp; Digital
          </button>
        </li>
        <li>
          <button
            type="button"
            class="mode-dropdown__option mode-dropdown__option--personal"
            data-dropdown-personal
          >
            Fuori orario
          </button>
        </li>
      </ul>
    </details>
    <!-- Desktop: switch a 2 chip, sempre entrambe le lingue visibili.
         Mobile: <details> nativo, zero JS — libera spazio per il mode-dropdown
         accanto, che su schermi stretti competeva con lo switch a 2 chip. -->
    <div class="lang-switch" aria-label="Lingua / Language">
      <span class="lang-switch__opt lang-switch__opt--active" aria-current="true">IT</span>
      <a href="/en/cv" class="lang-switch__opt" lang="en" aria-label="Switch to English">EN</a>
    </div>
    <details class="lang-dropdown">
      <summary class="lang-dropdown__trigger" aria-label="Lingua / Language">
        <span class="lang-dropdown__label">IT</span>
        <span class="lang-dropdown__chevron" aria-hidden="true">›</span>
      </summary>
      <ul class="lang-dropdown__list" role="list">
        <li class="lang-dropdown__option is-selected" aria-current="true">IT</li>
        <li class="lang-dropdown__option">
          <a href="/en/cv" lang="en" aria-label="Switch to English">EN</a>
        </li>
      </ul>
    </details>
  </nav>

  <!-- Dot-nav verticale — jump diretto tra le sezioni, desktop only -->
  <nav class="section-dots" aria-label="Naviga tra le sezioni">
    <a href="#hero" class="section-dot" aria-label="Home"
      ><span class="section-dot__tip">Home</span></a
    >
    <a href="#skills" class="section-dot" aria-label="Competenze"
      ><span class="section-dot__tip">Competenze</span></a
    >
    <a href="#experience" class="section-dot" aria-label="Esperienze"
      ><span class="section-dot__tip">Esperienze</span></a
    >
    <a href="#ai-section" class="section-dot" aria-label="AI Workflow"
      ><span class="section-dot__tip">AI Workflow</span></a
    >
    <a href="#worklife" class="section-dot" aria-label="Persona"
      ><span class="section-dot__tip">Persona</span></a
    >
    {
      cvData.feedbacks.length > 0 && (
        <a href="#feedback" class="section-dot" aria-label="Dicono di me">
          <span class="section-dot__tip">Dicono di me</span>
        </a>
      )
    }
    <a href="#projects" class="section-dot" aria-label="Progetti"
      ><span class="section-dot__tip">Progetti</span></a
    >
    <a href="#education" class="section-dot" aria-label="Formazione"
      ><span class="section-dot__tip">Formazione</span></a
    >
  </nav>

  <!-- ────────────────────────────────────────────────────────── MAIN -->
  <main class="cv-main" id="main-content">
    <!-- ── HERO ────────────────────────────────────────────────────── -->
    <section class="hero-section" id="hero">
      <img
        class="bg-knoll bg-knoll--laptop"
        src="/knolling/laptop.webp"
        aria-hidden="true"
        alt=""
      />
      <h1 class="hero-name" id="hero-name" aria-label={cvData.personal.name}>
        {
          cvData.personal.name
            .split("")
            .map((char, i) => (
              <span
                class:list={[
                  "hero-char",
                  { "hero-char--go": i === 0 || i === 7 },
                  { "hero-char--space": char === " " },
                ]}
              >
                {char === " " ? "\u00A0" : char}
              </span>
            ))
        }
      </h1>
      <p class="hero-title">{heroTitle}</p>
      <p class="hero-summary">{heroSummary}</p>

      <!-- Titolo/summary sopra sono statici per la route caricata (SSG). Il
           cambio mode via nav è client-side (modeStore, niente navigazione),
           quindi cv-init.ts legge questi dati per riscrivere il testo a runtime
           — stesso pattern del JSON-LD in Layout.astro (script non eseguibile,
           set:html, niente is:inline). Unica fonte di verità: i dizionari qui
           sopra, nessuna duplicazione in TS. -->
      <script
        type="application/json"
        id="hero-copy"
        set:html={JSON.stringify({ titles: heroTitles, summaries: heroSummaries })}
      />

      <p class="hero-tagline">
        Comprendere la radice è l'unico modo per non perdersi lungo i rami.
      </p>

      <!-- Card teaser, non un link testuale: il portfolio è la prova del
           lavoro, merita lo stesso peso visivo delle card su /work (stile
           .work-index-card, work-page.css) invece di sparire dentro il
           paragrafo come un link sottolineato qualunque. -->
      <a href="/work" class="work-index-card hero-portfolio-card work-index-card--pulse">
        <p class="work-index-card__eyebrow">Portfolio</p>
        <p class="work-index-card__role">
          Case study, non un elenco. Processi, decisioni e risultati.
        </p>
        <span class="work-index-card__cta">
          Esplora il portfolio
          <span class="work-chevron" aria-hidden="true"></span>
        </span>
      </a>

      <div class="hero-footer">
        <div class="hero-socials">
          {
            cvData.social.map((s) => (
              <a
                href={s.url}
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${s.platform}${s.label ? ` — ${s.label}` : ""} (apre in nuova scheda)`}
              >
                {s.platform}
              </a>
            ))
          }
        </div>
        <div class="hero-langs">
          {
            langsWithSteps.map((l) => (
              <span class="lang-chip">
                <b>{l.name}</b>
                {/* I quadratini sono aria-hidden e il livello sta in chiaro accanto:
                    prima il livello esisteva solo come aria-label, quindi chi vede
                    lo schermo doveva contare sei quadratini da 5px per sapere se
                    l'inglese è B2 o C1. Ora il testo è la fonte unica — leggibile a
                    occhio e annunciato dagli screen reader senza doppioni. */}
                <span class="lang-cefr" aria-hidden="true">
                  {Array.from({ length: 6 }, (_, i) => (
                    <span
                      class:list={[
                        "lang-dot",
                        { "lang-dot--filled": i < l.steps },
                        { "lang-dot--native": l.steps === 6 },
                      ]}
                    />
                  ))}
                </span>
                <span class="lang-level">{l.level}</span>
              </span>
            ))
          }
        </div>
      </div>

      <!-- Cue in-flow, non fixed: si limita a spingere giù il resto della
           hero e sparisce da solo appena scrolli oltre — niente overlay che
           possa coprire la card portfolio o il footer su mobile. Decorativo:
           la pagina scrolla comunque, non è un controllo. -->
      <div class="hero-scroll-cue" aria-hidden="true">Scroll</div>
    </section>

    <!-- ── SKILLS BENTO + FORCE NETWORK ─────────────────────────── -->
    <!-- Default per viewport (cv-init.ts): CARD su mobile (scannabile in 5s,
         D3 caricato solo al primo switch), GRAFICO su desktop dove ci sono
         spazio e mouse per esplorarlo. -->

    <section
      class="skills-section reveal delay-100"
      id="skills"
      aria-label="Competenze tecniche"
      data-skills-view="cards"
    >
      <img
        class="bg-knoll bg-knoll--multitool"
        src="/knolling/multitool.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title">
        <span>Skills</span>
        <span class="section-subtitle"
          >Livello e glow proporzionali: apri il Grafico per esplorare le connessioni.</span
        >
      </h2>
      <h3 class="skills-sub-title">Competenze tecniche, management e human.</h3>
      <div class="skills-view-toggle" role="group" aria-label="Scegli vista competenze">
        <button
          class="skills-view-btn is-active"
          type="button"
          data-skills-view-button="cards"
          aria-pressed="true">{skillViewLabels.cards}</button
        >
        <button
          class="skills-view-btn"
          type="button"
          data-skills-view-button="graph"
          aria-pressed="false">{skillViewLabels.graph}</button
        >
      </div>
      <div class="skills-stage">
        <div class="skills-stage__panel skills-stage__panel--graph">
          <skill-force-graph></skill-force-graph>
        </div>
        <div class="skills-stage__panel skills-stage__panel--cards">
          <div class="skills-collapsible" data-skills-expanded="false">
            <div
              class="skills-grid"
              role="list"
              aria-label="Competenze tecniche, creative e trasversali"
            >
              {skillSquares.map((skill) => <SkillSquare {...skill} />)}
            </div>
            <div class="skills-fade" aria-hidden="true"></div>
          </div>
          <button
            class="skills-expand-btn"
            type="button"
            data-skills-expand-toggle
            data-label-collapsed="Mostra tutte le competenze"
            data-label-expanded="Mostra meno"
            aria-expanded="false"
          >
            Mostra tutte le competenze
          </button>
        </div>
      </div>
    </section>

    <!-- ── EXPERIENCE ─────────────────────────────────────────────── -->
    <section
      class="exp-section reveal delay-200"
      id="experience"
      aria-label="Esperienze lavorative"
    >
      <img
        class="bg-knoll bg-knoll--flashlight"
        src="/knolling/flashlight.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title">
        <span>Esperienze</span>
        <span class="section-subtitle"
          >{cvData.experience.length} ruoli in 5 paesi: espandi il cluster per esplorare.</span
        >
      </h2>
      <div class="exp-clusters">
        {
          expClusters.map((cluster, clusterIdx) => (
            <div
              class="exp-cluster"
              data-cluster={cluster.key}
              {...(cluster.isDefaultOpen ? { "data-open": "" } : {})}
            >
              <button
                class="exp-cluster__header"
                type="button"
                aria-expanded={cluster.isDefaultOpen ? "true" : "false"}
                aria-controls={`cluster-body-${cluster.key}`}
              >
                <span class="exp-cluster__index" aria-hidden="true">
                  {String(clusterIdx + 1).padStart(2, "0")}
                </span>
                <span class="exp-cluster__name">{cluster.label}</span>
                <span class="exp-cluster__meta">
                  <span class="exp-cluster__count">{cluster.items.length} ruoli</span>
                  <span class="exp-cluster__chevron" aria-hidden="true" />
                </span>
              </button>
              <div class="exp-cluster__body" id={`cluster-body-${cluster.key}`}>
                <div class="exp-grid exp-grid--featured">
                  {cluster.featured.map((exp) => (
                    <ExpCard {...exp} />
                  ))}
                </div>
                {cluster.extra.length > 0 && (
                  <div class="exp-drawer" id={`exp-drawer-${cluster.key}`}>
                    <div class="exp-grid">
                      {cluster.extra.map((exp) => (
                        <ExpCard {...exp} />
                      ))}
                    </div>
                  </div>
                )}
              </div>
              {cluster.extra.length > 0 && (
                <button
                  class="exp-deeper-btn"
                  type="button"
                  data-drawer={cluster.key}
                  aria-controls={`exp-drawer-${cluster.key}`}
                >
                  <span class="exp-deeper-btn__label">
                    Leggi altre {Math.min(3, cluster.extra.length)}
                  </span>
                  <span class="exp-deeper-btn__arrow" aria-hidden="true" />
                </button>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── AI WORKFLOW ─────────────────────────────────────────────── -->
    <!-- Prima .ai-grid avvolgeva <section> (solo titolo) e le card come
         fratelli: il titolo diventava una cella della grid invece che
         un'intestazione a piena larghezza sopra le card, e ::before
         (ambient glow) + il trigger GSAP del parallax (cv-init.ts)
         coprivano solo il riquadro del titolo. Ora .ai-section avvolge
         tutto, come ogni altra sezione (skills/exp/soft/projects/edu). -->
    <section class="ai-section reveal delay-300" id="ai-section" aria-label="AI-Enhanced Workflow">
      <img class="bg-knoll bg-knoll--chess" src="/knolling/chess.webp" aria-hidden="true" alt="" />
      <h2 class="section-title ai-title">
        <span
          >AI-Enhanced Workflow <span class="ai-title__clip" aria-hidden="true">
            <span class="ai-title__clip-pin"></span>
            <span class="ai-title__clip-text">⚡ AI</span>
          </span></span
        >

        <span class="section-subtitle"
          >Come l'AI moltiplica l'output senza sostituire il giudizio.</span
        >
      </h2>
      <div class="ai-grid">
        {cvData.aiWorkflow.map((item) => <AiCard {...item} />)}
      </div>
    </section>

    <!-- ── PERSONA — soft skills, mindset e aree in evoluzione, sempre
         visibili. Prima <details> chiuso di default (materiale da "secondo
         colloquio"); header ora in stile catalogo come .exp-cluster__header
         ma statico — non è un accordion, niente chevron/toggle. -->
    <section
      class="worklife reveal"
      id="worklife"
      aria-label="Persona: soft skills, mindset e aree in evoluzione"
    >
      <div class="section-title">
        <span>Persona</span>
        <span class="section-subtitle">Soft skills, mindset e aree in evoluzione</span>
      </div>
      <div class="soft-section" id="soft-skills" aria-label="Soft skills e metodologia">
        <img
          class="bg-knoll bg-knoll--plant"
          src="/knolling/plant.webp"
          aria-hidden="true"
          alt=""
        />
        <div class="worklife__grid">
          <div class="worklife-card">
            <p class="worklife-card__label">Soft Skills</p>
            <ul class="soft-list">
              {
                softSkillsData.map((skill) => (
                  <SoftItem
                    name={skill.name}
                    description={skill.description}
                    modeTags={skill.modeTags}
                    variant="soft"
                  />
                ))
              }
            </ul>
          </div>
          <div class="worklife-card">
            <p class="worklife-card__label">Mindset</p>
            <ul class="method-list">
              {
                cvData.methodology.map((m) => (
                  <SoftItem
                    name={m.name}
                    description={m.description ?? ""}
                    modeTags="tech creative human management"
                    variant="method"
                  />
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── GROWTH AREAS ─────────────────────────────────────────────── -->
    {
      cvData.growthAreas.length > 0 && (
        <section
          class="growth-section reveal"
          id="growth"
          aria-label="Aree di crescita consapevole"
        >
          <h2 class="section-title">
            <span>Consapevolezza</span>
            <span class="section-subtitle">
              Quello su cui sto ancora lavorando, detto senza giri.
            </span>
          </h2>
          <div class="growth-grid">
            {cvData.growthAreas.map((area) => (
              <article class="growth-card cv-card" data-tags="tech creative human management">
                <p class="growth-card__label">Area in evoluzione</p>
                <p class="growth-card__name">{area.name}</p>
                <p class="growth-card__reframe">{area.reframe}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <!-- ── FEEDBACK — cosa dicono di me ─────────────────────────────── -->
    {
      cvData.feedbacks.length > 0 && (
        <section class="feedback-section reveal" id="feedback" aria-label="Cosa dicono di me">
          <div class="feedback-header">
            <h2 class="section-title">
              <span>Dicono di me</span>
              <span class="section-subtitle">Parole di chi ci ha lavorato insieme.</span>
            </h2>
            {/* Visibili solo se il carousel ha davvero altro da scorrere
                (JS: cv-init.ts misura scrollWidth vs clientWidth). Su
                mobile restano nascoste: lì l'affordance è lo swipe.
                Commento in forma JSX e non HTML perché qui siamo dentro
                un'espressione, dove il commento HTML non è sintassi valida
                (Astro lo tollera, Prettier no) e finirebbe nell'output. */}
            <div class="feedback-nav" data-feedback-nav>
              <button
                class="feedback-nav__btn feedback-nav__btn--prev"
                type="button"
                data-feedback-prev
                aria-label="Feedback precedente"
              >
                <span class="feedback-nav__arrow" aria-hidden="true" />
              </button>
              <button
                class="feedback-nav__btn feedback-nav__btn--next"
                type="button"
                data-feedback-next
                aria-label="Feedback successivo"
              >
                <span class="feedback-nav__arrow" aria-hidden="true" />
              </button>
            </div>
          </div>
          <div
            class="feedback-track"
            data-feedback-track
            tabindex="0"
            aria-label="Elenco feedback, scorri per vederne altri"
          >
            {cvData.feedbacks.map((f) => (
              <figure class="feedback-card cv-card" data-tags="tech creative human management">
                {f.quote && <blockquote class="feedback-quote">{f.quote}</blockquote>}
                {!f.quote && f.keywords.length > 0 && (
                  <ul
                    class="feedback-keywords"
                    aria-label={`Le parole che ${f.name} ha usato per descrivermi`}
                  >
                    {f.keywords.map((k) => (
                      <li class="feedback-kw">{k}</li>
                    ))}
                  </ul>
                )}
                <figcaption class="feedback-who">
                  <b>{f.name}</b>
                  {f.role && <span> · {f.role}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- ── PROJECTS ────────────────────────────────────────────────── -->
    <section class="projects-section reveal" id="projects" aria-label="Progetti personali">
      <img
        class="bg-knoll bg-knoll--compass"
        src="/knolling/compass.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title"><span>Progetti</span></h2>
      <div class="projects-grid">
        {projectsData.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>
    <!-- ── FORMAZIONE & CERTIFICAZIONI ────────────────────────────── -->
    <section class="edu-section reveal" id="education" aria-label="Formazione e certificazioni">
      <div class="edu-header">
        <h2 class="section-title">
          <span>Formazione &amp; Certificazioni</span>
          <span class="section-subtitle">Cronologia di completamento.</span>
        </h2>
        <div class="timeline-legend" aria-hidden="true">
          <span class="tl-legend-chip tl-legend-chip--cert">Certificazione</span>
          <span class="tl-legend-chip tl-legend-chip--edu">Formazione</span>
        </div>
      </div>
      <!-- Cronologia collassata: le voci recenti bastano al primo scan,
           il resto (fino al 2010) si apre con "Mostra tutta la cronologia". -->
      <div class="tl-collapsible" data-tl-expanded="false">
        <ol class="timeline" role="list">
          {
            timelineItems.map((item) => (
              <li class="tl-item" data-type={item.type}>
                <time class="tl-date" datetime={item.date} title={item.date}>
                  {item.dateLabel}
                </time>
                <span class="tl-dot-col" aria-hidden="true">
                  <span class="tl-dot" />
                </span>
                <div class="tl-body">
                  <p class="tl-title">
                    {item.title}
                    {item.inProgress && <span class="tl-wip">in corso</span>}
                  </p>
                  <p class="tl-inst">{item.institution}</p>
                  {item.credentialId && <p class="tl-cred">ID: {item.credentialId}</p>}
                </div>
              </li>
            ))
          }
        </ol>
        <div class="tl-fade" aria-hidden="true"></div>
      </div>
      <button
        class="skills-expand-btn"
        type="button"
        data-tl-expand-toggle
        data-label-collapsed="Mostra tutta la cronologia"
        data-label-expanded="Mostra meno"
        aria-expanded="false"
      >
        Mostra tutta la cronologia
      </button>
    </section>
  </main>

  <!-- ────────────────────────────────────────────────────────── FOOTER -->
  <footer class="cv-footer">
    {
      cvData.interests.length > 0 && (
        <div class="interests-strip">
          <p class="interests-label">Interessi</p>
          <ul class="interests-chips" role="list">
            {cvData.interests.map((interest) => (
              <li class="interest-chip">{interest}</li>
            ))}
          </ul>
        </div>
      )
    }
    <ContactFooter lang="it" />
    <p class="cv-footer__credit">{cvData.personal.name} · Digital CV</p>
  </footer>
</Layout>

<script>
  import "../scripts/cv-init.ts";
</script>

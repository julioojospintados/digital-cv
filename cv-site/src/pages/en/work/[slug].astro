---
import Layout from "../../../layouts/Layout.astro";
// Qui c'era <WorkDesignSystem />, la sezione "Design System" dentro questo
// case study. Documentava il sistema precedente — "quattro luci" quando le
// lenti sono tre, e due riquadri sugli square con glow delle skill, che non
// esistono piu' — quindi mostrava la documentazione di un sistema che non
// c'e'. Sospesa il 2026-08-26 e cancellata lo stesso giorno con il resto del
// sito storico: vive in julioojospintados/old-digital-cv. La vetrina vera e'
// /design-system.
import LangSwitch from "../../../components/LangSwitch.astro";
import { cvDataEn } from "@cv-data-en";
import { lensPath } from "../../../lib/cv-i18n";
import { workKnollIcon, workKnollRatio } from "../../../lib/work-knolling";
import "../../../styles/work-page.css";

export function getStaticPaths() {
  return cvDataEn.projects.filter((p) => !!p.slug).map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = cvDataEn.projects.find((p) => p.slug === slug)!;

const mode = project.primaryMode ?? "tech";
// The case study's object — keyed by slug, not by mode: maps and rationale
// live in lib/work-knolling.ts. Here it stays an atmospheric watermark, but
// it must be the same object the reader just saw on the index card,
// otherwise the page is not the continuation of that click.
const icon = workKnollIcon(slug);
const iconRatio = workKnollRatio(icon);
const email =
  cvDataEn.social.find((s) => s.platform === "Email")?.url ??
  "mailto:giulio.occhipinti.g@gmail.com";

// Steps in cv.en.ts follow the "Research — text..." format: the prefix
// becomes the stop name along the road. A step without the prefix simply
// renders without a title — nothing breaks.
const SEP = " — ";
const processSteps = (project.process ?? []).map((step) => {
  const i = step.indexOf(SEP);
  return i > 0 && i < 48
    ? { title: step.slice(0, i), body: step.slice(i + SEP.length) }
    : { title: null, body: step };
});
const totalSteps = String(processSteps.length).padStart(2, "0");
---

<Layout
  title={`${project.name} — Case Study — Giulio Occhipinti`}
  description={project.description}
  mode={mode}
  lang="en"
  showFab
>
  <nav class="work-nav">
    <go-logo></go-logo>
    <div class="work-nav__right">
      <a href={lensPath(mode, "en")} class="work-back">← Back to CV</a>
      <LangSwitch locale="en" href={`/work/${slug}`} />
    </div>
  </nav>

  <main class="work-main" id="main-content">
    <header class="work-hero">
      <img
        class="work-hero__icon"
        src={`/knolling/${icon}`}
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        style={`aspect-ratio: ${iconRatio};`}
      />
      <p class="work-hero__eyebrow">Case Study</p>
      <h1 class="work-hero__title">{project.name}</h1>
      {project.role && <p class="work-hero__role">{project.role}</p>}
      {
        project.tags && project.tags.length > 0 && (
          <div class="work-hero__tags">
            {project.tags.map((t) => (
              <span class="work-tag">{t}</span>
            ))}
          </div>
        )
      }
      {
        slug === "digital-cv" && (
          <a href="#design-system" class="work-hero__ds-link">
            Explore the design system
            <span class="work-chevron work-chevron--down" aria-hidden="true" />
          </a>
        )
      }
    </header>

    <!-- Horizontal journey: the project's timeline is the road — Problem
         (departure) → process steps (stops) → Measurable outcome (arrival).
         Without JS or with reduced-motion it stays a vertical stack. -->
    {
      processSteps.length > 0 && (
        <section
          class="journey"
          data-journey
          aria-label="From problem to outcome: the project journey"
        >
          <div class="journey__hud" aria-hidden="true">
            <span>
              Step <b data-j-current>00</b>/{totalSteps}
            </span>
            <span class="journey__hud-bar">
              <b data-j-bar />
            </span>
            <span class="journey__hud-km" data-j-km>
              0 m
            </span>
          </div>

          <img
            class="journey__traveler"
            data-j-traveler
            src="/knolling/compass.webp"
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            style="aspect-ratio: 208 / 341;"
          />

          <div class="journey__track" data-j-track>
            <svg
              class="journey__road"
              data-j-road
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path class="journey__road-base" data-j-road-base d="" />
              <path class="journey__road-progress" data-j-road-progress d="" />
            </svg>

            {project.problem && (
              <article class="journey__panel journey__panel--start">
                <img
                  class="journey__stop-icon"
                  data-j-parallax
                  src={`/knolling/${icon}`}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  style={`aspect-ratio: ${iconRatio};`}
                />
                <p class="journey__eyebrow">Departure</p>
                <h2 class="journey__start-title">The problem</h2>
                <p class="journey__text">{project.problem}</p>
                <p class="journey__hint" aria-hidden="true">
                  Scroll to depart <span class="work-chevron" />
                </p>
              </article>
            )}

            {processSteps.map((step, i) => (
              <article class="journey__panel journey__stop" data-stop>
                <p class="journey__step-num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </p>
                <p class="journey__eyebrow">
                  Step {String(i + 1).padStart(2, "0")}/{totalSteps}
                </p>
                {step.title && <h3 class="journey__stop-title">{step.title}</h3>}
                <p class="journey__text">{step.body}</p>
              </article>
            ))}

            {project.outcomes && project.outcomes.length > 0 && (
              <article class="journey__panel journey__panel--end">
                <p class="journey__eyebrow">Arrival</p>
                <h2 class="journey__end-title">Measurable outcome</h2>
                <ul class="journey__outcomes">
                  {project.outcomes.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
              </article>
            )}
          </div>
        </section>
      )
    }

    {
      project.decisions && project.decisions.length > 0 && (
        <section class="work-section" aria-labelledby="work-decisions-title">
          <h2 class="work-section__title" id="work-decisions-title">
            Key decisions
          </h2>
          <div class="work-decisions">
            {project.decisions.map((d) => (
              <article class="work-decision">
                <h3 class="work-decision__title">{d.title}</h3>
                <p class="work-decision__body">{d.body}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      project.learnings && project.learnings.length > 0 && (
        <section class="work-section" aria-labelledby="work-learnings-title">
          <h2 class="work-section__title" id="work-learnings-title">
            What I learned
          </h2>
          <ul class="work-learnings">
            {project.learnings.map((l) => (
              <li class="work-learnings__item">{l}</li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="work-cta">
      <p class="work-cta__text">Interested in working together?</p>
      <div class="work-cta__actions">
        <a
          href={email}
          target="_blank"
          rel="noopener"
          class="work-cta__link work-cta__link--primary">Get in touch</a
        >
        <a href={lensPath(mode, "en")} class="work-cta__link work-cta__link--secondary">
          Back to CV
        </a>
      </div>
    </footer>
  </main>
</Layout>

<script>
  import "../../../islands/GoLogo.lit.ts";
  import "../../../islands/FloatingMenu.lit.ts";
  import "../../../scripts/work-journey.ts";
</script>

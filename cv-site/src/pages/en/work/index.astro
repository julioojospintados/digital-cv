---
import Layout from "../../../layouts/Layout.astro";
import { cvDataEn } from "@cv-data-en";
import "../../../styles/work-page.css";
import WorkIndexCard from "../../../components/cards/WorkIndexCard.astro";
import WorkNav from "../../../components/WorkNav.astro";
import { lensPath } from "../../../lib/cv-i18n";
import { WORK_INDEX_ICON, workKnollSize } from "../../../lib/work-knolling";

const caseStudies = cvDataEn.projects.filter((p) => !!p.slug);
// The header object and its real dimensions: both from work-knolling.ts, so the
// IT and EN indexes cannot end up showing two different ones.
const heroObj = workKnollSize(WORK_INDEX_ICON);
---

<Layout
  title="Portfolio — Giulio Occhipinti"
  description="Giulio Occhipinti's case studies: the starting problem, the design and code choices, the automations with AI and what I learned along the way."
  lang="en"
  mode="creative"
>
  <WorkNav locale="en" back={lensPath("creative", "en")} langHref="/work" />

  <main class="work-main" id="main-content">
    <header class="work-index-hero">
      <p class="work-hero__eyebrow">Portfolio</p>
      <h1 class="work-index-hero__title">Case studies</h1>
      <p class="work-section__text">
        Every project starts from the problem I had in front of me and gets to what came out of it.
        In between are the choices, including the ones I had to redo, which is the part that does
        not fit in one line of a CV.
      </p>
      {
        /* Decorative: empty alt. It is an object on the table, not information —
      read aloud ("compass") it would add nothing for someone about to pick one
      of the case studies, and it would cost the title a line. */
      }
      <img
        class="work-index-hero__obj"
        src={`/knolling/${WORK_INDEX_ICON}`}
        alt=""
        width={heroObj.width}
        height={heroObj.height}
        loading="eager"
        decoding="async"
      />
    </header>

    <div class="work-index-grid">
      {
        caseStudies.map((p, i) => (
          <WorkIndexCard
            name={p.name}
            slug={p.slug!}
            stackIndex={i}
            role={p.role}
            workHref="/en/work"
            ctaLabel="Read the Case study"
          />
        ))
      }
    </div>
  </main>
</Layout>

<script>
  import "../../../islands/GoLogo.lit.ts";
  import { initStackDepth } from "../../../scripts/stack-depth";

  // La pila delle card: la coperta va fuori fuoco mentre la successiva le
  // sale sopra. Stesso script della home, misura più leggera: qui le card
  // sono più piccole e la sfocatura piena le renderebbe una macchia.
  initStackDepth(
    Array.from(document.querySelectorAll<HTMLElement>(".work-index-grid > .work-index-card")),
    { blur: 4, dim: 0.25 },
  );
</script>

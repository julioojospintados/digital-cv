---
import Layout from "../../layouts/Layout.astro";
import "../../styles/privacy-page.css";
import LangSwitch from "../../components/LangSwitch.astro";
import { DEFAULT_MODE, lensPath } from "../../lib/cv-i18n";
import { PRIVACY_BACK_LINK } from "../../lib/flags";

// Il ritorno va alla lente predefinita, costruito e non scritto a mano: la
// versione italiana puntava ancora a /tech, la predefinita di prima.
const back = lensPath(DEFAULT_MODE, "en");
---

<Layout
  title="Privacy — Giulio Occhipinti"
  description="Privacy notice for Giulio Occhipinti's digital CV: what data the site collects, with which tools, and how to manage consent."
  lang="en"
>
  <nav class="privacy-nav">
    <go-logo>GO</go-logo>
    <div class="privacy-nav__right">
      {
        PRIVACY_BACK_LINK && (
          <a href={back} class="privacy-back">
            ← Back to CV
          </a>
        )
      }
      <LangSwitch locale="en" href="/privacy" />
    </div>
  </nav>

  <main class="privacy-main" id="main-content">
    <header class="privacy-hero">
      <p class="privacy-hero__eyebrow">Privacy</p>
      <h1 class="privacy-hero__title">What this site collects.</h1>
      <p class="privacy-section__text">
        A few lines, not an endless legal document: this site is my personal CV, not a commercial
        product.
      </p>
    </header>

    <section class="privacy-section">
      <h2 class="privacy-section__title">Data controller</h2>
      <p class="privacy-section__text">
        Giulio Occhipinti — <a class="privacy-link" href="mailto:giulio.occhipinti.g@gmail.com"
          >giulio.occhipinti.g@gmail.com</a
        >.
      </p>
    </section>

    <section class="privacy-section">
      <h2 class="privacy-section__title">What I collect and with what</h2>
      <ul class="privacy-list">
        <li>
          <strong>PostHog</strong> — browsing stats (page views, events) and session recording (session
          replay, 10 seconds or longer) to understand where the site creates friction. Active from the
          first page load.
        </li>
        <li>
          <strong>Vercel Analytics &amp; Speed Insights</strong> — aggregated traffic and performance
          stats, declared cookieless by the vendor: they stay active without requiring prior consent.
        </li>
      </ul>
    </section>

    <section class="privacy-section">
      <h2 class="privacy-section__title">Why</h2>
      <p class="privacy-section__text">
        Only to understand how the site is browsed and improve its usability. No advertising, no
        commercial profiling, no selling data to third parties.
      </p>
    </section>

    <section class="privacy-section">
      <h2 class="privacy-section__title">Retention</h2>
      <p class="privacy-section__text">
        The site is static: I don't have my own database where your data gets stored. Everything
        collected stays within the systems of the providers listed above, following their default
        retention periods.
      </p>
    </section>

    <section class="privacy-section">
      <h2 class="privacy-section__title">Your rights</h2>
      <p class="privacy-section__text">
        Access, rectification, erasure, objection: write to the email above and I'll answer
        directly. You can also contact the <a
          class="privacy-link"
          href="https://www.garanteprivacy.it"
          target="_blank"
          rel="noopener noreferrer">Italian Data Protection Authority (Garante)</a
        >.
      </p>
    </section>
  </main>
</Layout>

<script>
  import "../../islands/GoLogo.lit.ts";
</script>

---
import Layout from '../../layouts/Layout.astro';
import '../../styles/index-page.css';
---

<Layout
  title="Giulio Occhipinti — Digital CV"
  description="Interactive CV of Giulio Occhipinti: Digital Innovation Consultant & Technical Partner for SMBs."
  lang="en"
>

  <div id="preloader" aria-hidden="true">
    <div class="pre-logo">
      <span id="pre-G" class="pre-go-letter">G</span>
      <span id="pre-O" class="pre-go-letter">O</span>
    </div>
    <div class="pre-bar"></div>
  </div>

  <div class="entry-root" id="entry-root">

    <div class="knolling-stage" id="knolling-stage" aria-hidden="true">
      <img class="knoll-item" data-modes="creative human"  src="/knolling/megaphone.png"   alt="" loading="eager" style="--kx:7%;--ky:14%;--kr:0deg;--ks:0.82;">
      <img class="knoll-item" data-modes="tech"            src="/knolling/flashlight.webp" alt="" loading="eager" style="--kx:9%;--ky:38%;--kr:0deg;--ks:1.2;--kfx:-1;">
      <img class="knoll-item" data-modes="management"      src="/knolling/multitool.png"   alt="" loading="eager" style="--kx:7%;--ky:62%;--kr:0deg;--ks:0.85;">
      <img class="knoll-item" data-modes="creative"        src="/knolling/camera.png"      alt="" loading="eager" style="--kx:7%;--ky:86%;--kr:0deg;--ks:0.8;">
      <img class="knoll-item" data-modes="management"      src="/knolling/chess.png"       alt="" loading="eager" style="--kx:91%;--ky:14%;--kr:0deg;--ks:0.52;">
      <img class="knoll-item" data-modes="tech"            src="/knolling/laptop.png"      alt="" loading="eager" style="--kx:91%;--ky:38%;--kr:0deg;--ks:0.75;">
      <img class="knoll-item" data-modes="management"      src="/knolling/compass.png"     alt="" loading="eager" style="--kx:91%;--ky:62%;--kr:0deg;--ks:0.65;">
      <img class="knoll-item" data-modes="human"           src="/knolling/plant.png"       alt="" loading="eager" style="--kx:91%;--ky:86%;--kr:0deg;--ks:0.72;">
    </div>

    <main class="entry-main" id="main-content">

      <header class="entry-header" id="entry-header">
        <p class="entry-label" id="entry-label">Digital CV</p>
        <h1 class="entry-name" id="entry-name" aria-label="Giulio Occhipinti">
          <span class="name-word" aria-hidden="true">Giulio</span>
          <span class="name-word" aria-hidden="true">Occhipinti</span>
        </h1>
        <p class="entry-tagline" id="entry-tagline">
          I accelerate SMB growth with Technology, Design and Method.
        </p>
      </header>

      <!-- Mobile knolling zone -->
      <div class="knolling-mob" aria-hidden="true">
        <div class="knoll-wrap"><img class="knoll-m" data-modes="creative human"  src="/knolling/megaphone.png"   alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="tech"            src="/knolling/laptop.png"      alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="management"      src="/knolling/compass.png"     alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="human"           src="/knolling/plant.png"       alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="tech"            src="/knolling/flashlight.webp" alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="management"      src="/knolling/chess.png"       alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="creative"        src="/knolling/camera.png"      alt="" loading="eager"></div>
        <div class="knoll-wrap"><img class="knoll-m" data-modes="management"      src="/knolling/multitool.png"   alt="" loading="eager"></div>
      </div>

      <section class="mode-cards" id="mode-cards" aria-label="Choose your perspective">
        <button class="mode-card" data-mode="tech" id="card-tech" type="button">
          <span class="mode-card__label">Software Developer</span>
          <span class="mode-card__desc">Automation, AI and architectures</span>
          <span class="mode-card__go" data-href="/en/cv" role="link" tabindex="-1" aria-hidden="true"><span class="go-text">GO to Software Developer</span><span class="go-icon">↗</span></span>
        </button>

        <button class="mode-card" data-mode="creative" id="card-creative" type="button">
          <span class="mode-card__label">Web &amp; UX Designer</span>
          <span class="mode-card__desc">Brand, aesthetics and interfaces</span>
          <span class="mode-card__go" data-href="/en/cv" role="link" tabindex="-1" aria-hidden="true"><span class="go-text">GO to Web &amp; UX Designer</span><span class="go-icon">↗</span></span>
        </button>

        <button class="mode-card" data-mode="management" id="card-management" type="button">
          <span class="mode-card__label">Project Manager</span>
          <span class="mode-card__desc">Lean Agile and short sprints</span>
          <span class="mode-card__go" data-href="/en/cv" role="link" tabindex="-1" aria-hidden="true"><span class="go-text">GO to Project Manager</span><span class="go-icon">↗</span></span>
        </button>

        <button class="mode-card" data-mode="human" id="card-human" type="button">
          <span class="mode-card__label">AI &amp; Digital Specialist</span>
          <span class="mode-card__desc">Storytelling and strategy</span>
          <span class="mode-card__go" data-href="/en/cv" role="link" tabindex="-1" aria-hidden="true"><span class="go-text">GO to AI &amp; Digital Specialist</span><span class="go-icon">↗</span></span>
        </button>
      </section>

    </main>
  </div>

  <!-- Scroll cue -->
  <p class="scroll-cue" aria-hidden="true">scroll ↓</p>

  <!-- ── PROFILE SECTIONS ── -->
  <div class="profiles-root" aria-label="Professional profiles">

    <section class="profile-section" data-mode="tech">
      <div class="profile-inner">
        <div class="profile-content">
          <p class="profile-eyebrow">Software Developer</p>
          <h2 class="profile-title">Automation,<br>AI and architectures.</h2>
          <p class="profile-desc">6+ years on Angular, Lit, TypeScript and MCP architectures. High-traffic enterprise systems, AI workflows and automation for SMBs that want to scale without hiring an entire team.</p>
          <a href="/en/cv" class="profile-cta">GO to Software Developer <span aria-hidden="true">↗</span></a>
        </div>
        <div class="profile-deco" aria-hidden="true"><span class="profile-deco__text">SD</span><img class="profile-knoll-img" src="/knolling/laptop.png" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>

    <section class="profile-section" data-mode="creative">
      <div class="profile-inner">
        <div class="profile-content">
          <p class="profile-eyebrow">Web &amp; UX Designer</p>
          <h2 class="profile-title">Brand,<br>aesthetics and interfaces.</h2>
          <p class="profile-desc">IBM certified. UX Research, wireframing, Figma, design systems and advanced GSAP animations. Digital experiences that blend beauty, usability and measurable brand impact.</p>
          <a href="/en/cv" class="profile-cta">GO to Web &amp; UX Designer <span aria-hidden="true">↗</span></a>
        </div>
        <div class="profile-deco" aria-hidden="true"><span class="profile-deco__text">WD</span><img class="profile-knoll-img" src="/knolling/camera.png" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>

    <section class="profile-section" data-mode="management">
      <div class="profile-inner">
        <div class="profile-content">
          <p class="profile-eyebrow">Project Manager</p>
          <h2 class="profile-title">Lean Agile<br>and short sprints.</h2>
          <p class="profile-desc">Technical Partner for SMBs. 1–2 week sprints, business-oriented backlog, real impactScore at every release. The team becomes autonomous — no dependency on the consultant.</p>
          <a href="/en/cv" class="profile-cta">GO to Project Manager <span aria-hidden="true">↗</span></a>
        </div>
        <div class="profile-deco" aria-hidden="true"><span class="profile-deco__text">PM</span><img class="profile-knoll-img" src="/knolling/chess.png" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>

    <section class="profile-section" data-mode="human">
      <div class="profile-inner">
        <div class="profile-content">
          <p class="profile-eyebrow">AI &amp; Digital Specialist</p>
          <h2 class="profile-title">Storytelling<br>and strategy.</h2>
          <p class="profile-desc">Artificial intelligence won't replace people, but it will reward those who know how to govern it. I build automated workflows to increase project productivity, combining technical skills with digital storytelling from my background in marketing and theatre. Because code without a story goes nowhere.</p>
          <a href="/en/cv" class="profile-cta">GO to AI &amp; Digital Specialist <span aria-hidden="true">↗</span></a>
        </div>
        <div class="profile-deco" aria-hidden="true"><span class="profile-deco__text">AI</span><img class="profile-knoll-img" src="/knolling/plant.png" alt="" loading="lazy" decoding="async"></div>
      </div>
    </section>

  </div>

  <div id="launch-overlay" aria-hidden="true"></div>

  <!-- Language switch — fixed top-right -->
  <a href="/" class="lang-switch" aria-label="Passa alla versione italiana">IT</a>

</Layout>

<script>
  import '../../scripts/index-init.ts';
</script>

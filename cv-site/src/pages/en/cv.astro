---
import Layout from "../../layouts/Layout.astro";
import { cvDataEn } from "@cv-data-en";
import "../../styles/cv-page.css";
// .work-index-card / .work-chevron — reused by the hero portfolio CTA, same
// visual identity as the /work cards (see hero-portfolio-card below).
import "../../styles/work-page.css";
import ExpCard from "../../components/cards/ExpCard.astro";
import AiCard from "../../components/cards/AiCard.astro";
import ProjectCard from "../../components/cards/ProjectCard.astro";
import SkillSquare from "../../components/cards/SkillSquare.astro";
import SoftItem from "../../components/cards/SoftItem.astro";
import ContactFooter from "../../components/ContactFooter.astro";
import {
  EXP_CLUSTER_DEFS,
  PROJ_CARD_META,
  type ClusterRef,
} from "../../lib/exp-clusters";

// Hero copy — EN page is always static, default persona is 'tech' (see
// mode-buttons comment below: mode switch only filters cards client-side,
// it doesn't re-render hero text). Mirrors the "tech" entry of heroTitles/
// heroSummaries in [mode].astro — same "Design first, Tech as a tool"
// framing (see memory "posizionamento-ux-ui-first").

const heroTitle =
  "Development in service of design: Angular, Lit, AI Workflow.";
const heroSummary =
  "I build interfaces with Angular, Lit and TypeScript, and I integrate AI tooling to move faster without losing quality. At ALTEN Italia I developed design systems and architecture for Aruba and Intesa San Paolo. This site, for example, I built with GitHub Copilot and Claude as operational assistants.";

// ── Skill level labels (English) ───────────────────────────────────────────
const LEVEL_EN: Record<string, string> = {
  Base: "Basic",
  Intermedio: "Intermediate",
  Avanzato: "Advanced",
  Esperto: "Expert",
};

type SkillSquareSource = {
  name: string;
  shortName?: string;
  domain?: "tech" | "human" | "creative" | "management" | "ai";
  level?: string;
  weight?: number;
  mastery?: number;
};

// ── Skill mode-tag sets ────────────────────────────────────────────────────
const TECH_SKILL_SET = new Set([
  "Angular",
  "HTML5",
  "CSS / SCSS",
  "TypeScript",
  "JavaScript",
  "Lit",
  "RXJS",
  "NGRX",
  "WebComponents",
  "React",
  "Git",
  "Bootstrap",
  "Material Design",
  "GraphQL",
  "SQL",
  "Jest",
  "Node.js",
  "REST API",
  "Spring",
  "JSF",
  "MCP Protocol",
  "Prompt Engineering",
  "GSAP",
  "Astro",
  "Hono",
]);
const CREATIVE_SKILL_SET = new Set([
  "Figma",
  "SEO",
  "SEM",
  "UX Research",
  "Wireframing",
  "Video editing",
  "Wordpress",
  "Adobe Suite",
  "Typography",
]);
const DUAL_SKILL_SET = new Set([
  "Accessibility / WCAG",
  "UX Research",
  "Wireframing",
  "Figma",
]);

function deriveSkillLevel(mastery = 65): string {
  if (mastery >= 85) return "Esperto";
  if (mastery >= 70) return "Avanzato";
  if (mastery >= 50) return "Intermedio";
  return "Base";
}

function skillModeTags(skill: SkillSquareSource): string {
  const tags = new Set<string>();

  if (skill.domain) {
    tags.add(skill.domain === "ai" ? "tech" : skill.domain);
  }

  if (TECH_SKILL_SET.has(skill.name)) {
    tags.add("tech");
  }

  if (CREATIVE_SKILL_SET.has(skill.name) || DUAL_SKILL_SET.has(skill.name)) {
    tags.add("creative");
  }

  if (tags.size === 0) {
    tags.add("tech");
    tags.add("creative");
    tags.add("human");
    tags.add("management");
  }

  return Array.from(tags).join(" ");
}

// ── Skill Grid ─────────────────────────────────────────────────────────────
const LEVEL_BORDERS: Record<string, number> = {
  Base: 1,
  Intermedio: 2,
  Avanzato: 3,
  Esperto: 4,
  Basic: 1,
  Intermediate: 2,
  Advanced: 3,
  Expert: 4,
};
function toSkillSquare(skill: SkillSquareSource) {
  const level = skill.level ?? deriveSkillLevel(skill.mastery);
  return {
    name: skill.name,
    shortName: skill.shortName,
    level: LEVEL_EN[level] ?? level,
    borderPx: LEVEL_BORDERS[level] ?? 1,
    isGlow: level === "Avanzato" || level === "Esperto",
    modeTags: skillModeTags(skill),
    weight: skill.weight ?? 1,
  };
}

const skillSquares = [
  ...cvDataEn.technicalSkills.map((skill) => toSkillSquare(skill)),
  ...cvDataEn.softSkills
    .filter(
      (skill) => skill.domain === "human" || skill.domain === "management",
    )
    .map((skill) => toSkillSquare(skill)),
  ...cvDataEn.transversalSkills
    .filter(
      (skill) => skill.domain === "human" || skill.domain === "management",
    )
    .map((skill) => toSkillSquare(skill)),
].sort((a, b) => {
  const activeDelta =
    Number(isActiveSkill(b.modeTags)) - Number(isActiveSkill(a.modeTags));
  if (activeDelta !== 0) return activeDelta;

  const areaA = (a.weight ?? 1) * (LEVEL_BORDERS[a.level] ?? 1);
  const areaB = (b.weight ?? 1) * (LEVEL_BORDERS[b.level] ?? 1);
  if (areaA !== areaB) return areaB - areaA;

  return a.name.localeCompare(b.name);
});

function isActiveSkill(modeTags: string): boolean {
  // EN page is always static; default mode is 'tech'
  const tags = modeTags.split(" ");
  return tags.includes("tech") || tags.includes("ai");
}

const skillViewLabels = {
  graph: "Graph",
  cards: "Cards",
} as const;

// ── Experience clusters — shared IT/EN definition in lib/exp-clusters.ts.
// Each ref becomes a card: the same experience can appear in more clusters
// with the right facet (role/description/highlights for that lens).
const AI_SKILL_HINTS = [
  "MCP Protocol",
  "Prompt Engineering",
  "GitHub Copilot",
  "Claude",
  "Cursor",
  "AI Orchestration",
  "MCP",
];

function refToCard(ref: ClusterRef, clusterTags: string) {
  if ("proj" in ref) {
    const p = cvDataEn.projects[ref.proj];
    const meta = PROJ_CARD_META[ref.proj];
    if (!p) return null;
    return {
      company: p.name,
      role: meta?.role.en ?? "",
      startYear: meta?.startYear ?? "",
      endYear: meta?.endYear ?? meta?.startYear ?? "",
      location: meta?.location?.en ?? "",
      remote: false,
      description: p.description,
      highlights: [] as string[],
      skills: p.tags ?? [],
      modeTags: clusterTags,
      aiAugmented: false,
    };
  }
  const exp = cvDataEn.experience[ref.exp];
  if (!exp) return null;
  const facet = ref.facet
    ? exp.facets?.find((f) => f.mode === ref.facet)
    : undefined;
  return {
    company: exp.company,
    role: facet?.role ?? exp.role,
    startYear: exp.startDate.substring(0, 4),
    endYear: exp.endDate === "present" ? "present" : exp.endDate.substring(0, 4),
    location: exp.location ?? "",
    remote: exp.remote ?? false,
    description: facet?.description ?? exp.description,
    highlights: facet?.highlights ?? exp.highlights ?? [],
    skills: exp.skills ?? [],
    modeTags: clusterTags,
    aiAugmented: !!(
      exp.tags?.includes("ai-orchestration") ||
      exp.skills?.some((s: string) => AI_SKILL_HINTS.includes(s))
    ),
  };
}

const FEATURED_N = 3;
const expClustersEn = EXP_CLUSTER_DEFS.map((cluster) => {
  const items = cluster.refs
    .map((r) => refToCard(r, cluster.tags))
    .filter((c): c is NonNullable<typeof c> => c !== null);
  return {
    key: cluster.key,
    label: cluster.labels.en,
    isDefaultOpen: cluster.key === "tech", // EN page is always static at 'tech'
    items,
    featured: items.slice(0, FEATURED_N),
    extra: items.slice(FEATURED_N),
  };
});

// ── Soft skills mode tags ─────────────────────────────────────────────────
// One entry per cvDataEn.softSkills item, same order. Mirrors [mode].astro:
// the list used to have 9 tags for 11 skills, so "Active listening" and
// "Assertiveness" (added later) stole the tags meant for "Aesthetic
// sensibility" and "T-shaped thinking".
const SOFT_MODE_TAGS = [
  "human creative", // Effective communication
  "creative human", // Applied creativity
  "human", // Cultural adaptability
  "human management", // Relational intelligence
  "tech human management", // Lateral problem solving
  "tech human management", // Strategic autonomy
  "human management", // Resilience and adaptive thinking
  "human management", // Active listening
  "creative", // Aesthetic sensibility
  "tech creative human management", // T-shaped thinking
];

// Index-based maps must stay aligned with the data: failing the build beats
// shipping a silently wrong visual emphasis.
for (const cluster of EXP_CLUSTER_DEFS)
  for (const ref of cluster.refs) {
    if ("exp" in ref && !cvDataEn.experience[ref.exp])
      throw new Error(
        `Cluster "${cluster.key}": exp ref ${ref.exp} outside cvDataEn.experience — update lib/exp-clusters.ts.`,
      );
    if ("proj" in ref && !cvDataEn.projects[ref.proj])
      throw new Error(
        `Cluster "${cluster.key}": proj ref ${ref.proj} outside cvDataEn.projects — update lib/exp-clusters.ts.`,
      );
    if ("exp" in ref && ref.facet && !cvDataEn.experience[ref.exp].facets?.some((f) => f.mode === ref.facet))
      throw new Error(
        `Cluster "${cluster.key}": experience ${ref.exp} has no "${ref.facet}" facet — add it in cv.en.ts.`,
      );
  }
if (SOFT_MODE_TAGS.length !== cvDataEn.softSkills.length)
  throw new Error(
    `SOFT_MODE_TAGS (${SOFT_MODE_TAGS.length}) out of sync with cvDataEn.softSkills (${cvDataEn.softSkills.length}): update the map in en/cv.astro.`,
  );

const softSkillsData = cvDataEn.softSkills.map((skill, i) => ({
  name: skill.name,
  description: skill.description ?? "",
  modeTags: SOFT_MODE_TAGS[i] ?? "tech creative human",
}));

// ── Timeline ───────────────────────────────────────────────────────────────
const MONTHS_EN = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
function isoToLabel(iso: string): string {
  const [y, m] = iso.split("-");
  return m ? `${MONTHS_EN[parseInt(m, 10) - 1]} ${y}` : y;
}
const timelineItems = [
  ...cvDataEn.education.map((e) => ({
    date: e.endDate,
    dateLabel: isoToLabel(e.endDate),
    title: `${e.degree}${e.field ? ` — ${e.field}` : ""}`,
    institution: e.institution,
    type: "edu" as const,
    inProgress: false,
    credentialId: undefined as string | undefined,
  })),
  ...cvDataEn.certifications.map((c) => ({
    date: c.date,
    dateLabel: isoToLabel(c.date),
    title: c.name,
    institution: c.issuer,
    type: "cert" as const,
    inProgress: c.inProgress ?? false,
    credentialId: c.credentialId,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

// ── CEFR steps ─────────────────────────────────────────────────────────────
const CEFR_STEPS: Record<string, number> = {
  Madrelingua: 6,
  Native: 6,
  C2: 6,
  C1: 5,
  B2: 4,
  B1: 3,
  A2: 2,
  A1: 1,
};
const langsWithSteps = cvDataEn.languages.map((l) => ({
  ...l,
  steps: CEFR_STEPS[l.level] ?? 3,
}));

// ── Projects ───────────────────────────────────────────────────────────────
const PROJECT_TAGS_MAP: Record<string, string> = {
  Cinema: "creative",
  React: "tech",
  Lit: "tech",
  WebComponents: "tech",
  "Event management": "human",
  Poetry: "creative human",
  Poesia: "creative human",
  Creativity: "creative",
  "Tour management": "creative management",
  "Content Strategy": "creative",
  "Digital marketing": "creative management",
};

const projectsData = cvDataEn.projects.slice(0, 6).map((p) => {
  const tags = p.tags ?? [];
  const modes = new Set<string>();
  tags.forEach((t) => {
    const mapped = PROJECT_TAGS_MAP[t];
    if (mapped) mapped.split(" ").forEach((m) => modes.add(m));
  });
  if (p.primaryMode) modes.add(p.primaryMode);
  const modeTags =
    modes.size > 0 ? Array.from(modes).join(" ") : "tech creative human";
  return { name: p.name, description: p.description, modeTags, slug: p.slug };
})
  // EN page is always static at 'tech' — same mode-first logic as [mode].astro.
  .sort((a, b) => Number(b.modeTags.includes("tech")) - Number(a.modeTags.includes("tech")));
---

<Layout
  title="CV — Giulio Occhipinti"
  description="Interactive CV: IBM-certified UX/UI & Web Designer, Creative Technologist, AI & Digital Specialist and Agile Project Manager."
  lang="en"
  showFab
>
  <!-- ────────────────────────────────────────────────────────── NAV -->
  <nav class="cv-nav" id="cv-nav" aria-label="Main navigation">
    <go-logo></go-logo>
    <div class="mode-buttons" role="group" aria-label="Choose display mode">
      <button
        class="mode-btn is-active"
        data-nav-mode="tech"
        type="button"
        aria-pressed="true"
      >
        <span class="mode-btn__abbr" aria-hidden="true">SD</span>
        <span class="mode-btn__label">Software Dev</span>
      </button>
      <button
        class="mode-btn"
        data-nav-mode="creative"
        type="button"
        aria-pressed="false"
      >
        <span class="mode-btn__abbr" aria-hidden="true">WD</span>
        <span class="mode-btn__label">Web &amp; UX</span>
      </button>
      <button
        class="mode-btn"
        data-nav-mode="management"
        type="button"
        aria-pressed="false"
      >
        <span class="mode-btn__abbr" aria-hidden="true">PM</span>
        <span class="mode-btn__label">Project Mgr</span>
      </button>
      <button
        class="mode-btn"
        data-nav-mode="human"
        type="button"
        aria-pressed="false"
      >
        <span class="mode-btn__abbr" aria-hidden="true">AI</span>
        <span class="mode-btn__label">AI &amp; Digital</span>
      </button>
      <!-- Navigation entry, not a mode: opens the "Off the clock" personal
           cluster and scrolls to it (handler in cv-init.ts). -->
      <button class="mode-btn mode-btn--personal" data-nav-personal type="button">
        <span class="mode-btn__label">Off the clock</span>
      </button>
    </div>
    <!-- Mobile dropdown -->
    <div class="mode-dropdown" id="mode-dropdown">
      <button
        class="mode-dropdown__trigger"
        id="mode-dropdown-btn"
        type="button"
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <span class="mode-dropdown__label" id="mode-dropdown-label">Software Dev</span>
        <span class="mode-dropdown__chevron" aria-hidden="true">›</span>
      </button>
      <ul
        class="mode-dropdown__list"
        id="mode-dropdown-list"
        role="listbox"
        aria-labelledby="mode-dropdown-btn"
      >
        <li class="mode-dropdown__option is-selected" role="option" data-dropdown-mode="tech" tabindex="-1">Software Dev</li>
        <li class="mode-dropdown__option" role="option" data-dropdown-mode="creative" tabindex="-1">Web &amp; UX</li>
        <li class="mode-dropdown__option" role="option" data-dropdown-mode="management" tabindex="-1">Project Manager</li>
        <li class="mode-dropdown__option" role="option" data-dropdown-mode="human" tabindex="-1">AI &amp; Digital</li>
        <li class="mode-dropdown__option mode-dropdown__option--personal" role="option" data-dropdown-personal tabindex="-1">Off the clock</li>
      </ul>
    </div>
    <!-- Desktop: switch a 2 chip, sempre entrambe le lingue visibili.
         Mobile: <details> nativo, zero JS — libera spazio per il mode-dropdown
         accanto, che su schermi stretti competeva con lo switch a 2 chip. -->
    <div class="lang-switch" aria-label="Lingua / Language">
      <a href="/tech" class="lang-switch__opt" lang="it" aria-label="Passa all'italiano">IT</a>
      <span class="lang-switch__opt lang-switch__opt--active" aria-current="true">EN</span>
    </div>
    <details class="lang-dropdown">
      <summary class="lang-dropdown__trigger" aria-label="Lingua / Language">
        <span class="lang-dropdown__label">EN</span>
        <span class="lang-dropdown__chevron" aria-hidden="true">›</span>
      </summary>
      <ul class="lang-dropdown__list" role="list">
        <li class="lang-dropdown__option">
          <a href="/tech" lang="it" aria-label="Passa all'italiano">IT</a>
        </li>
        <li class="lang-dropdown__option is-selected" aria-current="true">EN</li>
      </ul>
    </details>
  </nav>

  <!-- Vertical dot-nav — direct jump between sections, desktop only -->
  <nav class="section-dots" aria-label="Jump between sections">
    <a href="#hero" class="section-dot" aria-label="Home"><span class="section-dot__tip">Home</span></a>
    <a href="#skills" class="section-dot" aria-label="Skills"><span class="section-dot__tip">Skills</span></a>
    <a href="#experience" class="section-dot" aria-label="Experience"><span class="section-dot__tip">Experience</span></a>
    <a href="#ai-section" class="section-dot" aria-label="AI Workflow"><span class="section-dot__tip">AI Workflow</span></a>
    <a href="#worklife" class="section-dot" aria-label="Character"><span class="section-dot__tip">Character</span></a>
    {
      cvDataEn.feedbacks.length > 0 && (
        <a href="#feedback" class="section-dot" aria-label="What people say">
          <span class="section-dot__tip">What people say</span>
        </a>
      )
    }
    <a href="#projects" class="section-dot" aria-label="Projects"><span class="section-dot__tip">Projects</span></a>
    <a href="#education" class="section-dot" aria-label="Education"><span class="section-dot__tip">Education</span></a>
  </nav>

  <!-- ────────────────────────────────────────────────────────── MAIN -->
  <main class="cv-main" id="main-content">
    <!-- ── HERO ────────────────────────────────────────────────────── -->
    <section class="hero-section" id="hero">
      <img
        class="bg-knoll bg-knoll--laptop"
        src="/knolling/laptop.webp"
        aria-hidden="true"
        alt=""
      />
      <h1 class="hero-name" id="hero-name" aria-label={cvDataEn.personal.name}>
        {
          cvDataEn.personal.name
            .split("")
            .map((char, i) => (
              <span
                class:list={[
                  "hero-char",
                  { "hero-char--go": i === 0 || i === 7 },
                  { "hero-char--space": char === " " },
                ]}
              >
                {char === " " ? "\u00A0" : char}
              </span>
            ))
        }
      </h1>
      <p class="hero-title">{heroTitle}</p>
      <p class="hero-summary">{heroSummary}</p>

      <!-- How I work, in four sentences: principles that hold up in an
           interview. Numeric chips removed on request (2026-07-15):
           unmeasured percentages weakened credibility. Mirrors [mode].astro. -->
      <ul class="hero-stats" aria-label="In short">
        <li class="hero-stat">I find solutions that speed up the work downstream.</li>
        <li class="hero-stat">I've worked solo and in teams of 20+ people.</li>
        <li class="hero-stat">I look for ways to make other people's work easier.</li>
        <li class="hero-stat">I start from the why: that's where the root of things is.</li>
      </ul>

      <!-- Card teaser, not a plain text link: the portfolio is proof of the
           work, it deserves the same visual weight as the cards on /work
           (.work-index-card, work-page.css) instead of blending into the
           paragraph as just another underlined link. -->
      <a href="/en/work" class="work-index-card hero-portfolio-card work-index-card--pulse">
        <p class="work-index-card__eyebrow">Portfolio</p>
        <p class="work-index-card__role">Case studies, not a list. <br/> In the portfolio I tell the full process behind every project: problem, decisions, measurable outcomes.</p>
        <span class="work-index-card__cta">
          Explore the portfolio
          <span class="work-chevron" aria-hidden="true"></span>
        </span>
      </a>

      <div class="hero-footer">
        <div class="hero-socials">
          {
            cvDataEn.social.map((s) => (
              <a
                href={s.url}
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.platform}
              </a>
            ))
          }
          <a href="/en/work" class="social-link social-link--portfolio" aria-label="Go to the portfolio with case studies">
            <span class="social-link__icon" aria-hidden="true"></span>
            Portfolio
          </a>
        </div>
        <div class="hero-langs">
          {
            langsWithSteps.map((l) => (
              <span class="lang-chip">
                <b>{l.name}</b>
                <span class="lang-cefr" aria-label={l.level} title={l.level}>
                  {Array.from({ length: 6 }, (_, i) => (
                    <span
                      class:list={[
                        "lang-dot",
                        { "lang-dot--filled": i < l.steps },
                        { "lang-dot--native": l.steps === 6 },
                      ]}
                    />
                  ))}
                </span>
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── SKILLS BENTO + FORCE NETWORK ──────────────────────── -->
    <!-- Default per viewport (cv-init.ts): CARDS on mobile (scannable in 5s,
         D3 loaded only on first switch), GRAPH on desktop where there's
         room and a mouse to explore it. -->
    <section
      class="skills-section reveal delay-100"
      id="skills"
      aria-label="Technical skills"
      data-skills-view="cards"
    >
      <img
        class="bg-knoll bg-knoll--multitool"
        src="/knolling/multitool.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title">
        <span>Skills</span>
        <span class="section-subtitle"
          >Level and glow proportional: open the Graph to explore connections.</span
        >
      </h2>
      <h3 class="skills-sub-title">
        Technical, management and human skills.
      </h3>
      <div
        class="skills-view-toggle"
        role="tablist"
        aria-label="Choose skills view"
      >
        <button
          class="skills-view-btn is-active"
          type="button"
          data-skills-view-button="cards"
          aria-pressed="true">{skillViewLabels.cards}</button
        >
        <button
          class="skills-view-btn"
          type="button"
          data-skills-view-button="graph"
          aria-pressed="false">{skillViewLabels.graph}</button
        >
      </div>
      <div class="skills-stage">
        <div class="skills-stage__panel skills-stage__panel--graph">
          <skill-force-graph></skill-force-graph>
        </div>
        <div class="skills-stage__panel skills-stage__panel--cards">
          <div class="skills-collapsible" data-skills-expanded="false">
            <div class="skills-grid">
              {skillSquares.map((skill) => <SkillSquare {...skill} />)}
            </div>
            <div class="skills-fade" aria-hidden="true" />
          </div>
          <button
            class="skills-expand-btn"
            type="button"
            data-skills-expand-toggle
            data-label-collapsed="Show all skills"
            data-label-expanded="Show less"
            aria-expanded="false"
          >
            Show all skills
          </button>
        </div>
      </div>
    </section>

    <!-- ── EXPERIENCE ─────────────────────────────────────────────── -->
    <section class="exp-section reveal delay-200" id="experience" aria-label="Work experience">
      <img
        class="bg-knoll bg-knoll--flashlight"
        src="/knolling/flashlight.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title">
        <span>Experience</span>
        <span class="section-subtitle"
          >{cvDataEn.experience.length} roles in 5 countries: expand a cluster to explore.</span
        >
      </h2>
      <div class="exp-clusters">
        {
          expClustersEn.map((cluster, clusterIdx) => (
            <div
              class="exp-cluster"
              data-cluster={cluster.key}
              {...(cluster.isDefaultOpen ? { "data-open": "" } : {})}
            >
              <button
                class="exp-cluster__header"
                type="button"
                aria-expanded={cluster.isDefaultOpen ? "true" : "false"}
                aria-controls={`cluster-body-${cluster.key}`}
              >
                <span class="exp-cluster__index" aria-hidden="true">
                  {String(clusterIdx + 1).padStart(2, "0")}
                </span>
                <span class="exp-cluster__name">{cluster.label}</span>
                <span class="exp-cluster__meta">
                  <span class="exp-cluster__count">
                    {cluster.items.length} roles
                  </span>
                  <span class="exp-cluster__chevron" aria-hidden="true" />
                </span>
              </button>
              <div class="exp-cluster__body" id={`cluster-body-${cluster.key}`}>
                <div class="exp-grid exp-grid--featured">
                  {cluster.featured.map((exp) => (
                    <ExpCard {...exp} />
                  ))}
                </div>
                {cluster.extra.length > 0 && (
                  <div
                    class="exp-drawer"
                    id={`exp-drawer-${cluster.key}`}
                  >
                    <div class="exp-grid">
                      {cluster.extra.map((exp) => (
                        <ExpCard {...exp} />
                      ))}
                    </div>
                  </div>
                )}
              </div>
              {cluster.extra.length > 0 && (
                <button
                  class="exp-deeper-btn"
                  type="button"
                  data-drawer={cluster.key}
                  aria-controls={`exp-drawer-${cluster.key}`}
                >
                  <span class="exp-deeper-btn__label">
                    Read {Math.min(3, cluster.extra.length)} more
                  </span>
                  <span class="exp-deeper-btn__arrow" aria-hidden="true" />
                </button>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── AI WORKFLOW ─────────────────────────────────────────────── -->
    <section
      class="ai-section reveal delay-300"
      id="ai-section"
      aria-label="AI-Enhanced Workflow"
    >
      <img
        class="bg-knoll bg-knoll--chess"
        src="/knolling/chess.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title ai-title">
        <span>AI-Enhanced Workflow <span class="ai-title__clip" aria-hidden="true">
          <span class="ai-title__clip-pin"></span>
          <span class="ai-title__clip-text">⚡ AI</span>
        </span></span>

        <span class="section-subtitle"
          >How AI multiplies output without replacing judgement.</span
        >

      </h2>
      <div class="ai-grid">
        {cvDataEn.aiWorkflow.map((item) => <AiCard {...item} />)}
      </div>
    </section>

    <!-- ── CHARACTER — soft skills, mindset and growing areas, always
         visible. Previously a <details> closed by default ("second
         interview material"); header now catalog-style like
         .exp-cluster__header but static — not an accordion, no
         chevron/toggle. Mirrors [mode].astro. -->
    <section class="worklife reveal" id="worklife" aria-label="Character: soft skills, mindset and growing areas">
      <div class="section-title">
        <span >Character</span>
        <span class="section-subtitle">Soft skills, mindset and growing areas</span>
      </div>
      <div class="soft-section" id="soft-skills" aria-label="Soft skills and methodology">
        <img
          class="bg-knoll bg-knoll--plant"
          src="/knolling/plant.webp"
          aria-hidden="true"
          alt=""
        />
        <div class="worklife__grid">
          <div class="worklife-card">
            <p class="worklife-card__label">Soft Skills</p>
            <ul class="soft-list">
              {
                softSkillsData.map((skill) => (
                  <SoftItem
                    name={skill.name}
                    description={skill.description}
                    modeTags={skill.modeTags}
                    variant="soft"
                  />
                ))
              }
            </ul>
          </div>
          <div class="worklife-card">
            <p class="worklife-card__label">Mindset</p>
            <ul class="method-list">
              {
                cvDataEn.methodology.map((m) => (
                  <SoftItem
                    name={m.name}
                    description={m.description ?? ""}
                    modeTags="tech creative human management"
                    variant="method"
                  />
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── GROWTH AREAS ─────────────────────────────────────────────── -->
    {
      cvDataEn.growthAreas.length > 0 && (
        <section
          class="growth-section reveal"
          id="growth"
          aria-label="Areas of conscious growth"
        >
          <h2 class="section-title">
            <span>Self-awareness</span>
            <span class="section-subtitle">
              Growing areas, reframed as strengths.
            </span>
          </h2>
          <div class="growth-grid">
            {cvDataEn.growthAreas.map((area) => (
              <article
                class="growth-card cv-card"
                data-tags="tech creative human management"
              >
                <p class="growth-card__label">Growing area</p>
                <p class="growth-card__name">{area.name}</p>
                <p class="growth-card__reframe">{area.reframe}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <!-- ── FEEDBACK — what people say ───────────────────────────────── -->
    {
      cvDataEn.feedbacks.length > 0 && (
        <section class="feedback-section reveal" id="feedback" aria-label="What people say">
          <div class="feedback-header">
            <h2 class="section-title">
              <span>What people say</span>
              <span class="section-subtitle">Words from people who worked with me.</span>
            </h2>
            <!-- Visible only when the carousel actually has more to scroll
                 (JS: cv-init.ts measures scrollWidth vs clientWidth). Hidden
                 on mobile: the affordance there is the swipe itself. -->
            <div class="feedback-nav" data-feedback-nav>
              <button class="feedback-nav__btn feedback-nav__btn--prev" type="button" data-feedback-prev aria-label="Previous feedback">
                <span class="feedback-nav__arrow" aria-hidden="true"></span>
              </button>
              <button class="feedback-nav__btn feedback-nav__btn--next" type="button" data-feedback-next aria-label="Next feedback">
                <span class="feedback-nav__arrow" aria-hidden="true"></span>
              </button>
            </div>
          </div>
          <div class="feedback-track" data-feedback-track tabindex="0" aria-label="Feedback list, scroll for more">
            {cvDataEn.feedbacks.map((f) => (
              <figure class="feedback-card cv-card" data-tags="tech creative human management">
                {f.quote && <blockquote class="feedback-quote">{f.quote}</blockquote>}
                {!f.quote && f.keywords.length > 0 && (
                  <ul class="feedback-keywords" aria-label={`The words ${f.name} used to describe me`}>
                    {f.keywords.map((k) => (
                      <li class="feedback-kw">{k}</li>
                    ))}
                  </ul>
                )}
                <figcaption class="feedback-who">
                  <b>{f.name}</b>
                  {f.role && <span> · {f.role}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- ── PROJECTS ────────────────────────────────────────────────── -->
    <section class="projects-section reveal" id="projects" aria-label="Personal projects">
      <img
        class="bg-knoll bg-knoll--compass"
        src="/knolling/compass.webp"
        aria-hidden="true"
        alt=""
      />
      <h2 class="section-title"><span>Projects</span></h2>
      <div class="projects-grid">
        {projectsData.map((project) => <ProjectCard {...project} workHref="/en/work" />)}
      </div>
    </section>
    <!-- ── EDUCATION & CERTIFICATIONS ─────────────────────────────── -->
    <section
      class="edu-section reveal"
      id="education"
      aria-label="Education and certifications"
    >
      <div class="edu-header">
        <h2 class="section-title">
          <span>Education &amp; Certifications</span>
          <span class="section-subtitle">Completion timeline.</span>
        </h2>
        <div class="timeline-legend" aria-hidden="true">
          <span class="tl-legend-chip tl-legend-chip--cert">Certification</span>
          <span class="tl-legend-chip tl-legend-chip--edu">Education</span>
        </div>
      </div>
      <!-- Collapsed timeline: recent entries are enough for the first scan,
           the rest (back to 2010) opens with "Show full timeline". -->
      <div class="tl-collapsible" data-tl-expanded="false">
      <ol class="timeline" role="list">
        {
          timelineItems.map((item) => (
            <li class="tl-item" data-type={item.type}>
              <time class="tl-date" datetime={item.date} title={item.date}>
                {item.dateLabel}
              </time>
              <span class="tl-dot-col" aria-hidden="true">
                <span class="tl-dot" />
              </span>
              <div class="tl-body">
                <p class="tl-title">
                  {item.title}
                  {item.inProgress && <span class="tl-wip">in progress</span>}
                </p>
                <p class="tl-inst">{item.institution}</p>
                {item.credentialId && (
                  <p class="tl-cred">ID: {item.credentialId}</p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
        <div class="tl-fade" aria-hidden="true"></div>
      </div>
      <button
        class="skills-expand-btn"
        type="button"
        data-tl-expand-toggle
        data-label-collapsed="Show full timeline"
        data-label-expanded="Show less"
        aria-expanded="false"
      >
        Show full timeline
      </button>
    </section>
  </main>

  <!-- ────────────────────────────────────────────────────────── FOOTER -->
  <footer class="cv-footer">
    {
      cvDataEn.interests.length > 0 && (
        <div class="interests-strip">
          <p class="interests-label">Interests</p>
          <ul class="interests-chips" role="list">
            {cvDataEn.interests.map((interest) => (
              <li class="interest-chip">{interest}</li>
            ))}
          </ul>
        </div>
      )
    }
    <ContactFooter lang="en" />
    <p class="cv-footer__credit">{cvDataEn.personal.name} · Digital CV</p>
  </footer>
</Layout>

<script>
  import "../../scripts/cv-init.ts";
</script>

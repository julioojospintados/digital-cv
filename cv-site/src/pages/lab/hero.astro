---
// /lab/hero — PROTOTIPO, non è la home.
//
// Mette alla prova una direzione sola: struttura alla Olivia Truong (una riga
// di ruolo, nessuna scelta all'ingresso, una still-life per progetto) con il
// mestiere del movimento speso in un punto solo, l'hero. Gli oggetti knolling
// esistenti sono usati come piani a profondità diversa: parallasse, ombra a
// terra, sfocatura per distanza.
//
// TESTI — nessuna copy scritta qui dentro. Tutto viene da @cv-data e da
// cv-i18n, come nelle pagine vere: il prototipo cambia la struttura, non la
// voce. Le uniche stringhe locali sono le etichette di servizio del banco di
// prova (la barra "Prototipo", la nota in fondo), che non sono contenuto del
// CV e spariscono se la direzione viene promossa.
import Layout from "../../layouts/Layout.astro";
import { cvData } from "@cv-data";
import { LOCALES } from "../../lib/cv-i18n";
import "../../styles/lab-hero.css";

const t = LOCALES.it;

// Posizionamento UX/UI-first: l'hero mode-aware di /creative, non il titolo
// generico da partner tecnico di personal.title.
const role = t.heroTitles.creative;

// La riga che chiude personal.summary: è già la tesi dell'intero profilo,
// scritta da Giulio. Presa verbatim invece di riassunta.
const claim = cvData.personal.summary.split(". ").at(-1) ?? "";

// ── La composizione ──────────────────────────────────────────────────────
// Non è uno scatter casuale: è una still-life. Gli oggetti lontani stanno in
// alto, piccoli e sfocati; i vicini in basso, grandi e nitidi. È così che si
// legge una foto di still-life, ed è la differenza fra "oggetti composti in
// una scena" e "oggetti appoggiati sui bordi come decorazione".
//
// depth = moltiplicatore di parallasse (0 = fondale, 1.45 = primo piano)
// z     = profondità reale in rem, dentro la perspective dello stage
// drop  = esce sotto i 56rem, dove affollerebbe invece di dare profondità
const composition = [
  {
    src: "megaphone",
    x: "79%",
    y: "19%",
    w: "17%",
    z: -6,
    depth: 0.1,
    r: "8deg",
    blur: 2.8,
    drop: true,
  },
  {
    src: "plant",
    x: "17%",
    y: "25%",
    w: "13%",
    z: -5,
    depth: 0.15,
    r: "-6deg",
    blur: 2.2,
    drop: false,
  },
  {
    src: "compass",
    x: "78%",
    y: "57%",
    w: "14%",
    z: -2,
    depth: 0.35,
    r: "5deg",
    blur: 0.6,
    drop: false,
  },
  {
    src: "laptop",
    x: "50%",
    y: "47%",
    w: "40%",
    z: 0,
    depth: 0.45,
    r: "-2deg",
    blur: 0,
    drop: false,
  },
  {
    src: "chess",
    x: "24%",
    y: "61%",
    w: "15%",
    z: 3,
    depth: 0.7,
    r: "-4deg",
    blur: 0,
    drop: false,
  },
  {
    src: "camera",
    x: "63%",
    y: "81%",
    w: "21%",
    z: 5,
    depth: 0.95,
    r: "6deg",
    blur: 0,
    drop: false,
  },
  {
    src: "multitool",
    x: "33%",
    y: "87%",
    w: "17%",
    z: 7,
    depth: 1.2,
    r: "-9deg",
    blur: 1.2,
    drop: true,
  },
];
// La torcia era qui, in primo piano a sinistra con blur 2.6: a quella
// dimensione non leggeva come sfocatura di profondità, leggeva come una
// macchia. Tolta — meglio sette oggetti composti che otto con uno sporco.

// ── I lavori ─────────────────────────────────────────────────────────────
// Stessa fonte di /work: cvData.projects con uno slug. Nome, ruolo e modalità
// sono quelli scritti da Giulio in cv.ts. L'unica aggiunta del prototipo è
// l'oggetto che fa da metafora al progetto — è direzione artistica, non copy.
const objectBySlug: Record<string, string> = {
  "product-discovery": "flashlight",
  "digital-cv": "laptop",
  "trip-runway": "compass",
  "music-agency": "megaphone",
};

// I quattro accenti delle modalità, distribuiti per posizione e non per
// primaryMode. Sui dati veri primaryMode vale solo "tech" o "creative": due
// pannelli ciano e due arancioni, mentre oro e viola non comparivano mai.
// L'idea "le modalità diventano il colore dei case study" resta, ma per
// funzionare come codifica visiva i quattro colori devono esserci tutti.
const PANELS = ["creative", "tech", "human", "management"] as const;

const cases = cvData.projects
  .filter((p) => !!p.slug)
  .map((p, i) => ({
    slug: p.slug!,
    name: p.name,
    role: p.role,
    object: objectBySlug[p.slug!] ?? "multitool",
    panel: `var(--lab-p-${PANELS[i % PANELS.length]})`,
  }));
---

<Layout
  title="Prototipo hero — Giulio Occhipinti"
  description="Banco di prova di una direzione di layout per il CV digitale."
  mode="creative"
  noindex
>
  <link slot="head" rel="preload" as="image" href="/knolling/laptop.webp" fetchpriority="high" />

  <div class="lab">
    <header class="lab-bar">
      <a href="/" class="lab-mark" aria-label="Torna alla home attuale">GO</a>
      <span class="lab-flag">Prototipo</span>
    </header>

    <section class="lab-hero">
      <div class="lab-hero-inner">
        <div class="lab-copy">
          <p class="lab-role">{role}</p>
          <h1 class="lab-name">{cvData.personal.name}</h1>
          <p class="lab-claim">{claim}</p>
          <p class="lab-where">
            <span>{cvData.personal.location}</span>
          </p>
          <div class="lab-cta">
            <a href="#main-content" class="lab-btn lab-btn--solid">Case study</a>
            <a href="/cv/Giulio_Occhipinti_CV.pdf" class="lab-btn" download>CV in PDF</a>
          </div>
        </div>

        <!-- La still-life. aria-hidden: è un'immagine decorativa composta,
             il contenuto informativo è tutto nella colonna di testo. -->
        <div class="lab-scene" aria-hidden="true">
          <div class="lab-stage" data-lab-stage>
            {
              composition.map((o) => (
                <div
                  class="lab-obj"
                  data-drop={o.drop ? "1" : undefined}
                  style={`--x:${o.x};--y:${o.y};--w:${o.w};--z:${o.z};--depth:${o.depth};--r:${o.r};--blur:${o.blur};--sh:${1 + o.depth}rem;--shb:${1.5 + o.depth * 1.5}rem`}
                >
                  <img
                    src={`/knolling/${o.src}.webp`}
                    alt=""
                    loading={o.src === "laptop" ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <main class="lab-work" id="main-content">
      <div class="lab-work-head">
        <p class="lab-eyebrow">Portfolio</p>
        <h2 class="lab-h2">Case study, non un elenco.</h2>
        <p class="lab-claim">
          Racconto ogni progetto dal problema al risultato misurabile: analisi UX/UI, decisioni
          tecniche, workflow AI-augmented. Tutto ciò che sta dietro al "com'è andata".
        </p>
      </div>

      {
        cases.map((c) => (
          <article class="lab-case" style={`--panel:${c.panel}`}>
            <div class="lab-panel">
              <img src={`/knolling/${c.object}.webp`} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="lab-label">
              <h3>{c.name}</h3>
              <p class="lab-q">{c.role}</p>
              <a href={`/work/${c.slug}`} class="lab-link">
                Leggi il case study
              </a>
            </div>
          </article>
        ))
      }
    </main>

    <div class="lab-end">
      <a href="/creative" class="lab-btn">Vedi il CV completo</a>
    </div>

    <p class="lab-note">
      Prototipo /lab/hero — struttura, non contenuti. Tutti i testi vengono da cv.ts e cv-i18n:
      ruolo dall'hero di /creative, claim dall'ultima riga di personal.summary, progetti da
      cvData.projects.<br />
      Confronto con la home attuale: 4 bottoni di modalità → 0 · 5 ruoli nell'occhiello → 1 · 5.824 px
      di scroll → circa 4 schermate. Le modalità non spariscono: diventano il colore dei quattro case
      study (primaryMode).
    </p>
  </div>
</Layout>

<script>
  import { initLabHero } from "../../scripts/lab-hero";
  initLabHero();
</script>

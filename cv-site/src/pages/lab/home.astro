---
// /lab/home — PROVA: la home senza le quattro card.
//
// L'ingresso diventa una sola schermata piena di oggetti grandi, con nome e
// ruolo al centro. Nessuna scelta da fare: si scorre, e le quattro sezioni
// arrivano una alla volta a schermo intero. Le modalità non spariscono,
// smettono di essere un bivio all'ingresso e diventano un percorso.
//
// Rispetto alla home vera questa prova è volutamente spoglia: niente
// preloader GO, niente cassetto delle foto, niente scatter dei fun fact.
// Serve a giudicare una cosa sola — se gli oggetti grandi reggono da soli
// al posto delle card.
//
// TESTI: tutti da cv-i18n e @cv-data, nessuna copy scritta qui.
import Layout from "../../layouts/Layout.astro";
import { cvData } from "@cv-data";
import { LOCALES, MODES } from "../../lib/cv-i18n";
import "../../styles/lab-home.css";

const t = LOCALES.it;

// ── La composizione dell'ingresso ────────────────────────────────────────
// Otto oggetti grandi disposti attorno al centro, che resta libero per il
// nome. Le dimensioni sono in vmin (la minore fra larghezza e altezza della
// finestra), così la composizione tiene le proporzioni sia su schermo largo
// che stretto invece di appiattirsi.
//
// depth = quanto insegue il puntatore  ·  sh-* = direzione e morbidezza
// dell'ombra portata (vedi lab-home.css)
const composition = [
  { src: "megaphone", x: "13%", y: "20%", w: "17vmin", r: "-9deg", depth: 0.5, blur: 0 },
  // Scacchi e pianta si sono scambiati di posto. Posizione e depth sono del
  // posto, non dell'oggetto: la profondità cresce scendendo (in alto la scena
  // si muove poco, in basso molto), quindi resta 0.3 qui e 1 in fondo.
  // Larghezza e rotazione invece viaggiano con l'oggetto.
  // 10.5vmin e non 14: quassù pesava quanto il megafono e i pezzi sono alti,
  // quindi occupano molto più di quanto la larghezza lasci pensare. È anche
  // il webp più piccolo del set (177 px), quindi meno lo si ingrandisce
  // meglio tiene.
  { src: "chess", x: "35%", y: "12%", w: "10.5vmin", r: "-3deg", depth: 0.3, blur: 0 },
  { src: "laptop", x: "76%", y: "19%", w: "26vmin", r: "4deg", depth: 0.65, blur: 0 },
  // 13% e non 8%: sotto quella soglia la torcia veniva tagliata dal bordo
  // sinistro e sembrava un errore, non una scelta di inquadratura.
  // -190deg e non -4deg: girata quasi a mezzo giro, la testa della torcia
  // punta verso il centro invece che fuori dall'inquadratura. 26vmin perché
  // è l'oggetto più allungato della scena: alla larghezza degli altri
  // spariva, ed è la sorgente più grande che abbiamo (1187px).
  { src: "flashlight", x: "13%", y: "52%", w: "26vmin", r: "-190deg", depth: 0.9, blur: 0 },
  { src: "compass", x: "89%", y: "54%", w: "15vmin", r: "8deg", depth: 0.8, blur: 0 },
  { src: "multitool", x: "20%", y: "84%", w: "19vmin", r: "12deg", depth: 1.15, blur: 0 },
  // 62% e non 50%: al centro questo posto finisce esattamente sotto
  // l'indicatore "Scorri", che ci si sovrappone.
  { src: "plant", x: "62%", y: "88%", w: "12vmin", r: "5deg", depth: 1, blur: 0 },
  { src: "camera", x: "80%", y: "85%", w: "20vmin", r: "-7deg", depth: 1.25, blur: 0 },
];

// ── Le quattro sezioni ───────────────────────────────────────────────────
// Una per modalità, nell'ordine di MODES (creative per primo: il
// posizionamento è design-first). Sigla, oggetto, etichetta e descrizione
// sono quelli già scritti in cv-i18n.
const initials: Record<string, string> = {
  creative: "WD",
  tech: "SD",
  management: "PM",
  human: "AI",
};

const sectionObject: Record<string, string> = {
  creative: "camera",
  tech: "laptop",
  management: "chess",
  human: "compass",
};

// Larghezza reale in pixel di ogni webp, convertita in rem (÷16).
// Serve a non disegnare mai un oggetto più grande dei pixel che ha davvero:
// gli scacchi sono 177 px e venivano stirati a 352, da cui lo sgranato.
// Questo tetto risolve il sintomo; la cura è riesportare le sorgenti più
// grandi, perché così alcuni oggetti restano piccoli per forza.
const NATIVE_REM: Record<string, number> = {
  camera: 327 / 16,
  chess: 177 / 16,
  compass: 208 / 16,
  flashlight: 1187 / 16,
  laptop: 524 / 16,
  megaphone: 389 / 16,
  multitool: 226 / 16,
  plant: 226 / 16,
};

// I testi delle quattro sezioni, copiati **verbatim** da index.astro
// (§ .profile-section): titolo su due righe, occhiello, paragrafo. Nel giro
// precedente avevo usato modeLabels/modeDescriptions di cv-i18n, che sono
// un'altra cosa — servono all'hero delle pagine CV e ai meta, non a questa
// sezione. Qui la voce deve essere quella della home.
const copy: Record<string, { title: [string, string]; desc: string }> = {
  creative: {
    title: ["Brand,", "estetica e interfacce."],
    desc: `Di natura cerco di risolvere problemi: che siano di un amico, di un passante per strada o di un collega. Questa "deformazione" professionale mi ha portato ad appassionarmi alla UX/UI e a unirla all'estetica. Formazione IBM e SkillUp, con un interesse attento a come la Generative AI sta ridisegnando il settore.`,
  },
  tech: {
    title: ["Automazione,", "AI e architetture."],
    desc: `Sviluppo da anni per il mondo enterprise, muovendomi tra TypeScript, Angular e React. Sono passato da team di 30 persone a progetti in solitaria potenziati dall'AI, dove creo workflow e integrazioni MCP su misura. Tutta la lista di tecnologie e sigle la trovi cliccando qua sotto.`,
  },
  management: {
    title: ["Agile snello", "e sprint brevi."],
    desc: `Opero come partner tecnico per aziende e progetti digitali. Lavoro con metodo Agile, concentrandomi sul risolvere i problemi reali e nel fare da ponte tra i diversi ruoli del team. Il mio obiettivo è semplice: trovare soluzioni efficaci e rendere le persone autonome, senza creare dipendenze. Quanto è bello facilitare il lavoro alle persone?`,
  },
  human: {
    title: ["Storytelling", "e strategia."],
    desc: `L'AI esegue, calcola e velocizza, ma non comprende intrinsecamente le persone. Unisco la progettazione di workflow automatizzati alla sensibilità narrativa che mi arriva dal marketing, dalla scrittura e dal teatro. L'AI fa davvero un gran lavoro, ma senza un pilota potrebbe non farti mai arrivare a Itaca.`,
  },
};

const sections = MODES.map((mode) => ({
  mode,
  initial: initials[mode],
  object: sectionObject[mode],
  nativeRem: NATIVE_REM[sectionObject[mode]],
  title: copy[mode].title,
  eyebrow: t.modeLabels[mode],
  desc: copy[mode].desc,
  // Il portfolio è la prova più importante per il ruolo target: nella
  // sezione design la sua CTA deve esserci, accanto a quella del CV.
  portfolio: mode === "creative",
}));
---

<Layout
  title="Prova home senza card — Giulio Occhipinti"
  description="Banco di prova: ingresso a schermo pieno con gli oggetti grandi, senza le quattro card."
  mode="creative"
  noindex
>
  <link slot="head" rel="preload" as="image" href="/knolling/laptop.webp" fetchpriority="high" />

  <div class="lh">
    <header class="lh-bar">
      <a href="/" class="lh-mark" aria-label="Torna alla home attuale">GO</a>
      <nav class="lh-nav">
        <a href="/lab/hero">← altra prova</a>
        <span class="lh-flag">Prova</span>
      </nav>
    </header>

    <!-- ── Ingresso: una schermata, nessuna card ── -->
    <section class="lh-hero">
      <div class="lh-stage" data-lab-stage aria-hidden="true">
        {
          composition.map((o) => (
            <div
              class="lh-obj"
              data-obj={o.src}
              style={`--x:${o.x};--y:${o.y};--w:${o.w};--r:${o.r};--depth:${o.depth}`}
            >
              {/* Ombra portata: la stessa immagine annerita, sfocata e
                  inclinata. Segue la sagoma perché ne eredita l'alpha. */}
              <img
                class="lh-obj__shadow"
                src={`/knolling/${o.src}.webp`}
                alt=""
                aria-hidden="true"
              />
              <img
                class="lh-obj__img"
                src={`/knolling/${o.src}.webp`}
                alt=""
                loading={o.src === "laptop" ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
          ))
        }
      </div>

      {
        /* Testi dell'ingresso: gli stessi di index.astro (§ .entry-header),
          verbatim. Anche qui avevo sostituito di mia iniziativa — occhiello,
          tagline e riga dei ruoli sono quelli scritti da Giulio. */
      }
      <div class="lh-copy">
        <h1 class="lh-name">{cvData.personal.name}</h1>
        <p class="lh-tagline">Se esiste una verità assoluta, dev'essere molto annoiata.</p>
        <p class="lh-cred">
          Web Designer · UX/UI · Software Developer · Comunicazione Digitale · AI Workflow
        </p>
      </div>

      <a class="lh-scroll" href="#main-content">
        <span>Scorri</span>
        <span class="lh-scroll__line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- ── Le quattro sezioni, una schermata ciascuna ── -->
    <main id="main-content">
      {
        sections.map((s) => (
          <section class="lh-section" data-mode={s.mode}>
            <div class="lh-section__object" style={`--nat:${s.nativeRem}rem`}>
              <img
                class="lh-obj__shadow"
                src={`/knolling/${s.object}.webp`}
                alt=""
                aria-hidden="true"
              />
              <img src={`/knolling/${s.object}.webp`} alt="" loading="lazy" decoding="async" />
            </div>

            {/* La sigla sta dentro la colonna di testo, non ancorata al bordo
                della pagina: così si allinea al margine destro del titolo e
                gli resta dietro, invece di entrargli addosso di lato. */}
            <div class="lh-section__copy">
              <p class="lh-section__initial" aria-hidden="true">
                {s.initial}
              </p>
              <h2 class="lh-section__title">
                {s.title[0]}
                <br />
                {s.title[1]}
              </h2>
              <p class="lh-section__eyebrow">{s.eyebrow}</p>
              <p class="lh-section__text">{s.desc}</p>
              <div class="lh-section__actions">
                <a class="lh-cta" href={`/${s.mode}`}>
                  GO to {s.eyebrow}
                </a>
                {s.portfolio && (
                  <a class="lh-cta lh-cta--ghost" href="/work">
                    Esplora il portfolio
                  </a>
                )}
              </div>
            </div>
          </section>
        ))
      }
    </main>

    <p class="lh-note">
      Prova /lab/home — l'ingresso perde le 4 card: gli oggetti diventano grandi e occupano una
      schermata intera, le 4 modalità si incontrano scorrendo invece di sceglierle subito. Testi da
      cv-i18n e cv.ts. Le ombre sono ricostruite (silhouette annerita, sfocata e inclinata), non
      fotografate.
    </p>
  </div>
</Layout>

<script>
  import { initLabHero } from "../../scripts/lab-hero";
  import {
    initLabHomeScroll,
    initLabHomeSnap,
    initLabHomeMood,
  } from "../../scripts/lab-home-scroll";

  initLabHero();
  initLabHomeScroll();
  initLabHomeSnap();
  initLabHomeMood();
</script>

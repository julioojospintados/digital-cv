---
// /design · /tech · /ai — la pagina CV in italiano.
//
// Il corpo sta in components/CvLensPage.astro, che rende **anche** l'inglese
// (en/[lens].astro). Una pagina sola per due lingue non è un risparmio di
// righe: è ciò che rende impossibile la divergenza IT/EN — l'errore
// ricorrente numero uno di questo repo secondo AGENTS.md. Qui restano solo
// la rotta e la lingua.
import CvLensPage from "../components/CvLensPage.astro";
import { LENS_SLUGS, MODE_BY_SLUG, MODES } from "../lib/cv-i18n";

export function getStaticPaths() {
  // Il parametro di rotta è lo **slug** (/design, /tech, /ai), non la chiave
  // interna: vedi LENS_SLUGS in cv-i18n.ts per il perché non coincidono.
  return MODES.map((mode) => ({ params: { lens: LENS_SLUGS[mode] } }));
}

const { lens: slug } = Astro.params as { lens: string };
---

<CvLensPage lens={MODE_BY_SLUG[slug]} locale="it" />

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  mode?: 'tech' | 'creative' | 'human';
}

const {
  title = 'Giulio Occhipinti — Digital CV',
  description = 'CV interattivo di Giulio Occhipinti: Senior Frontend Developer, UX Designer, Creative Technologist.',
  mode,
} = Astro.props;
---

<!doctype html>
<html lang="it" class="scroll-smooth" data-mode={mode ?? 'tech'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- View Transitions API -->
    <meta name="view-transition" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body>
    <slot />

    <!-- Init mode from store on client -->
    <script>
      import { initMode } from '../islands/stores/modeStore';
      initMode();
    </script>
  </body>
</html>


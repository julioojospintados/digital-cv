---
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  mode?: "tech" | "creative" | "human" | "management";
  lang?: "it" | "en";
}

const {
  title = "Giulio Occhipinti — Digital CV",
  description = "CV interattivo di Giulio Occhipinti: Senior Frontend Developer, UX Designer, Creative Technologist.",
  mode,
  lang = "it",
} = Astro.props;

const siteUrl = "https://giulio-occhipinti.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/favicon.svg`;

// JSON-LD — Person schema (schema.org) — indicizzato direttamente da Google
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Giulio Occhipinti",
  jobTitle: "Consulente per l'Innovazione Digitale & Partner Tecnico per PMI",
  url: siteUrl,
  email: "mailto:giulio.occhipinti.g@gmail.com",
  sameAs: [
    "https://www.linkedin.com/in/giulio-occhipinti",
    "https://github.com/julioojospintados",
  ],
  knowsAbout: [
    "Angular",
    "TypeScript",
    "Lit",
    "WebComponents",
    "Node.js",
    "MCP Protocol",
    "Agile",
    "UX Design",
    "GSAP",
    "Astro",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Torino",
    addressCountry: "IT",
  },
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth" data-mode={mode ?? "tech"}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Mi piace risolvere i problemi digitali e di comunicazione"
    />
    <meta name="author" content="Giulio Occhipinti" />
    <meta name="robots" content="index, follow" />
    <!-- Tells browsers this page is already dark — prevents OS dark mode from
         force-inverting colors (lines, overlays) on Chrome/Safari Android/iOS -->
    <meta name="color-scheme" content="dark" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- View Transitions API -->
    <meta name="view-transition" content="same-origin" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "it_IT"} />
    <meta property="og:site_name" content="Giulio Occhipinti — Digital CV" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data — Person schema (schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Preload critical fonts — 400 for body text, 800 for preloader & entry name -->
    <!-- font-display: block in global.css prevents FOUC during the preloader animation -->
    <!-- 400: prefetch (not preload) — GSAP hides text at opacity:0 initially, preload would trigger an "unused preload" warning -->
    <link
      rel="prefetch"
      as="font"
      type="font/woff2"
      href="/fonts/Lexend/lexend-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Lexend/lexend-latin-800-normal.woff2"
      crossorigin
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>

  <body>
    <!-- Skip to main content — keyboard/screen reader accessibility -->
    <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

    <!-- Custom cursor -->
    <div id="cursor-dot" aria-hidden="true"></div>
    <div id="cursor-ring" aria-hidden="true"></div>

    <slot />

    <!-- Floating Action Button — globale su tutte le pagine -->
    <floating-menu></floating-menu>

    <SpeedInsights />

    <!-- Init mode from store on client -->
    <script>
      import { initMode } from "../islands/stores/modeStore";
      initMode();
    </script>

    <!-- Lenis smooth scroll + GSAP ScrollTrigger wiring -->
    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({ lerp: 0.08, syncTouch: true });
      lenis.on("scroll", ScrollTrigger.update);
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      // Expose for pages that need direct access
      window.__lenis = lenis;
    </script>

    <!-- Custom cursor script -->
    <script>
      import { gsap } from "gsap";

      const dot = document.getElementById("cursor-dot")!;
      const ring = document.getElementById("cursor-ring")!;

      // cursor: none è già in global.css con `* { cursor: none !important }` —
      // nessun loop JS necessario.

      window.addEventListener("mousemove", (e) => {
        const mx = e.clientX;
        const my = e.clientY;
        // Dot: segue immediato il puntatore
        gsap.to(dot, { x: mx - 4, y: my - 4, duration: 0.05, ease: "none" });
        // Ring: lerp via GSAP to — aggiorna solo on mousemove, nessun ticker aggiuntivo
        gsap.to(ring, {
          x: mx - 20,
          y: my - 20,
          duration: 0.22,
          ease: "power2.out",
        });
      });

      // Hover states
      const interactives = document.querySelectorAll(
        'a, button, [role="button"], .cv-card, .knoll-item',
      );
      interactives.forEach((el) => {
        el.addEventListener("mouseenter", () => {
          dot.classList.add("cursor--hover");
          ring.classList.add("cursor--hover");
          // Passive card: mostra cursore speciale (freccia su + anello tratteggiato pulsante)
          if ((el as HTMLElement).dataset?.state === "passive") {
            dot.classList.add("cursor--passive-card");
            ring.classList.add("cursor--passive-card");
          }
        });
        el.addEventListener("mouseleave", () => {
          dot.classList.remove("cursor--hover");
          ring.classList.remove("cursor--hover");
          dot.classList.remove("cursor--passive-card");
          ring.classList.remove("cursor--passive-card");
        });
      });

      // Hide on leave, show on enter
      document.addEventListener("mouseleave", () => {
        gsap.to([dot, ring], { opacity: 0, duration: 0.3 });
      });
      document.addEventListener("mouseenter", () => {
        gsap.to([dot, ring], { opacity: 1, duration: 0.3 });
      });
    </script>

    <!-- FloatingMenu Lit island — sempre attivo su tutte le pagine -->
    <script>
      import "../islands/FloatingMenu.lit.ts";
    </script>
  </body>
</html>

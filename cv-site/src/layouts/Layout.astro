---
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  title?: string;
  description?: string;
  mode?: "tech" | "creative" | "human" | "management";
  lang?: "it" | "en";
  /** FAB contatti — pagine CV ([mode], en/cv), home (index, en/index) e /work */
  showFab?: boolean;
  /** true sulle home (index/en/index): il ConsentBanner aspetta l'evento
   * "cv:wip-badge-shown" del preloader invece di comparire subito — vedi
   * ConsentBanner.astro. */
  consentBannerWaitForWip?: boolean;
}

const {
  title = "Giulio Occhipinti — Digital CV",
  description = "CV interattivo di Giulio Occhipinti: UX/UI & Web Designer certificato IBM, Creative Technologist, AI & Digital Specialist e Project Manager Agile.",
  mode,
  lang = "it",
  showFab = false,
  consentBannerWaitForWip = false,
} = Astro.props;

const siteUrl = "https://giulio-occhipinti.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
// Screenshot reale della home 1200×630, JPEG ~90KB: WhatsApp scarta le
// immagini og sopra ~300KB. Nome nuovo (og-cover) = cache busting per le
// anteprime già condivise con il vecchio og-image.png.
const ogImage = `${siteUrl}/og-cover.jpg`;

// JSON-LD — Person schema (schema.org) — indicizzato direttamente da Google
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Giulio Occhipinti",
  jobTitle: "Consulente per l'Innovazione Digitale & Partner Tecnico per piccole e grandi realtà",
  url: siteUrl,
  email: "mailto:giulio.occhipinti.g@gmail.com",
  sameAs: [
    "https://www.linkedin.com/in/giulio-occhipinti",
    "https://github.com/julioojospintados",
  ],
  knowsAbout: [
    "UX Design",
    "UI Design",
    "Figma",
    "GSAP",
    "Astro",
    "Angular",
    "TypeScript",
    "Lit",
    "WebComponents",
    "Agile",
    "MCP Protocol",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Torino",
    addressCountry: "IT",
  },
};
---

<!doctype html>
<html lang={lang} class="cursor-idle" data-mode={mode ?? "tech"} data-fab-scrollwait>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Giulio Occhipinti" />
    <meta name="robots" content="index, follow" />
    <!-- Tells browsers this page is already dark — prevents OS dark mode from
         force-inverting colors (lines, overlays) on Chrome/Safari Android/iOS -->
    <meta name="color-scheme" content="dark" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "it_IT"} />
    <meta property="og:site_name" content="Giulio Occhipinti — Digital CV" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data — Person schema (schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />


    <!-- PostHog — solo in build di produzione E solo sull'hostname canonico.
         import.meta.env.PROD da solo non basta: i deploy preview di Vercel
         eseguono comunque una build "production" di Astro/Vite (stesso output
         statico dietro *.vercel.app), quindi quel check da solo lascia
         passare anche i preview. Il controllo su location.hostname a runtime
         esclude alias/preview Vercel e localhost.
         enable_heatmaps esplicito: la cattura heatmap non è garantita on-by-default
         dal solo snippet standard.
         disable_surveys: non usiamo survey — evita di scaricare surveys.js (~33KB) a vuoto.
         init posticipato a dopo 'load' + idle: array.js/recorder.js (~455KB da parsare)
         non devono più competere con il preloader GO per banda e main thread.
         Gate di consenso (banner ConsentBanner.astro, chiave localStorage
         "cv-consent"): posthog.init parte da solo al load SOLO se il
         consenso è già "granted" da una visita precedente. Se non ancora
         deciso, __phInit resta esposto su window.__cvInitPostHog e viene
         chiamato dal banner al click su "Accetta" — mai prima. -->
    {import.meta.env.PROD && (
      <script is:inline type="text/javascript" set:html={`!function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="Ji Yi init fn mn Hr pn bn cn capture calculateEventProperties Sn register register_once register_for_session unregister unregister_for_session Tn getFeatureFlag getFeatureFlagPayload getFeatureFlagResult getAllFeatureFlags isFeatureEnabled reloadFeatureFlags updateFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey displaySurvey cancelPendingSurvey canRenderSurvey canRenderSurveyAsync Mn identify setPersonProperties unsetPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset shutdown setIdentity clearIdentity get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException addExceptionStep captureLog startExceptionAutocapture stopExceptionAutocapture loadToolbar get_property getSessionProperty Cn xn createPersonProfile setInternalOrTestUser In hn Pn opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing get_explicit_consent_status is_capturing clear_opt_in_out_capturing debug Ur Rt getPageViewId captureTraceFeedback captureTraceMetric an".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        function __phInit() {
          if (location.hostname === '${new URL(siteUrl).hostname}' || location.hostname === 'www.${new URL(siteUrl).hostname}') {
            posthog.init('phc_wsRRcGh7HYR8yuR2jzPjf3kin2SpGqPXNcy9byhQ2pbc', {
                api_host: 'https://us.i.posthog.com',
                defaults: '2026-05-30',
                person_profiles: 'identified_only',
                enable_heatmaps: true,
                disable_surveys: true,
            })
          }
        }
        function __phIdle() { (window.requestIdleCallback || function(cb){setTimeout(cb, 1)})(__phInit); }
        window.__cvInitPostHog = __phIdle;
        if (localStorage.getItem('cv-consent') === 'granted') {
          if (document.readyState === 'complete') { __phIdle(); } else { window.addEventListener('load', __phIdle); }
        }`}></script>
    )}

    <!-- Preload critical fonts — 400 for body text, 800 for preloader & entry name -->
    <!-- font-display: block in global.css prevents FOUC during the preloader animation -->
    <!-- 400: prefetch (not preload) — GSAP hides text at opacity:0 initially, preload would trigger an "unused preload" warning -->
    <link
      rel="prefetch"
      as="font"
      type="font/woff2"
      href="/fonts/Lexend/lexend-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Lexend/lexend-latin-800-normal.woff2"
      crossorigin
    />

    <!-- Favicon GO rasterizzati con Lexend reale (favicon-render): l'SVG con
         <text> non è affidabile fuori dal browser (i bot di anteprima non
         caricano webfont né renderizzano SVG). favicon.ico reale a 3 taglie
         per crawler e contesti legacy. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <slot name="head" />
  </head>

  <body>
    <!-- Skip to main content — keyboard/screen reader accessibility -->
    <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

    <!-- Custom cursor -->
    <div id="cursor-dot" aria-hidden="true"></div>
    <div id="cursor-ring" aria-hidden="true"></div>

    <slot />

    <!-- FAB contatti (showFab) — la definizione dell'island è importata
         dalla pagina ospite (cv-init.ts sulle pagine CV, script inline su
         home e /work) -->
    {showFab && <floating-menu></floating-menu>}

    <ConsentBanner lang={lang} waitForWipBadge={consentBannerWaitForWip} />

    <SpeedInsights />
    <Analytics />

    <!-- Init mode from store on client -->
    <script>
      import { initMode } from "../islands/stores/modeStore";
      initMode();
    </script>

    <!-- Microsoft Clarity — riattivato il 2026-07-28 per provare la sua UI
         di recordings/heatmap al posto di quella di PostHog. Il replay/
         heatmap di PostHog restano in pausa lato progetto
         (session_recording_opt_in e heatmaps_opt_in a false) per non far
         osservare il DOM a due recorder in contemporanea.

         Snippet ufficiale raw via is:inline + set:html, stesso pattern del
         blocco PostHog qui sopra. Due tentativi precedenti sono falliti:
         (1) mettere {`...`} come children di uno script is:inline — Astro
             non valuta le espressioni nei children di uno script is:inline,
             le stampa come testo letterale, quindi non partiva mai. Il fix è
             passare il codice via set:html, non come children.
             NB: non nominare mai il tag script per esteso, con parentesi
             angolari, dentro un commento HTML di questo file — il post-build
             hook stripComments() in astro.config.mjs protegge i blocchi
             script/style con una regex che scansiona il testo grezzo, senza
             sapere che è dentro un commento; se trova lì un'apertura di tag
             senza una chiusura altrettanto vicina, la sua ricerca della
             chiusura più vicina salta oltre la fine del commento e aggancia
             il tag reale subito dopo, cancellando tutto il mezzo in
             silenzio. Riprodotto proprio con questo commento.
         (2) pacchetto npm @microsoft/clarity con import() dinamico al posto
             dello snippet raw — il chunk veniva compilato in build ma Astro/
             Vite lo escludeva comunque dall'HTML della pagina, a prescindere
             dalla sua posizione nel documento (provato sia come primo script
             che dopo initMode). Lo snippet raw is:inline evita del tutto
             quel livello di bundling, quindi evita il bug.

         Gate di consenso, stesso meccanismo del blocco PostHog sopra: la
         iniezione dello script viene incapsulata in window.__cvInitClarity
         e parte da sola solo se "cv-consent" è già "granted" da una visita
         precedente; altrimenti resta in attesa del click su "Accetta" nel
         banner (ConsentBanner.astro). -->
    {import.meta.env.PROD && (
      <script
        is:inline
        type="text/javascript"
        set:html={`window.__cvInitClarity = function() {
          (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "xresw2uoe6");
        };
        if (localStorage.getItem('cv-consent') === 'granted') { window.__cvInitClarity(); }`}
      ></script>
    )}

    <!-- Lenis smooth scroll + GSAP ScrollTrigger wiring — attivo su tutte
         le pagine, home inclusa. Niente più CSS scroll-snap: coerenza
         site-wide, i reveal per-sezione sono in index-init.ts (ScrollTrigger). -->
    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({ lerp: 0.15, syncTouch: true });
      lenis.on("scroll", ScrollTrigger.update);
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      // Expose for pages that need direct access
      window.__lenis = lenis;
    </script>

    <!-- FAB visibile solo dopo il primo scroll — attributo SSR su <html>,
         tolto oltre gli 80px e rimesso quando si torna in cima -->
    <script>
      const fabSync = () => {
        document.documentElement.toggleAttribute(
          "data-fab-scrollwait",
          window.scrollY <= 80,
        );
      };
      fabSync();
      window.addEventListener("scroll", fabSync, { passive: true });
    </script>

    <!-- Custom cursor script -->
    <script>
      import { gsap } from "gsap";

      const dot = document.getElementById("cursor-dot")!;
      const ring = document.getElementById("cursor-ring")!;

      // cursor: none è già in global.css con `* { cursor: none !important }` —
      // nessun loop JS necessario.

      // quickTo() invece di gsap.to() per-mousemove (todo #51): pre-costruisce
      // il tween una sola volta e sui frame successivi aggiorna solo il valore
      // target, senza allocare un nuovo tween/oggetto di config ad ogni evento.
      const moveDot = gsap.quickTo(dot, "x", { duration: 0.05, ease: "none" });
      const moveDotY = gsap.quickTo(dot, "y", { duration: 0.05, ease: "none" });
      const moveRing = gsap.quickTo(ring, "x", { duration: 0.22, ease: "power2.out" });
      const moveRingY = gsap.quickTo(ring, "y", { duration: 0.22, ease: "power2.out" });

      window.addEventListener("mousemove", (e) => {
        // Primo movimento: rivela il cursore (era parcheggiato invisibile a 0,0)
        document.documentElement.classList.remove("cursor-idle");
        const mx = e.clientX;
        const my = e.clientY;
        // Dot: segue immediato il puntatore
        moveDot(mx - 4);
        moveDotY(my - 4);
        // Ring: lerp via GSAP quickTo — aggiorna solo on mousemove, nessun ticker aggiuntivo
        moveRing(mx - 20);
        moveRingY(my - 20);
      });

      // Hover states
      const interactives = document.querySelectorAll(
        'a, button, [role="button"], .cv-card, .knoll-item',
      );
      interactives.forEach((el) => {
        el.addEventListener("mouseenter", () => {
          dot.classList.add("cursor--hover");
          ring.classList.add("cursor--hover");
          // Passive card: mostra cursore speciale (freccia su + anello tratteggiato pulsante)
          if ((el as HTMLElement).dataset?.state === "passive") {
            dot.classList.add("cursor--passive-card");
            ring.classList.add("cursor--passive-card");
          }
        });
        el.addEventListener("mouseleave", () => {
          dot.classList.remove("cursor--hover");
          ring.classList.remove("cursor--hover");
          dot.classList.remove("cursor--passive-card");
          ring.classList.remove("cursor--passive-card");
        });
      });

      // Hide on leave, show on enter
      document.addEventListener("mouseleave", () => {
        gsap.to([dot, ring], { opacity: 0, duration: 0.3 });
      });
      document.addEventListener("mouseenter", () => {
        gsap.to([dot, ring], { opacity: 1, duration: 0.3 });
      });
    </script>

  </body>
</html>

---
import "../styles/global.css";
import cursorCssUrl from "../styles/cursor.css?url";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
// ConsentBanner disattivato il 2026-08-04 (richiesta esplicita, responsabilità
// privacy presa dall'utente) — PostHog parte automaticamente, vedi lo script
// inline più sotto. Import commentato invece di rimosso: riattivarlo significa
// scommentare qui, la riga <ConsentBanner ... /> sotto, e il gate di consenso
// nello script PostHog.
// import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  title?: string;
  description?: string;
  mode?: "tech" | "creative" | "human";
  lang?: "it" | "en";
  /** FAB contatti — pagine CV ([mode], en/cv), home (index, en/index) e /work */
  showFab?: boolean;
  /** true sulle home (index/en/index): il ConsentBanner aspetta l'evento
   * "cv:wip-badge-shown" del preloader invece di comparire subito — vedi
   * ConsentBanner.astro. */
  consentBannerWaitForWip?: boolean;
  /** Esclude la pagina dall'indicizzazione. Serve a 404.astro (servita per
   * qualsiasi URL inesistente) e alle pagine private sotto /tools/. Va in
   * coppia con la riga corrispondente in robots.txt e col filtro della
   * sitemap: da solo, `noindex` non impedisce la scansione. */
  noindex?: boolean;
  /**
   * La pagina si aggancia da sola, con `scroll-snap` nativo: qui Lenis **non**
   * si accende.
   *
   * Non è una preferenza, è un'incompatibilità. Lenis non lascia scorrere il
   * browser: intercetta la rotella e riscrive la posizione a ogni fotogramma.
   * Per il motore di snap quello non è un gesto, è una sequenza di salti
   * programmatici — e lo snap o non parte, o parte contro l'animazione. Le due
   * cose vogliono possedere la stessa cosa, e una delle due deve cedere.
   *
   * Dove è `true` lo scorrimento è quello nativo: nessun evento intercettato,
   * quindi nessuna finestra in cui un gesto possa sparire. È la ragione per
   * cui la home sta su questo binario — vedi lab-home.css § "L'aggancio".
   */
  nativeSnap?: boolean;
}

const {
  title = "Giulio Occhipinti — Digital CV",
  description = "CV interattivo di Giulio Occhipinti: UX/UI & Web Designer certificato IBM, Creative Technologist, AI & Digital Specialist e Project Manager Agile.",
  mode,
  lang = "it",
  showFab = false,
  // Prop tenuta (i chiamanti la passano ancora) ma non letta finché il
  // ConsentBanner resta disattivato più sotto — prefisso _ per l'unused-vars
  // di eslint. Rinominarla in consentBannerWaitForWip quando si riattiva.
  consentBannerWaitForWip: _consentBannerWaitForWip = false,
  noindex = false,
  nativeSnap = false,
} = Astro.props;

const siteUrl = "https://giulio-occhipinti.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Coppia IT/EN della pagina corrente, quando esiste. Le pagine fuori dal
// sito pubblico (gli strumenti privati, la 404) non hanno controparte e non
// devono dichiararne una.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const senzaControparte = ["/tools", "/404"];
const alternates = senzaControparte.some((p) => path.startsWith(p))
  ? null
  : {
      it: new URL(path.startsWith("/en") ? path.slice(3) || "/" : path, siteUrl).href,
      en: new URL(path.startsWith("/en") ? path : `/en${path === "/" ? "" : path}`, siteUrl).href,
    };
// Screenshot reale della home 1200×630, JPEG ~90KB: WhatsApp scarta le
// immagini og sopra ~300KB. Nome nuovo (og-cover) = cache busting per le
// anteprime già condivise con il vecchio og-image.png.
const ogImage = `${siteUrl}/og-cover.jpg`;

// JSON-LD — Person schema (schema.org) — indicizzato direttamente da Google
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Giulio Occhipinti",
  jobTitle: "Consulente per l'Innovazione Digitale & Partner Tecnico per piccole e grandi realtà",
  url: siteUrl,
  email: "mailto:giulio.occhipinti.g@gmail.com",
  sameAs: ["https://www.linkedin.com/in/giulio-occhipinti", "https://github.com/julioojospintados"],
  knowsAbout: [
    "UX Design",
    "UI Design",
    "Figma",
    "GSAP",
    "Astro",
    "Angular",
    "TypeScript",
    "Lit",
    "WebComponents",
    "Agile",
    "MCP Protocol",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Torino",
    addressCountry: "IT",
  },
};
---

<!doctype html>
<html
  lang={lang}
  data-mode={mode ?? "tech"}
  data-fab-scrollwait
  data-native-snap={nativeSnap ? "" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Giulio Occhipinti" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <!-- Tells browsers this page is already dark — prevents OS dark mode from
         force-inverting colors (lines, overlays) on Chrome/Safari Android/iOS -->
    <meta name="color-scheme" content="dark" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    {
      /* hreflang — dice ai motori che due indirizzi sono la STESSA pagina in
         due lingue, invece di due pagine che si fanno concorrenza. Serve da
         quando l'italiano e l'inglese sono generati dallo stesso componente:
         prima erano alberi separati e nessuno dei due lo dichiarava.

         Il percorso EN è quello IT con /en davanti — regola vera su tutto il
         sito (/design ↔ /en/design, /work ↔ /en/work, / ↔ /en). Le pagine
         che non hanno controparte (/tools, la 404) non lo emettono:
         `alternates` resta null e il blocco non esce.

         x-default punta all'italiano, che è la lingua della home. */
      alternates && (
        <>
          <link rel="alternate" hreflang="it" href={alternates.it} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="x-default" href={alternates.it} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "it_IT"} />
    <meta property="og:site_name" content="Giulio Occhipinti — Digital CV" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data — Person schema (schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- PostHog — solo in build di produzione E solo sull'hostname canonico.
         import.meta.env.PROD da solo non basta: i deploy preview di Vercel
         eseguono comunque una build "production" di Astro/Vite (stesso output
         statico dietro *.vercel.app), quindi quel check da solo lascia
         passare anche i preview. Il controllo su location.hostname a runtime
         esclude alias/preview Vercel e localhost.
         enable_heatmaps esplicito: la cattura heatmap non è garantita on-by-default
         dal solo snippet standard.
         disable_surveys: non usiamo survey — evita di scaricare surveys.js (~33KB) a vuoto.
         init posticipato a dopo 'load' + idle: array.js/recorder.js (~455KB da parsare)
         non devono più competere con il preloader GO per banda e main thread.
         Gate di consenso rimosso il 2026-08-04 (richiesta esplicita, banner
         disattivato — vedi ConsentBanner import/render commentati qui sotto):
         posthog.init parte da solo al load, senza attendere alcun consenso.
         session_recording.minimumDurationMilliseconds: 10s minimi di sessione
         prima che una registrazione venga tenuta, per non salvare rumore su
         rimbalzi immediati. Per riattivare il gate: decommenta l'import/uso
         di ConsentBanner sotto e reintroduci il check su
         localStorage['cv-consent'] prima di chiamare __phIdle(). -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          type="text/javascript"
          set:html={`!function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="Ji Yi init fn mn Hr pn bn cn capture calculateEventProperties Sn register register_once register_for_session unregister unregister_for_session Tn getFeatureFlag getFeatureFlagPayload getFeatureFlagResult getAllFeatureFlags isFeatureEnabled reloadFeatureFlags updateFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey displaySurvey cancelPendingSurvey canRenderSurvey canRenderSurveyAsync Mn identify setPersonProperties unsetPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset shutdown setIdentity clearIdentity get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException addExceptionStep captureLog startExceptionAutocapture stopExceptionAutocapture loadToolbar get_property getSessionProperty Cn xn createPersonProfile setInternalOrTestUser In hn Pn opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing get_explicit_consent_status is_capturing clear_opt_in_out_capturing debug Ur Rt getPageViewId captureTraceFeedback captureTraceMetric an".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        function __phInit() {
          if (location.hostname === '${new URL(siteUrl).hostname}' || location.hostname === 'www.${new URL(siteUrl).hostname}') {
            posthog.init('phc_wsRRcGh7HYR8yuR2jzPjf3kin2SpGqPXNcy9byhQ2pbc', {
                api_host: 'https://us.i.posthog.com',
                defaults: '2026-05-30',
                person_profiles: 'identified_only',
                enable_heatmaps: true,
                capture_performance: { web_vitals: true },
                disable_surveys: true,
                session_recording: { minimumDurationMilliseconds: 10000 },
            })
          }
        }
        function __phIdle() { (window.requestIdleCallback || function(cb){setTimeout(cb, 1)})(__phInit); }
        if (document.readyState === 'complete') { __phIdle(); } else { window.addEventListener('load', __phIdle); }`}
        />
      )
    }

    <!-- Nessun foglio dei caratteri differito, e non e' una semplificazione:
         e' la correzione. Qui c'era fonts.css, servito con il trucco
         `media="print"` + `onload` per tenerlo fuori dal percorso critico.
         Misurato: nell'istante in cui quel foglio passa a `media="all"` il
         browser ricostruisce l'INTERO set di caratteri del documento e rifa'
         la selezione da capo — le facce gia' risolte tornano "unloaded" e
         vengono riabbinate. Le chip della lente saltavano li', da 51 a 54px a
         247ms, e nessun `font-display` poteva impedirlo: la decisione veniva
         presa due volte, e la seconda con la cache ormai calda dava un esito
         diverso dalla prima.

         Adesso tutte le facce che servono — quattro Lexend e tre JetBrains
         Mono — sono dichiarate in global.css, che blocca gia' il rendering.
         Un set solo, deciso una volta. -->

    <!-- ── Il cambio lingua attraversa invece di tagliare ──────────────────
         Misurato il 2026-09-01 sul cambio lingua della home, e i numeri sono
         il motivo per cui questo script esiste:

           · il cursore dell'interruttore faceva 150ms di andata alla
             pressione e 150ms di RITORNO al rilascio, e solo dopo arrivava la
             pagina nuova. Tre movimenti per un comando che ne ha uno;
           · la transizione fra i due documenti c'era gia' — `pageswap` e
             `pagereveal` consegnano entrambi un viewTransition — ma alla sua
             `ready` le animazioni erano ZERO. La radice non si fotografa
             (global.css, `view-transition-name: none`) e nessun elemento
             portava un nome condiviso: il browser montava tutta la macchina
             della transizione per non animare niente.

         Qui non si accende niente di nuovo: si da' un nome all'unica cosa che
         si muove davvero. Il cursore e' lo stesso oggetto sulle due pagine, in
         due posizioni diverse — e' esattamente il caso per cui un
         `view-transition-name` condiviso esiste. Costo: due assegnazioni di
         stringa dentro una transizione che era gia' in corso.

         Quello che NON si fa, e vale scriverlo perche' e' la prima idea che
         viene: fotografare la radice per dissolvere le due lingue una
         nell'altra. Tre ragioni. La dissolvenza di serie fonde i due strati in
         `plus-lighter`, quindi la frase italiana e quella inglese si
         leggerebbero sovrapposte — provata e scartata il 2026-08-27 per la
         lente, e qui sarebbe peggio, perche' i due testi dicono la stessa cosa
         in due lingue. La pagina d'arrivo, poi, al primo disegno e' ancora
         nascosta dall'anti-lampo dell'ingresso: si dissolverebbe verso il
         vuoto. E terzo, non serve — fra le due home cambiano la tagline, la
         riga dei ruoli e i testi sotto la piega; il nome, gli oggetti e
         l'impaginato sono identici, quindi non c'e' quasi niente da
         dissolvere.

         Le due meta':

         1. ALLA PARTENZA (delegato, in cattura: il markup non c'e' ancora
            quando questo script gira). `data-going` fissa il cursore dove sta
            andando — e' la fine della molla — e il nome fa entrare il cursore
            nella fotografia del documento che se ne va.
         2. ALL'ARRIVO (`pagereveal`, prima del primo disegno). Il nome va
            dato alla pagina nuova prima che il browser la fotografi, che e'
            la stessa ragione per cui l'atterraggio dell'oggetto della lente
            sta in uno script inline e non in un modulo.

         Come si sa che questa navigazione e' un cambio lingua e non un'altra:
         l'interruttore della pagina d'arrivo ha UN solo link, e quel link
         punta alla pagina da cui si viene. Se combacia con il referrer,
         allora si e' arrivati da li' cambiando lingua. Nessuna matematica sui
         percorsi da tenere allineata a `lensPath()`: il dato e' gia' nel DOM,
         messo da chi lo sa gia'.

         A movimento ridotto il nome non si assegna: la regola globale che
         azzera le durate usa `*`, e i pseudo-elementi della transizione
         stanno in un albero che `*` non raggiunge. Senza nome non c'e'
         niente da animare, ed e' il comportamento giusto. -->
    <script is:inline>
      (() => {
        const NOME = "lang-thumb";
        const fermo = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const nudo = (u) => u.pathname.replace(/\/+$/, "") || "/";

        addEventListener(
          "click",
          (e) => {
            const opt = e.target.closest && e.target.closest("a.lang-switch__opt");
            if (!opt || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey) return;
            const sw = opt.closest(".lang-switch");
            if (!sw) return;
            sw.dataset.going = "";
            const th = sw.querySelector(".lang-switch__thumb");
            if (th && !fermo) th.style.viewTransitionName = NOME;
          },
          true,
        );

        // Tornando indietro dalla cache la pagina e' quella di prima, con
        // addosso lo stato di un viaggio gia' fatto: il cursore resterebbe
        // dalla parte sbagliata rispetto alla lingua che si sta leggendo.
        addEventListener("pageshow", (e) => {
          if (!e.persisted) return;
          document.querySelectorAll(".lang-switch[data-going]").forEach((sw) => {
            delete sw.dataset.going;
          });
        });

        addEventListener("pagereveal", (e) => {
          const vt = e.viewTransition;
          if (!vt || fermo || !document.referrer) return;
          const sw = document.querySelector(".lang-switch");
          const link = sw && sw.querySelector("a.lang-switch__opt");
          const th = sw && sw.querySelector(".lang-switch__thumb");
          if (!link || !th) return;
          let da;
          try {
            da = new URL(document.referrer);
          } catch {
            return;
          }
          if (da.origin !== location.origin) return;
          if (nudo(da) !== nudo(new URL(link.href))) return;
          th.style.viewTransitionName = NOME;
          vt.finished.finally(() => {
            th.style.viewTransitionName = "";
          });
        });
      })();
    </script>

    <!-- ── L'oggetto in volo aspetta che la pagina sia in piedi ────────────
         Una transizione fra due documenti parte al PRIMO DISEGNO della
         pagina di arrivo: nell'istante in cui quella pagina ha appena finito
         il suo primo layout e deve ancora decodificare le immagini della
         testata e rasterizzare. Chiedere un'animazione fluida proprio li' e'
         chiedere al browser due cose insieme, e la seconda la fa male.

         Prima qui c'era un'attesa fissa (`--delay-page: 190ms`) e funzionava
         quando indovinava. Misurato: a browser caldo il buco peggiore
         durante il volo passava da 21ms a 92 fra una prova e l'altra, e a
         browser freddo — prima navigazione dopo l'apertura, cioe' il caso di
         chi arriva dal QR — restava sopra i 300. Un numero fisso non puo'
         sapere quanto ci mette una pagina a nascere su una macchina che non
         conosce.

         Quindi non si indovina piu': si guarda. L'animazione parte in pausa e
         riparte al terzo fotogramma consecutivo consegnato in tempo, che e'
         il segno che la pagina ha finito. Su una macchina veloce sono ~50ms,
         su una lenta quanto serve. Il tetto e' mezzo secondo: se in mezzo
         secondo la pagina non si e' calmata, si parte lo stesso — meglio
         un'animazione imperfetta di un oggetto che resta appeso.

         Senza JS non succede niente di male: le animazioni non vengono messe
         in pausa e la transizione e' quella di prima. -->
    <script is:inline>
      addEventListener("pagereveal", (e) => {
        const vt = e.viewTransition;
        if (!vt) return;
        vt.ready.then(() => {
          const anim = document
            .getAnimations()
            .filter((a) => a.effect?.pseudoElement?.startsWith("::view-transition"));
          if (!anim.length) return;
          anim.forEach((a) => a.pause());

          const via = (scaduto) => {
            clearTimeout(tetto);
            const t = performance.now() - t0;
            // Scaduto il tetto si decide sui fatti, non sulla speranza: se in
            // quel mezzo secondo la pagina ha consegnato meno della meta' dei
            // fotogrammi che avrebbe dovuto, non si e' calmata e non si
            // calmera'. Li' animare e' peggio che non animare — un volo a
            // quattro scatti si legge come un difetto, l'oggetto gia' al suo
            // posto no. `finish()` lo porta a destinazione senza disegnare il
            // viaggio.
            const fiacca = scaduto && visti < t / 33;
            anim.forEach((a) => (fiacca ? a.finish() : a.play()));
            if (window.__vt) {
              window.__vt.attesa = t;
              window.__vt.rinuncia = fiacca;
            }
          };
          const t0 = performance.now();
          const tetto = setTimeout(() => via(true), 600);

          let buoni = 0;
          let visti = 0;
          let prec = t0;
          const guarda = () => {
            const ora = performance.now();
            visti++;
            buoni = ora - prec <= 20 ? buoni + 1 : 0;
            prec = ora;
            if (buoni >= 3) via(false);
            else requestAnimationFrame(guarda);
          };
          requestAnimationFrame(guarda);
        });
      });
    </script>

    <!-- Rallentatore della transizione di pagina: `?vt=slow` per accenderlo,
         `?vt=off` per spegnerlo, dura quanto la sessione. Il perche' e la
         regola che ne segue stanno in global.css, § Rallentatore.

         Inline e in testa perche' l'attributo deve esserci PRIMA del primo
         disegno: se arrivasse dopo, la transizione sarebbe gia' partita
         alla velocita' di sempre e non ci sarebbe niente da guardare. -->
    <script is:inline>
      try {
        const vt = new URLSearchParams(location.search).get("vt");
        if (vt === "off") {
          sessionStorage.removeItem("vt-slow");
          sessionStorage.removeItem("vt-debug");
        } else if (vt === "slow") sessionStorage.setItem("vt-slow", "1");
        else if (vt === "debug") sessionStorage.setItem("vt-debug", "1");
        else if (vt === "slowdebug") {
          sessionStorage.setItem("vt-slow", "1");
          sessionStorage.setItem("vt-debug", "1");
        }
        if (sessionStorage.getItem("vt-slow")) document.documentElement.dataset.vtSlow = "";
        if (sessionStorage.getItem("vt-debug")) {
          document.documentElement.dataset.vtDebug = "";
          // Il campionamento sta QUI e non nel modulo, ed e' la stessa ragione
          // per cui la transizione era da sistemare: uno <script> a modulo
          // gira DOPO `pagereveal`, cioe' dopo l'istante che di questa
          // transizione interessa di piu'. Un misuratore che arriva tardi
          // misura solo la parte che gia' andava bene. Qui si raccolgono i
          // numeri, il modulo li racconta.
          const reg = { campioni: [], nome: null, durata: 0 };
          reg.fine = new Promise((r) => (reg.chiudi = r));
          window.__vt = reg;
          addEventListener(
            "pagereveal",
            (e) => {
              const vt = e.viewTransition;
              if (!vt) return reg.chiudi();
              vt.ready.then(() => {
                const t0 = performance.now();
                const el = document.documentElement;
                const x = (n) => {
                  const t = getComputedStyle(el, "::view-transition-group(" + n + ")").transform;
                  const m = /matrix\(([^)]*)\)/.exec(t);
                  return m ? parseFloat(m[1].split(",")[4]) : NaN;
                };
                reg.nome = ["lens-object", "portfolio-hero"].find((n) => !isNaN(x(n))) || null;
                let viva = true;
                const passo = () => {
                  if (!viva) return;
                  reg.campioni.push({ t: performance.now() - t0, x: reg.nome ? x(reg.nome) : 0 });
                  requestAnimationFrame(passo);
                };
                passo();
                vt.finished.finally(() => {
                  viva = false;
                  reg.durata = performance.now() - t0;
                  reg.chiudi();
                });
              });
            },
            { once: true },
          );
        }
      } catch {
        // Navigazione privata con lo storage negato: pazienza, niente strumenti.
      }
    </script>

    <!-- Cursore custom: richiesto solo su pointer fine (desktop/trackpad).
         matchMedia gira synchronously prima del primo paint (niente flash),
         e sui touch device (Moto G Power incluso — l'audit Lighthouse
         mobile lo segnalava al 100% inutilizzato) il file non viene nemmeno
         scaricato: zero byte invece di CSS morto. Vedi styles/cursor.css. -->
    <script is:inline define:vars={{ cursorCssUrl }}>
      if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = cursorCssUrl;
        document.head.appendChild(link);
      }
    </script>

    <!-- I QUATTRO pesi che servono al primo disegno: 400 per il testo, 600 per
         bottoni e occhielli, 700 per i titoli, 800 per il preloader e il nome
         d'ingresso. Non e' un elenco a occhio: misurato leggendo
         document.fonts dopo il load su tutte e cinque le rotte pubbliche,
         ognuna li usa tutti e quattro. Tutti e due sono dichiarati in
         global.css sul file pubblico, cioe' su QUESTO indirizzo: se le due
         cose divergono il preload non viene mai usato e il file arriva due
         volte, che e' esattamente quello che succedeva al 400 fino al
         2026-08-27 (prefetch verso una copia, @fontsource verso un'altra).
         Da @fontsource resta solo JetBrains Mono, che al primo disegno non
         serve. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Lexend/lexend-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Lexend/lexend-latin-800-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Lexend/lexend-latin-600-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Lexend/lexend-latin-700-normal.woff2"
      crossorigin
    />

    <!-- E i tre pesi del monospaziato. Con `optional` un carattere che arriva
         dopo la scadenza non viene usato affatto per quella vista: senza
         questi preload le date, le chip e le sigle CEFR ripiegavano sul
         monospaziato di sistema per tutta la prima pagina (misurato: chip a
         51px invece di 54). Non sono byte in piu' — questi file scendevano
         gia' su ogni pagina — e' solo la priorita' che cambia. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/JetBrainsMono/jetbrains-mono-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/JetBrainsMono/jetbrains-mono-latin-600-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/JetBrainsMono/jetbrains-mono-latin-700-normal.woff2"
      crossorigin
    />

    <!-- Favicon GO rasterizzati con Lexend reale (favicon-render): l'SVG con
         <text> non è affidabile fuori dal browser (i bot di anteprima non
         caricano webfont né renderizzano SVG). favicon.ico reale a 3 taglie
         per crawler e contesti legacy. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <slot name="head" />
  </head>

  <body>
    <!-- Skip to main content — keyboard/screen reader accessibility -->
    <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

    <!-- Il nucleo del cursore: il punto che dice dove sei. aria-hidden e
         pointer-events:none — non esiste per chi naviga da tastiera o con uno
         screen reader, che e' esattamente come deve essere. L'alone che lo
         accompagnava e' stato tolto il 2026-08-27: la luce e' rimasta, ma ora
         si vede solo da cosa illumina. -->
    <div id="cursor-core" aria-hidden="true"></div>

    <slot />

    <!-- FAB contatti (showFab) — la definizione dell'island è importata
         dalla pagina ospite (cv-init.ts sulle pagine CV, script inline su
         home e /work) -->
    {showFab && <floating-menu />}

    {/* <ConsentBanner lang={lang} waitForWipBadge={consentBannerWaitForWip} /> */}

    <SpeedInsights />
    <Analytics />

    <!-- Init mode from store on client -->
    <script>
      import { initMode } from "../islands/stores/modeStore";
      initMode();
    </script>

    <!-- Notifica engagement PostHog (20s di tempo visibile reale) — vedi
         engagement-tracking.ts per la logica e il perché. -->
    <script>
      import "../scripts/engagement-tracking";
    </script>

    <!-- Lenis smooth scroll + GSAP ScrollTrigger wiring — attivo su tutte
         le pagine, home inclusa. Niente più CSS scroll-snap: coerenza
         site-wide, i reveal per-sezione sono in index-init.ts (ScrollTrigger).

         L'accensione aspetta la fine della transizione di pagina. Non è
         prudenza: costruire Lenis significa misurare il documento, e il
         ticker di GSAP aggiunge un giro di rAF a ogni fotogramma — due cose
         che, arrivando qui dalla home, cadevano dentro il mezzo secondo in
         cui l'oggetto sta attraversando lo schermo. Il conto misurato e il
         perché stanno in scripts/after-page-transition.ts.

         Gli import restano statici di proposito: così il pezzo di codice
         viaggia con la pagina e resta in cache fra una lente e l'altra —
         a essere rimandata è l'accensione, non lo scaricamento. -->
    <!-- Il racconto della sonda: import dinamico, quindi il file non viene
         nemmeno scaricato se nessuno l'ha chiesto con `?vt=debug`.

         E arriva DOPO la fine della transizione, non prima. Scaricare e
         valutare un modulo mentre l'oggetto vola e' esattamente il tipo di
         lavoro che fa perdere fotogrammi: misurato, con l'import in testa la
         stessa transizione passava da 16 campioni a 8 e da 18ms di buco
         peggiore a 357. Uno strumento che peggiora quello che misura non
         misura niente. I numeri intanto sono gia' al sicuro: li raccoglie
         l'interruttore inline qui sopra. -->
    <script>
      if (document.documentElement.hasAttribute("data-vt-debug")) {
        void window.__vt?.fine.then(() =>
          import("../scripts/vt-debug").then((m) => m.initVtDebug()),
        );
      }
    </script>

    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import { afterPageTransition } from "../scripts/after-page-transition";

      gsap.registerPlugin(ScrollTrigger);

      afterPageTransition(() => {
        // Pagina che si aggancia da sola con `scroll-snap` nativo: Lenis resta
        // spento, e lo scorrimento è quello del browser. Le due cose vogliono
        // possedere la stessa posizione — il perché per esteso sta sulla prop
        // `nativeSnap` in testa a questo file.
        //
        // ScrollTrigger non ne risente: senza Lenis torna semplicemente ad
        // ascoltare l'evento `scroll` nativo, che è il suo comportamento
        // predefinito. L'unica cosa che va tolta è il ponte `lenis.on("scroll")`,
        // che senza Lenis non ha nessuno da ascoltare.
        if (document.documentElement.hasAttribute("data-native-snap")) return;

        const lenis = new Lenis({ lerp: 0.15, syncTouch: true });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);

        // Expose for pages that need direct access
        window.__lenis = lenis;
      });
    </script>

    <!-- FAB visibile solo dopo il primo scroll — attributo SSR su <html>,
         tolto oltre gli 80px e rimesso quando si torna in cima -->
    <script>
      const fabSync = () => {
        document.documentElement.toggleAttribute("data-fab-scrollwait", window.scrollY <= 80);
      };
      fabSync();
      window.addEventListener("scroll", fabSync, { passive: true });
    </script>

    <!-- ── Cursore e luce di scena ──────────────────────────────────────
         Un punto che segue il puntatore, e sugli oggetti knolling le ombre
         portate che si spostano davvero: --lh-sh-x/y esistono gia' in
         lab-home.css, erano solo costanti. La luce c'era, mancava di dire da
         dove venisse.

         La sorgente e' invisibile: fino al 2026-08-27 era un alone da 22rem
         che inseguiva il puntatore, ed e' quello che dava al cursore un'aria
         lenta — un alone in ritardo si legge come pagina che rincorre il
         mouse, anche quando il punto e' esatto. Tolto l'alone, restano i due
         numeri della sua posizione: la luce continua a esserci, si vede solo
         attraverso le ombre che getta.

         Un rAF per l'intera scena, come lab-hero.ts: niente GSAP, che qui
         servirebbe per un lerp da dieci righe. Il loop si spegne da solo
         quando il puntatore e' fermo.

         Delegation invece di due listener per nodo (todo #51): lo stato lo
         porta una classe su <html>, quindi funziona anche per gli elementi
         montati dopo dalle island Lit. -->
    <script>
      // Un cursore custom cancella il puntatore di sistema, e con lui le
      // impostazioni di accessibilita' dell'OS (cursore ingrandito, ad alto
      // contrasto). Dove il sistema le chiede, non si parte proprio: il CSS
      // fa lo stesso e i due devono restare d'accordo.
      const ok =
        window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
        window.matchMedia("(prefers-reduced-motion: no-preference)").matches &&
        window.matchMedia("(prefers-contrast: no-preference)").matches;

      const core = document.getElementById("cursor-core");

      if (ok && core) {
        const root = document.documentElement;

        let px = 0,
          py = 0; // dove sta il puntatore
        let lx = 0,
          ly = 0; // dove sta la LUCE, che insegue il puntatore
        let acceso = false,
          gira = false;

        // Gli oggetti che la luce illumina davvero.
        const illuminati = Array.from(
          document.querySelectorAll<HTMLElement>(".lh-obj, .lh-section__object"),
        );

        // Le rect si rileggevano a ogni frame, tutte: N chiamate a
        // getBoundingClientRect() per giro, che costringono il browser a
        // ricalcolare il layout mentre muovi il mouse. E' quello che dava al
        // cursore l'aria di arrancare — non il punto, che e' sempre stato
        // esatto, ma il frame che diventava lungo.
        //
        // Adesso si rileggono solo quando possono essere cambiate davvero:
        // allo scorrimento e al ridimensionamento. Muovendo il mouse su una
        // pagina ferma il costo per frame e' zero letture di layout.
        let rects: DOMRect[] = [];
        let daRileggere = true;
        const invalida = () => {
          daRileggere = true;
        };
        window.addEventListener("scroll", invalida, { passive: true });
        window.addEventListener("resize", invalida, { passive: true });

        const frame = () => {
          // 0.32 e non 0.16: senza piu' l'alone da inseguire, il ritardo non
          // serve piu' a nascondere niente. Le ombre girano il doppio piu'
          // svelte e restano comunque morbide — a 1 seguirebbero il pixel e
          // tremolerebbero.
          lx += (px - lx) * 0.32;
          ly += (py - ly) * 0.32;

          // Il punto per primo, e con i valori esatti del puntatore: qualunque
          // cosa venga dopo in questo frame, il cursore e' gia' al suo posto.
          core.style.transform = `translate3d(${px}px,${py}px,0)`;

          if (illuminati.length) {
            const h = window.innerHeight;
            const diag = Math.hypot(window.innerWidth, h) || 1;
            if (daRileggere) {
              rects = illuminati.map((el) => el.getBoundingClientRect());
              daRileggere = false;
            }

            for (let i = 0; i < illuminati.length; i++) {
              const b = rects[i];
              // Fuori dalla finestra non si illumina niente: e' il grosso del
              // risparmio su una pagina lunga.
              if (!b || b.bottom < -200 || b.top > h + 200 || !b.width) continue;

              const dx = b.left + b.width / 2 - lx;
              const dy = b.top + b.height / 2 - ly;
              const d = Math.hypot(dx, dy) || 1;
              const q = Math.min(d / (diag * 0.55), 1);
              const lung = 4 + q * 16;

              const st = illuminati[i].style;
              st.setProperty("--lh-sh-x", `${((dx / d) * lung).toFixed(1)}px`);
              st.setProperty("--lh-sh-y", `${((dy / d) * lung * 0.75 + 4).toFixed(1)}px`);
              st.setProperty("--lh-sh-blur", `${(0.55 + q * 1.5).toFixed(2)}rem`);
              st.setProperty("--lh-sh-opacity", (0.62 - q * 0.28).toFixed(2));
            }
          }

          if (Math.abs(px - lx) < 0.3 && Math.abs(py - ly) < 0.3) {
            gira = false;
            return;
          }
          requestAnimationFrame(frame);
        };

        const sveglia = () => {
          if (gira) return;
          gira = true;
          requestAnimationFrame(frame);
        };

        window.addEventListener(
          "pointermove",
          (e) => {
            if (e.pointerType !== "mouse") return;
            px = e.clientX;
            py = e.clientY;
            if (!acceso) {
              acceso = true;
              lx = px;
              ly = py;
              root.classList.add("cursor-on");
            }
            sveglia();
          },
          { passive: true },
        );

        // ── Gli stati, per delegation ──────────────────────────────────
        const TESTO =
          "input:not([type=button]):not([type=submit]):not([type=checkbox]):not([type=radio]), textarea, [contenteditable=true]";
        const CLICCA =
          'a[href], button, summary, [role="button"], label[for], select, input[type=checkbox], input[type=radio]';

        const leggiStato = (t: EventTarget | null) => {
          if (!(t instanceof Element)) return;
          const spento = t.closest("[disabled], [aria-disabled=true]");
          const testo = t.closest(TESTO);
          const clicca = t.closest(CLICCA);
          root.classList.toggle("cursor-off", !!spento);
          root.classList.toggle("cursor-text", !spento && !!testo);
          root.classList.toggle("cursor-hot", !spento && !testo && !!clicca);
        };

        document.addEventListener("pointerover", (e) => leggiStato(e.target), { passive: true });

        // Il tasto premuto: lo stato lo porta <html>, cosi' vale anche se il
        // puntatore esce dall'elemento mentre e' giu'.
        window.addEventListener("pointerdown", () => root.classList.add("cursor-down"), {
          passive: true,
        });
        const su = () => root.classList.remove("cursor-down");
        window.addEventListener("pointerup", su, { passive: true });
        window.addEventListener("pointercancel", su, { passive: true });
        window.addEventListener("blur", su);

        // Uscita dalla finestra: il cursore si spegne invece di restare
        // parcheggiato sull'ultimo punto.
        document.addEventListener("pointerleave", () => root.classList.remove("cursor-on"));
        document.addEventListener("pointerenter", () => {
          if (acceso) root.classList.add("cursor-on");
        });
      }
    </script>
  </body>
</html>

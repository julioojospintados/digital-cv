# Prima di ogni `git push`, in tre tempi.
#
# 1. Lint e format — la stessa coppia che gira in CI ("Lint & format (repo
#    intero)", .github/workflows/ci.yml): un errore come consentBannerWaitForWip
#    (unused var sfuggita a un commit locale) lo vedi subito, non dopo
#    un'email di CI fallita 20 minuti dopo. Sono secondi.
#
# 2. I controlli da browser — `npm run qa:prepush`: build vera, server statico
#    su quella build, poi vetrina (qa:ds), copertura della vetrina
#    (qa:showcase), parità IT ↔ EN, link interni e misure reali dei visitatori
#    (qa:viewports), tutti su TUTTE le pagine del build.
#    Costano parecchi minuti, e girano solo quando il push lo chiede davvero
#    (regola di Giulio, 2026-10-22: «solo quando ti chiedo di pushare, non
#    ogni volta»):
#      - sempre, se il push porta qualcosa su main;
#      - su un ramo di lavoro, solo con QA=1:  QA=1 git push
#    Un push di salvataggio su un ramo di lavoro fa solo lint e format. Chi
#    lavora per Giulio usa QA=1 ogni volta che è lui a chiedere il push.
#
#    Perché sulla build e non su un dev server: la cache delle dipendenze di un
#    dev server rimasto aperto ha già prodotto falsi negativi (404 su chunk
#    Vite invalidati da una build parallela, letti come errori di pagina).
#
# 3. Un promemoria per analisi.md — e SOLO un promemoria. Il file è gitignored:
#    nessun hook può sapere se il suo contenuto è aggiornato, quindi bloccare
#    il push sarebbe una bugia travestita da controllo. Compare quando il push
#    porta un segnale «macro»: una dipendenza cambiata, o un file toccato sotto
#    src/tools/, .claude/agents/, .claude/skills/, cv-site/src/pages/, scripts/.
#    Vedi AGENTS.md § "analisi.md".
#
# Richiede cv-site/node_modules già installato — normale su una macchina di
# sviluppo, non lo installiamo qui per non rallentare ogni push.
#
# Scorciatoia consapevole, per un push urgente: SKIP_QA=1 git push (mai su main).
npm run lint && npm run format:check || exit 1

# Git passa sullo stdin una riga per ogni ref che parte:
#   <ref locale> <sha locale> <ref remoto> <sha remoto>
VERSO_MAIN=0
while read -r _ _ REMOTO _; do
  [ "$REMOTO" = "refs/heads/main" ] && VERSO_MAIN=1
done

if [ "$SKIP_QA" = "1" ]; then
  echo "SKIP_QA=1 — controlli da browser saltati. Non farlo su main."
elif [ "$VERSO_MAIN" = "1" ] || [ "$QA" = "1" ]; then
  npm run qa:prepush || exit 1
else
  echo "Ramo di lavoro: solo lint e format. I controlli da browser girano verso main, o con QA=1."
fi

# ── Promemoria analisi.md (mai bloccante) ─────────────────────────────────
# Confronta ciò che sta per partire con l'upstream; al primo push di un ramo
# (nessun upstream) guarda l'ultimo commit e basta.
BASE=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo 'HEAD~1')
MACRO=$(git diff --name-only "$BASE"..HEAD 2>/dev/null |
  grep -E '^(package\.json|cv-site/package\.json|src/tools/|\.claude/agents/|\.claude/skills/|cv-site/src/pages/|scripts/)' ||
  true)

if [ -n "$MACRO" ]; then
  echo ""
  echo "  📓 Questo push tocca qualcosa di «macro»:"
  echo "$MACRO" | head -12 | sed 's/^/       /'
  echo ""
  if [ -f analisi.md ]; then
    echo "     Se introduce una funzionalità nuova (libreria, pagina, rotta, tool MCP,"
    echo "     agente, skill, sottosistema, regola ferrea), aggiorna analisi.md prima"
    echo "     di raccontarlo altrove. Una correzione CSS non ci va."
  else
    echo "     analisi.md non c'è: è il registro delle macrofunzionalità del sito"
    echo "     (root, gitignored). Vedi AGENTS.md, sezione analisi.md."
  fi
  echo ""
fi

exit 0

{
  "mcpServers": {
    "mcp-base-template": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/dist/index.js"]
    },
    "gsc": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "suganthan-gsc-mcp@2.5.1"],
      "env": {
        "GSC_KEY_FILE": "${GSC}",
        "GSC_AUTH_MODE": "service_account",
        "GSC_SITE_URL": "sc-domain:giulio-occhipinti.com",
        "GSC_SCOPES": "readonly"
      }
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@0.0.83"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp"
    }
  }
}

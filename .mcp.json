{
	"mcpServers": {
		"mcp-base-template": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${CLAUDE_PROJECT_DIR:-.}/dist/index.js"
			]
		},
		"sequential-thinking": {
			"command": "cmd",
			"args": [
				"/c",
				"mcp-server-sequential-thinking"
			],
			"disabled": false,
			"alwaysAllow": []
		},
		"playwright": {
			"type": "stdio",
			"command": "cmd",
			"args": [
				"/c",
				"npx",
				"-y",
				"@playwright/mcp@latest"
			]
		}
	}
}

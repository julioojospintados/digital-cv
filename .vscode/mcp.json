{
  // ─── SECRETS ──────────────────────────────────────────────────────────────
  // VS Code asks once per session and stores the value securely in the keychain.
  "inputs": [
    {
      "id": "github-token",
      "type": "promptString",
      "description": "GitHub Personal Access Token (scopes: repo, read:org, read:user)",
      "password": true
    },
    {
      "id": "gitlab-token",
      "type": "promptString",
      "description": "GitLab Personal Access Token (scope: api)",
      "password": true
    },
    {
      "id": "brave-api-key",
      "type": "promptString",
      "description": "Brave Search API Key — get one at https://api.search.brave.com/",
      "password": true
    }
  ],
  "servers": {
    // ─── LOCAL PROJECT SERVER ──────────────────────────────────────────────
    "mcp-base-template": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/dist/index.js"
      ]
    },
    // ─── GITHUB ───────────────────────────────────────────────────────────
    // Capabilities: repos, issues, PRs, branches, commits, file search, gists
    // Create token: https://github.com/settings/tokens
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github-token}"
      }
    },
    // ─── GITLAB ───────────────────────────────────────────────────────────
    // Capabilities: repos, MRs, issues, pipelines, groups
    // Create token: https://gitlab.com/-/profile/personal_access_tokens
    "gitlab": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${input:gitlab-token}",
        "GITLAB_API_URL": "https://gitlab.com"
      }
    },
    // ─── OTHER RECOMMENDED SERVERS (uncomment to activate) ────────────────
    // FILESYSTEM — read/write files outside the workspace
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ]
    },
    // SEQUENTIAL THINKING — structured multi-step reasoning chains
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    // BRAVE SEARCH — real-time web search
    // Get your free API key at: https://api.search.brave.com/
    "brave-search": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "${input:brave-api-key}"
      }
    },

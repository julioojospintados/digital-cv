  "servers": {
    // ═══════════════════════════════════════════════════════════════════════
    // ■ CORE — SEMPRE ATTIVI
    //   Nessun token richiesto. Si avviano automaticamente con il progetto
    //   grazie al task "MCP: Auto-build server" in tasks.json (runOn: folderOpen).
    //   Se uno di questi mostra "stopped", usa Ctrl+Shift+P → "MCP: Restart Server".
    // ═══════════════════════════════════════════════════════════════════════
    // SERVER LOCALE CV — espone cv.ts come tool/resource leggibili dall'AI
    // Dipende da dist/index.js → tasks.json fa npm run build al folder open
    "mcp-base-template": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/dist/index.js"]
    },
    // SEQUENTIAL THINKING — ragionamento strutturato step-by-step
    // Attivare per decisioni architetturali, copy complesso, UX analysis
    // Installato globalmente: npm i -g @modelcontextprotocol/server-sequential-thinking
    "sequential-thinking": {
      "command": "cmd",
      "args": ["/c", "mcp-server-sequential-thinking"]
    },
    // PLAYWRIGHT — automazione browser: naviga, clicca, screenshot, verifica UI
    // Scarica on-demand via npx al primo avvio (nessuna install globale richiesta)
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ○ ON-DEMAND — attivare solo quando servono (richiedono token/auth)
    // ═══════════════════════════════════════════════════════════════════════
    // GITHUB — repos, issues, PRs, branches, commits, file search
    // Create token: https://github.com/settings/tokens
    // "github": {
